@article{Nordeide1998,
  title = {Coastal Cod and North-East {{Arctic}} Cod - {{Do}} They Mingle at the Spawning Grounds in {{Lofoten}}?},
  author = {Nordeide, J T},
  year = {1998},
  volume = {83},
  pages = {373--379},
  abstract = {Cod (Gadus morhua L.) off northern Norway are divided into two main groups. The north-east Arctic cod (NAC) migrate southwards from the Barents Sea to the main spawning area near the Lofoten Islands on the coast off northern Norway. Coastal cod (CC) are relatively stationary, live and spawn along the entire Norwegian coast, including near the Lofoten Islands. In order to test if the two groups physically intermingle at the spanning grounds, cod were sampled by trawl and Danish seine at the traditionally important spawning grounds near the Lofoten Islands during the spawning season in 1995-97. Cod from 24 samples were examined for haemoglobin alleles, length, ses and stage of sexual maturity. The results indicate that: (1) NAC and CC did not mingle randomly. (2) However, specimens from both groups may stay simultaneously at the same local spanning ground within an area of less than 0.012 km(2). (3) Distribution of NAC and CC overlapped vertically, although NAC was more abundant than CC in samples from deep waters. (4) The ses ratio was skewed towards males in a majority of the samples. (5) A larger percentage of males compared to females was ready to spawn. (6) Cod shoals may be size-assorted. The results are discussed in relation to existing hypotheses about cod spanning behaviour.},
  isbn = {0036-4827},
  journal = {Sarsia},
  keywords = {ATLANTIC COD,cod,distribution,GADUS-MORHUA L,GENETIC-VARIATION,NORWAY,NORWEGIAN COASTAL,POPULATION-STRUCTURE,spawning,stocks},
  language = {English},
  number = {5}
}

