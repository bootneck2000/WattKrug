@article{Kumar2001,
  title = {Polychlorinated Dibenzo-p-Dioxins, Dibenzofurans, and Polychlorinated Biphenyls in Human Tissues, Meat, Fish, and Wildlife Samples from {{India}}},
  author = {Kumar, K S and Kannan, K and Paramasivan, O N and Sundaram, V P S and Nakanishi, J and Masunaga, S},
  year = {2001},
  volume = {35},
  pages = {3448--3455},
  abstract = {Concentrations of polychlorinated dibenzo-p-dioxins (PCDDs), dibenzofurans (PCDFs), and non- and mono-orthosubstituted polychlorinated biphenyls (dioxin-like PCBs) were measured in tissues of humans, fishes, chicken, lamb, goat, predatory birds, and Ganges River dolphins collected from various locations in India. PCDDs/DFs were found in most of the samples analyzed with the liver of spotted owlet containing the highest concentration of 3300 pg/g, fat wt. 2,3,7,8-Substituted PCDDs and PCDFs were found in human fat tissues at concentrations ranging from 170 to 1300 pg/g, fat wt. Concentrations of PCDDs were generally greater than those of PCDFs in human tissues, fishes, animal fat, and dolphin. Among fishes, meat, and wildlife samples analyzed, concentrations of PCDDs/DFs were found in the following order: country chicken \textexclamdown{} goat/lamb fat \textexclamdown{} fishes \textexclamdown{} river dolphins \textexclamdown{} predatory birds. Hepta-CDDs and OCDD were the major PCDD homologues found in humans, fishes, meat products, and dolphins. 2,3,7,8-Tetrachlorodibenzo-p-dioxin equivalents of PCDDs/DFs were greater than those of PCBs in selected fish, dolphin, and human samples. To our knowledge, this is the first report of PCDDs and PCDFs in human tissues, fishes, meat, and wildlife collected from India. [References: 61]},
  journal = {Environmental Science \& Technology},
  keywords = {Environment/Ecology in Current Contents(R)/Agricul,Exposure,Ganges river dolphins,Human adipose-tissue,Japan.,Organochlorine pesticides,Pcbs,Pcdds,Pcdfs,Tailed sea eagles,Water},
  number = {17}
