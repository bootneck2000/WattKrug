  journal = {Marine Mammal Science},
  keywords = {763,Callorhinus ursinus,Halichoerus grypus,Leptonychotes weddellii,metabolic rate,Mirounga angustirostris,Monachus schauinslandi,newborn,Odobenus rosmarus,Orcinus orca,PBS Record: 181,Phoca groenlandica,Phoca hispida,Phoca vitulina,Phocoena phocoena,scaling,Stenella longirostris,thermoregulation,thermoregulation/marine mammals/body size/exercise,Trichechus inunguis,Tursiops truncatus,Zalophus californianus},
