@misc{Watkins2004,
  title = {The {{CCAMLR}} 2000 {{Survey}}: {{A}} Multinational, Multi-Ship Biological Oceanography Survey of the {{Atlantic}} Sector of the {{Southern Ocean}}},
  author = {Watkins, J. L. and Hewitt, R and Naganobu, M and Sushin, V},
  year = {2004},
