@article{Treasure2017,
  title = {Marine Mammals Exploring the Oceans Pole to Pole: {{A}} Review of the Meop Consortium},
  author = {Treasure, A.M. and Roquet, F. and Ansorge, I.J. and Bester, M.N. and Boehme, L. and Bornemann, H. and Charrassin, J.-B. and Chevallier, D. and Costa, D.P. and Fedak, M.A. and Guinet, C. and Hammill, M.O. and Harcourt, R.G. and Hindell, M.A. and Kovacs, K.M. and Lea, M.-A. and Lovell, P. and Lowther, A.D. and Lydersen, C. and McIntyre, T. and McMahon, C.R. and Muelbert, M.M.C. and Nicholls, K. and Picard, B. and Reverdin, G. and Trites, A.W. and Williams, G.D. and Nico De Bruyn, P.J.},
  year = {2017},
  volume = {30},
  issn = {10428275},
  doi = {10.5670/oceanog.2017.234},
  abstract = {\textcopyright{} 2017, Oceanography Society. All rights reserved. Polar oceans are poorly monitored despite the important role they play in regulating Earth's climate system. Marine mammals equipped with biologging devices are now being used to fill the data gaps in these logistically difficult to sample regions. Since 2002, instrumented animals have been generating exceptionally large data sets of oceanographic CTD casts ( \textquestiondown{} 500,000 profiles), which are now freely available to the scientific community through the MEOP data portal (http://meop.net). MEOP (Marine Mammals Exploring the Oceans Pole to Pole) is a consortium of international researchers dedicated to sharing animal-derived data and knowledge about the polar oceans. Collectively, MEOP demonstrates the power and cost-effectiveness of using marine mammals as data-collection platforms that can dramatically improve the ocean observing system for biological and physical oceanographers. Here, we review the MEOP program and database to bring it to the attention of the international community.},
  journal = {Oceanography},
  number = {2}
}

