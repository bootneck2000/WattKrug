@article{Miyazaki1997,
  title = {Preliminary Study on Comparative Skull Morphology and Vertebral Formula among the Six Species of the Genus {{Lagenorhynchus}} ({{Cetacea}}: {{Delphinidae}})},
  author = {Miyazaki, N and Shikano, C},
  year = {1997},
  volume = {61},
  pages = {573--587},
  abstract = {To improve knowledge of the taxonomic relationships of six species of the genus Lagenorhynchus (L. obliquidens, L, albirostris, L. acutus, L. obscurus, L. australis and L. cruciger), we examined cranial characters obtained from 93 specimens and vertebral formula from 25 specimens. Comparison of absolute values (8 characters), proportional values to condylobasal length (8), and vertebral formula indicated that the six species are distinct from one another and are valid. The specific differences within the genus Lagenorhynchus were also strongly supported by the canonical discriminant analysis and Mahalanobis' distance. Their relationships were suggested as follows: (1) L. obliquidens was closer to L. obscurus, (2) L. australis was closer to L. cruciger, and (3) these four species were closer to L. acutus than to L. albirostris.},
  journal = {Mammalia},
  number = {4}
}

@article{Miyazaki1997a,
  title = {Comparison of Growth and Skull Morphology of Pacific White-Sided Dolphin, Lagenorhynchus Obliquidens, between the Coastal Waters of Iki Island and the Oceanic Waters of the Western North Pacific},
  author = {Miyazaki, N and Shikano, C},
  year = {1997},
  volume = {61},
  pages = {561--572},
  abstract = {Growth and skull morphology were studied on 58 specimens of Pacific white-sided dolphin (Lagenorhynchus obliquidens) collected from the coastal waters of Iki Island (Korea Strait, Japan) and the oceanic waters of the western North Pacific. As cranial bones of the species reach adult size at around 5 years old, cranial analyses were made on samples of more than 5 years. Comparison of cranial characters of the above two areas suggests that the Pacific white-sided dolphins off Iki Island belong to a different population from that in the western North Pacific. No significant sexual difference of body length and condylobasal length was observed in the samples from both areas. The males had broader rostrum and skull than females in Iki specimens Body length and condylobasal length of the Iki specimens were significantly larger than those of the western North Pacific specimens as well as 24 and 27 cranial characters for females and males, respectively. [References: 30]},
  journal = {Mammalia},
  keywords = {Animal sciences.},
  number = {4}
}

