@article{Vila1990,
  title = {Aggressiveness between Females and Mother-Pup Separation in the Southern Sea Lion in Chubut Argentina},
  author = {Vila, B L and Cassini, M H},
  year = {1990},
  volume = {63},
  pages = {169--176},
  abstract = {Female southern sea lion, Otaria byronia (de Blainville, 1820), individuals were studied the breeding season, from their arrival to the colony to their first sea journey. The aggression frequency observed per female increased with : (a) tide level, (b) hottest daily hours, (c) number of females in th reproductive group. (d) arrival of a new female in a group, (e) female size; and, (F) frequency of aggressions received to her offspring. The hypothesis of a direct relation between females aggressiveness and parental care is tested. Besides, proximal causes of mother-pup separations were analyzed, being male intrusion the main source of perturbation. Separations were more frequently seen during high tide, storms, satellite male intrusions and in single female groups, or in small females. Finally, general data of colony reproduction were obtained.},
