@article{Kasuya1977,
  title = {Age Determination and Growth of the Bairds Beaked Whale with a Comment on the Fetal Growth Rate},
  author = {Kasuya, T},
  year = {1977},
  pages = {1--20},
  abstract = {Two kinds of cycles exist in the alternation of the stainability of dentine and cementum of the species [Berardius bairdii Stejneger]. The longer cycle is annual, and the stainable layer is deposited from Aug.-Jan. The shorter cycle ranges 27-31 days with possible individual variations. The deposition of dentine ceases within several years after birth, and the short cycle is distinguishable in the 1st few annual layers. In cementum the annual layer is possibly formed during the entire life time, and the short cycle on the anterior tooth until 40-60 yr old. The life expectancy is 70 yr. The gestation will last for about 17 mo., one of the longest among the cetaceans.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animals,Cetaceans,Chordata,Chordates,Dental and Oral Biology/General,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Environmental Biology/Wildlife Management-Aquatic,Ge,General and Systematic Zoology/Mammalia,General/Laborato,Gerontology [24500],Mammalia,Mammals,Materials and Apparatus,Methods,Methods [16501],Methods [19001],Nonhuman Mammals,Nonhuman Vertebrates,Reproductive System/General,Vertebrata,Vertebrates,Ziphiidae [85840],Ziphiidae: Cetacea},
  number = {29}
}

@article{Kasuya1978,
  title = {The Life History of Dalls Porpoise with Special Reference to the Stock off the Pacific Coast of Japan},
  author = {Kasuya, T},
  year = {1978},
  pages = {1--64},
  abstract = {The geographical variation of color types indicated 3 local stocks in the northwestern north Pacific and western Bering Sea (WNP/BS); off the Pacific coast of Japan (PJ) and in the sea of Japan and Okhotsk Sea (SJ/OS). The catches by the salmon gillnet fishery in WNP/BS and harpoon fishing in PJ and in SJ/OS, and the age structure based on the cemental growth layers gave an estimation of the life history parameters. The calves are born in Aug.-Sept. at the length of 100 cm after gestation of 11.4 mo., and nursed for about 2 yr. Sexual maturity is attained in males at the age of 7.9 yr and the length of 195.7 cm, and in females at 6.8 yr and 186.5 cm. The mean calving interval is about 3 yr, and the annual natural mortality rate of the adult female will be below 0.1. Data was insufficient to indicate the degree of between stock difference of the parameters. The weaned immature individuals were distributed in the south in the winter (PJ, WNP/BS and SJ/OS) and possibly also in the summer. (WNP/BS.) The segregation of pregnant females by the size of the fetus may occur. (WNP/BS). The harpoon fishing mainly exploits the weaned immature and newly matured individuals (PJ and SJ/OS). The salmon gillnet fishery kills the calves of suckling age and newly matured individuals (WNP/BS). Lactating females are underrepresented in the both fisheries.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Anatomy and Histology,Animal,Animal Distribution (1971- ) [62800],Animals,Cetaceans,Chorda,Chordata,Chordates,Delphinidae: Cetacea,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Environmental Biology/Wildlife Management-Aquatic,Fish,Ge,General and Comparative/Com,General and Miscellaneous/Necrosis (197,General and Systematic Zoology/Mammalia,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/Population Genetics (197,Genetics and Cytogenetics/Sex Differences [03510],Gerontology [24500],Integumentary System/Anatomy [18502],Mammalia,Mammals,Metabolism/Energy and Respiratory Metabolism [1300,Methods [16501],Nonhuman Mammals,Nonhuman Vertebrates,Osteichthyes [85206],Osteichthyes: Pisces,Pathology,Pediatrics [25000],Reproductive System/General,Reproductive System/Physiology and Biochemistry [1,Vertebrata,Vertebrates},
  number = {30}
}

@article{Kasuya1978a,
  title = {On the Age Characteristics and Anatomy of the Tusk of Dugong-Dugon},
  author = {Kasuya, T and Nishiwaki, M},
  year = {1978},
  pages = {301--310},
  abstract = {Samples (15) obtained at Celebes, Luzon, Mulgrave and Thursday Islands were examined. The dentinal growth layers in the larger tusk, possibly the permanent 1st upper incisor, were the most useful for age determination unless the tusk was erupted and abraded. Cemental layers and the circular ridge on the surface of the tusk were useful to a lesser degree. The formation cycle is probably annual from comparison with the growth of reared animals. The female seems to attain sexual maturity at about 10 yr of age, and live for 45 yr. Special pattern of distribution of enamel on the tusk was described.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Anatomy and Histology,Animals,Chordat,Chordata,Chordates,Dental and Oral Biology/Anatomy [19002],Dental and Oral Biology/General,Dental and Oral Biology/Physiology and Biochemistr,Developmental Biology/Embryology-Morphogenesis,Dugongidae [86435],Dugongidae: Sirenia,Ecology,Environmental Biology/Water Research and Fishery B,Environmental Biology/Wildlife Management-Aquatic,Ge,General and Comparative/Com,General and Comparative/Gro,General and Systematic Zoology/Mammalia,Gerontology [24500],Mammalia,Mammals,Methods [19001],Nonhuman Mammals,Nonhuman Vertebrates,Reproductive System/Physiology and Biochemistry [1,Sirenians,Vertebrata,Vertebrates},
  number = {30}
}

@article{Kasuya1979,
  title = {Age Determination Reproduction and Growth of the Franciscana Dolphin Pontoporia-Blainvillei},
  author = {Kasuya, T and Brownell, R L Jr},
  year = {1979},
  pages = {45--68},
  abstract = {An examination was made of 260 Franciscana dolphins taken off the Uruguayan coast. Deposition of dentinal and cemental layers is annual, with the formation of an unstainable layer between Aug. and Nov. Cementum deposition continues after the probable cessation of dentine deposition 4-7 yr. Females usually have a 2 yr reproductive cycle. Calves are born at a length from 70-75 cm after a gestation of about 10.5 mo., and weaned before 1 yr of age. Sexual maturity is attained in both sexes at an age between 2 and 3 yr, which corresponds to the length of 131 cm and weight of 25-29 kg in males, and to 140 cm and 33-34 kg in females. Physical maturity is attained soon after the onset of sexual maturity. Sex ratio is at parity in immature individuals.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animals,Bones,Cetaceans,Chor,Chordata,Chordates,Connective and Adipose Tis,Dental and Oral Biology/General,Dental and Oral Biology/Physiology and Biochemistr,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Fasciae,Ge,General and Miscellaneous/Comparative,General and Systematic Zoology/Mammalia,Genetics and Cytogenetics/Sex Differences [03510],Gerontology [24500],Joints,Mammalia,Mammals,Methods [16501],Methods [18001],Methods [19001],Nonhuman Mammals,Nonhuman Vertebrates,Pediatrics [25000],Physiology,Platanistidae [85835],Platanistidae: Cetacea,Reproductive System/General,Reproductive System/Physiology and Biochemistry [1,Vertebrata,Vertebrates},
  number = {31}
}

@article{Kasuya1979a,
  title = {The Population of Finless Porpoise Neophocaena-Phocaenoides in the Inland Sea of Japan},
  author = {Kasuya, T and Kureha, K},
  year = {1979},
  pages = {1--44},
  abstract = {Observations of 1194 finless porpoises made through 11,549 km of sighting cruises in the Inland Sea are discussed. The porpoise migrates annually to and from the Pacific coast mainly through the 2 passes at the eastern Inland Sea. The highest density (4900 individuals) is found in April at the beginning of parturition season, and the lowest (1600) in early winter. The ratios of solitary adults, solitary calves and cows with calves show seasonal fluctuations and allow the analyses of the seasonality of reproduction. Gestation lasts for about 11 mo. Parturition occurs between April and Aug. with a possible peak in April and May. Most cows with calves born in April and May apparently leave the Inland Sea in the summer months. Weaning occurs from Dec.-June after a nursing period ranging from 6-15 mo. Pregnancies in 2 contiguous years are not frequent. A 2 yr breeding cycle may be the most common. Annual production of about 870 calves (both sexes) and gross annual reproductive rate of 17.9\% are provisionally estimated for the individuals in the Inland Sea.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animals,Cetaceans,Chorda,Chordata,Chordates,Circadian Rhythms and Other Periodic Cycles [07200,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,Mammalia,Mammals,Metabolism/Energy and Respiratory Metabolism [1300,Methods [16501],Movement (1971- ) [12100],Nonhuman Mammals,Nonhuman Vertebrates,Pediatrics [25000],Reproductive System/General,Reproductive System/Physiology and Biochemistry [1,Vertebrata,Vertebrates},
  number = {31}
}

