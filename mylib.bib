@article{Piatkowski2001a,
  title = {Impact of Cephalopods in the Food Chain and Their Interaction with the Environment and Fisheries: An Overview.},
  author = {Piatkowski, U and Pierce, G J and DaCunha, M M},
  year = {2001},
