@article{Tedman1979,
  title = {Cow Pup Behavior of the Weddell Seal Leptonychotes-Weddelli Pinnipedia in Mcmurdo Sound Antarctica},
  author = {Tedman, R A and Bryden, M M},
  year = {1979},
  volume = {6},
  pages = {19--38},
  abstract = {Observations on cow-pup behavior in the Weddell seal from birth to weaning were made at Turtle Rock, McMurdo Sound, during the breeding seasons of 1973 and 1974. Cow-pup pairs comgregated about cracks in the sea ice. Pups entered the water for the 1st time between 8 and 12 days of age and continued to enter the water with their mothers usually at least once per 24 h throughout the rest of the 6-7 wk nursing period. Inconsistent suckling was rare. Marked cows (22) suckled their own pups and no others, but on 2 out of 486 suckling bouts a marked pup attempted to suck from a foreign cow at least once. The total time spent suckling decreased from a mean of 298 min/24 h during the 1st wk post partum to 152 min/24 h during the lase 2 wk of the nursing period. The frequency of suckling periods decreased from 13.0-5.4/24 h during the same interval. The diurnal activity pattern in the suckling coincided with the movements of the seals in and out of the water. The growth rate of pups decreased after the 2nd wk post partum, associated with increased swimming activities, decreased sleeping time and a decreased time spent suckling.},
  journal = {Australian Wildlife Research},
  keywords = {*Behavioral Biology/Animal Behavior [07003],*Chordata,*Developmental Biology/Embryology-Morphogenesis,*Ecology,*Nutrition/General Studies,*Psychiatry/Psychophysiology [21003],*Reproductive System/Physiology and Biochemistry [,7900,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Biochemical Studies/General [10060],Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,G,General and Miscellaneous/Comparative,General and Systematic Zoology/Mammalia,Gerontology [24500],Methods [16501],Movement (1971- ) [12100],Nervous System/Physiology and Biochemistry [20504],Nutritional Status and,Pediatrics [25000],Phocidae [86185],Physiology,Reproductive System/General,Suckling Sleep Age Growth},
