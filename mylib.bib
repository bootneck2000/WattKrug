@article{Ridgway1999,
  title = {Comments on "Broadband Spectra of Seismic Survey Air-Gun Emissions, with Reference to Dolphin Auditory Thresholds"},
  author = {Ridgway, S H and Carder, D A and Kamolnick, T and Schlundt, C E and Elsberry, W and Hastings, M},
  year = {1999},
