  journal = {Marine mammal biology. An evolutionary approach.},
  keywords = {8690,anatomy,Arctocephalus australis,Arctocephalus forsteri,Arctocephalus galapagoensis,Arctocephalus gazella,Arctocephalus philippi,Arctocephalus pusillus,Arctocephalus townsendi,Arctocephalus tropicalis,Callorhinus ursinus,Cystophora cristata,diving,Erignathus barbatus,Eumetopias jubatus,Halichoerus grypus,Hydrurga leptonyx,Leptonychotes weddellii,Lobodon carcinophagus,Mirounga angustirostris,Mirounga leonina,Monachus monachus,Monachus schauinslandi,Neophoca cinerea,Odobenus rosmarus,Ommatophoca rossi,Otaria byronia,oxygen stores,Phoca caspica,Phoca fasciata,Phoca groenlandica,Phoca hispida,Phoca largha,Phoca sibirica,Phoca vitulina,Phocarctos hookerii,streamlining,thermoregulation,water balance,Zalophus californianus},
