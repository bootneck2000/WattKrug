@article{Levin2006,
  title = {A Stable Isotope Aridity Index for Terrestrial Environments},
  author = {Levin, N E and Cerling, T E and Passey, B H and Harris, J M and Ehleringer, J R},
  year = {2006},
  volume = {103},
  pages = {11201--11205},
  doi = {10.1073/pnas.0604719103},
  abstract = {We use the oxygen isotopic composition of tooth enamel from multiple mammalian taxa across eastern Africa to present a proxy for aridity. Here we report tooth enamel delta O-18 values of 14 species from 18 locations and classify them according to their isotopic sensitivity to environmental aridity. The species are placed into two groups, evaporation sensitive (ES) and evaporation insensitive (EI). Tooth enamel delta O-18 values of ES animals increase with aridity, whereas the tooth enamel delta O-18 values of EI animals track local meteoric water delta O-18 values, demonstrating that bioapatite delta O-18 values of animals with different behaviors and physiologies record different aspects of the same environment. The enrichment between tooth enamel delta O-18 values of ES and El animals records the degree of O-18 enrichment between evaporated water (ingested water or body water) and source water, which increases with environmental aridity. Recognition of the ES-EI distinction creates the opportunity to use the O-18 composition of bioapatite as an index of terrestrial aridity.},
  isbn = {0027-8424},
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  keywords = {bioapatite,BONE PHOSPHATE,CARBONATE,CLIMATE-CHANGE,East Africa,ECOLOGY,HYDROGEN,mammals,OXYGEN ISOTOPES,oxygen-18,RATIOS,RECORD,TOOTH ENAMEL,WATER,water use},
  language = {English},
  number = {30}
}

