@article{Murphy1980,
  title = {Metabolic Activities of Heart Lung and Brain during Diving and Recovery in the Weddell Seal Leptonychotes-Weddelli},
  author = {Murphy, B and Zapol, W M and Hochachka, P W},
  year = {1980},
  volume = {48},
  pages = {596--605.},
  abstract = {The metabolic potentials and activities of the heart, lung and brain were studied in the Weddell seal, a species displaying outstanding diving abilities. The activities of representative enzymes in oxidative and fermentative metabolism were similar to those in homologous bovine organs, but the brain and heart contained elevated levels of lactate dehydrogenase. Isozyme analyses indicated the potential in all 3 organs for either lactate production or lactate utilization, both conditions being found during diving-recovery cycles. During awake simulated diving, overall energy needs were supplied by glucose in a mixed aerobic and anaerobic metabolism; the consequent fall in blood glucose levels and rise in lactate levels were due predominantly to peripheral hypoperfused tissues, but the central organs influenced these metabolite pools as well. The brain utilized blood glucose at a rate of 0.3 .mu.mol .cntdot. g-1 .cntdot. min-1, releasing 20-25\% as lactate; this proportion did not change through diving-recovery cycles. The lung utilized blood lactate preferentially at a rate of about 0.5 mmol/min and thus diminished its accumulation in the blood during diving. The main fate of lactate taken up by the lung was oxidation inasmuch as 14CO2 was the only measurable derivative found in aortic blood following 14Clactate infusion into the right ventricle. During recovery, when blood lactate levels rose about 6 .mu.mol/ml, the brain switched from lactate release to lactate uptake at a rate high enough to readily support the normal metabolic rate of this organ (about 8 .mu.mol ATP .cntdot. g-1 .cntdot. min-1). Enzyme and metabolite measurements suggested that the lung and heart also contributed to lactate clearance and reestablishment of metabolic homeostasis following diving.},
  journal = {Journal of Applied Physiology: Respiratory, Environmental and Exercise Physiology},
  keywords = {*Cardiovascular System/Physiology and Biochemistry,*Ecology,*Enzymes/General and Comparative Studies,*Enzymes/Physiological Studies [10808],*Metabolism/Carbohydrates [13004],*Metabolism/Energy and Respiratory Metabolism [130,*Metabolism/General Metabolism,*Metabolism/Proteins,*Muscle/Physiology and Biochemistry [17504],*Nervous System/Physiology and Biochemistry [20504,*Physiology,*Respiratory System/Physiology and Biochemistry [1,64,8000,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Biochemical Studies/Carbohydrates [10068],Biochemical Studies/General [10060],Biochemical Studies/Proteins,Biochemistry/Gases (1970- ) [10012],Biophysics/Biocybernetics (1972- ) [10515],Blood,blood parameters,Blood-Forming Organs and Body Fluids/Blood,Bovidae [85715],brain metabolism,Cardiovascular System/General,Coenzymes [10802],Comparative Biochemistry,diving,Environmental Biology/Animal [07508],General [10010],General and Miscellaneous/Exercise an,General and Miscellaneous/General [12,heart metabolism,Lactate Dehydrogenase Blood Glucose Carbon Di Oxid,Leptonychotes weddellii,lung metabolism,Metabolic Pathways [13002],metabolism,Methods [14501],Movement (1971- ) [12100],Otariidae [86180],Peptides and Amino A,Peptides and Amino Acids [13,Psychiatry/Psychophysiology [21003],Radiation/Radiation and Isotope Techniques [06504]},
  mendeley-tags = {64},
  number = {4}
}

@article{Murphy1981,
  title = {Activities of Oxidative and Glycolytic Enzymes in Fetal Heart Lung and Brain in the Weddell Seal Leptonychotes-Weddelli},
  author = {Murphy, B J and Hochachka, P W},
  year = {1981},
  volume = {59},
  pages = {1172--1175},
  abstract = {The oxidative and glycolytic capacities of brain, heart and lung in near-term Weddel seal fetuses were estimated from the maximal activities of 4 mitochondrial marker enzymes and 4 glycolytic enzymes. The catalytic potentials for both groups of enzymes were similar to adult levels in all 3 organs. The critical metabolic functions performed by these 3 central organs during diving are already fully developed in the fetal seal. This early development of adult-type metabolic machinery did not appear to be a preparatory step for later extrauterine function, but rather appeared to be necessary for times of normal maternal diving when fetal metabolic responses mimic those of the mother.},
  journal = {Canadian Journal of Zoology},
  keywords = {*Aerospace and Underwater Biological Effects/Physi,*Cardiovascular System/Physiology and Biochemistry,*Developmental Biology/Embryology-General and Desc,*Enzymes/Physiological Studies [10808],*Metabolism/Carbohydrates [13004],*Metabolism/Energy and Respiratory Metabolism [130,*Metabolism/General Metabolism,*Nervous System/Physiology and Biochemistry [20504,*Respiratory System/Physiology and Biochemistry [1,8200,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Biochemical Studies/Proteins,Cytology and Cytochemistry/Animal [02506],Ecology,Environmental Biology/Water Research and Fishery B,Maternal Diving Metabolic Responses,Metabolic Pathways [13002],Peptides and Amino A,Phocidae [86185]},
  number = {6}
}

