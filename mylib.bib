@article{Knutti2012,
  title = {Robustness and Uncertainties in the New {{CMIP5}} Climate Model Projections},
  author = {Knutti, Reto and Sedl{\'a}{\v c}ek, Jan},
  year = {2012},
  volume = {3},
  pages = {1--5},
  issn = {1758-678X},
  doi = {10.1038/nclimate1716},
  abstract = {Estimates of impacts from anthropogenic climate change rely on projections from climate models. Uncertainties in those have often been a limiting factor, in particular on local scales. A new generation of more complex models running scenarios for the upcoming Intergovernmental Panel on Climate Change Fifth Assessment Report (IPCC AR5) is widely, and perhaps naively, expected to provide more detailed and more certain projections. Here we show that projected global temperature change from the new models is remarkably similar to that from those used in IPCC AR4 after accounting for the different underlying scenarios. The spatial patterns of temperature and precipitation change are also very consistent. Interestingly, the local model spread has not changed much despite substantial model development and a massive increase in computational capacity. Part of this model spread is irreducible owing to internal variability in the climate system, yet there is also uncertainty from model differences that can potentially be eliminated. We argue that defining progress in climate modelling in terms of narrowing uncertainties is too limited. Models improve, representing more processes in greater detail. This implies greater confidence in their projections, but convergence may remain slow. The uncertainties should not stop decisions being made.},
  isbn = {1758-678X},
  journal = {Nature Climate Change},
  number = {October}
}

@article{Kobayashi1995,
  title = {Evaluation of Shark, Dolphin, and Monk Seal Interactions with {{Northwestern Hawaiian Island}} Bottomfishing Activity: {{A}} Comparison of Two Time Periods and an Estimate of Economic Impacts},
  author = {Kobayashi, Donald R D: R and Kawamoto, Kurt E},
  year = {1995},
  volume = {23},
  pages = {11--22},
  abstract = {The incidence rates of bottomfish damaged by sharks, dolphins, and monk seals were compared from two sources of observer data taken aboard commercial bottomfishing vessels in the Northwestern Hawaiian Islands. The current (1990-1993) shark damage rate is significantly different from, and nearly six times higher than, the rate measured in 19811982. The dolphin and monk seal damage rates are also currently higher than the earlier rates. These temporal differences could be indicative of an increasing trend in interaction rates. A theoretical model is developed to estimate unobservable losses of fish based on the amount of fishing gear lost. The current economic impact is estimated to be approximately 700,000 annually (or approximately 7000 of lost revenue per trip on average) considering all sources of losses.},
  journal = {Fisheries Research},
  keywords = {241,Anim,Animal,animals,cetaceans,Chondrichthyes (Chondrichthyes),Chondrichthyes [85202],Chondrichthyes: Pisces,Chor,Chorda,Chordata,chordates,Delphinidae (Delphinidae),Delphinidae: Cetacea,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Environmental Sciences),fish,fish (Pisces - Unspecified),fishery interactions,General and Systematic Zoology/Pisces [6,Hawaii (USA,mammal (Mammalia - Unspecified),Mammalia,Mammalia - Unspecified: Mammalia,mammals,Marine Ecology (Ecology,Monachus schauinslandi,Nearctic region),net entanglement,nonhuman mammals,nonhuman vertebrates,North America,Nutrition,Nutrition/General Studies,Nutritional Status and,Osteichthyes (Osteichthyes),Osteichthyes: Pisces,Pacific Ocean (Pacific Ocean),Phocidae (Phocidae),Phocidae: Pinnipedia,pinnipeds,Pisces - Unspecified: Pisces,Systematics and Taxonomy,USA (North America,Vertebrata,vertebrates,Wildlife Management (Conservation)},
