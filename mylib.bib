@article{Findlay1996,
  title = {Estimates of the Numbers of Humpback Whales Observed Migrating Past {{Cape Vidal}}, {{South Africa}}, 1988-1991},
  author = {Findlay, K P and Best, P B},
  year = {1996},
  volume = {12},
  pages = {354--370},
  abstract = {A recovery-monitoring program of the African east coast humpback whale population was carried out through shore-based visual surveys from Cape Vidal, northern Natal. Surveys of the northward migration were undertaken each winter from 1988 to 1991, and a survey of the southward migration was undertaken in 1990. Independent observer surveys were undertaken during June 1990 and during the entire 1991 survey. Hourly densities of groups sighted each day were adjusted for groups missed by observers with distance from the shore and under different sighting conditions. Densities were multiplied by 24 h and the mean group size of the survey year to give resulting daily densities of individuals, which were summed to provide totals of whales sighted during each year's survey. The best estimate of population size was 1,711 (made during the northward migration of 1990), although this is likely to be biased downwards by a proportion of the population passing outside of observers' view. Bootstrapping of the 1991 daily data resulted in CVs between 11.4\% and 12.2\%. The numbers sighted show the population to have undergone considerable recovery since protection in October 1963.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {4341,African east coast/humpback whale/Megaptera novaea,Megaptera novaeangliae,PBS Record: 750},
  mendeley-tags = {4341,PBS Record: 750},
  number = {3}
}

@article{Findlay1996a,
  title = {Assessment of Heterogeneity in Sighting Probabilities of Humpback Whales within Viewing Range of {{Cape Vidal}}, {{South Africa}}},
  author = {Findlay, K P and Best, P B},
  year = {1996},
  volume = {12},
  pages = {335--353},
  abstract = {The migrations of humpback whales on the African east coast were monitored between 1988 and 1991 at Cape Vidal, South Africa. Shore-based surveys of the northward migration were undertaken each winter, and a survey of the southward migration was undertaken in 1990, from an approximately 60-m-high vantage point on a headland. Independent-observer surveys were carried out in both 1990 (22 d) and 1991 (51 d) to determine the proportion of the population within the survey area that were being missed by observers using a single mark-release model. Results were stratified into three distance intervals from the shore and three sighting condition intervals; there were constant sighting probabilities from the south tower under different sighting conditions, while those from the north tower increased slightly as sighting conditions improved. Sighting probabilities from both towers were highest in the intermediate distance interval and decreased in both the inshore and offshore regions.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {4340,humpback whale/Megaptera novaeangliae/sighting pro,Megaptera novaeangliae,PBS Record: 749},
  mendeley-tags = {4340,PBS Record: 749},
  number = {3}
}

@article{Findlay1997,
  title = {Attitudes and Expenditures of Whale Watchers in {{Hermanus}}, {{South Africa}}},
  author = {Findlay, K P},
  year = {1997},
  volume = {27},
  pages = {57--62},
  abstract = {Whale watching is becoming an increasingly popular wildlife-orientated recreation activity around the world. The Western Cape coastline of South Africa has extremely good shore-based whale watching of southern right whales Eubalaena australis centred on the coastal community of Hermanus. Resident and visitor whale watchers in Hermanus were interviewed during September and October 1995. Residents were questioned as to their attitudes to whale watching development and existing information facilities and as to the time and money spent whale watching. Visitors were questioned as to their origin, reasons for their visit to Hermanus, expenditure on their visit and their attitudes to information facilities and development. The total number of whale-watching visitors to Hermanus over the entire season could not be determined as no direct revenue is collected from this activity. Furthermore, direct counts were influenced by tourist turnover and multi-site watching within Hermanus. Consequently, visitor numbers were estimated from the observations made during surveys. The expenditure of whale-watch visitors over the 1995 season is estimated at about R5 million in indirect expenses. Residents were generally in agreement with the development of shore-based whale watching as a tourism activity, but against the development of boat-based whale watching.},
  journal = {South African Journal of Wildlife Research},
  keywords = {[00512] General biology - Conservation and resourc,[07502] Ecology: environmental biology - General a,[85805] Balaenidae,[86215] Hominidae,Balaenidae: Animals,Business and Industry,Cetacea,Cetaceans,Chordates,Conservation,Eubalaena-australis: southern right whale [Balaeni,expenditure,Hominidae: Animals,human [Hominidae],Humans,Mammalia,Mammals,Pr,Primates,tourism activity,Vertebrata,whale watching},
  number = {2}
}

@article{Findlay2002,
  title = {A Review of Humpback Whale Catches by Modern Whaling Operations in the {{Southern Hemisphere}}},
  author = {Findlay, K P},
  year = {2002},
  volume = {47},
  pages = {411--420},
  abstract = {Catches of humpback whales in the Southern Hemisphere are reviewed from a number of sources, along with numbers of catcher vessels which operated on each whaling ground, where data were available. Catches amounted to \textquestiondown 200,000 whales and can be divided into four groups: 1) pre-1917 coastal whaling from shore stations and floating factories; 2) Antarctic and low latitude pelagic and coastal catches reported to the Bureau of International Whaling Statistics (1923-1963); 3) post-1942 coastal catches largely centred in Australian and New Zealand waters; and 4) other catches, including those of the Olympic Challenger and the Soviet Antarctic whaling fleets. Crude catch per unit of effort (CPUE) indices were calculated as annual catch per catcher vessel for the Falkland Island Dependencies, African and South American whaling grounds. No CPUE indices could be calculated for the Australian grounds or the Antarctic pelagic whaling grounds. Catch trends in most grounds showed marked declines within the first decade of whaling, followed by no recovery. Marked differences in catch trends off both Gabon and Madagascar from those of other grounds off the west and east coasts of Africa respectively, suggest stock segregation in both areas.},
  journal = {Memoirs of the Queensland Museum},
  keywords = {[00512] General biology - Conservation and resourc,[07502] Ecology: environmental biology - General a,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[07516] Ecology: environmental biology - Wildlife,[85810] Balaenopteridae,annual catch per vessel,Balaenopteridae: Animals,Bureau of International Whaling Statistics,catch numb,catch per unit effort [CPUE],catcher vessel numbers,Cetacea,Cetaceans,Chordates,coastal whaling,Environmental Sciences,Falkland Island Dependencies,floating factories,low latitude coastal catches,low latitude pelagic catches,Ma,Mammalia,Marine Ecology: Ecology,Megaptera novaeangliae: humpback whale,shore stations,stock segregation,Verteb,whaling grounds,Wildlife Management: Conservation},
  number = {2}
}

