@article{Epica2006,
  title = {One-to-One Coupling of Glacial Climate Variability in {{Greenland}} and {{Antarctica}}},
  author = {Barbante, C. and Barnola, J. M. and Becagli, S. and Beer, J. and Bigler, M. and Boutron, C. and Blunier, T. and Castellano, E. and Cattani, O. and Chappellaz, J. and {Dahl-Jensen}, D. and Debret, M. and Delmonte, B. and Dick, D. and Falourd, S. and Faria, S. and Federer, U. and Fischer, H. and Freitag, J. and Frenzel, A. and Fritzsche, D. and Fundel, F. and Gabrielli, P. and Gaspari, V. and Gersonde, R. and Graf, W. and Grigoriev, D. and Hamann, I. and Hansson, M. and Hoffmann, G. and Hutterli, M. A. and Huybrechts, P. and Isaksson, E. and Johnsen, S. and Jouzel, J. and Kaczmarska, M. and Karlin, T. and Kaufmann, P. and Kipfstuhl, S. and Kohno, M. and Lambert, F. and Lambrecht, Astrid Anja and Lambrecht, Astrid Anja and Landais, A. and Lawer, G. and Leuenberger, M. and Littot, G. and Loulergue, L. and L{\"u}thi, D. and Maggi, V. and Marino, F. and {Masson-Delmotte}, V. and Meyer, H. and Miller, H. and Mulvaney, R. and Narcisi, B. and Oerlemans, J. and Oerter, H. and Parrenin, F. and Petit, J. R. and Raisbeck, G. and Raynaud, D. and R{\"o}thlisberger, R. and Ruth, U. and Rybak, O. and Severi, M. and Schmitt, J. and Schwander, J. and Siegenthaler, U. and {Siggaard-Andersen}, M. L. and Spahni, R. and Steffensen, J. P. and Stenni, B. and Stocker, T. F. and Tison, J. L. and Traversi, R. and Udisti, R. and {Valero-Delgado}, F. and Van Den Broeke, M. R. and Van De Wal, R. S.W. and Wagenbach, D. and Wegner, A. and Weiler, K. and Wilhelms, F. and Winther, J. G. and Wolff, E. and Epica, Community Members},
  year = {2006},
  volume = {444},
  pages = {195--198},
  issn = {14764687},
  doi = {10.1038/nature05301},
  abstract = {Precise knowledge of the phase relationship between climate changes in the two hemispheres is a key for understanding the Earth's climate dynamics. For the last glacial period, ice core studies have revealed strong coupling of the largest millennial-scale warm events in Antarctica with the longest Dansgaard-Oeschger events in Greenland through the Atlantic meridional overturning circulation. It has been unclear, however, whether the shorter Dansgaard-Oeschger events have counterparts in the shorter and less prominent Antarctic temperature variations, and whether these events are linked by the same mechanism. Here we present a glacial climate record derived from an ice core from Dronning Maud Land, Antarctica, which represents South Atlantic climate at a resolution comparable with the Greenland ice core records. After methane synchronization with an ice core from North Greenland, the oxygen isotope record from the Dronning Maud Land ice core shows a one-to-one coupling between all Antarctic warm events and Greenland Dansgaard-Oeschger events by the bipolar seesaw. The amplitude of the Antarctic warm events is found to be linearly dependent on the duration of the concurrent stadial in the North, suggesting that they all result from a similar reduction in the meridional overturning circulation. \textcopyright 2006 Nature Publishing Group.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\IQV3GQE4\\Epica - 2006 - One-to-one coupling of glacial climate variability in Greenland and Antarctica.pdf},
  isbn = {0028-0836},
  journal = {Nature},
  number = {7116},
  pmid = {17099953}
}

@article{Erasmus1997,
  title = {The Endocrine Pancreas of the {{Cape}} Fur Seal, {{Arctocephalus}} Pusillus ({{Schreber}}, 1776): {{An}} Immunocytochemical Study},
  author = {Erasmus, C P and Van, Aswegen G},
  year = {1997},
  volume = {64},
  pages = {239--242},
  abstract = {The indirect peroxidase method was employed to study the endocrine pancreas of the Cape fur seal. Immunoreactivity to insulin was confined to the cores of the islets and the insulin cells were more abundant than the other endocrine cell types, which occurred mainly in the mantles of the islets. Of these, glucagon cells were the most numerous, followed by somatostatin and pancreatic polypeptide (PP) cells. The latter were observed in the mantles of the islets and scattered in the exocrine tissue of the duodenal lobe. The marked variation in the shape and the distribution of the endocrine cells in the mantles of the islets seen in the pancreas of the seal, seems to be typical of carnivorous species like the cat and dog.},
  journal = {Onderstepoort Journal of Veterinary Research},
  keywords = {Animals. Chordates. Mammals. Nonhuman Mammals. Non,Arctocephalus-pusillus [Cape fur seal] (Otariidae),Chord,endocrine pancreas: endocrine system,Endocrine System (Chemical Coordination and Homeos,Endocrine System/Pancreas [17008],Mammalia,Methods [38002],Microscopy Techniques/Cytology and Cytochemistry [,Otariidae [86180],Otariidae: Pinnipedia,physiology.,Vertebrata,Veterinary Science/General},
