@article{Silber1990,
  title = {Killer Whales Orcinus-Orca Attack and Kill a Bryde's Whale Balaenoptera-Edeni},
  author = {Silber, G K and Newcomer, M W and Perez, Cortes M H},
  year = {1990},
  volume = {68},
  pages = {1603--1606},
  abstract = {On 3 May 1988, we observed a group of killer whales that pursued, killed, and partially consumed a Bryde's whale in the northern Gulf of California, Mexico (31.degree.01 N, 114.degree.15'W). The attack was observed from 06:54 and 08:53 while circling in a single-engine aircraft at an altitude of 160 m. The group comprised about 15 killer whales, including two adult males and at least two calves. Females and (or) subadult males pressed the attack most intently. The killer whales tore skin and blubber from the right flank of the Bryde's whale, and on 11 occasions the killer whales swam onto the head or back of the Bryde's whale, which hindered its breathing. The respiration intervals of the Bryde's whale were short and irregular, and blow rates differed significantly from those of undisturbed Bryde's whales. Fatiguing the whale may have facilitated an easier kill by asphyxiation. After the death of the Bryde's whale, the two adult male killer whales surfaced slowly about 200-300 m away from the remainder of the group, which presumably fed on the submerged Bryde's whale carcass. Two days later, the drifting Bryde's whale carcass was located. A large wound was visible on the abdomen, and sections of the lower jaw had been removed. Like those of canids and some fields that hunt cooperatively when preying on ungulates, attacks by Orcinus orca exhibit coordination of activities and efficiency in dispatching prey.},
  journal = {Canadian Journal of Zoology},
  keywords = {*Behavioral Biology/Animal Behavior [07003],*Ecology,*Nutrition/General Dietary Studies [13214],*Pathology,*Respiratory System/Pathology [16006],9000,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Balaenopteridae [85810],Chordate Body Regions/Abdomen (1970- ) [11314],Delphinidae [85815],Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],General and Miscellaneous/Necrosis (19,Respiration Interval Asphyxiation Coordination of},
  number = {7}
}

@article{Silber1994,
  title = {Cetaceans of the Northern {{Gulf}} of {{California}}: Distribution, Occurrence, and Relative Abundance},
  author = {Silber, Gregory K and Newcomer, Michael W and Silber, Patricia C and {P{\'e}rez-Cort{\'e}s M}, H{\'e}ctor and Ellis, Graeme M},
  year = {1994},
  volume = {10},
  pages = {283--298},
  abstract = {A total of 1,715 km of boat-based surveys and 1,521 km of aircraft-based surveys was conducted from 1986-1985, to assess the distribution, relative abundance, and ecological relationships of cetaceans in the northern Gulf of California. Seven cetacean species were seen; in decreasing frequency of groups encountered they were: bottlenose dolphins, Tursiops truncatus; vaquitas, Phocoena sinus; common dolphins, Delphinus delphis; fin whales, Balaenoptera physalus, Bryde's whales, B. edeni; gray whales, Eschrichtius robustus, and killer whales, Orcinus orca. Common dolphins were numerically dominant and bottlenose dolphins were seen most often. Bryde's whales and vaquitas had the smallest group sizes. In general, the odontocete cetaceans were separated spatially, whereas the distribution of Bryde's and fin whales overlapped considerably.},
