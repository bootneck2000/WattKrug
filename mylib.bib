  volume = {21},
  pages = {437--441},
  abstract = {We anesthetized 14 Weddell seals by using a combination of ketamine hydrochloride (HCl), xylazine HCl, and diazepam. Narcoses were terminated with yohimbine HCl. The mean total dosage/kg body mass was ketamine 3.11 mg (SE = 0.19), xylazine 0.94 mg (SE = 0.04), diazepam 0.04 mg (SE = 0.01), and yohimbine 0.5 mg (SE = 0.02). This drug combination enabled us to shorten the recovery time considerably and did not cause undesirable side effects, especially during recovery.},
