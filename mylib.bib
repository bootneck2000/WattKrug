@article{Sweeting2007,
  title = {Effects of Body Size and Environment on Diet-Tissue Delta {{C}}-13 Fractionation in Fishes},
  author = {Sweeting, C J and Barry, J T and Polunin, N V C and Jennings, S},
  year = {2007},
  volume = {352},
  pages = {165--176},
  doi = {10.1016/j.jembe.2007.07.007},
  abstract = {delta C-13 data are often used in trophodynamic research where diet-tissue fractionation (Delta delta C-13) is assumed to be 0-1\%. per trophic level and unaffected by the size of animals or their environment. Variation in Delta delta C-13 Will influence conclusions about food sources, energy pathways and trophic level. To assess the effects of body size, age and environmental conditions on Delta delta C-13, European sea bass (Dicentrarchus labrax) were reared on constant diets of dab (Limanda limanda) or (Ammodytes marinus) for 2years under natural environmental regimes. Bags were sampled approximately monthly to determine Delta delta C-13 for muscle, heart and liver tissue and were 1.66 parts per thousand, -0.18 parts per thousand, -1.77 parts per thousand (sandeel diet) and 1.34 parts per thousand, -1.18 parts per thousand, -1.75 parts per thousand (dab diet) respectively. Arithmetic lipid correction increased Delta delta C-13 to \textquestiondown{} 2\%o for muscle and liver. Delta delta C-13 was dependent on body mass and experimental duration (age) and generally declined with weight or time even after correction for lipid content. For liver, increasing temperature increased Delta delta C-13. The Delta delta C-13 estimates from this study were compared with all available published A613 C estimates for fish. Bass muscle A Delta delta C-13 was similar to previous estimates for fish white muscle Delta delta C-13 (1.56 +/- 1.10\%o) and whole body Delta delta C-13 (1.52 +/- 1.13\%o). Fractionations derived in this study, combined with those from the literature, support the use of diet-tissue fractionation values of between 1 parts per thousand-2 parts per thousand for delta C-13, rather than the commonly used 0 parts per thousand - 1 parts per thousand. For muscle Delta delta C-13, 1.5 parts per thousand is appropriate. (c) 2007 Elsevier B.V. All rights reserved.},
  isbn = {0022-0981},
  journal = {Journal of Experimental Marine Biology and Ecology},
  keywords = {AQUATIC FOOD-WEB,ATLANTIC SALMON,CARBON ISOTOPES,depleted,enriched,FEEDING ECOLOGY,isotope,LITTORAL FISHES,marine,nitrogen,NITROGEN ISOTOPES,OREOCHROMIS-NILOTICUS,SPATIAL,STABLE-ISOTOPE RATIOS,TROPHIC SHIFT,VARIATION},
  language = {English},
  number = {1}
}

@article{Sweller2004,
  title = {Instructional Design Consequences of an Analogy between Evolution by Natural Selection and Human Cognitive Architecture},
  author = {Sweller, J},
  year = {2004},
  volume = {32},
  pages = {9--31},
  abstract = {Evolution by natural selection may be characterized as a system in which a large store of genetic information will persist indefinitely while it remains coordinated with its environment but will continuously produce small random variations that are tested for environmental effectiveness. In any environment, effective variations will persist while ineffective variations will disappear. Similarly, human cognitive architecture includes a large store of information held in long-term memory that coordinates our cognitive activities. A very limited working memory, tests the effectiveness of small variations to long-term memory with effective variations altering long-term memory while ineffective variations are lost. Both an existing genetic code and information in long-term memory provide a central executive that guides behaviour. Such a central executive is unavailable when an environment alters or when working memory must be used to deal with novel information. A major function of instructional design is to provide the otherwise missing structure of a central executive when dealing with novel information and to reduce that structural support as knowledge accumulates in long-term memory. Cognitive load theory both provides instructional design principles that would be difficult to devise without its particular view of human cognitive architecture and throws further light on that architecture.},
  isbn = {0020-4277},
  journal = {Instructional Science},
  keywords = {APPROACH,GOAL SPECIFICITY,HIGH-SCHOOL,LOAD,MULTIMEDIA INSTRUCTION,PROGRAMMING INSTRUCTION,SPLIT-ATTENTION,STUDENTS LEARN,WORD-PROBLEMS,WORKED EXAMPLES,WORKING-MEMORY},
  language = {English},
  number = {1-2}
}

@article{Swift2001,
  title = {Growth Rate and Development in Infant {{Natterer}}'s Bats ({{Myotis}} Nattereri) Reared in a Flight Room},
  author = {Swift, S M},
  year = {2001},
  volume = {3},
  pages = {217--223},
  abstract = {Myotis nattereri born and reared by their mothers in a flight room had a mean birth body mass of 3.4 ga and forearm length of 17.00 nun. Infants opened their eyes at 6 days old, and they were no longer always found roosting attached to their mothers after this age. They were fully furred at 7-8 days and began to flap their wings at 15 days. Growth was initially rapid and linear until 20 days of age and then slowed. At 58-60 days, mean body mass was 8.8 a (89\% of adult mass) and mean forearm length was 40.55 nun (98\% of adult length). Juveniles began to fly at 20 days, at which age their forearm length was 93.4\% of mean adult value. Forearm data were best fitted by the logistic growth model (k = 0.18; asymptotic length = 40.79 mm for males) and body mass data by the von Bertalanffy equation (k = 0.10; asymptotic mass = 8.42 g for males). Pre-flight growth and development rates were similar to those in other British vespertilionid bats, but M. nattereri showed very rapid development of foraging ability after they began to fly. Mothers suckled only their own infants and transported flightless young between roost boxes, on average every 5.3 days. [References: 18]},
  journal = {Acta Chiropterologica},
  keywords = {Animal Sciences in Current Contents(R)/Agricultura,Body mass,Chiroptera.,Development,Foraging behavior,Forearm length,Growth,Maternal care.,Myotis nattereri,Pipistrellus-pipistrellus,Plecotus-auritus,Postnatal-growth,Suckling behavior,Vespertilionidae,Weaning},
