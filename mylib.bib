@article{Martin1987,
  title = {Aspects of the Biology of Pilot Whales Globicephala-Melaena in Recent Mass Strandings on the British Coast},
  author = {Martin, A R and Reynolds, P and Richardson, M G},
  year = {1987},
  volume = {211},
  pages = {11--24},
  abstract = {Five mass strandings of Pilot whales, involving from 23 to 40 animals, occurred on the British coast between 1982 and 1985. The sex ratio in all strandings was biased towards females (62\% overall), but more than one mature male was present in each group. A multi-male, polygynous social system is suggested. Growth is rapid from a mean body length at birth of 1.78 m to about 3 m at 2-3 years. Thereafter, males grow faster than females and attain a greater body length by some 18-25\%. Maximum body lengths in this study were of a 6.3 m male and a 5.5 m female. The greatest ages determined were of a 20-year-old male and a 25-year-old female, but there is a possibility that readable dentine is not deposited in the teeth of older animals and that some whales are thus of a greater age than can be detected. Females become sexually mature at about seven years of age and a body length 3-4 m. Some reach sexial senility before death. Males mature at a greater age and at about 5 m in length. Annual calf production is about 11\% and no seasonality in parturition could be detected. Pollutant levels are generally within the range of those published for odentocetes, but PCB levels are higher than any yet found in other Pilot whale populations. Evidence of squid was found in three digestive tracts. Blubber thickness increases with the size of the animal, reaching 35-65 mm in adults. The existence of an annual, rigid north-south migrational pattern is unlikely.},
  journal = {Journal of Zoology (London)},
  keywords = {Animalia,Animals,Behavioral Biology/Animal Behavior [07003],Bones,Cephalopoda [61100],Cephalopoda: Mollusca,Cetaceans,Chorda,Chordates,Connective and Adipose Tis,Delphinidae: Cetacea,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Animal [07508],Fasciae,Ge,Genetics and Cytogenetics/Sex Differences [03510],Gerontology [24500],Invertebrata,Invertebrates,Joints,Mammalia,Mammals,Mollusks,Movement (1971- ) [12100],Nonhuman Mammals,Nonhuman Vertebrates,Pediatrics [25000],Public Health: Environmental Health/Air,Reproductive System/Physiology and Biochemistry [1,Toxicology/Environmental and Industrial Toxicology,Vertebrata,Vertebrates,Water and},
  number = {1}
}

@article{Martin1988,
  title = {Cetaceans around the {{Central Azores Islands Portugal}} in the {{Summers}} of 1985 and 1986},
  author = {Martin, A R},
  year = {1988},
  volume = {52},
  pages = {541--548},
  abstract = {Six species of cetaceans were observed and photographed during two surverys aboard yachts around islands in the central Azores archipelago. The most common species was the Atlantic spotted dolphin Stenella frontalis, identified on 34 occasions. Physeter macrocephalus, Delphinus delphis and Tursiops truncatus occurred fairly frequently, but Grampus griseus and Globicephala species were uncommon. Orcinus orca and Phoceana phocaena were not observed at all and can no longer be considered common in the region on the basis of this study.},
  journal = {Mammalia},
  number = {4}
}

