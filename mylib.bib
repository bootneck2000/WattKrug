@article{Honkela2008,
  title = {Agglomerative Independent Variable Group Analysis},
  author = {Honkela, A and Seppae, J and Alhoniemi, E},
  year = {2008},
  volume = {71},
  pages = {1311--1320},
  doi = {10.1016/j.neucom.2007.11.024},
  abstract = {Independent variable group analysis (IVGA) is a method for grouping dependent variables together while keeping mutually independent or weakly dependent variables in separate groups. In this paper two variants of an agglomerative method for learning a hierarchy of IVGA groupings are presented. The method resembles hierarchical clustering, but the choice of clusters to merge is based oil variational Bayesian model comparison. This is approximately equivalent to using a distance measure based on a model-based approximation of mutual information between groups of variables. The approach also allows determining optimal cutoff points for the hierarchy. The method is demonstrated to find sensible groupings of variables that can be used for feature selection and ease construction of a predictive model. (c) 2008 Elsevier B.V. All rights reserved.},
  isbn = {0925-2312},
  journal = {Neurocomputing},
  keywords = {hierarchical clustering,independent variable group analysis,information,mutual,MUTUAL INFORMATION,NONPARAMETRIC PROBLEMS,variable grouping,variational Bayesian learning},
  language = {English},
  number = {7-9}
}

@article{Honma1990,
  title = {Revised Records of Large Marine Animals Stranded on the Coast of Niigata and Sado Island in the Sea of Japan},
  author = {Honma, Y},
  year = {1990},
  volume = {Publicatio},
  pages = {1--40},
  abstract = {In order to clarify some aspects of animals, and their strandings on the beaches of the Niigata region, recent records of whales, pinnipeds, turtles, snakes, lampridiform fishes, basking sharks, and giant squids, in addition to previous reports by us (Honma and Kitami, 1976, 1981; Honma et al., 1983; Honma and Mizusawa, 1984) were collected and analysed. For marine mammals and turtles, records described in historical documents, such as a diary of the Sado Bugyosho (Regional Administration) under the direct control of the Edo Bakufu (the Shogunate) for gold mining, were also examined and compared with recent records. This paper comprises 5 categories: (1) marine mammals-subdivided into whales (more than 4 m in total length) (8 species), dolphins and porpoises (less than 4 m in total length) (5 species), and pinnipeds (5 species); (2) marine reptiles-subdivided into turtles (5 species) and snakes (3 species); (3) lampridiform fishes (4 species); (4) basking sharks and whale sharks; and (5) giant squids (2 species). In short, this study revealed a fairly distinct monthly or seasonal difference in strandings amongst the animal species investigated. It is clear that the yellow-bellied sea snake and frilled squid tend to become stranded in early winter (November), whereas the 5 species of turtles and Dall's porpoise are exclusively found in January and February, respectively. After that, giant squids (A. japonicus) may be found stranded over February and March, and both deal fish and basking sharks during March and April. On the contrary, baleen whales and beaked whales may be seen every month, with the exception of August. These phenomena may be largely dependent upon differences in ecology, and life history characteristhcs of these animals.},
  journal = {Sado Marine Biological Station Niigata University Special},
  keywords = {*Anatomy and Histology,*Chordata,*Ecology,9200,Anatomy and Histology,Animals. Invertebrates. Mollusks. Chordates. Verte,Cephalopoda [61100],Cetacea-Unspecified [85800],Chelonia [85402],Chondrichthyes [85202],Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Fish Turtle Reptile Snake Whale Shark Pinniped Squ,General and Comparative/Gro,General and Comparative/Mi,General and Systematic Zoology/General,Pinnipedia-Unspecified [86170],Pisces-Unspecified [85200],Reptilia-Unspecified [85400],Serpentes [85410]},
  number = {5}
}

@article{Honma1995,
  title = {Further Notes on Ovarian Histology of the {{Stejneger}}'s Beaked Whale, {{Mesoplodon}} Stejnegeri, from a Recent Stranding on the Coast of {{Niigata District}}, {{Sea}} of {{Japan}}},
  author = {Honma, Yoshiharu and Yamada, Tadasu K},
  year = {1995},
  volume = {21},
  pages = {109--118},
  abstract = {A pair of ovaries of a Stejneger's beaked whale, Mesoplodon stejnegeri, were studied histologically. The animal was 4.8 m in total length, stranded on the coast of Noh Town, Niigata Prefecture, facing the Sea of Japan, in late February 1993. The ovaries were 42 and 37 mm in length and 6.7 and 3.3 g in weight, respectively. After removal from the decomposing body, the ovaries were initially preserved in 10\% formalin solution. Subsequently, after 15 months, they were postfixed in Bouin's solution. Light microscopy revealed several tens of primary follicles in the connective tissue stroma of the cortical region, in contrast to the conditions in previously described specimens. Well-developed corpora albicantia were present throughout, whereas neither a well-defined corpus luteum nor characteristically coiled and thick-walled arteries were detected in any of the blocks examined.},
  journal = {Bulletin of the National Science Museum Series A (Zoology)},
  number = {2}
}

