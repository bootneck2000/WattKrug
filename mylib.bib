@article{Yamamoto1987,
  title = {Tissue Distribution of Heavy Metals in {{Weddell}} Seals ({{Leptonychotes}} Weddellii).},
  author = {Yamamoto, Y and Honda, K and Hidaka, H and Tatsukawa, R},
  year = {1987},
  volume = {18},
  pages = {164--169},
  abstract = {Tissue distributions of heavy metals were investigated in the Weddell seal collected around Syowa Station, Antarctica. Generally, the metal concentrations were high in liver and kidney and low in brain, blubber and skin. Fe in blood and spleen, Zn in bone, and Mn and Cd in pancreas and gastrointestinal organs were also relatively high. Wide variations of the metal concentrations in different bones were also observed. The concentrations of Fe and Cd were positively correlated with moisture content of the bones, while those of Mn and Zn increased with increase of Ca content in the bone. Majority of the metal burden in the body existed in muscle and liver. A relatively high burden of Cd was in the kidney. Based upon these results, the suitability of the tissues of a seal for ecological and toxicological comparisons is discussed.},
  journal = {Marine Pollution Bulletin},
  keywords = {*Blood,*Bones,*Digestive System/Pathology [14006],*Ecology,*Integumentary System/Pathology [18506],*Metabolism/Minerals [13010],*Nervous System/Pathology [20506],*Public Health: Environmental Health/Air,*Toxicology/Environmental and Industrial Toxicolog,*Urinary System and External Secretions/Pathology,4632,8700,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Biochemical Studies/Minerals [10069],Blood-Forming Organs and Body Fluids/Blood,Connective and Adipose Ti,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Fasciae,Joints,Leptonychotes weddellii,Phocidae [86185],pollution,Pollution Liver Kidney Blood Brain Spleen Blubber,Water an},
  mendeley-tags = {4632},
