@article{Ishikawa2003,
  title = {Stranding and Incidental Catch Records in the {{Sea}} of {{Japan}} Coast of {{Japan}}},
  author = {Ishikawa, Hajime},
  year = {2003},
  volume = {3},
  pages = {87--91},
  abstract = {Seasonal change of stranding and incidental catch records in the Sea of Japan coast of Japan were analyzed by using of ICR stranding database. In the Sea of Japan coast of Japan, records of Pacific white-sided dolphin, Stejneger's beaked whale, common minke whale, finless porpoise and Dall's porpoise were dominant. Stranding records increased from January to June whereas decreased from July to December. Incidental catch records also showed similar pattern. Live stranding rate were high in summer season whereas extremely low in winter. These characters in the Sea of Japan coast of Japan can be explained mainly by the seasonal migration and low survival rate of the dominant species.},
  journal = {Honyurui Kagaku},
