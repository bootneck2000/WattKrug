@article{Miyazaki1980,
  title = {Catch Records of Cetaceans off the Coast of the Kii Peninsula Japan},
  author = {Miyazaki, N},
  year = {1980},
  volume = {Museum},
  pages = {69--82},
  abstract = {Catch records of 14 spp. Balaenoptera acutorostrata, Physeter macrocephalus, Ziphius cavirostris, Stenella attenuata, S. coeruleoalba, Lagenorhynchus obliquidens, Tursiops gilli, Steno bredanensis, Phocoena phocoena, Globicephala macrorhynchus, Pseudorca crassidens, Peponocephala electra, Orcinus orca and Grampus griseus from 7 families are represented from the daily fishing record of the fisherman's cooperative union at Taiji. A Bryde's whale (Balaenoptera edeni) and a pygmy sperm whale (Kogia sp.) were taken in Feb., 1976 and on Oct. 4, 1974, respectively. Several studies have reported pygmy killer whale (Feresa attenuata) and finless porpoise (Neophocaena phocaenoides) off the coast of the Kii Peninsula. Only Phocoena phocoena was mainly distributed in the colder waters, and possibly came from the northern area of the Pacific. The occurrence of common porpoise at Taiji seems to be similar to the case of the Greenland right whale (Balaena mysticetus), which strayed from the north and was captured alive at Osaka Bay on June 23, 1969 (Nishiwake et Kasuya, 1970). Most of the species caught off the coast of the Kii Peninsula are sporadically captured in all seasons but show seasonal fluctuations in the catch. The seasonal fluctuation of the percentage catch of 6 spp., S. coeruleoalba, G. machrorhynchus, T. gilli, G. griseus, Z. cavirostris and O. orca, is discussed. These species have biomodal fluctuation in seasonal catch, with peaks in spring-summer and in autumn-winter. There was no remarkable difference in the 2nd peak, which is composed of the southbound animals. It is well known that delphinid species, being distributed in the warmer waters, are concentrated in the northern boundary of the Kuroshio and that migrations seem affected by movement of the Kuroshio in a year extending up to around 46.degree.N in the summer and retreating around 33.degree.N in winter (Miyazaki et al., 1974, Kasuya, 1975). The 6 spp. might almost simultaneously retreat in autumn-winter from the northern area corresponding to the movement of the Kuroshio, while the 1st peak might occur in different months. T. gilli, G. machrorhynchus and S. coeruleoalba seem to migrate from the north to offshore at Taiji in May. This is earlier by 2 mo. than the arrival of Z. cavirostris in July, and is later by 2 mo. than the arrival of G. griseus in March and by 3 mo. than that of O. orca in Feb. Z. cavirostris is probably distributed in slightly warmer waters than T. gilli, G. machrorhynchus and S. coeruleoalba, and G. griseus and O. orca may be distributed in slightly colder waters than these 3 spp. O. orca seems to be distributed in slightly colder waters than G. griseus. Whaling efforts for these species were not taken into consideration.},
  journal = {Memoirs of the National Science},
  keywords = {*Animal Distribution (1971- ) [62800],*Chordata,*Ecology,8100,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Balaenidae [85805],Balaenoptera-Edeni Balaenoptera-Acutorostrata Kogi,Balaenopteridae [85810],Cetacea-Unspecified [85800],Delphinidae [85815],Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,Monodontidae [85825],Movement (1971- ) [12100],Physeteridae [85830],Ziphiidae [85840]},
  number = {Tokyo) (13}
}

@article{Miyazaki1987,
  title = {A Stranding of Mesoplodon-Stejnegeri in the Maizuru Bay Sea of Japan},
  author = {Miyazaki, N and Nakamura, I and Tanabe, S and Tatsukawa, R},
  year = {1987},
  pages = {91--106},
  abstract = {On 13 June 1984 a Stejneger's beaked whale, Mesoplodon stejnegeri, was found to have stranded on the beach of Maizuru Bay (35.degree.31'N,135.degree.24'E), the Sea of Japan. This whale was probably one of two unidentified whales occasionally sighted in the bay since eight months before the stranding. The animal was a juvenile male having testes of 34 g and measuring 396.5 cm in body length. It had 44 vertebrae, composed of 7 cervical (first three cervical bones were fused into one unit), 9 dorsal, 11 lumbar and 17 caudal vertebrae. Only vertebral epiphyses of the 3rd-7th cervicals and the 16-17th caudals were fused with the centrum. The external, cranial and vertebral measurements, and organ weights were presented. The PCBs and p,p'-DDE levels in blubber were 7.0 and 44 .mu.g/g on wet weight basis, respectively. The distribution of the five species of Mesoplodon [M. stejneri, M. carlhubbsi, M. ginkgodens, M. densirostris, and M. hectori] known from the North Pacific Ocean was discussed.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo.(38)}
}

@article{Miyazaki1992,
  title = {Osteological Study of a Hybrid between {{Tursiops}} Truncatus and {{Grampus}} Griseus},
  author = {Miyazaki, Nobuyuki and Hirosaki, Yoshitsugu and Kinuta, Toshikazu and Omura, Hideo},
  year = {1992},
  volume = {18},
  pages = {79--94},
  abstract = {A hybrid between a female Tursiops truncatus and a male Grampus griseus was born on 29 September 1978 and died on 1 May 1985 in Enoshima Aquarium, Japan. The living period was 2,407 days, which is the longest record among hybrids ever recorded in the world. The specimen was a female of 277 cm in body length and was sexually immature. The present hybrid specimen showed intermediate values in cranial characters between T. truncatus and G. griseus. Relationship of the hybrid specimen to Fraser's three anomalous specimens, T. truncatus and G. griseus was discussed using the principal component analysis of 16 cranial characters.},
  journal = {Bulletin of the National Science Museum Series A (Zoology)},
  number = {2}
}

