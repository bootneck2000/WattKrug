@article{Kock2003,
  title = {Shedding New Light on the Life Cycle of Mackerel Icefish in the {{Southern Ocean}}},
  author = {Kock, K H and Everson, I},
  year = {2003},
  volume = {63},
  pages = {1--21},
  doi = {10.1046/j.1095-8649.2003.00150.x},
  abstract = {Mackerel icefish have a widespread distribution in the Atlantic mid Indian Ocean sectors of the low-Antarctic region. Biological characteristics differ considerably between populations in the southern Scotia Arc and those living further to the north. Fish living in the north mature 1 year earlier than in the south. They have a much shorter life span and die after they have spawned two to three limes. The number of eggs produced per gram of body mass is higher in the north. Stocks have declined ill most parts of the distribution range due to the impact of fishing and due to natural causes. Increases in populations of Antarctic fur seals at South Georgia and parts of the Indian Ocean appear to have led to increased predation of stocks of icefish. Shifts in hydrological regimes in the northern part of the distributional range either started to lead or will lead to deteriorating living conditions for mackerel icefish in the near future. Fish stock assessment needs to take these constraints into consideration when providing advice on total allowable catches for fisheries management. (C) The Fisheries Society of the British Isles.},
