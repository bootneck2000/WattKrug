@article{Hwang2007,
  title = {Do Delta {{N}}-15 and Delta {{C}}-13 Values of Feces Reflect the Isotopic Composition of Diets in Small Mammals?},
  author = {Hwang, Y T and Millar, J S and Longstaffe, F J},
  year = {2007},
  volume = {85},
  pages = {388--396},
  doi = {10.1139/z07-019},
  abstract = {The stable isotope composition of carbon and nitrogen in feces can be a useful tool for reconstructing diet. To examine whether the isotopic composition of feces reflect those of diet, we determined the fractionation of N-15 and C-13 along the digestive tracts of several species of small mammals. There were significant differences in the delta N-15 values of digesta in different compartments of the gastrointestinal (GI) tract, with consistent enrichment of N-15 in the stomach, intestine, and cecum, and the depletion of N-15 in the colon (i.e., feces). Although feces had lower delta N-15 values than digesta in the cecum, feces of small mammals were significantly more enriched in N-15 (by similar to 2.5 parts per thousand.) than diet. The mechanisms causing this enrichment in the GI tract may arise from the operation of different biochemical pathways within the different GI compartments. The stable carbon isotope composition of digesta in small mammals were similar along the GI tract, but the delta C-13 values of digesta and feces were significantly lower than reported previously for large ungulates (-3.5 parts per thousand vs. -0.5 parts per thousand). The delta N-15 and delta C-13 values of feces did not directly reflect the isotopic compositions of these mammals' diet. Our data offer evidence for variations in isotopic discrimination effects. This variation can probably be ascribed to metabolism of different body sizes of mammals and the complexities linked with digestive physiology of herbivores.},
  isbn = {0008-4301},
  journal = {Canadian Journal of Zoology-Revue Canadienne De Zoologie},
  keywords = {AFRICAN,AMINO-ACIDS,ANIMALS,BOVIDAE,BREATH CO2,ECOLOGY,FRACTIONATION,N-15,NATURAL-ABUNDANCE,NITROGEN ISOTOPES,STABLE CARBON ISOTOPES},
  language = {English},
  number = {3}
}

@article{Hwang2008,
  title = {A Comprehensive Analysis of Three {{Asiatic}} Black Bear Mitochondrial Genomes (Subspecies Ussuricus, Formosanus and Mupinensis), with Emphasis on the Complete {{mtDNA}} Sequence of {{Ursus}} Thibetanus Ussuricus ({{Ursidae}})},
  author = {Hwang, D S and Ki, J S and Jeong, D H and Kim, B H and Lee, B K and Han, S H and Lee, J S},
  year = {2008},
  volume = {19},
  pages = {418--429},
  doi = {10.1080/19401730802389525},
  abstract = {In the present paper, we describe the mitochondrial genome sequence of the Asiatic black bear (Ursus thibetanus ussuricus) with particular emphasis on the control region (CR), and compared with mitochondrial genomes on molecular relationships among the bears. The mitochondrial genome sequence of U. thibetanus ussuricus was 16,700 bp in size with mostly conserved structures (e. g. 13 protein-coding, two rRNA genes, 22 tRNA genes). The CR consisted of several typical conserved domains such as F, E, D, and C boxes, and a conserved sequence block. Nucleotide sequences and the repeated motifs in the CR were different among the bear species, and their copy numbers were also variable according to populations, even within F1 generations of U. thibetanus ussuricus. Comparative analyses showed that the CR D1 region was highly informative for the discrimination of the bear family. These findings suggest that nucleotide sequences of both repeated motifs and CR D1 in the bear family are good markers for species discriminations.},
  isbn = {1940-1736},
  journal = {Mitochondrial DNA},
  keywords = {Asiatic black bear,COMPLETE NUCLEOTIDE-SEQUENCE,control,DNA,GENES,INFERENCE,minisatellite,mitochondrial genome,MODEL,NUCLEAR,ORGANIZATION,PHYLOGENY,region,REGIONS,TANDEM REPEATS,Ursus thibetanus},
  language = {English},
  number = {4}
}

