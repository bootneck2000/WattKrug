@article{Hill1987a,
  title = {Heart Rate and Body Temperature during Free Diving of {{Weddell}} Seals.},
  author = {Hill, R D and Schneider, R C and Liggins, G C and Schuette, A H and Elliott, R L and Guppy, M and Hochachka, P W and Quist, J and Falke, K J and Zapol, W M and Elliot, R L and Guppy, M and Hochachka, P W and Qvist, J and Falke, K J and Zapol, W M and Elliott, R L and Guppy, M and Hochachka, P W and Qvist, J and Falke, K J and Zapol, W M},
  year = {1987},
  volume = {253},
  pages = {R344--R351},
  abstract = {We have developed and successfully used the first microprocessor-controlled monitors for collection of data on depth, heart rate, and body temperature of one fetal and five adult male freely swimming Weddell seals. Adult seals almost invariably experienced a prompt bradycardia at the start of each dive, and the mean heart rate during diving was significantly lower for dives \textquestiondown{} 20 min (P \textquestiondown{} 0.999). The heart rate was also significantly greater during the ascent portion of dives when compared with a descent portion (P \textquestiondown{} 0.95). The fetal seal experienced a slow onset of bradycardia when its mother dived; during diving the fetal heart rate decreased by an average of 1.1 beats/min for each minute of the dive. The fetal heart rate generally took .apprx. 10 min to recover to predive levels after its mother resurfaced to breathe. The body temperature of one adult male Weddell seal showed a decrease of \textquestiondown{} 1.5.degree. C from resting levels before dives of \textquestiondown{} 15 min were initiated and a drop of over 2.degree. C before dives of \textquestiondown{} 30 min duration.},
  journal = {American Journal of Physiology},
  keywords = {*Aerospace and Underwater Biological Effects/Physi,*Cardiovascular System/Heart Pathology [14506],*Cardiovascular System/Physiology and Biochemistry,*Developmental Biology/Embryology-Descriptive Tera,*Physiology,*Reproductive System/Physiology and Biochemistry [,*Temperature: Its Measurement,569,8700,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Bradycardia Fetal Heart Rate Diving Reflex,Cardiovascular System/General,diving,Effects and Regulat,Effects and Regulati,External Effects/Pressure [10606],External Effects/Temperature as a Primary Variable,fetus,General and Miscellaneous/General [12,General and Miscellaneous/Instrumentat,heart rate,Leptonychotes weddellii,Methods [14501],Phocidae [86185],physiology,Physiology,seals,Temperature: Its Measurement,thermoregulation,Weddell},
