@article{Heywood2004,
  title = {On the Fate of the {{Antarctic Slope Front}} and the Origin of the {{Weddell Front}}},
  author = {Heywood, Karen J. and Naveira Garabato, Alberto C. and Stevens, David P. and Muench, Robin D.},
  year = {2004},
  volume = {109},
  issn = {01480227},
  doi = {10.1029/2003JC002053},
  abstract = {Data from the Deep Ocean Ventilation Through Antarctic Intermediate Layers (DOVETAIL) and Antarctic Large-Scale Box Analysis and the Role of the Scotia Sea (ALBATROSS) projects are combined in the region of the Antarctic Peninsula and the South Scotia Ridge to determine the paths and transports associated with the Antarctic Coastal Current, the Antarctic Slope Front, and the Weddell Front. The Antarctic Coastalflows over the Antarctic continental shelf and is not tied to a particular isobath. It transports {$\sim$}1 Sv westward to the Bransfield Strait. Its subsequent course is uncertain, but we speculate that it may continue southwest along the western side of the Antarctic Peninsula, close to the coast. The Antarctic Slope Front, present almost all the way aroundtied to the continental slope, has not previously been mapped after it reaches the tip of the Antarctic Peninsula. We show that the frontal jet splits into two branches in the northwest Powell Basin where the isobaths diverge. The shoreward portion of the water associated with the front (lying above isobaths shallower than 1500 m) is able to cross the South Scotia Ridge and head northwestward and retains many of the properties of the Antarctic Slope Front. It is associated with a transport of {$\sim$}7 Sv. The portion of the front constrained to lie above isobaths deeper than 1500 m becomes the Weddell Front. This takes a path around the northern Powell Basin and south of the South Orkney Islands. Of the {$\sim$}13 Sv that circulates around the southern flank of the South Orkney Plateau, {$\sim$}8 Sv of Weddell Sea Deep Water and Warm Deep Water leaves the front to continue west. The remaining shallow and intermediate water retroflects and returns south associated with the Weddell Front through the Orkney Passage. Approximately 5\textendash 7 Sv is transported eastward associated with the Weddell Front, tied closely to the southern flanks of the Bruce andBanks above the 2000\textendash 2500 m isobaths, and forming the southern boundary of the Weddell Scotia Confluence.},
  isbn = {0148-0227},
  journal = {Journal of Geophysical Research C: Oceans},
  keywords = {Topographic interaction,Water masses,Weddell Scotia Confluence},
  number = {6}
}

@incollection{Heywood2013,
  title = {Transport and Water Masses of the Antarctic Slope Front System in the Eastern Weddell Sea},
  author = {Heywood, Karen J. and Locarnini, Ricardo A. and Frew, Russell D. and Dennis, Paul F. and King, Brian A.},
  year = {2013},
  volume = {75},
  pages = {203--214},
  doi = {10.1029/ar075p0203},
  abstract = {We present observations of the Antarctic Slope Front and the water masses of the continental shelf and slope in the eastern Weddell Sea near 17 \textdegree{} W , obtained during early autumn ( late March of 1995 ). A variant of Antarctic Surface Water , freshened and cooled through the addition of glacial ice melt , fills the continental shelf , and extends to depths of about 700 m over the upper continental slope . A tongue of this water extends about 50 km offshore over the continental slope at a depth of 100 to 200 m . A set of high accuracy and high horizontal resolution measurements of the relative abundances of the stable isotopes of oxygen confirms previous observations of the importance of glacial ice melt in imprinting its isotopic signal on the Antarctic Surface Water near the Antarctic margin . Monitoring of this isotopic signal could provide an indicator of changes in the melt rate of the Antarctic ice cap caused by ciimate variability . A detailed hydrographic section across the Antarctic Slope Front yields a baroclinic contribution to this southwestward flow of 4 Sv ( 1 Sv = 10 m s " ) relative to the sea bed . Using the shipborne Acoustic Doppler Current Profiler as a reference for the geostrophic shear enables the calculation of the much larger barotropic component across this transect ( 10 Sv ). Total transport from sea surface to sea floor , which reaches 4000 m near the base of the continental slope , is 14 ( {$\pm$} 3 ) Sv to the southwest . In the eastern Weddell Sea , the current associated with the Antarctic Slope Front is split into two cores , centered above the continental slope in water depths of 1000 m and 3000 m respectively . Surface currents in the southern core are of order 50 cm s " . In addition , a shallow , fast current just inshore of the southern core may indicate merging with the Antarctic Coastal Current often observed on the continental shelf near the front of ice shelves . A northeastward undercurrent at 800 m depth on the flank of the continental slope has a transport of approximately 0 . 1 Sv .}
}

