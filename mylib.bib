@article{Timmermann2017,
  title = {Response to {{Filchner}}-{{Ronne Ice Shelf}} Cavity Warming in a Coupled Ocean-Ice Sheet Model - {{Part}} 1: {{The}} Ocean Perspective},
  author = {Timmermann, Ralph and Goeller, Sebastian},
  year = {2017},
  volume = {13},
  pages = {765--776},
  publisher = {{Copernicus Publications}},
  issn = {18120792},
  doi = {10.5194/os-13-765-2017},
  abstract = {The Regional Antarctic ice and Global Ocean (RAnGO) model has been developed to study the interaction between the world ocean and the Antarctic ice sheet. The coupled model is based on a global implementation of the Finite Element Sea-ice Ocean Model (FESOM) with a mesh refinement in the Southern Ocean, particularly in its marginal seas and in the sub-ice-shelf cavities. The cryosphere is represented by a regional setup of the ice flow model RIMBAY comprising the Filchner-Ronne Ice Shelf and the grounded ice in its catchment area up to the ice divides. At the base of the RIMBAY ice shelf, melt rates from FESOM's ice-shelf component are supplied. RIMBAY returns ice thickness and the position of the grounding line. The ocean model uses a pre-computed mesh to allow for an easy adjustment of the model domain to a varying cavity geometry. RAnGO simulations with a 20th-century climate forcing yield realistic basal melt rates and a quasi-stable grounding line position close to the presently observed state. In a centennial-scale warm-water-inflow scenario, the model suggests a substantial thinning of the ice shelf and a local retreat of the grounding line. The potentially negative feedback from ice-shelf thinning through a rising in situ freezing temperature is more than outweighed by the increasing water column thickness in the deepest parts of the cavity. Compared to a control simulation with fixed ice-shelf geometry, the coupled model thus yields a slightly stronger increase in ice-shelf basal melt rates.},
  isbn = {1812-0792},
  journal = {Ocean Science},
  number = {5}
}

@article{Timonin1995,
  title = {Diel Dynamics of the Plankton Distribution in the Northern Benguela Upwelling System},
  author = {Timonin, A G},
  year = {1995},
  volume = {35},
  pages = {556--561},
  abstract = {The plankton abundance was analyzed on the basis of net plankton samples collected vertically by layers during 24 h cycle at a station in the northern part of the Benguela upwelling zone. The vertical distributions of plankton (seston) and zooplankton biomass were characterized by the existence of surface and deep-lying layers of high concentrations and by distinct diurnal periodicity. The zooplankton biomass in surface layers showed the increase during the dark hours, exceeding the day time biomass as much as 2 - 2.5 times. Diurnal pattern of plankton distribution in deep layers was practicaly in the opposite phase to surface waters. Obtained results are discussed in relation to diurnal pattern of zooplankton distribution in different areas. [References: 23]},
  journal = {Okeanologiya},
  number = {4}
}

@article{Timonin1997,
  title = {Daily Vertical Migrations of Calanoides Carinatus and Metridia Lucens (Copepoda, Calanoida) in the Northern Benguela Upwelling Area},
  author = {Timonin, A G},
  year = {1997},
  volume = {37},
  pages = {868--873},
  abstract = {The daily dynamics of the two most important dominant zooplankton species Calanoides carinatus and Metridia lucens were investigated from the surface to the bottom (0-450 m) in the northern part of the Benguela upwelling area. For both species distinct age-and sex-specific differences in patterns of migrations were discovered. Various zonation and maintenance of copepods populations as a result of interaction of migratory behavior of different stages of the both species with alongshore currents regimes and cross-shelf processes are discussed. [References: 21]},
  journal = {Okeanologiya},
  number = {6}
}

@article{Timonin1997a,
  title = {Diel Vertical Migration of Zooplankton in the Upwelling Area of the West Coast of South Africa},
  author = {Timonin, A G},
  year = {1997},
  volume = {37},
  pages = {90--96},
  abstract = {On the basis of the net plankton samples collected vertically by layers during 24 h cycle on a fixed station in the northern part of the Benguela upwelling system, the diel dynamics of the vertical distribution and abundance of different species and groups of zooplankton were studied. Practically non-migratory species (epipelagic small copepods Paracalanus, Clausocalanus, Oithona and Oncaea, also Centropages brachiatus and a chaetognath Eukrohnia hamata), weakly migrating in surface layers (Nannocalanus minor, Sagitta spp.) and extensively migrating between the surface and deep waters (rather large copepods Pleuromamma gracilis, P. borealis, Metridia lucens, Calanoides carinatus) were revealed. The diel dynamics of total zooplankton is discussed as a result of migratory behavior of these groups. [References: 18]},
  journal = {Okeanologiya},
  number = {1}
}

