@article{Pilleri1982,
  title = {The Cephalization of Cephalorhynchus-Commersoni},
  author = {Pilleri, G and Gihr, M},
  year = {1982},
  pages = {79--85},
  abstract = {With a mean body weight of 35 kg, C. commersoni has a mean brain weight of 913 g. This very high relative brain weight exceeds that of Phocoena phocoena, Delphinus delphis/Stenella coeruleoalba and other species, and is comparable with that of Tursiops truncatus, Lagenorhynchus obliquidens and Grampus griseus. The smaller marine odontocetes (including Inia) which have so far been considered as a single group may be divided into 2 separate groups. With the help of regression lines and variance analysis it was possible to show that there is a genuine difference in the levels of cephalization of the 2 groups. It is possible to distinguish 4 degrees of cephalization among the Cetacea. The lowest degree is shared by the Platanistoidea (excluding India) and a number of Mysticeti (Eubalaena australis, Balaenoptera musculus). The 3rd highest level has been reached by other Mysticeti (Eschrichtius glaucus, Megaptera novaeangliae, B. physalus) and among the Odontoceti Physeter macrocephalus. The species Phocoena phocoena, Delphinus delphis/Stenella coeruleoalba, Phocoenoides truei and P. dalli, together with I. boliviensis, present the 2nd highest degree of cephalization. The highest level of cephalization among the Cetacea has been achieved by the species Lagenorhynchus obliquidens, Tursiops truncatus, Grampus griseus and Orcinus orca. C. commersoni belongs to this group.},
  journal = {Investigations on Cetacea}
}

