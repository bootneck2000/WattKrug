@misc{Addison1984a,
  title = {{{DDT}} Has Declined More than {{PCBs}} in Eastern {{Canadian}} Seals during the 1970s},
  author = {Addison, R F and Brodie, P F and Zinck, M E and Sergeant, D E},
  year = {1984},
  volume = {18},
  pages = {935--937},
  issn = {0013-936X},
  doi = {10.1021/es00130a008},
  abstract = {Concentrations of DDT-group insecticide residues in the blubber of gray seals (Halichoerus grypus) shot on Sable Is., Nova Scotia, in 1982 were lower than in comparable samples taken in 1974 and 1976; p,p'-DDE represented a greater fraction of the total DDT group in the 1982 samples than in 1974 or 1976. These data are consistent with the availability of DDT group residues having declined during the interval 1976-1982. Concentrations of polychlorinated biphenyl (PCB) residues did not change over this period. Similar trends emerged from a comparison of harp seals (Pagophilus groenlandicus) shot in the Gulf of St. Lawrence in 1971 and in 1982, except that, in this group, a slight reduction in PCB levels occurred over the 11-year interval. Taken together, the data suggest that DDT-group levels are declining significantly in high level predator organisms but that PCB levels are declining less rapidly.},
  isbn = {0013-936X},
  journal = {Environmental science \& technology},
  keywords = {314,Halichoerus grypus,Phoca groenlandica,pollution},
  mendeley-tags = {314},
  number = {12}
}

