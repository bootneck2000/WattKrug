@article{Schwartz1999,
  title = {Tag Position and First {{Dorsal}} Fin Growth Relationships in a Sphyrnid and Nine Carcharhinid Sharks},
  author = {Schwartz, Frank J and Cook, Michael and McCann, Courtney},
  year = {1999},
  volume = {115},
  pages = {55--60},
  abstract = {Dorsal fin one (D1) and fork length (FL) body growth relationships were examined for young to adults of 129 male and 128 females representing nine carcharhinid and one sphyrnid sharks to note how they may affect tag retention. Females of seven species had higher Dorsal1 fins than did males, except for blacktip males whose D1 fins were always higher. Males of five species possessed longer dorsal fin bases as the shark grew. A tag placed at the base of the D1 fin would remain in place. Tags placed in the middle of the D1 fin would move upward in six species, laterally rearward in three species, and remain stationary in two species.},
  journal = {Journal of the Elisha Mitchell Scientific Society},
  number = {1}
}

@article{Schwartz2000,
  title = {Food of Tiger Sharks, {{Galeocerdo}} Cuvier ({{Carcharhinidae}}) from the Northwest {{Atlantic Ocean}}, off {{North Carolina}}},
  author = {Schwartz, Frank J},
  year = {2000},
  volume = {116},
  pages = {351--355},
  abstract = {Hook and line sport fishermen captured 116 tiger sharks (Galeocerdo cuvier) during 15 yr of the Poor Boy shark tournaments (1982-1996). Ten male and 27 female stomachs contained foods. Blue crabs (Callinectes sapidus, 22.1\%), loggerhead sea turtle parts (Caretta caretta, 16.2\%), and king mackerel (Scomberomorus cavalla, 5.8\%) dominated the 35 different foods eaten. Tiger shark diets were as varied as reported elsewhere.},
  journal = {Journal of the Elisha Mitchell Scientific Society},
  number = {4}
}

@article{Schwartz2000a,
  title = {Elasmobranchs of the Cape Fear River, North Carolina},
  author = {Schwartz, Frank J},
  year = {2000},
  volume = {[ print] 1},
  pages = {206--224},
  abstract = {Twenty-four species of elasmobranchs (sharks, skates, and rays) were collected during an intensive six-year (1973-1978) survey of 22 stations located throughout the Cape Fear River estuary, Carolina Beach Inlet, and the adjacent Atlantic Ocean. Three additional species (whale shark, Rhincodon typus, basking shark, Cetorhinus maximus, and spinner shark, Carcharhinus brevipinna), reported in the literature, brought the elasmobranch fauna to 27 species. Elasmobranchs entered the Cape Fear River estuary from the Atlantic Ocean at its mouth near Southport, North Carolina, or via Carolina Beach Inlet. Channel, east and west shoal stations were sampled using otter trawls and gill nets from January through November of each year. Water temperatures, salinities, and dissolved oxygen levels were collected at each station in the river ecosystem. Three species dominated the elasmobranch fauna: Atlantic sharpnose shark (Rhizoprionodon terraenovae), Atlantic stingray (Dasyatis sabina), and clearnose skate (Raja eglanteria). Freshwater inflows or marine intrusions affected various elasmobranch use and penetration of the Cape Fear ecosystem. Most specimens were females, R. eglanteria and D. sabina were the first Elasmobranchs to enter the Cape Fear system each January or February; D. sabina was the last species to leave in November. Many species occurred where river waters were warm, whereas only a few occurred when waters were cool. Roughtail stingrays (D. centroura) were the only odd species captured in the river as it usually occurred in offshore Atlantic Ocean waters. A vibrant, seasonal, sequence of elasmobranchs utilized the Cape Fear River ecosystem. Unless pollution from Wilmington, North Carolina, is abated, many elasmobranchs will be affected and their utilization of the Cape Fear ecosystem, as part of their life stages, will be in peril.},
  journal = {Journal of the Elisha Mitchell Scientific Society},
  keywords = {Anim,Animal Distribution (1971- ) [62800],Animals. Chordates. Fish. Nonhuman Vertebrates. Ve,Cape Fear River (North Carolina,Carcharhinus brevipinna [spinner shark] (Chondrich,Chondrichthyes [85202],Chondrichthyes: Pisces,Chordata,Ecology,Environmental Biology/Animal [07508],Environmental Biology/General,Environmental Biology/Oceanography and Limnology [,Environmental Sciences,Estuarine Ecology (Ecology,freshwater inflows. geographic distribution. habit,Methods [07502],North Americ,USA,Vertebrata},
  number = {3}
}

@article{Schwartz2004,
  title = {Occurrences and Distributions of Some {{Labrid}}, {{Ostraciid}}, and {{Diodontid}} (Class {{Actinopterygii}}) Fishes in {{North Carolina}}},
  author = {Schwartz, Frank J},
  year = {2004},
  volume = {120},
  pages = {167--171},
  abstract = {The distributions and size status are reviewed of one Labrid, four Ostraciid, and five Diodontid fishes in North Carolina. Two species, Lachnolaimus maximus and Diodon hystrix represent new size records; Chilomycterus atringa a northern range extension. The majority of the fishes examined, except for the striped burrfish (Chilomycterus shoepfi) were occasional or rare members of the North Carolina fish fauna. Striped burrfish dominated ocean and inland waters from mid July-September. Young balloonfish were found in the stomach contents of a dolphin (Coryphaena) while a striped burrfish was eaten by a tiger shark. Overall abundances and occurrences remain unresolved.},
  journal = {Journal of the North Carolina Academy of Science},
  number = {4}
}

@article{Schwartz2007,
  title = {Inferring Geographic Isolation of Wolverines in {{California}} Using Historical {{DNA}}},
  author = {Schwartz, M K and Aubry, K B and McKelvey, K S and Pilgrim, K L and Copeland, J P and Squires, J R and Inman, R M and Wisely, S M and Ruggiero, L F},
  year = {2007},
  volume = {71},
  pages = {2170--2179},
  doi = {10.2193/2007-026},
  abstract = {Delineating a species' geographic range using the spatial distribution of museum specimens or even contemporary detection-non-detection data can be difficult. This is particularly true at the periphery of a species range where species' distributions are often disjunct. Wolverines (Gulo gulo) are wide-ranging mammals with discontinuous and potentially isolated populations at the periphery of their range. One potentially disjunct population occurred in the Sierra Nevada Mountains, California, USA, and appears to have been extirpated by the 1930s. Many early 20th century naturalists believed that this population was connected to other populations occurring in the Cascade Range of northern California, Oregon, and Washington, USA, but a recent analysis of historical records suggests that California wolverines were isolated from other populations in North America. We used DNA extracted from museum specimens to examine whether California wolverines were isolated. Both nuclear and mitochondrial DNA data indicate that California wolverines were genetically distinct from extant populations, suggesting long-term isolation. We identified 2 new control region (mitochondrial DNA) haplotypes located only within California. We used these data and referenced sequences from the Rocky Mountains, USA, to make inferences regarding potential wolverine translocations into California. In addition, we used these genetic data to make inferences about wolverine conservation throughout western North America.},
  isbn = {0022-541X},
  journal = {Journal of Wildlife Management},
  keywords = {ANCIENT DNA,BREEDING BIRD SURVEY,CONSERVATION,distribution,GENETIC DIVERSITY,geographic range,Gulo gulo,GULO-GULO POPULATIONS,historical DNA,management,MARTES-PENNANTI,microsatellite,mitochondrial DNA,MITOCHONDRIAL-DNA,NORTH-AMERICA,POLYMORPHIC MICROSATELLITES,reintroduction,translocations,units,VARIABILITY,wolverines},
  language = {English},
  number = {7}
}

