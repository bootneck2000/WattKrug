@article{Paterson1990a,
  title = {Records of Beaked Whales in Queensland},
  author = {Paterson, R A and Van Dyck, S},
  year = {1990},
  pages = {63--77},
  abstract = {Beaked whale records in the Queensland Museum [Australia] are confined to eleven specimens representing four species. They include the holotype of Indopacetus pacificus (Longman, 1926) and specimens of Mesoplodon densirostris (de Blainville, 1817) (5), M. layardii (Gray, 1865) (3) and Ziphius cavirostris (Cuvier, 1823) (2). Dental/mandibular relationships are demonstrated by radiographic methods in specimens of M. densirostris and M. layardii. Temperatures in Queensland waters are influenced by the warm East Australian Current and the commposition of the collection reflects known distributions of the relevant species.},
  journal = {Scientific Reports of Cetacean Research.(1)}
