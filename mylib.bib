@article{Kock1992,
  title = {Antarctic Fish and Fisheries},
  author = {Kock, K. H.},
  year = {1992},
  issn = {00218790},
  doi = {10.2307/5212},
  abstract = {Provides the first detailed account of the Antarctic finfish fishery, which has been exploited for over two decades with many stocks apparently overfished. In the first part of the book the current state of Antarctic ichthyology is examined, summarizing information on the composition of the fish fauna, distributions and abundance, and evolutionary specializations. Emphasis is given to growth, reproduction and early life history, as well as to the role of fish in the food webs of the Southern Ocean as one of the prerequisites for their sound management. The second part of the book aims to give a comprehensive description of finfish exploitation, beginning with its history and describing changes in the fishery, fishing grounds and fishing conditions, fishing fleets, fish stock assessment and the state of stocks, particularly as a result of krill fishing. More effective management methods for the fish resources of the Southern Ocean are proposed in the light of the Convention on the Conservation of Antarctic Marine Living Resources. -after Author},
