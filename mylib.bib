@article{Walker1976,
  title = {Effects of Species Sex Length and Locality on the Mercury Content of School Shark Galeorhinus-Australis and Gummy Shark Mustelus-Antarcticus from Southeastern Australian Waters},
  author = {Walker, T I},
  year = {1976},
  volume = {27},
  pages = {603--616},
  abstract = {The Hg levels detected in the muscle tissues of sharks ranged from 0.01-2.7 ppm wet weight for G. australis and from 0.07-3.0 ppm for M. antarcticus. Estimates of the mean Hg levels for the 1971 Victorian landed commercial shark catch were found to be 0.90 ppm for the school shark and 0.37 ppm for the gummy shark. The analyses for total Hg determinations were carried out by 5 independent laboratories. Preliminary analyses carried out by one indicated that most of the Hg in school sharks and about two-thirds of the Hg in gummy sharks was present as methylmercury. The Hg concentrations varied exponentially with shark length. School sharks had statistically significantly higher Hg levels than gummy sharks of the same length and for the medium-sized and large individuals of each species males had significantly higher levels than females. Levels in male gummy sharks were found to be affected by locality.},
  journal = {Australian Journal of Marine and Freshwater Research},
  number = {4}
}

