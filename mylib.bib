@article{Peichl2001,
  title = {For Whales and Seals the Ocean Is Not Blue: {{A}} Visual Pigment Loss in Marine Mammals},
  author = {Peichl, Leo and Behrmann, Guenther and Kroger, Ronald H H and Kr{\"o}ger, R H H and Berhmann, G and Kr{\"o}ger, R H H},
  year = {2001},
  volume = {13},
  pages = {1520--1528},
  abstract = {Most terrestrial mammals have colour vision based on two spectrally different visual pigments located in two types of retinal cone photoreceptors, i.e. they are cone dichromats with long-to-middle-wave-sensitive (commonly green) L-cones and short-wave-sensitive (commonly blue) S-cones. With visual pigment-specific antibodies, we here demonstrate an absence of S-cones in the retinae of all whales and seals studied. The sample includes seven species of toothed whales (Odontoceti) and five species of marine carnivores (eared and earless seals). These marine mammals have only L-cones (cone monochromacy) and hence are essentially colour-blind. For comparison, the study also includes the wolf, ferret and European river otter (Carnivora) as well as the mouflon and pygmy hippopotamus (Artiodactyla), close terrestrial relatives of the seals and whales, respectively. These have a normal complement of S-cones and L-cones. The S-cone loss in marine species from two distant mammalian orders strongly argues for convergent evolution and an adaptive advantage of that trait in the marine visual environment. To us this suggests that the S-cones may have been lost in all whales and seals. However, as the spectral composition of light in clear ocean waters is increasingly blue-shifted with depth, an S-cone loss would seem particularly disadvantageous. We discuss some hypotheses to explain this paradox.},
  journal = {European Journal of Neuroscience},
  keywords = {[01500] Evolution,[20004] Sense organs - Physiology and biochemistry,[20504] Nervous system - Physiology and biochemist,[85715] Bovidae,[85735] Hippopotamidae,[85765] Canidae,[85780] Mustelidae,[85815] Delphinidae,[86180] Otariidae,[86185] Phocidae,7132,Animals,Arctocephalus gazella,Arctocephalus pusillus [Australian fur seal] (Otar,Arctocephalus pusillus: Australian fur seal [Otari,Artiodactyla,Artiodactyls,Associated Structures and Functions/,Bovidae [85715],Bovidae: Animals,Bovidae: Artiodactyla,Callorhinus ursinnus [Northern fur seal] (Otariida,Callorhinus ursinnus: Northern fur seal [Otariidae,Callorhinus ursinus,Canidae: Animals,Canidae: Carnivora,Canis lupus [wolf] (Canidae),Canis lupus: wolf [Canidae],Carnivora,Carnivores,Cetacea,Cetaceans,Choeropsis liberiensis [pygmy hippopotamus] (Hippo,Choeropsis liberiensis: pygmy hippopotamus [Hippop,Chord,Chorda,Chordata,Chordates,color perception,color vision,colour vision,Cystophora cristata,Cystophora cristata [hooded seal] (Phocidae),Cystophora cristata: hooded seal [Phocidae],Delphinidae: Animals,Delphinidae: Cetacea,Delphinus delphis [common dolphin] (Delphinidae),Delphinus delphis: common dolphin [Delphinidae],Evolution [01500],Evolution and Adaptation,Globicephala macrorhynchus [short-finned pilot wha,Globicephala macrorhynchus: short-finned pilot wha,Globicephala melaena [long-finned pilot whale] (De,Globicephala melaena: long-finned pilot whale [Del,Grampus griseus [Risso's dolphin] (Delphinidae),Grampus griseus: Risso's dolphin [Delphinidae],Halichoerus grypus,Halichoerus grypus [grey seal] (Phocidae),Halichoerus grypus: grey seal [Phocidae],Hippopotamidae: Animals,Hippopotamidae: Artiodactyla,L-cones: long-to-middle wave sensitive,L-cones: sensory system,Lagenorhynchus albirostris [white-beaked dolphin],Lagenorhynchus albirostris: white-beaked dolphin [,long-to-middle wave sensi,Lutra lutra [European river otter] (Mustelidae),Lutra lutra: European river otter [Mustelidae],Mammal,Mammalia,Mammals,Mustela putorius furo [domestic ferret] (Mustelida,Mustela putorius furo: domestic ferret [Mustelidae,Mustelidae: Animals,Mustelidae: Carnivora,Nervous System (Neural Coordination),Nervous System: Neural Coordination,Nervous System/Physiology and Biochemistry [20504],Nonhuman Mammals,Nonhuman V,Nonhuman Ve,Nonhuman Vertebrates,Otaria byronia,Otaria byronia [Southern sea lion] (Otariidae),Otaria byronia: Southern sea lion [Otariidae],Otariidae: Animals,Otariidae: Pinnipedia,Ovis musimon [mouflon] (Bovidae),Ovis musimon: mouflon [Bovidae],Phoca hispida,Phoca hispida [ringed seal] (Phocidae),Phoca hispida: ringed seal [Phocidae],Phoca vitulina,Phoca vitulina [harbour seal] (Phocidae),Phoca vitulina: harbour seal [Phocidae],Phocidae: Animals,Phocidae: Pinnipedia,Phocoena phocoena [harbor porpoise] (Delphinidae),Phocoena phocoena: harbor porpoise [Delphinidae],Pinnipedia,Pinnipeds,retinal cone photoreceptors: sensory system,S-cones: sensory system,Sense Organs,Sense Organs (Sensory Reception),Sense Organs: Sensory Reception,sensory sy,short-wave sensitive,Tursiops truncatas [bottlenose dolphin] (Delphinid,Tursiops truncatas: bottlenose dolphin [Delphinida,Ve,Vertebrat,Vertebrata,Vertebrates,vision,visual environment,visual pigments: loss},
