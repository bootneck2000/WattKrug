@article{Tedman1981b,
  title = {Mammary Gland of the Weddell Seal Leptonychotes-Weddelli Pinnipedia 1. {{Gross}} and Microscopic Anatomy},
  author = {Tedman, R A and Bryden, M M},
  year = {1981},
  volume = {199},
  pages = {519--530},
  abstract = {The Weddell seal cow possesses 2 subcutaneous, ellipsoidal, abdominal mammary glands with a volume of 2-3 l when lactating. Corrosion casts reveal that approximately 10 large ducts radiate from a gland cistern at the base of the nipple, and end in a complex system of terminal branches. Each gland has a separate arterial supply, mostly from the caudal deep epigastric with a minor contribution from the deep circumflex iliac. Histologically, lactating, nonlactating (resting) and immature glands resemble those of other eutherians. Sinusoidal blood vessels, not observed in the mammary glands of other mammals, are present within lactating but not in resting lobules in the seal. The terminal pouch and lactiferous sinuses possess circular smooth muscle and elastic fibers in the walls, and accumulations of lymphocytes immediately beneath the epithelium. Sebaceous and sweat glands open into the walls of the nipple and the apex of the terminal pouch. There are extensive networks of blood vessels and longitudinal smooth muscle and elastic fibers in the walls and base of the nipple. The possible functions of these morphological observations are discussed.},
  journal = {Anatomical Record},
  keywords = {*Anatomy and Histology,*Reproductive System/Anatomy [16502],*Reproductive System/Physiology and Biochemistry [,8100,Anatomy and Histology,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Blood,Blood-Forming Organs and Body Fluids/Lympha,Bones,Cardiovascular System/Anatomy [14502],Chordate Body Regions/Abdomen (1970- ) [11314],Connective and Adipose Tis,Eutherian Blood Vessel Smooth Muscle Elastic Fiber,Fasciae,General and Comparative/Com,General and Comparative/Mi,Integumentary System/Anatomy [18502],Joints,Mammalia-Unspecified [85700],Methods [16501],Microscopy Techniques/Histology and Histochemistry,Muscle/Anatomy [17502],Phocidae [86185],Reproductive System/General},
  number = {4}
}

