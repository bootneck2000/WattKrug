  author = {Hawke, David J and Newman, Jamie},
  year = {2005},
  volume = {52},
  pages = {108--111},
  journal = {Notornis},
  keywords = {[07502] Ecology: environmental biology - General a,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[13202] Nutrition - General studies,[62800] Animal distribution,[85508] Apterygiformes,[85518] Charadriiformes,[85524] Columbiformes,[85540] Gruiformes,[85548] Passeriformes,[85556] Procellariiformes,[85564] Strigiformes,[86170] Pinnipedia,[86180] Otariidae,An,Apterygiformes: Animals,Apteryx australis lawryi: subspecies [Apterygiform,Arctocephalus forsteri: species,Athene noctua: species [Strigiformes],Aves,Biogeography: Population Studies,Birds,Bowdleria punctata caudata: subspecies [Passerifor,carbon isotopes: nutrient,Charadriiformes: Animals,Chord,Chordat,Chordata,Chordates,co,Coenocorypha aucklandica: species [Charadriiformes,Columbiformes: Animals,Environmental Sciences,Gallirallus australis: species [Gruiformes],Gruiformes: Animals,Hemiphaga novaeseelandiae: species [Columbiformes],Hooker's sea lion,Mammalia,Mammals,Marine Ecology: Ecology,New Zealand fur s,nitrogen isotopes: nutrient,Nonh,Nonhum,Nonhuma,Nonhuman,Nonhuman V,Nonhuman Ve,Nutrition,nutritional s,Otariidae: Animals,Passeriformes: Animals,petrel: common [Procellariiformes],Petroica macrocephala dannefaerdi: subspecies [Pas,Phocarctos hookeri: species,pinniped: common [Pinnipedia],Pinnipedia,Pinnipedia: Animals,Procellariiformes: Animals,shearwater: common [Procellariiformes],Strigiformes: Animals,Turdus philomelos: species [Passeriformes],Vertebrat,Vertebrata,Zosterops lateralis: species [Passeriformes]},
