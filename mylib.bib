  author = {Frugone, M.J. Mar{\'i}a Jos{\'e} and L{\'o}pez, Mar{\'i}a Eugenia M.E. and Segovia, N.I. Nicol{\'a}s I. and Cole, T.L. Theresa L. and Lowther, Andrew and Pistorius, Pierre and Dantas, Gisele P.M. G.P.M. and Petry, M.V. Maria Virginia and Bonadonna, Francesco and Trathan, Phil and Polanowski, Andrea and Wienecke, Barbara and Bi, Ke and {Wang-Claypool}, Cynthia Y. C.Y. and Waters, J.M. Jonathan M. and Bowie, Rauri C.K. R.C.K. and Poulin, Elie and Vianna, Juliana A. J.A.},
