@article{Levenson1997,
  title = {Pupillometry in Seals and Sea Lions: Ecological Implications},
  author = {Levenson, D H and Schusterman, R J},
  year = {1997},
  volume = {75},
  pages = {2050--2057},
  abstract = {Phocid and otariid pinnipeds forage almost exclusively under water, where observing them is difficult. As a result. little is known of how their senses art used while divine, to locate and capture prey, In this study we used pupillometric methods to describe the relative visual abilities of three pinniped species: the northern elephant seal (Mirounga angustirostris), the harbor seal (Phoca vitulina), and the California sea lion (Zalophus californianus). The range of pupillary area and lower limit of pupillary adjustment were determined for each species. The northern elephant seal exhibited the largest range of pupillary area of the species examined. Furthermore, the elephant seal's pupil was found to reach maximum size only under extremely dim conditions. Both the harbor seal and California sea lion exhibited maximum pupillary dilation in conditions several log units brighter. These results indicate that the elephant seal's visual system is designed to function in dimmer conditions and to respond to greater changes in light levels than those of the harbor seal and sea lion. Such findings support the hypothesis that the visual systems of these pinnipeds are adapted for use in their respective foraging environments, and thus suggest that the visual sense is probably an important sensory modality used to locate and capture prey while diving.},
  isbn = {0008-4301},
  journal = {Canadian Journal of Zoology-Revue Canadienne De Zoologie},
  keywords = {6040,BEHAVIOR,DIVING,GROENLANDICUS ERXLEBEN 1777,HARP SEAL,LUMINANCE,Mirounga angustirostris,Phoca vitulina,predation,PUPIL,SIZE,vision,VISUAL ACUITY,Zalophus californianus,ZALOPHUS-CALIFORNIANUS},
  language = {English},
  mendeley-tags = {6040},
  number = {12}
}

@article{Levenson1999,
  title = {Dark Adaptation and Visual Sensitivity in Shallow and Deep-Diving Pinnipeds},
  author = {Levenson, David H and Schusterman, Ronald J},
  year = {1999},
  volume = {15},
  pages = {1303--1313},
  abstract = {Pinnipeds forage almost exclusively underwater. Consequently, observing them is difficult and relatively little is known of how they use their senses to locate prey, avoid predators, and navigate while diving. Vision has been presumed to be of primary importance, although previous measurements of visual functioning in pinnipeds have been restricted to just a few shallow-diving species. As diving pinnipeds experience rapid changes in light levels during descent/ascent and low light levels at depth, it has not been clear whether they possess visual capabilities adequate for use while diving, particularly in the case of deep-diving species. To examine this issue, behavioral psychophysics have been used to assess and compare the dark adaptation rates and relative light sensitivities of a deep-diving pinniped (northern elephant seal, Mirounga angustirostris), two shallow-diving species (California sea lion, Zalophus californianus, and harbor seal, Phoca vitulina), and a human subject.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {6530,diving,Mirounga angustirostris,PBS Record: 1616,Phoca vitulina,vision,Zalophus californianus},
  mendeley-tags = {6530,PBS Record: 1616},
  number = {4}
}

@article{Levenson2003,
  title = {Genetic Evidence for the Ancestral Loss of Short-Wavelength-Sensitive Cone Pigments in Mysticete and Odontocete Cetaceans},
  author = {Levenson, D H and Dizon, A},
  year = {2003},
  volume = {270},
  pages = {673--679},
  abstract = {All mammals ancestrally possessed two types of cone pigments, an arrangement that persists in nearly all contemporary species. However, the absence of one of these cone types, the short-wavelength-sensitive (SWS) cone, has recently been established in several delphinoid cetacean species, indicating that the loss of this pigment type may be widespread among cetaceans. To evaluate the functional condition of SWS cones in cetaceans, partial SWS cone-opsin gene sequences were obtained from nuclear DNA for 16 species representing 12 out of the 14 extant mysticete (baleen) and odontocete (toothed) families. For all these species one or more mutations were identified that indicate that their SWS cone-opsin genes are pseudogenes and thus do not code for functional visual pigment proteins. Parsimonious interpretation of the distribution of some of these mis-sense mutations indicates that the conversion of cetacean SWS cone-opsin genes to pseudogenes probably occurred before the divergences of the mysticete and odontocete suborders. Thus, in the absence of dramatic homoplasy, all modern cetaceans lack functional SWS cone visual pigments and, by extension, the visual capacities that such pigments typically support.},
  journal = {Proc. R. Soc. Lond. B},
  keywords = {[01500] Evolution,[03502] Genetics - General,[03506] Genetics - Animal,[10062] Biochemistry studies - Nucleic acids,[10064] Biochemistry studies - Proteins,[20004] Sense organs - Physiology and biochemistry,[85735] Hippopotamidae,[85800] Cetacea,[85805] Balaenidae,[85810] Balaenopteridae,[85815] Delphinidae,[85820] Eschrichtidae,[85825] Monodontidae,[85830] Physeteridae,[85835] Platanistidae,[85840] Ziphiidae,8071,A,Amazon river dolphin,Artiodactyla,Artiodactyls,Balaena mysticetus,Balaena mysticetus: species,Balaenidae: Animals,Balaenoptera acutorostrata: species,Balaenoptera musculus: species,Balaenopteridae: Animals,beluga whale,blue whale,bowhead whale,c,Cetacea,Cetacea: Animals,cetacean: common [Cetacea],Cetaceans,Chordata,Chordates,color vision,colour vision,comm,commo,common,common [Delphini,common bottlenose dol,common minke,cone opsin: ancestral loss,cone pigment,cone: sensory system,Delphinapterus leucas,Delphinapterus leucas: species,Delphinidae: Animals,Eschrichtidae: Animals,Eschrichtius robustus: species,Eubalaena glacialis: species,evolution,Evolution and Adaptation,evolutionary divergence,franciscana,genetics,Genetics,gray whale,harbor porpoise,Hippopotamidae: Animals,Hippopotamus amphibius: species,humpback whale,Indian river dolphi,Inia geoffrensis: species,Kogia breviceps: species,Ma,Mamm,Mamma,Mammal,Mammalia,Mammals,Megaptera novaeangliae: species,Mesoplodon bidens: species,missense mutations,Molecular Genetics: Biochemistry and Molecular Bio,Monodontidae: Animals,N,North Atlantic right,nuclear DNA,peptides,Phocoena phocoena: species,Phocoena sinus: species,Physeter macrocephalus: species,Physeteridae: Animals,Platanista gangetica: species,Platanistidae: Animals,Pontoporia blainvillei: species,puri,pygmy sperm whale,river hippopotamu,Sense Organs: Sensory Reception,short-wa,Sowerby's beaked whale,sperm whale,Tursiops truncatus: species,vaquita,Ve,Verteb,Vertebra,Vertebrat,Vertebrata,vision,visual capacity,Ziphiidae: Animals},
