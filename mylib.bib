@article{Carabel2006,
  title = {An Assessment of Sample Processing Methods for Stable Isotope Analyses of Marine Food Webs},
  author = {Carabel, S and {Godinez-Dominguez}, E and Verisimo, P and Fernandez, L and Freire, J},
  year = {2006},
  volume = {336},
  pages = {254--261},
  doi = {10.1016/j.jembe.2006.06.001},
  abstract = {Carbon and nitrogen stable isotope ratios are commonly used in the study of marine food webs. However, different sample processing methods can influence the measurement of these stable isotope ratios. The purpose of this study is to define an adequate methodology to be used in the construction of whole food webs. It is demonstrated that acidification of the samples results in a decrease in carbon stable isotope values for sedimentary organic matter, suspended particulate organic matter, plankton and invertebrates with carbonated structures. The response was variable for nitrogen isotope ratios. Based on our results we recommend sample acidification for carbon analysis in these compartments where effects of this treatment were observed. We observed a decrease in delta C-13 values after washing with distilled water, so we do not recommend washing with water after acidification. For nitrogen analysis, acidification should be avoided. The various dehydration treatments studied caused significant differences only in nitrogen isotope ratios. (c) 2006 Elsevier B.V. All rights reserved.},
  isbn = {0022-0981},
  journal = {Journal of Experimental Marine Biology and Ecology},
  keywords = {BAY,CARBON,coastal ecosystem,DELTA-N-15,ESTUARY,food web,NITROGEN,ORGANIC-MATTER,RATIOS,sample processing,stable isotopes,STRANDED MACROALGAE,TROPHIC ECOLOGY,VARIABILITY},
  language = {English},
  number = {2}
}

