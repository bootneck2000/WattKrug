@article{Clark1986,
  title = {Archaeological and Historic Evidence for an 18th-Century "Blip" in the Distribution of the Northern Fur Seal at {{Kodiak Island}}, {{Alask}}},
  author = {Clark, Donald W},
  year = {1986},
  volume = {39},
  pages = {39--42},
  abstract = {Clark reports on several sites scattered across Kodiak that show evidence of fur seal use. In particular, he shows that the ratio of fur seals to harbor seals was initially low (ca. AD 0), then increased from the first millennium AD to the end of the 18th century. The dates for the different sites indicate that the peak in fur seal use pre-dates the first arrival of the Russians. The explanation Clark proposes for this is a short-term increase in the availability of fur seals. This could be a consequence of changes in storm patterns, which would drive the seal herd closer to shore, or possibly from an increase in herring stocks, which NFS have been documented to follow into inlets. Clark ends with a final caution that "in the case of presumably stable maritime ecosystems the past may not always be assumed from the present." Clark only provides summary data for each of the sites, and doesn't list anything by stratum (although he apparently does in (Clark n.d.)). He also doesn't provide any info on age/sex distributions of the specimens. It would certainly be interesting to see the original data. Or, even better, see the specimens.},
  journal = {Arctic},
  keywords = {northern fur seal Callorhinus ursinus pinniped ota},
  number = {1}
}

