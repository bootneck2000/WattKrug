}

@article{Lee2009c,
  title = {The Effects of the Fractal Landscape Structure on the Territory Size Distribution of Subterranean Termites: {{A}} Simulation Study},
  author = {Lee, S H and Su, N Y},
  year = {2009},
  volume = {54},
  pages = {1697--1701},
  abstract = {The foraging territory of the Formosan subterranean termite, Coptotermes formosanus Shiraki, was simulated by using a lattice model in order to understand how the fractal landscape structure affects the foraging territory and interacts with the territory size. Each lattice cell had a value ranging from 0.0 to 1.0, interpreted as a transition probability, P-trans, which represents the spatially-distributed property of the fractal landscape. The fractal landscape was characterized by a parameter, H, controlling aggregation of lattice cells with higher values Of P-trans. At the beginning of the simulation, N (=30, 50, 80 and 100, depending on the condition) termite cells, each representing a founding pair, were randomly distributed within the lattice space. After fourteen simulation years, all territories had reached a steady state in which their shapes did not change over time. In this state, we investigated the size distribution of territories in size descending order. For large-sized territories (rank \textexclamdown{} 10 - 20), the size increase with increasing H, which resulted from the fact that high H values indicated that fewer but larger, areas of contiguous cells with high values Of Ptrans were present. For small-sized territories (rank \textquestiondown{} 20), H had little affect on the territory size.},
  isbn = {0374-4884},
  journal = {Journal of the Korean Physical Society},
  keywords = {ECOLOGY,Fractal,ISOPTERA,landscape,Lattice model,LOUISIANA,MODELS,RHINOTERMITIDAE,Termite territory,Territorial competition},
  language = {English},
  number = {4}
