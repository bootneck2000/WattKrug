@article{Beaufils2007,
  title = {Comparative Behaviour of Goat Beta and Alpha(S1)-Caseins at the Air-Water Interface and in Solution},
  author = {Beaufils, S and {Hadaoui-Hammoutene}, R and Vie, V and Miranda, G and Perez, J and Terriac, E and Henry, G and Delage, M M and Leonil, J and Martin, P and Renault, A},
  year = {2007},
  volume = {21},
  pages = {1330--1343},
  doi = {10.1016/j.foodhyd.2006.10.014},
  abstract = {Here we present a comparative study of caprine beta- and alpha(s1)-caseins behaviours at the air-water interface and in solution. Both caseins were purified from the milk of a single goat homozygous at the a(s1)- and beta-Cn loci, with a high degree of purity (98\%). Physical measurements (ellipsometry, surface pressure and surface rheology) were performed at the air-water interface, whereas SAXS measurements were performed on casein solutions. Our results clearly show that self-organizations, both at the air-water interface and in solution are different for beta- and alpha(s1)-caseins. beta-casein is unfolded in solution and forms a network at the interface, while alpha(s1)-casein forms compact objects in solution and is organised in fluid domains at the interface. We also show that the presence of Ca2+ in the subphase strongly disturbs the interfacial layer formed by the caseins. It is elsewhere worth noting that in solution, the aggregation of alpha(s1)-casein induced by calcium ions is associated with a pronounced change in the molecular structural organisation of the protein, which seems to adopt, in these conditions, an unfolded structure. (C) 2006 Elsevier Ltd. All rights reserved.},
  isbn = {0268-005X},
  journal = {Food Hydrocolloids},
  keywords = {auto association,BETA-CASEIN ADSORPTION,casein,COAGULATION PROPERTIES,ellipsometry,ELLIPSOMETRY,GENETIC-POLYMORPHISM,goat,KAPPA-CASEIN,LIQUID INTERFACES,MILK-PROTEINS,MONOLAYERS,rheology,SAXS,SURFACE RHEOLOGICAL PROPERTIES,X-RAY-SCATTERING},
  language = {English},
  number = {8}
}

