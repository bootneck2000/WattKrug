@article{Siniff1977,
  title = {An Analysis of the Dynamics of a {{Weddell}} Seal Population},
  author = {Siniff, D B and DeMaster, D P and Hofman, R J and Eberhardt, L L},
  year = {1977},
  volume = {47},
  pages = {319--335},
  abstract = {A breeding population of the Weddell seal (Leptonychotes weddelli) was studied annually during the 2 1/2-mo. pupping and breeding season in McMurdo Sound, Antarctica, from 1969-1974. Components of the population were estimated by direct counts of adult .female..female. with pups, by capture-recapture studies of nonparous .female..female. and adult .male..male. and by aerial counting. Total population size was estimated as being on the order of 2500-3000 seals. The Seber-Jolly method was adapted to circumstances of the present study. Reproductive rates (measured in terms of successful pupping) were .apprxeq. 0.5 pups/.female. for the entire breeding colony and .apprxeq. 0.7 pups/.female. for a subset of tagged .female..female. observed for 4 yr in sequence. Age-specific reproductive data were also obtained, and it appears that full reproductive activity of .female..female. is achieved at .apprxeq. age 7. The annual survival rate for adult .female..female. is in the range of 0.80-0.85, as determined (by several methods) from tagging data. Survival rates for adult .male..male. are lower (perhaps 0.50), but are not as well established. Little information was obtained on the subadult class (1-3 yr of age). Underwater territories of adult .male..male. on one breeding colony were studied by acoustic tagging and found to be steadily patrolled by dominant .female..female.. Two experimental colonies having different densities of .female..female. with pups demonstrated increased interactions at higher densities, but lower weight losses on the part of the .female..female. (presumably due to isolated location of the colonies). The McMurdo Sound population is apparently regulated by a physiological or social connection between the number of adult .female..female. at the pupping colonies and subsequent years' pup population.},
  journal = {Ecological Monographs},
  keywords = {*Behavioral Biology/Animal Behavior [07003],*Chordata,*Ecology,*Reproductive System/General,1384,7800,acoustic telemetry,aerial survey,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Environmental Biology/Wildlife Management-Aquatic,General and Miscellaneous/Necrosis (197,General and Systematic Zoology/Mammalia,General/Field Me,Gerontology [24500],Leptonychotes weddellii,Leptonychotes-Weddelli Mcmurdo Sound Antarctica De,mark-recapture,Materials and Apparatus,Methods,Methods [16501],modelling,Pathology,Pediatrics [25000],Phocidae [86185],population parameters},
  mendeley-tags = {1384},
  number = {3}
}

