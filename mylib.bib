@article{Lorance1998,
  title = {Structure of the Multispecies Fish Population of the Continental Slope to the {{West}} of {{British Isles}} and Impact of the Fishery},
  author = {Lorance, Pascal},
  year = {1998},
  pages = {31,1998},
  abstract = {A first survey designed to estimate the impact of the fishery on the multispecific population of the slope has been carried out from June 26th to July 20th 1996 on board of the French R/V Thalassa. This survey took place West of Scotland, between 55degree and 57degree of latitude North, on an area from where data before exploitation were available and where fishing activity was intensive since the 90's. On this area, the analysis of the species composition by haul only showed that the fish assemblage was structured according to depth. Such a conclusion was not new. However, the positioning of the hauls on two smaller sectors characterized by different slopes and bottoms, and probably by a lesser fishing intensity on the one with rougher bottom did not appear different in term of species composition. The catch rates obtained during this survey were compared to previous data collected from 1973 to 1980. The comparison showed a general decline in the catch rates. Shark and Hoplostethus atlanticus populations seem to have declined more than that of Coryphaenoides rupestris.},
  journal = {Cybium},
  keywords = {[00512] General biology - Conservation and resourc,[07502] Ecology: environmental biology - General a,[07516] Ecology: environmental biology - Wildlife,[62510] Chordata: general and systematic - Pisces,[85206] Osteichthyes,Chordata,Chordates,continental slope,Coryphaenoides rupestris [Osteichthyes],Fish,fishing activity,Hoplostethus atlanticus [Osteichthyes],multispecies fish population,Nonhuman V,Osteichthyes: Animals,Pisces,population structure,species composition,Vertebrata,Wildlife Management: Conservation}
}

