@article{Cruickshank1981,
  title = {Recent Observations and Some Historical Records of Southern Right Whale Dolphins Lissodelphis-Peronii},
  author = {Cruickshank, R A and Brown, S G},
  year = {1981},
  volume = {15},
  pages = {109--122},
  abstract = {Sightings [7] of the southern right whale dolphin L. peronii in the Benguela Current system off South West Africa and 1 sighting off Marion Island in the southern Indian Ocean are reported together with some unpublished historical records. The occcurence of the species in the South-East Atlantic is confirmed and discussed in relation to documented records and some relevant museum calvaria of the species. Some color variations are reported. Swimming behavior and speeds, herd configurations and sizes and reactions to other species and ships are noted. Sea surface temperatures were between 5.2-20.1.degree. C, both of which limits lie outside the previously reported temperature range for the species. A circumpolar distribution within the cold waters of the subtropical zone of the southern hemisphere is demonstrated. The feasibility of applying information on color variants to studies on behavior and social grouping is assessed.},
