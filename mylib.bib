  title = {The Winter Pack-Ice Zone Provides a Sheltered but Food-Poor Habitat for Larval {{Antarctic}} Krill},
  author = {Meyer, Bettina and Freier, Ulrich and Grimm, Volker and Groeneveld, J{\"u}rgen and Hunt, Brian P.V. and Kerwath, Sven and King, Rob and Klaas, Christine and Pakhomov, Evgeny and Meiners, Klaus M. and {Melbourne-Thomas}, Jessica and Murphy, Eugene J. and Thorpe, Sally E. and Stammerjohn, Sharon and {Wolf-Gladrow}, Dieter and Auerswald, Lutz and G{\"o}tz, Albrecht and Halbach, Laura and Jarman, Simon and Kawaguchi, So and Krumpen, Thomas and Nehrke, Gernot and Ricker, Robert and Sumner, Michael and Teschke, Mathias and Trebilco, Rowan and Yilmaz, Noyan I.},
