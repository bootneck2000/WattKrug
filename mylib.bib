@article{Mallory2006,
  title = {The {{Northern Fulmar}} ({{Fulmarus}} Glacialis) in {{Arctic Canada}}: Ecology, Threats, and What It Tells Us about Marine Environmental Conditions},
  author = {Mallory, M L},
  year = {2006},
  volume = {14},
  pages = {187--216},
  doi = {10.1139/a06-003},
  abstract = {The northern fulmar Fulmarus glacialis is a ubiquitous seabird found across the North Atlantic Ocean and into the Canadian Arctic. However, we know little of its ecology in the Arctic, which is unfortunate, because it possesses many traits that make it an excellent biomonitor of the condition of Arctic marine environments. Presently, Arctic fulmars face threats from harvest, bycatch in fisheries, and fouling in oil spills while the birds are in their winter range (the North Atlantic). However, during breeding, migration, and overwintering, they may also experience stress from ecotourism, contaminants, particulate garbage, and climate change. In this paper I review the effects of all of these threats on fulmars; and I describe how the ecology of these birds makes them particularly suitable for tracking contaminants, garbage, and the effects of climate change in the Arctic marine ecosystem. I also highlight our key existing knowledge gaps on this species and how additional research will strengthen the utility of fulmars as biomonitors.},
  isbn = {1181-8700},
  journal = {Environmental Reviews},
  keywords = {Arctic,BARENTS SEA,change,climate,contaminants,FOOD-WEB,Fulmarus glacialis,LONG-TERM CHANGES,northern fulmar,NORTHWEST ATLANTIC-OCEAN,PERSISTENT ORGANIC POLLUTANTS,pollution,RATIOS,STABLE-ISOTOPE,TEMPORAL TRENDS,TRACE-ELEMENTS,TROPHIC RELATIONSHIPS,VALDEZ OIL-SPILL},
  language = {English},
  number = {3}
}

