  keywords = {[07502] Ecology: environmental biology - General a,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[62800] Animal distribution,[86170] Pinnipedia,[86180] Otariidae,[86185] Phocidae,101 specie,anthropogenic debris,Arctocephalus: genus,Biogeography: Population Studies,Chordata,Chordates,common,disease risk factor,entanglement,Environmental Sciences,fur seal,Mammalia,Mammals,Marine Ecology: Ecology,Mirounga leonina: species,Nonhuman,Nonhuman V,Nonhuman Ve,Otariidae: Animals,Phocidae: Animals,pinniped: common [Pinnipedia],Pinnipedia,Pinnipedia: Animals,southern elephant seal,species distribution,Vertebrat,Vertebrata}
