@techreport{Rogers2008,
  title = {The Science behind the Guidelines},
  author = {Weaver, Connie M.},
  year = {2005},
  volume = {37},
  pages = {S344},
  issn = {0195-9131},
  doi = {10.1249/00005768-200505001-01799},
  abstract = {\textbullet{} The deep-sea fishing industry targets around 20 major fish species globally. \textbullet{} Many of these species are fished on or in the proximity to deep-sea vulnerable marine ecosystems (VMEs). \textbullet{} Deep-Sea Fisheries typically exhibit `boom and bust' catches and have been poorly regulated and many are overexploited or depleted. \textbullet{} Long-term sustainable yields of deep-sea fish species are generally low compared with shelf fisheries. \textbullet{} Commercial deep-sea fish tend to be long-lived, slow growing, late maturing and form aggregations that make them vulnerable to overexploitation. \textbullet{} Deep-sea fish stocks have a low capacity for recovery after overexploitation. \textbullet{} Because of the poor history of Deep-Sea Fisheries precautionary and ecosystem approaches are needed to best manage them, especially where new stocks are exploited. \textbullet{} Management of Deep-Sea Fisheries can be improved given timely reporting of fine-scale catch and by-catch data. \textbullet{} Deep-sea coral and sponge habitats are highly species rich VMEs that occur in discrete locations, have a relatively small area and are easily damaged by the mechanical impacts of mobile and static fishing gear. \textbullet{} Deep-sea corals and sponges are very slow growing and are extremely slow to recover or may never recover from fishing impacts. \textbullet{} Chemosynthetic ecosystems are classed as VMEs because they host unique communities of species that occur in discrete locations, are rare and are not found elsewhere. \textbullet{} The vulnerability of deep-sea sedimentary habitats is currently generally unknown. \textbullet{} VMEs are important ecosystems in the deep sea because of their associated biodiversity, their importance to the surrounding ecosystem and species therein, their fisheries resources and as a source of novel biomolecules for the biotechnology industry. \textbullet{} Our knowledge of the distribution of deep-sea VMEs continues to be improved through modelling, mapping and analyses of fisheries, research and observer data; methods for identification of where VMEs occur are outlined with examples. \textbullet{} Satellite tracking through Vessel Monitoring Systems (VMS) requires improvement but offers a cost effective method for the identification of where fishing activities coincide with VMEs and in the design, monitoring and enforcement of spatial management in the deep sea. \textbullet{} Urgent action is required as climate change and a range of other human activities will affect the deep-sea realm in the coming decades.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\CGAMQIWG\\Rogers et al. - 2008 - The Science behind the Guidelines A Scientific Guide to the FAO Draft International Guidelines (December 2007) fo.pdf},
  journal = {Medicine \& science in sports \& exercise},
  number = {Supplement}
}

