@article{Lundqvist2002,
  title = {Cloning of the {{IgM}} Heavy Chain of the Bottlenose Dolphin ({{Tursiops}} Truncatus), and Initial Analysis of {{VH}} Gene Usage},
  author = {Lundqvist, Mats L and Kohlberg, Kathleen E and Gefroh, Holly A and Arnaud, Philippe and Middleton, Darlene L and Romano, Tracy A and Warr, Gregory W},
  year = {2002},
  volume = {26},
  pages = {551--562},
  abstract = {Clones encoding the dolphin IgM heavy (mu) chain gene were isolated from a cDNA library of peripheral blood leukocytes. Genomic Southern blot analyses showed that the dolphin IGHM gene is most likely present in a single copy, and its sequence shows greatest similarity to those of the IGHM gene of the sheep, pig and cow, evolutionarily related artiodactyls. The transmembrane (TM) form of the IGHM chain was isolated by 3' RACE. While showing similarities to the TM regions of other mammalian IGHM chains, the highly conserved Ser residue of the CART motif is substituted with a Gly in the dolphin. In contrast to the pig and cow, which utilize only a single VH family, the dolphin expresses at least two distinct VH families, belonging to the mammalian VH clans I and III. At least two JH genes were identified in the dolphin. Some CDR3 regions of the dolphin VH are long (up to 21 amino acids), and contain multiple Cys residues, hypothesized to stabilize the CDR3 structure through disulfide bond formation.},
  journal = {Developmental \& Comparative Immunology},
  keywords = {Animals,CART motif,Cetaceans,Chorda,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/General [03502],IgM heavy chain [immunoglobulin M heavy chain],Mammalia,Mammals,Molecular Genetics (Biochemistry and Molecular Bio,Nonhuman Mammals,Nonhuman Vertebrates,Tursiops truncatus [bottlenose dolphin] (Delphinid,Vertebrata,Vertebrates},
  number = {6}
}

