  year = {1978},
  volume = {Tokyo},
  pages = {291--300},
  abstract = {The total filter area of south Pacific Bryde's whales, in square meters, was 1.43-1.99 (Av. average 1.75) in male, 1.19-2.40 (Av. 1.95) in female. It was 1.04-1.92 (Av. 1.64) in male, 1.10-2.44 (Av. 2.02) in female in the north Pacific animals. The averaged filter area per unit body length (m2/m body length), combined for both sexes, was 0.136 in the south Pacific animals while it was 0.145 in the north Pacific animals. The south Pacific animals had the smallest filter area of Bryde's whale ever examined. They are possibly separated from the north Pacific populations occurring in both northern pelagic and coastal waters.},
