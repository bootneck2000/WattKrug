@article{Heath1996,
  title = {Telazol and Isoflurane Field Anesthesia in Free-Ranging Stellers Sea Lions (Eumetopias Jubatus)},
  author = {Heath, R B and Calkins, D and McAllister, D and Taylor, W and Spraker, T},
  year = {1996},
  volume = {27},
  pages = {35--43},
  abstract = {Free-ranging Steller's sea lions (Eumetopias jubatus) in various parts of Alaska were stalked and darted with telazol. The sea lions were then intubated and maintained with isoflurane anesthesia for 69-162 min (mean, 113 min; SD = 26 min) using large-animal anesthesia equipment and monitoring techniques. Forty-six adult female sea lions were successfully captured, studied physiologically, tested for disease states, and released unharmed. The animals returned to normal activity within 2 hr. Failure of darts resulted in 22 escaped captures. Five mortalities occurred: two sea lions drowned in pools of water on the haulouts; two died of telazol anesthesia complications; and one died early in inhalation anesthesia. Choice of animal, stalking, and darting methods were important factors in avoiding problems with capturing these animals. Isoflurane can be delivered safely for over 2 hr of spontaneous ventilation and anesthesia in this species. [References: 35]},
  journal = {Journal of Zoo and Wildlife Medicine},
  keywords = {5191,Anesthesia,Chemical restraint,Combination,Darting.,drugging,Eumetopias jubatus,Immobilization,Isoflurane,Ketamine,Pinnipeds,Stellers sea lion,Telazol,Veterinary medicine/animal health.,Wild.,Zalophus-californianus},
