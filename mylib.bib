  pages = {595--600},
  issn = {0015-296X},
  doi = {doi:10.1139/f73-106},
  abstract = {Les auteurs ont dos\'e les m\'etabolites du DDT, les PCB et la dieldrine dans des \'echantillons de couche de graisse de 18 phoques du Groenland captur\'es pr\`es de l'embouchure du Saguenay, dans le golfe Saint-Laurent. La teneur en DDT total et en m\'etabolites varie de 3.1 \`a 22.6ppm, celle des PCB (sous forme d'Aroclor\textregistered{} 1254) de 2 \`a 22ppm, celle de la dieldrine de 0.1 \`a 0.3ppm de graisse. La corr\'elation des rangs entre le niveau des r\'esidus et l'\^age d\'emontre que des portions significatives de la variance de et de PCB sont attribuables \`a l'augmentation des niveaux de r\'esidus en fonction de l'\^age. Parmi le groupe des , seul le DDE accuse une forte augmentation de concentration proportionellement \`a l'\^age. La teneur en dieldrine est relativement ind\'ependante de l'\^age. Parmi les facteurs autres que l'\^age, les variations d'\'epaisseur de la couche de graisse ne contribuent pas \`a augmenter de fa\c{c}on appr\'eciable la variance de la concentration de r\'esidus dans la couche de graisse. Un examen des autres donn\'ees publi\'ees sugg\`ere que la parturition ou la lactation, ou les deux, peuvent r\'eduire la teneur en r\'esidus dans la couche de graisse.},
  journal = {Journal of the fisheries research board of canada},
  keywords = {2591,Age,blubber,DDT,dieldrin,Groenland,Gulf of St. Lawrence,Harp seal,marine mammal,OC,Organochlorine Residue Levels,organochlorines,Pagophilus groenlandicus,PCB,seal,Variation},
