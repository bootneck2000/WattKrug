@article{Leatherwood1980,
  title = {Distribution and Movements of Rissos Dolphin Grampus-Griseus in the Eastern North Pacific},
  author = {Leatherwood, S and Perrin, W F and Kirby, V L and Hubbs, C L and Dahlheim, M},
  year = {1980},
  volume = {77},
  pages = {951--964},
  abstract = {Records of occurrence are summarized from 22 strandings/collections and 210 sighting records from miscellaneous sources. When available, levels of effort were identified and utilized to interpret the trends in distribution and movement apparent from the data. Risso's dolphins occur from at least the equator (southern end of area examined) north to approximately latitude 50.degree. N [north], with regions of apparently very low density centering at about latitude 20.degree. and 43.degree. N. Records from northern and inshore portions of the range were most numerous during late spring through early fall. Both within and among years, periods of greatest abundance for the species north of latitude 43.degree. N, near Monterey Bay, California, and over the southern California continental borderland may correspond with protracted periods of warm water. Groups contained from 1 to an estimated 220 animals, about a geometric mean of 10.7. An estimated 76.4\% of the groups contained fewer than 20 animals.},
  journal = {Fishery Bulletin (Washington D C)},
  number = {4}
}

@article{Leatherwood1986,
  title = {Further Notes on Cetaceans of Sri-Lanka},
  author = {Leatherwood, S},
  year = {1986},
  abstract = {Between six and 19 March 1984 data on cetaceans of Sri Lanka were obtained by visits to four fishing villages (Palatupana, Patangala, Trincomalee and Pitipana/Negombo) and three days of surveys from smallboats in Koddiyar Bay and the adjacent Bay of Bengal. Collectively, fishermen interviewed were familiar with blue and sperm whales, Risso's bottlenose and spinner dolphins, and pygmy and dwarf sperm whales. For all except blue whales, skulls, or other materials near the villages or at marketplaces verified that these species are among those taken, mostly incidentally, by fishermen. The extent to which animals taken are used for food varies among villages, apparently largely as function of dominant religion. On the three days of boat surveys cetaceans were located as follows: blue whales (16; 26; 19). Bryde's whales (4; 3; 2) unidentified baleen whales (1; 1; 3), bottlenose dolphins (5; 35.+-. 5; 0) and spinner dolphins (0;0; 40.+-. 10 and 10.+-. 2). I also learned of observations by colleagues working farther offshore of sightings of sperm whales and Risso's dolphins. Nine blue and three Bryde's whales were individually identified from photographs, bringing totals so identified since April 1982 to 12 and four, respectively. Identifiable whales have been resighted in the same area after one day (2 blues), two days (1 Bryde's and 1 blue) and 12.5 months (1 blue).},
  journal = {SO - Cetology (50). 1986. 1-12.},
  keywords = {*Animal Distribution (1971- ) [62800],*Chordata,*Ecology,8600,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Balaenopteridae [85810],Blue Whale Bryde's Whale Baleen Whale Bottlenose D,Delphinidae [85815],Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Ethnobiology [05000],General and Systematic Zoology/Mammalia,Physeteridae [85830],Physical Anthropology,Ziphiidae [85840]}
}

