@article{Djordjevic1993,
  title = {Restriction-Endonuclease Analysis of {{Australian}} Isolates of {{Leptospira}} Interrogans Serovar Hardjo from Cattle with Agalactia and Abortion},
  author = {Djordjevic, S and Hornitzky, M and Ross, A D and Whittington, R J},
