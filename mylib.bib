@article{Mattiucci2008,
  title = {Genetic Relationships among Species of {{Contracaecum Railliet}} \& {{Henry}}, 1912 and {{Phocascaris Host}}, 1932 ({{Nematoda}} : {{Anisakidae}}) from Pinnipeds Inferred from Mitochondrial Cox2 Sequences, and Congruence with Allozyme Data},
  author = {Mattiucci, S and Paoletti, M and Webb, S C and Sardella, N and Timi, J T and Berland, B and Nascetti, G},
  year = {2008},
  volume = {15},
  pages = {408--419},
  abstract = {The genetic relationships among 11 taxa, belonging to the genus Contracaecum (C. osculatum A, C. osculatum, B, C. osculatum (s.s.), C. osculatum D, C. osculatum E, C. osculatum baicalensis, C. miroungo, C. radiatum, C. ogmorhini (s.s.), C. morgolisi) and Phocoscaris (Phocascaris cystophoroe), parasites as adults of seals, were inferred from sequence analysis (5 19 bp) of the mitochondrial cytochrome c oxidase subunit 11 (mtDNA cox2) gene. Phylogenetic analyses obtained from Parsimony (MP) and Neighbour-joining (NJ) K2P distance values generated similar topologies, each well supported at major nodes. All analyses delineated two main clades: the first encompassing the parasites of the phocid seals, i.e. the C. osculatum species complex, C. osculatum baicalensis, C. miroungo and C. radiatum, with the latter two species forming a separate subclade, the second including the parasites of otarids, i.e. C. ogmorhini (s.s.) and C. margolisi. An overall high congruence between mtDNA inferred tree topologies and those produced from nuclear data sets (20 allozyme loci) was observed. Comparison of the phylogenetic hypothesis here produced for Contracaecum slap. plus Phocascaris with those currently available for their definitive hosts (pinnipeds) suggests parallelism between hosts and parasite phylogenetic tree topologies.},
  isbn = {1252-607X},
  journal = {Parasite-journal De La Societe Francaise De Parasitologie},
  keywords = {10620,allozymes,Arctocephalus australis,ASCARIDIDA,ASCARIDOIDEA,BOREAL,Contracaecum,Cystophora cristata,DNA,Erignathus barbatus,genetics,Halichoerus grypus,host-parasite cophylogenetic aspects,Leptonychotes weddellii,MEMBERS,Mirounga leonina,MOLECULAR SYSTEMATICS,MORPHOLOGY,mTDNA cox2,OSCULATUM COMPLEX NEMATODA,parasites,PARASITIC NEMATODES,Phoca groenlandica,Phoca sibirica,Phocascaris,PHYLOGENETIC ANALYSIS,phylogeny,seals,Zalophus californianus},
  language = {English},
  mendeley-tags = {10620},
  number = {3}
}

