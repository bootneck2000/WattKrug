@article{Huckstadt2007,
  title = {Stable Isotope Analysis Reveals Pelagic Foraging by the {{Southern}} Sea Lion in Central {{Chile}}},
  author = {H{\"u}ckst{\"a}dt, L A and Rojas, C P and Antezana, T and Huckstadt, L A and Rojas, C P and Antezana, T},
  year = {2007},
  volume = {347},
  pages = {123--133},
  doi = {10.1016/j.jembe.2007.03.014},
  abstract = {The diet of Southern sea lion Otaria flavescens is poorly known along the coast of central Chile (32 degrees-39 degrees S), where a population of about 17,300 individuals occurs, in an ecosystem that sustains one of the world's most important fishing industries. The primary objective of this study was to reconstruct the diet and estimate Trophic Positions (TPs) of sea lions and their prey off central Chile using stable isotopes (delta C-13 and delta N-15). Our results showed that the diet of sea lions is primarily composed of pelagic prey, with the jack mackerel Trachitrus murphyi as the principal prey item in the diet of sea lion (1-99th percentile: 20-66\%), while demersal prey accounted for only 0-2.8\%. We also found regional differences on the relative contribution of prey to the diet of sea lions. Animals that were sampled close to major fishing areas showed an increase in the relative contribution of jack mackerel to the diet as opposed to animals sampled away from these areas that displayed a relatively more heterogeneous diet. Trophic Positions (TPs) of sea lions prey items ranged between 3.39 for jack mackerel and 4.48 for pink cusk-eel (Genypterus blacodes). The TP for sea lions was 4.57. Hence, our results showed a community composed by at least 5 trophic levels, with sea lion as the top predator. In summary, our study demonstrates that the Southern sea lion is displaying pelagic foraging off central Chile. We highlight the necessity of conducting further research on the trophic ecology and diving behavior of Southern sea lion to obtain a better understanding of their role as top predator. (c) 2007 Elsevier B.V All rights reserved.},
  isbn = {0022-0981},
  journal = {Journal of Experimental Marine Biology and Ecology},
  keywords = {10074,CALLORHINUS-URSINUS,delta C-13,delta N-15,diet,DIET,EUMETOPIAS-JUBATUS,FEEDING ECOLOGY,FOOD-WEB,MACKEREL TRACHURUS-SYMMETRICUS,marine mammal,MARINE MAMMALS,Otaria byronia,Otaria flavescens,OTARIA-FLAVESCENS,prey,RATIOS,stable isotopes,trophic level,TROPHIC POSITION},
  language = {English},
  mendeley-tags = {10074},
  number = {1-2}
}

