@article{Hanni1997,
  title = {Sightings and Strandings of {{Guadalupe}} Fur Seals in Central and Northern {{California}}, 1988-1995},
  author = {Hanni, K D and Long, D J and Jones, R E and Pyle, P and Morgan, L E},
  year = {1997},
  volume = {78},
  pages = {690--984},
  abstract = {The Guadalupe fur seal (Arctocephalus townsendi) was hunted to near extinction before its natural history was well known. The last known population is currently centered on Guadalupe Island, Mexico, but in recent years northern extralimital records from California have become more frequent. We report 14 new records (3 adults, 11 juveniles) of Guadalupe fur seals stranded (nine) or sighted (five) along the central and northern coast of California. These northern records appear to correspond with El Nino events, seasonal currents in California, and to dispersal behavior in this species. Dietary items retrieved from stomachs and feces included otoliths from Citharichthys sordidus, Lampanyctus, Protomyctophum, and Scopelogadus, and beaks of the squids Loligo opalescens, Gonatopsis, and Onychoteuthis borealojaponica. Emaciation commonly was associated with stranding, but other findings included an umbilical hernia, septicemia, and bacterial pneumonia. Three of the stranded individuals had experienced entanglement in fishing gear or marine debris.},
  journal = {Journal of Mammalogy},
  keywords = {6047,Animal Distribution (1971- ) [62800],animals. chordates. mammals. nonhuman mammals. non,Arctocephalus townsendi,Arctocephalus townsendi (Otariidae). Guadalupe fur,Bacterial Disease. Bacterial Pneumonia. Biogeograp,Behavior. Biogeography (Population Studies). Clima,Behavioral Biology/Animal Behavior [07003],California (USA,Chord,Chordata,Digestive System/Pathology [14006],distribution,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],General and Systematic Zoology/Mammalia,Mammalia,Medical and Clinical Microbiology/Bacteriology [36,Nearctic region).,North America,Nutrition/General Studies,Nutrition/Malnutrition,Nutritional Status and,Obesity [13203],Otariidae [86180],Otariidae: Pinnipedia,Respiratory System/Pathology [16006],Vertebrata},
