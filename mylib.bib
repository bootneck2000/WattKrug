@article{Jefferson1994a,
  title = {Marine Mammal Sightings in the Caribbean Sea and Gulf of Mexico, Summer 1991},
  author = {Jefferson, Thomas A and Lynn, Spencer K},
  year = {1994},
  volume = {30},
  pages = {83--89},
  abstract = {In the summer of 1991, we conducted marine mammal surveys in the Gulf of Mexico, Caribbean Sea, and a small portion of the southwestern North Atlantic. A total of 193 hours of survey effort was conducted, and there were 60 marine mammal sightings. Species identified (number of sightings in parentheses) were: sperm whale Physeter catodon L. (6), Cuvier's beaked whale Ziphius cavirostris G. Cuvier (1), short-finned pilot whale Globicephala macrorhynchus Gray (1), rough-toothed dolphin Steno bredanensis (Lesson) (1), bottlenose dolphin Tursiops truncatus (Montagu) (6), Atlantic spotted dolphin Stenella frontalis (G. Cuvier) (2), pantropical spotted dolphin S. attenuata (Gray) (10), spinner dolphin S. longirostris (Gray) (1), and striped dolphin S. coeruleoalba (Meyen) (3). Distribution of sightings was largely related to sighting conditions, but there were concentrations of sightings in areas with high sea floor relief - in the Straits of Florida, the area west of Martinique, and along the Mexican Ridge.},
  journal = {Caribbean Journal of Science},
  keywords = {Animal Distribution (1971- ) [62800],animals,Biogeography (Population Studies),cetaceans,Chord,Chorda,Chordata,chordates,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Ecology (Environmental Sciences),Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Sciences),General and Systematic Zoology/Mammalia,Globicephala macrorhynchus (Delphinidae),Mammalia,mammals,Marine Ecology (Ecology,nonhuman mammals,nonhuman vertebrates,Physeter catodon (Physeteridae),Physeteridae: Cetacea,Stenella coeruleoalba (Delphinidae),Stenella frontalis (Delphinidae),Steno bredanensis (Delphinidae),Systematics and Taxonomy,Tursiops truncatus (Delphinidae),Vertebrata,vertebrates,West Indies (Neotropical region),Ziphiidae: Cetacea,Ziphius cavirostris (Ziphiidae)},
