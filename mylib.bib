@article{Butterworth1987a,
  title = {A Note on Relating Antarctic Krill Catch-per-Unit-Effort Measures to Abundance Trends},
  author = {Butterworth, D S and Milller, D G M},
  year = {1987},
  volume = {17},
  pages = {112--116},
  abstract = {A crude mathematical framework is developed to describe krill abundance in terms of selected parameters of various aggregation behaviours exhibited by the Antarctic krill (Euphausia superba Dana). The relationship of combinations of these parameters to various possible measures of catch-per-unit-effort (CPUE) for the Antarctic krill fishery is considered. The combined index of catch-per-hour (CPH) of trawling multiplied by the inverse of the average interconcentration search time (1ST) is suggested as a possible measure of krill abundance; such an index should be stratified both spatially and by krill aggregation type .sbd. this has implications for routine data collection. Models should be constructed to investigate how substantial the non-linearities in the relationship between the index and krill abundance might be.},
  journal = {South African Journal of Antarctic Research},
  keywords = {*Behavioral Biology/Animal Behavior [07003],*Ecology,*Invertebrata,*Mathematical Biology and Statistical Methods [045,*Methods,8800,Animals. Invertebrates. Arthropods. Crustaceans.,Comparative and Experimental Morpho,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Euphausia-Superba Aggregation Behavior Fishery Ind,General/Field M,Malacostraca [75112],Materials and Apparatus},
