@article{Weimerskirch2000,
  title = {Fast and Fuel Efficient? {{Optimal}} Use of Wind by Flying Albatrosses},
  author = {Weimerskirch, H and Guionnet, T and Martin, J and Shaffer, S A and Costa, D P},
  year = {2000},
  volume = {267},
  pages = {1869--1874},
  abstract = {The influence of wind patterns on behaviour and effort of free-ranging male wandering albatrosses (Diomedea exulans) was studied with miniaturized external heart-rate recorders in conjunction with satellite transmitters and activity recorders. Heart rate was used as an instantaneous index of energy expenditure. When cruising with favourable tail or side winds, wandering albatrosses can achieve high flight speeds while expending little more energy than birds resting on land. In contrast, heart rate increases concomitantly with increasing head winds, and flight speeds decrease. Our results show that effort is greatest when albatrosses take off from or land on the water. On a larger scale, we show that in order for birds to have the highest probability of experiencing favourable winds, wandering albatrosses use predictable weather systems to engage in a stereotypical flight pattern of large looping tracks. When heading north, albatrosses fly in anticlockwise loops, and to the south, movements are in a clockwise direction. Thus, the capacity to integrate instantaneous eco-physiological measures with records of large-scale flight and wind patterns allows us to understand better the complex interplay between the evolution of morphological, physiological and behavioural adaptations of albatrosses in the windiest place on earth. [References: 32] 32},
  journal = {Proceedings of the Royal Society of London - Series B: Biological Sciences},
  keywords = {.,2000 week 44,Black-browed albatrosses. Wandering albatrosses. E,Cost.,Experimental Biology in Current Contents(R)/Life S,F-79360 Villiers En Bois,France,Metabolic rates. Flight. Patterns. Energetics. Mig,Reprint available from: Weimerskirch H. Ctr Etud B},
  number = {1455}
}

