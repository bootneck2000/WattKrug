@article{Hochachka1992,
  title = {Metabolic Biochemistry and the Making of a Mesopelagic Mammal},
  author = {Hochachka, P W},
  year = {1992},
  volume = {48},
  pages = {570--575},
  abstract = {Large seals such as northern and southern elephant seals and Weddell seals are able to dive for startling duration and enormous depth. The current dive duration record is 120 minutes (recorded for the southern elephant seal); the current depth record is 1.5 km (recorded for the northern elephant seal). Equally striking is the widespread observation that these seals when at sea spend close to 90\% of the time submerged and often at great depth. For practical purposes, these species can be viewed as true mesopelagic animals when they are at sea. A review of current knowledge indicates that low power output but high efficiency metabolic functions of skeletal muscles coupled with inherently low (and potentially further suppressible) metabolic rates constitute strategic biochemical components in the 'making' of a mesopelagic mammal.},
  journal = {Experientia (Basel)},
  keywords = {*Comparative Biochemistry,*Ecology,*Metabolism/Energy and Respiratory Metabolism [130,*Muscle/Physiology and Biochemistry [17504],*Physiology,4930,9200,Animals. Chordates. Vertebrates. Nonhuman Vertebra,diving,Environmental Biology/Animal [07508],General [10010],General and Miscellaneous/Comparative,General and Miscellaneous/Exercise an,General and Miscellaneous/General [12,heart rate,Leptonychotes weddellii,metabolism,Mirounga angustirostris,Mirounga leonina,Movement (1971- ) [12100],Phocidae [86185],Review Elephant Seal Weddell Seal Diving Skeletal},
  mendeley-tags = {4930},
  number = {6}
}

@article{Hochachka1993,
  title = {Phocid and Cetacean Blueprints of Muscle Metabolism.},
  author = {Hochachka, P W and Foreman, R A I I I and Hochacka, P W and Foreman, R A I I I and Hochachka, P W and {Foreman R A III}},
  year = {1993},
  volume = {71},
  pages = {2089--2098},
  abstract = {Large seals, such as northern and southern elephant seals and Weddell seals, are able to dive for unexpected lengths of time and to enormous depth. The current dive-duration record is 120 min (recorded for the southern elephant seal); the current depth record is 1.5 km (recorded for the northern elephant seal). Equally striking is the widespread observation that these seals, when at sea, spend close to 90\% of the time submerged and often at great depth. For practical purposes, these species can be viewed as true mesopelagic animals when they are at sea. Analysis of current knowledge indicates that enzyme adaptations in chronic hypobaric hypoxia are directed mainly towards up-regulation of metabolic efficiencies. Evidence that similar metabolic adjustments are utilized by seals was obtained by profiling the maximum enzyme activities of four phocid species (harbor seal, Weddell seal, crabeater seal, leopard seal) and one cetacean (fin whale). In the seals, the patterns obtained were strikingly similar to those of hypobaric hypoxia adaptations. The extensive enzyme data obtained on seals, however, showed notably different patterns from those found in whale muscles. The data from the large seals were consistent with the concept that low power output but high-efficiency metabolic functions of skeletal muscles coupled with inherently low (and potentially further suppressible) metabolic rates constitute strategic biochemical components in the design of a mesopelagic mammal.},
  journal = {Canadian Journal of Zoology},
  keywords = {4755,animals. cetaceans. chordates. mammals. nonhuman m,Balaenoptera physalus,Behavior. Ecology (Environmental Sciences). Marine,Behavioral Biology/Animal Behavior [07003],Biochemical Studies/Proteins,Cetacea - Unspecified: Cetacea,Cetacea (Cetacea - Unspecified). Delphinidae (Delp,Cetacea-Unspecified [85800],Delphinidae [85815],Depth Record. Dive Duration Record. Mesopelagial.,diving,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Enzymes/Physiological Studies [10808],Hydrurga leptonyx,Leptonychotes weddellii,Lobodon carcinophagus,Mammalia,Metabolic Pathways [13002],metabolism,Metabolism/General Metabolism,Muscle/Physiology and Biochemistry [17504],muscles,myoglobin,Peptides and Amino A,physiology,seals,Vertebra},
