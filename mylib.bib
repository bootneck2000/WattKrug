@article{Harzen1998,
  title = {Habitat Use by the Bottlenose Dolphin ({{Tursiops}} Truncatus) in the {{Sado}} Estuary, {{Portugal}}},
  author = {Harzen, Stefan},
  year = {1998},
  volume = {24},
  pages = {117--128},
  abstract = {The habitat use of bottlenose dolphins (Tursiops truncatus) in the Sado estuary, Portugal (38degree29'N, 08degree55'W) was studied throughout two periods (June to August 1986-87; May to December 1992-93). Land and boat based observations were conducted, and theodolite tracking and compass triangulation employed, to determine the position of the animals within the study area. Seven ecologically distinct areas, including open ocean, shallow coastal waters, channel areas and shallow waters inside the estuary, were surveyed in this study. Differences were attributed to water depth, water temperature, currents, abundance of prey and levels of pollution (agricultural, industrial and urban waste water runoffs). The dolphins appear to come into the Sado estuary most often during the morning hours and with flood tide, swimming inward through the southern canal zone and foraging with the current. They may remain in this sub-area or extend their distribution to other sub-areas during morning hours. In the early afternoon. the animals can be frequently observed in either the southern canal zone, the ship channel or the outside shallows, foraging, traveling or exhibiting non-directional movement. With the beginning of ebb tide, and through the hours of late afternoon, the dolphins gradually move towards the ship channel and the outside shallows, moving progressively downstream and eventually leaving the study area. During this slow exodus, the animals continue to forage, participate in social interaction or non-directional movements.},
  journal = {Aquatic Mammals},
  number = {3}
}

@article{Hasan2002,
  title = {{Comparison of in vitro androgenetic response and F-1 yield performance in wheat (Triticum aestivum L.)}},
  author = {Hasan, M S and Pauk, J and Jankulosky, L and Gyuris, K and Kertesz, C S and Banhidy, J and Meszaros, A and {Toth-Lokos}, K and Falusi, J and Petroczi, I and Kertesz, Z},
  year = {2002},
  volume = {51},
  pages = {125--132},
  abstract = {In vitro androgenesis is an efficient system for producing homozygotic plants in one step. So homozygotes and homogeneous lines can be produced from one generation to the next. By means of this method the selection period can be reduced by 3-5 years. Up to this point several publications have appeared dealing with the agronomic value of the doubled haploid lines and varieties produced. Only a little information is available about the breeding value of the doubled haploid lines, their behaviour in hybrid combinations and their W, ability to improve the agronomic value of their progenies. A specially important question is whether they can be improved for in vitro reactions by breeding. To answer this question the genetic control of in vitro reactions should be clarified. After solving the critical methodological problems (genotype dependence, haploid induction, plant regeneration, chromosome doubling and R-o plant growing) involved in in vitro androgenesis, it is essential to examine in an accurate way the genetic control of these in vitro traits. This type of work will be important in the future, too, at higher and higher levels. In a special series of experiments 9 Hungarian wheat cultivars and their F-1 progenies were tested for per se performance, for general combining ability effects on embryo-like-structure (ELS) production in anther culture and for yield performance. Significant differences were found between the parents in respect to the production of ELS. No significant correlation was found between the in vitro reactions of the parents and their yield performance. When analysing the F-1 hybrids the Mura x Zugoly hybrid was found to produce the largest heterosis effects and the best per se performance. Valuable combinations were the following: Elet x Kalasz, Pinka x Kalasz, Favorit x Kalasz and Zugoly x Favorit. On the basis of heterosis and general combining ability Kalasz, Zugoly, Favorit and Mura proved to be the most valuable parents. Very similar tendencies were found for gain yield. Here the best combination was Mura x Zugoly. The rank of the parents for combining ability was the same as that found form vitro reactions. The general conclusion can be drawn that parents with good combining ability for in vitro reactions may be good combiners for grain yield as well. Breeders and geneticists should concentrate on putting together the two important characteristics in one line or variety. In the present experiment it was confirmed that these goals can be achieved. Hybrid grain yield and in vitro androgenesis are genetically independent traits, but in the present experiment both of them showed similar genetic control. This is probably due to a hybrid effect. It can be seen in this experiment that ELS formation is controlled mostly by additive gene effects.},
  isbn = {0546-8191},
  journal = {Novenytermeles},
  keywords = {ANTHER CULTURE,CROSSES,IN-VITRO,LINES,PLANTS,SINGLE SEED DESCENT},
  language = {Hungarian},
  number = {1}
}

@article{Hashimoto1431,
  title = {Promoting Effect of Urea and Ph on Thermal Denaturation of Myofibrillar Protein from Shark},
  author = {Hashimoto, K and Nishikiori, T and Arai, K I},
  year = {1431},
  volume = {50},
  pages = {1431--1438},
  abstract = {The myofibril suspension (in 0.16 M KCl-40 mM Tris-HCl, pH 7.5 or 0.16 M KCl-40 mM Trismaleate, pH 5.8) of blue shark and tiger shark was kept at a fixed temperature in the range of 20-45.degree. C with various concentrations of urea and measured for its Ca-ATPase activity with a lapse of time. In the presence of urea, myofibrillar Ca-ATPase of blue shark inactivated in 2 first order reactions with an early fast rate (kDf) and subsequently with a slow rate (kDa), whereas the inactivation of myofibrillar Ca-ATPase of tiger shark fitted by a single exponential with a rate of kD. Plotting the logarithm of rate constant against the concentration (M) of urea, a linear relation was thus obtained. The slope (D) of the graph of logarithm of rate constant vs. urea (M) indicated that myofibrillar protein of blue shark was more susceptible to urea than that of tiger shark. By introducing an increase in the rate constant as a measure of accelerating effect on denaturation of myofibrillar protein, multiplying effect by the presence of urea (0.3 M), the fall in pH (from 7.5 to 5.8) and an increase in temperature was observed for both shark species.},
  journal = {Nippon Suisan Gakkaishi},
  number = {8}
}

@incollection{Hass2010,
  title = {Climate Fluctuations during the Past Two Millennia as Recorded in Sediments from {{Maxwell Bay}}, {{South Shetland Islands}}, {{West Antarctica}}},
  booktitle = {Geological Society Special Publication},
  author = {Hass, H. C. and Kuhn, G. and Monien, P. and Brumsack, H. J. and Forwick, M.},
  editor = {Howe, J A and Austin, W E N and Forwick, M and Paetzel, M},
  year = {2010},
  volume = {344},
  pages = {243--260},
  publisher = {{Geological Society of London}},
  address = {{London}},
  issn = {03058719},
  doi = {10.1144/SP344.17},
  abstract = {The climate evolution of the South Shetland Islands during the last c. 2000 years is inferred from the multiproxy analyses of a long (928 cm) sediment core retrieved from Maxwell Bay off King George Island. The vertical sediment flux at the core location is controlled by summer melting processes that cause sediment-laden meltwater plumes to form. These leave a characteristic signature in the sediments of NE Maxwell Bay. We use this signature to distinguish summer and winter-dominated periods. During the Medieval Warm Period, sediments are generally finer which indicates summer-type conditions. In contrast, during the Little Ice Age (LIA) sediments are generally coarser and are indicative of winter-dominated conditions. Comparison with Northern and Southern Hemisphere, Antarctic, and global temperature reconstructions reveals that the mean grain-size curve from Maxwell Bay closely resembles the curve of the global temperature reconstruction. We show that the medieval warming occurred earlier in the Southern than in the Northern Hemisphere, which might indicate that the warming was driven by processes occurring in the south. The beginning of the LIA appears to be almost synchronous in both hemispheres. The warming after the LIA closely resembles the Northern Hemisphere record which might indicate this phase of cooling was driven by processes occurring in the north. Although the recent rapid regional warming is clearly visible, the Maxwell Bay record does not show the dominance of summer-type sediments until the 1970s. Continued warming in this area will likely affect the marine ecosystem through meltwater induced turbidity of the surface waters as well as an extension of the vegetation period due to the predicted decrease of sea ice in this area. \textcopyright{} The Geological Society of London 2010.}
}

