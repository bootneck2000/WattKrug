@article{Boness1979a,
  title = {Reproductive Behavior of the Gray Seal Halichoerus-Grypus on Sable Island Nova-Scotia Canada},
  author = {Boness, D J and James, H},
  year = {1979},
  volume = {188},
  pages = {477--500},
  abstract = {An unusual mating system observed in a land-breeding colony of gray seal, H. grypus, in the western Atlantic is described. Males and females begin visiting the breeding beach about a week before the season begins, but none stay ashore for long until the 1st pup is born. The cows are gregarious, probably return to the same part of the beach to give birth from one year to the next, and tend to remain in the general birth site vicinity during their two and a half week sojourn ashore. Within these limits, they are quite mobile, and the size, location and composition of the temporary aggregations which they form vary. The cows become thinner and more sedentary as estrus approaches, but otherwise they give no overt receptivity signs. The males do not defend territories, nor do they dominance hierarchies. Instead, they compete for tenure, the right to remain within the shifting female population. Tenured bulls directly test receptivity of nearby cows, and continually maneuver in ways which maximize chances of being next to cows which are either in estrus or likely to become so in the near future. Bulls falling to establish themselves among females try to intercept cows leaving for the sea at the end of their season, but their estimated reproductive success is significantly lower than that of bulls with tenure. The system would be adaptive for seals which breed on pack ice, but it is unique among land-breeding pinnipeds. If, as some circumstantial evidence suggests, gray seals were originally pack-ice breeders, persistence of such a system in a land-breeding colony raises interesting questions about the plasticity of mating behavior.},
  journal = {Journal of Zoology},
  keywords = {[07003] Behavioral biology - Animal behavior,[07200] Circadian rhythms and other periodic cycle,[07504] Ecology: environmental biology - Bioclimat,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[07517] Ecology: environmental biology - Water res,[12003] Physiology - Comparative,[12100] Movement,[16501] Reproductive system - General and methods,[16504] Reproductive system - Physiology and bioch,[21001] Psychiatry - General,[25000] Pediatrics,[62520] Chordata: general and systematic - Mammali,[86170] Pinnipedia,[86185] Phocidae,Behavior,Chordata,Chordates,Ecology: Environmental Sciences,Environmental Sciences,Mammalia,Mammals,Marine Ecology: Ecology,medical psychology a,Nonhuman,Nonhuman Ve,Phocidae: Animals,pinniped tenure estrus mobility,Pinnipedia,Pinnipedia: Animals,Reproductive System: Reproduction,Systematics and Taxonomy,Vertebrata},
  number = {4}
}

