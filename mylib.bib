@article{Jardine2005a,
  title = {Analytical Error in Stable Isotope Ecology},
  author = {Jardine, Timothy D. and Cunjak, Richard A.},
  year = {2005},
  month = aug,
  volume = {144},
  pages = {528--533},
  issn = {00298549},
  doi = {10.1007/s00442-005-0013-8},
  abstract = {The increasing popularity of stable isotope analysis (SIA) as an ecological research tool and the ease of automated analysis have created a knowledge gap between ecologists using SIA and the operators of isotope ratio mass spectrometry (IRMS) equipment. This has led to deterioration in the understanding of IRMS methodology and its proper dissemination in the ecological literature. Of 330 ecological research papers surveyed, 63 (19\%) failed to report any form of analytical error associated with IRMS. Of the 267 papers that reported analytical error, there was considerable variation both in the terminology and approach used to quantify and describe error. Internal laboratory standards were often used to determine the analytical error associated with IRMS, so chosen because they are homogenous and have isotopic signatures that do not vary over time. We argue that true ecological samples collected in the field are complex bulk mixtures and often fail to adhere to these two criteria. Hence the analytical error associated with samples is potentially greater than that of standards. A set of standard data run over time with a precision typically reported in the ecological literature (1 standard deviation: 1SD = 0.26 per thousand) was simulated to determine the likelihood of spurious treatment effects depending on timing of analysis. There was a 90\% likelihood of detecting a significant difference in the stable nitrogen ratio of a single sample (homogenized bovine liver) run in two time periods when n \textquestiondown{} 30. Minor protocol adjustments, including the submission of blind replicates by researchers, random assignment of sample repeats within a run by analytical labs, and reporting 1SD of a single sample analyzed both within and between runs, will only serve to strengthen the interpretation of true ecological processes by both researchers and reviewers.},
  isbn = {0029-8549},
  journal = {Oecologia},
  keywords = {accuracy,Accuracy,analytical labs,Analytical labs,BROOK TROUT,CARBON ISOTOPES,DELTA-C-13,FOOD WEBS,IRMS,MASS-SPECTROMETRY,NITROGEN ISOTOPES,ORGANIC-MATTER,PACIFIC,precision,Precision,REFERENCE SAMPLES,SALMON,standards,Standards,TROPHIC INTERACTIONS},
  language = {English},
  number = {4},
  pmid = {15761780}
}

@article{Jardine2008,
  title = {An Elemental and Stable Isotope Assessment of Water Strider Feeding Ecology and Lipid Dynamics: Synthesis of Laboratory and Field Studies},
  author = {Jardine, T D and Kidd, K A and Polhemus, J T and Cunjak, R A},
  year = {2008},
  volume = {53},
  pages = {2192--2205},
  doi = {10.1111/j.1365-2427.2008.02044.x},
  abstract = {Despite the ubiquity and abundance of water striders (Hemiptera: Gerridae) in temperate streams and rivers and their potential usefulness as sentinels in contaminant studies, little is known about their feeding ecology and lipid dynamics. In this study we used stable isotopes of carbon (delta C-13) and nitrogen (delta N-15) and elemental carbon to nitrogen ratios (C/N) to assess dietary habits and lipid content, respectively, for water striders. To determine diet-tissue fractionation factors, nymphs of the most common species in New Brunswick, Canada, Aquarius remigis were reared in the laboratory for 73 days and exhibited rapid isotopic turnover in response to a switch in diet (C half-life = 1.5 days, N half-life = 7.8 days). Their lipid content increased towards the end of the growing season and resulted in lower delta C-13 values. Diet-tissue fractionation factors were established after correction of delta C-13 data for the confounding effect of de novo lipid synthesis (strider delta C-13(adj)- diet delta C-13(adj) = 0.1 parts per thousand, strider delta N-15 - diet delta N-15 = 2.7 parts per thousand). Water striders from the majority of 45 stream sites (83\%) in New Brunswick had less than 50\% contribution of aquatic carbon to their diets but showed a gradual increase in the contribution of this carbon source to their diet with increasing stream size. These data indicate that striders exhibit a strong connection to terrestrial carbon sources, making them important users of energy subsidies to streams from the surrounding catchment. However, this dependence on terrestrial organic matter may limit their utility as indicators of contamination of aquatic systems by heavy metals and other pollutants.},
  isbn = {0046-5070},
  journal = {Freshwater Biology},
  keywords = {Aquarius remigis,C,CARBON ISOTOPES,DELTA-C-13 VALUES,diet-tissue fractionation,ENERGY-SOURCES,GERRIDAE,N,NITROGEN,organic matter,PELAGIC FOOD WEBS,REMIGIS SAY HETEROPTERA,stable isotopes,STREAM,streams,TEMPORAL VARIATION,TISSUES},
  language = {English},
  number = {11}
}

