@article{Goodall1997,
  title = {Review and Update on the Biology of {{Peale}}'s Dolphins, {{Lagenorhynchus}} Australis},
  author = {Goodall, R Natalie P and Norris, Kenneth S and Schevill, William E and Fraga, Fabio and Praderi, Ricardo and Iniguez Jr., Miguel A and De Haro, J Cristian},
  year = {1997},
  volume = {0},
  pages = {777--796},
  abstract = {Peale's dolphin (Lagenorhynchus australis) is the cetacean species most often seen off certain parts of southernmost South America, yet very little has been published about its basic biology. Through a review of the literature and recent studies, we have compiled a list of all the published and new specimens known of this species. Known distribution is from 32degree55'S off Concon, Chile southward to about 59degree south of Cape Horn and up the east coast of South America to Miramar, Provincia de Buenos Aires, at 33degree17'S. These are the exceptional ranges; the more normal range may be to just north of Valdivia (about 38degreeS) on the west coast and Golfo San Jorge (44degreeS) on the east. Peale's dolphins can be confused with dusky dolphins L. obscurus through much of this range. On both coasts there are two kinds of habitats; the channel/fjord regions of the south and west, and the open coasts farther north. Although Peale's dolphins are commonly seen, there is no information on abundance, stocks, or population size. Thirty-five specimens of known total length ranged from a foetus or neonate of 98cm to a maximum of 218cm. Females, apart from the neonate, ranged from 130-210 cm (n = 20), males from 138-218cm (n = 9). Five animals of unknown sex ranged from 172-213cm. The oldest animal to date was a physically mature female with 13 GLGs. Weights are available for five animals; the heaviest was 115kg. A female of 185cm was sexually immature, one of 193cm was pubescent and one of 210cm was mature. There is no information on sexual maturity in males. Females of 192 and 199cm were physically mature, but three animals of 201-210cm were not. Two juveniles of 130 and 138cm still had the neural spines unfused to the centra. A male of 187cm was still very immature; there were no physically mature males. An animal of unknown sex was mature at 190cm. There are up to 37 teeth in each upper jaw and 34 in the lower; the number of teeth is variable. The mouth is unusual in having a wide lip beyond the tooth line. Vertebrae number is 66-70, the most common being 67-68. Pigmentation is as described in the literature, with variations in the lateral patches, the dark pigmentation of the chin-throat region and the genital region. Some animals have lighter areas over the eyes and a light dorsal mid-line. The dorsal fins and flippers of some Peale's dolphins have a lighter posterior edge, as in dusky dolphins. Young animals are lighter grey than adults. Young are born from spring to autumn, October to March or April. The parasite fauna of this species is still under study, but Anisakis simplex was present in three females. Exploitation of this species for crab bait in the southern part of its range was extensive in the 1980s but crab fishing effort has lessened through the over-exploitation of crabs, alternative bait is more available and change from crab fishing to that of sea urchins. Offshore fishing represents a potential danger that should be monitored.},
  journal = {Report of the International Whaling Commission},
  number = {47}
}

@article{Goodall1997a,
  title = {Sightings and Behaviour of {{Peale}}'s Dolphins, {{Lagenorhynchus}} Australis, with Notes on Dusky Dolphins, {{L}}. Obscurus, off Southernmost {{South America}}},
  author = {Goodall, R Natalie P and De Haro, J Cristian and Fraga, Fabio and Iniguez, Miguel A and Norris, Kenneth S},
  year = {1997},
  volume = {0},
  pages = {757--775},
  abstract = {The Peale's dolphin, Lagenorhynchus australis, has been studied through coastal, shipboard and aerial surveys, as well as through incidental sightings by interested observers. This dolphin is known from the waters off southern South America from about 33degreeS on the Chilean coast to Cape Horn and northward along the Atlantic coast to about 38degreeS, although sightings are rare north of about 44degreeS. The southernmost sighting until recently was at 57degreeS; there is one new sighting at 59degree10'S in the Drake Passage. The highest water temperature recorded was 14.7degreeC. These animals are often seen near the coast, and so are easily observed. They occupy two major habitats: open, wave-washed coasts over shallow continental shelves to the north; and deep, protected bays and channels to the south and west. In the channels, this is an 'entrance animal', associated with the rocky coasts and riptides at the entrance to fjords. Peale's dolphins show a high degree of association with kelp beds (Macrocystis pyrifera), especially in the channel regions. They swim and feed within, inshore and offshore of the kelp forests, using natural channels for movement. The population size of this species is not known although Peale's dolphins are common, especially in the southern part of the range. Group size is normally small, but the largest school size reported was of about 100 animals, broken into smaller groups. The mode of 527 sightings was two per sighting. At least some of the population appears to move offshore in winter, but more observations are needed. Peale's dolphins are noted for the amount of water they 'plough' up when travelling. They are often ponderous and slow while feeding, but can be very active, with much head movement and rolling, breaching, spy-hopping and spinning. Their sounds have been recorded during only one expedition; the animals were remarkably quiet. Peale's dolphins readily approach boats and ships, especially if moving. They swim, often in synchronised formation, with other dolphins, particularly Cephalorhynchus commersonii. They also interact with birds, forcing them to lift off the water. Over much of its range Peale's dolphin is sympatric with the dusky dolphin, L. obscurus, although their usages of habitats are slightly different. These two species are often difficult to differentiate at sea. Dusky dolphins are plentiful north of 43degreeS in the southwestern South Atlantic, but can occasionally be found in waters, especially on the outer coasts, south to 56degreeS. The southernmost confirmed record for the dusky dolphin is at 57degree50'S, south of Cape Horn.},
  journal = {Report of the International Whaling Commission},
  number = {47}
}

@article{Goodall1997b,
  title = {On the Biology of the Hourglass Dolphin, {{Lagenorhynchus}} Cruciger ({{Quoy}} and {{Gaimard}}, 1824)},
  author = {Goodall, R N P and Baker, Alan N and Best, Peter B and Meyer, Michael and Miyazaki, Nobuyuki},
  year = {1997},
  volume = {0},
  pages = {985--999},
  abstract = {The hourglass dolphin, Lagenorhynchus cruciger, has been sighted often in the southern oceans but little is known of the dolphin's biology. Five specimens were collected before 1900 and only six more have been published since then. We present information on a further nine specimens and four stranding observations. The hourglass dolphin is circumpolar in Antarctic and Sub-Antarctic waters of the Southern Hemisphere from about 36degreeS in the South Atlantic, and possibly 33degreeS in the South Pacific, to nearly 68degreeS. Total lengths of nine animals ranged from 142 to 187 cm. The largest female (n = 5) measured 183 cm, the largest male (n = 3) 187 cm. Both of these animals had almost reached physical maturity, while a male of 174 cm was physically mature. The pigmentation pattern (five specimens) varies greatly, especially below the flank patch. A 163.5cm female was sexually immature and the 183cm animal was pubescent. Two males of 174 and 187cm were sexually mature. No hourglass dolphins have been aged. The number of vertebrae ranged from 69-71, possibly 72. The CBL of 11 skulls ranged from 316-370mm. The number of visible teeth was 26-34 upper and 27-35 lower. Organ weights are given. The stomachs of four specimens contained small fish and otoliths, squid of two families and crustaceans. One animal examined had peritonitis. Hourglass dolphins have been deliberately caught only for scientific purposes. At least four animals have been taken incidentally in fishing nets. None have been kept in captivity. Nothing is known about the movements, young, reproduction or longevity of this species.},
  journal = {Report of the International Whaling Commission},
  number = {47}
}

@article{Goodall1997c,
  title = {Review of Sightings of the Hourglass Dolphin, {{Lagenorhynchus}} Cruciger, in the {{South American}} Sector of the {{Antarctic}} and Sub-{{Antarctic}}},
  author = {Goodall, R N P},
  year = {1997},
  volume = {0},
  pages = {1001--1013},
  abstract = {A review of the literature, sightings of IWC/IDCR Minke Whale Assessment Cruises and reported incidental sightings produced at least 185 observations of the hourglass dolphin for the South American sector of the Antarctic and sub-Antarctic, from 20degreeW in the southern South Atlantic to 130'W in the southern South Pacific. The northernmost limits of distribution do not exceed those published in the literature, 33degreeS in the southeastern South Pacific and 36degreeS in the southwestern South Atlantic. The southernmost confirmed sighting was at 67degree38'S in the South Pacific; in the South Atlantic, there were no sightings southeast of the Antarctic Peninsula. The largest concentration of sightings was in the Drake Passage, an area with considerable ship traffic in summer. Sea water temperatures ranged from 0.6degreeC-13degreeC (mean 4.8degree). There were no sightings from May to September, probably a reflection of observer effort. Observers reported variation in the lateral pigmentation and the dorsal fin shape of animals seen at sea. These sightings confirm that hourglass dolphins are quick, active animals, which are attracted to ships and are present around them even in the highest seas. Group size is generally small, usually from 1-16 animals (mean 5.7). Hourglass dolphins are found in the company of most of the other cetaceans inhabiting the region, especially fin whales, and can be spotted in feeding seabird concentrations. Young animals were noted only once. Increased tourist activity from southern South America to the Antarctic Peninsula should produce increased awareness and further sightings of this species.},
  journal = {Report of the International Whaling Commission},
  number = {47}
}

@article{Goodall1998,
  title = {A Note on the Behaviour of Pilot Whales in a {{Beagle Channel Bay}}, {{Tierra}} Del {{Fuego}}},
  author = {Goodall, R Natalie P and Macnie, S V},
  year = {1998},
  volume = {0},
  pages = {559--563},
  abstract = {A pod of about 25 long-finned pilot whales, Globicephala melas, spent the day of 27 October 1984 quietly in a bay off the Beagle Channel in southern Tierra del Fuego, coming very close to shore. Two newborns observed in late afternoon indicate the first documented live birth of this species in the sub-Antarctic. Throughout the day, two large animals actively swam towards each other, possibly aggressively, keeping themselves between the herd and the mouth of the bay. The whales departed before dawn the next day. A freshly dead, 528cm sexually mature but physically immature male which had died from massive haemorrhaging, possibly due to ramming by another pilot whale, was found at the mouth of the bay.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Beagle Channel (South America,Biogeography (Population Studies),Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,General and Systematic Zoology/Mammalia,Globicephala melas [long-finned pilot whale] (Delp,Mammalia,Mammals,Neotropical region),Nonhuman Mammals,Nonhuman Vertebrates,Vertebrata,Vertebrates},
  number = {48}
}

@article{Goodall1998a,
  title = {Sightings of Pilot Whales off {{South America South}} of {{30degreeS}}: {{A}} Review of Data to 1988},
  author = {Goodall, R Natalie P and Macnie, S V},
  year = {1998},
  volume = {0},
  pages = {565--579},
  abstract = {Two species of pilot whale are found in South American waters. The southernmost records of the short-finned pilot whale, Globicephala macrorhynchus, are at about 25degreeS along both east and west coasts. The long-finned pilot whale, G. melas, occurs from the Antarctic northward to at least 25degreeS in the southwest South Atlantic and to about 14degreeS in the southeastern South Pacific. The sightings reported south of 30degreeS, were probably of the latter species. Sightings in the southeastern South Pacific clustered from 30-35degreeS, 72-78degreeW, the maximum being about 160 n.miles from shore. In the southwestern South Atlantic, sightings clustered in two areas, 34-46degreeS and off Tierra del Fuego, 52-56degreeS. Here schools were found up to 1,000 n.miles from shore. Fifteen sightings were from waters south of the Antarctic Convergence, from December to March. School size ranged from 1- \textquestiondown{} 200+ individuals, with about half comprising ltoreq20. Many individuals had both a white post-ocular streak and variable post-dorsal saddle; this white pigmentation may disappear quickly on death, or more slowly on long exposure to air in live animals. Young animals were lighter brown. Young were present in all areas, including the sub-Antarctic, where they were seen in January (summer), March and April (autumn) and October (spring), when a birth occurred, and in the Antarctic in summer, with a birth occurring at South Georgia in March (autumn). Pilot whales were observed in close association with fin, sperm and minke whales, and common, bottlenose, hourglass and possibly dusky dolphins. Only one sighting was made south of 44degreeS in winter, probably due to lack of effort in southern seas during the colder months.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Biogeography (Population Studies),Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,General and Systematic Zoology/Mammalia,Globicephala macrorhynchus [short-finned pilot wha,Globicephala melas [long-finned pilot whale] (Delp,Mammalia,Mammals,Nonhuman Mammals,Nonhuman Vertebrates,South America (Neotropical region),Vertebrata,Vertebrates},
  number = {48}
}

