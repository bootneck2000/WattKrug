  year = {2002},
  volume = {47},
  pages = {579--586},
  abstract = {The humpback whale stock that migrates along the east Australian coast comprises part of the Area V (130degreeE-170degreeW) stock and was monitored by shore-based observations from Point Lookout (27degree26'S, 153degree33'E) during 1978-1999. Devastated by whaling which ceased in 1962, the stock is estimated to be recovering at a rate of 10.9\% per annum (99\% CI+-1\%) and to number 3,600+-440 in 1999. Advantages and limitations of the Point Lookout observation methods are discussed.},
