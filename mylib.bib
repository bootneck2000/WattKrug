@article{Kasuya1997,
  title = {Life History of {{Baird}}'s Beaked Whales off the {{Pacific}} Coast of {{Japan}}},
  author = {Kasuya, Toshio and {Brownell Robert L Jr.} and {Balcomb Kenneth C III}},
  year = {1997},
  volume = {0},
  pages = {969--979},
  abstract = {Life history parameters of Baird's beaked whales were examined using material from the catches off the Pacific coast of Japan in the 1975 and 1985-1988 seasons. Deposition of cemental layers was assumed to be annual, but the counts might bias the true age by -0.5 to +1.5 years due to the timing of birth, deposition of stainable layers and sampling. Males mature at younger age (6-11 vs 10-15 layers) and at smaller body lengths (9.1-9.8 vs 9.8-10.7m) than females. Both sexes cease growing soon after sexual maturation (\textexclamdown{} ca 15 layers). Males have lower natural mortality rates, and live longer than females (84 vs 54 layers). The proportion of females is about equal to or greater than that of males at ages \textexclamdown{} 10 layers, but it decreases with increasing age until 54 layers, when it reaches zero. The female proportion among sexually mature individuals is about 23\% due to later maturation and shorter longevity of females. The apparent pregnancy rate (30\%) and annual ovulation rate (0.47/year) do not change with increasing age, and this appears to reject the possibility of a significant post-reproductive life for females. These life history parameters differ from those commonly found among polygynous cetaceans, and further information on their social structure is needed to understand the male's role in the community.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals,Berardius-bairdii [Baird's beaked whale] (Ziphiida,Cetaceans,Chordata,Chordates,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Japan (Palearctic region),Mammalia,Mammals,Methods [16501],Nonhuman Mammals,Nonhuman Vertebrates,Reproductive System/General,Resource Management,Vertebrata,Vertebrates,Wildlife Management (Conservation),Ziphiidae [85840],Ziphiidae: Cetacea},
  number = {47}
}

@article{Kasuya1997a,
  title = {A Note on the Chemical Composition of Milk and Stomach Contents of {{Baird}}'s Beaked Whales ({{Berardius}} Bairdii) and a Minke Whale ({{Balaenoptera}} Acutorostrata)},
  author = {Kasuya, Toshio and Kato, Hidehiro and Dosako, Shun-Ichi},
  year = {1997},
  volume = {0},
  pages = {981--984},
  abstract = {This paper examines the possibility of identifying whether Baird's beaked whale calves are suckling by analysing fluid samples from stomach contents (n = 4) and milk (n = 4). Samples from a North Pacific minke whale were used as a control. Although one minke whale (4.1 m; \textexclamdown{} 0.5 year) had been identified as suckling both visually and by lactose analysis, none of the stomach fluid samples of the Baird's beaked whale calves (aged at 3-6 tooth layers) were identified as suckling either visually or by lactose, and none of the milk samples contained detectable level of lactose. Thus it is not possible to determine whether or not the Baird's beaked whale calves were suckling prior to death or whether the milk they consumed contained detectable levels of lactose. Control data are required before using similarities of fatty acid and amino acid compositions between milk of Baird's beaked whale and stomach fluid of their calves for identification of presence of suckling. Investigation of additional key elements of milk to enable identification of suckling is greatly needed.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals,Balaenoptera-acutorostrata [minke whale] (Balaenop,Balaenopteridae [85810],Balaenopteridae: Cetacea,Behavior,Behavioral Biology/Animal Behavior [07003],Berardius-bairdii [Baird's beaked whale] (Ziphiida,Cetaceans,Ch,Chordata,Chordates,Digestive System/General,Ecology,Environmental Biology/Wildlife Management-Aquatic,Mammalia,Mammals,Methods [14001],Nonhuman Mammals,Nonhuman Vertebrates,Physiology,Vertebrata,Vertebrates,Ziphiidae: Cetacea},
  number = {47}
}

@article{Kasuya1997b,
  title = {Distribution of Baird's Beaked Whales off Japan},
  author = {Kasuya, Toshio and Miyashita, Tomio},
  year = {1997},
  volume = {0},
  pages = {963--968},
  abstract = {Records of 320 Baird's beaked whale schools sighted during whale sighting cruises covering 11 months of the year for the years 1982-1994 are presented to update current information on the seasonal distribution of the species in the waters adjacent to Japan. The species is not found in the East China Sea, Yellow Sea and western North Pacific south of 34degreeN but is present in the Sea of Japan, Okhotsk Sea and the southern Kuril Islands area throughout the year. They appear in May along the Pacific coast of Japan, increase in density during summer on the continental slope (1,000-3,000m depth) and north of 34degreeN and apparently leave in December, although there has been little sighting effort in December-April in their coastal summering ground. They are not confirmed in the deeper offshore waters in any season of the year and their wintering ground is still unknown. There is no evidence to alter the three stocks hypothesis previously proposed for the species off Japan, i.e. Sea of Japan, Pacific coast and Okhotsk Sea stocks, but there is a possibility that some individuals from the latter stock may migrate (at least seasonally) off the Pacific coast of eastern Hokkaido, northern Japan.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals,Berardius-bairdii [Baird's beaked whale] (Ziphiida,Cetaceans,Chordata,Chordates,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Japan (Palearctic region),Mammalia,Mammals,Nonhuman Mammals,Nonhuman Vertebrates,Resource Management,Vertebrata,Vertebrates,Wildlife Management (Conservation),Ziphiidae [85840],Ziphiidae: Cetacea},
  number = {47}
}

