@article{Riget2007,
  title = {Transfer of Mercury in the Marine Food Web of {{West Greenland}}},
  author = {Riget, F and M{\o}ller, P and Dietz, R and Nielsen, T G and Asmund, G and Strand, J and Larsen, M M and Hobson, K A and Moller, P and Dietz, R and Nielsen, T G and Asmund, G and Strand, J and Larsen, M M and Hobson, K A},
  year = {2007},
  volume = {9},
  pages = {877--883},
  doi = {10.1039/b704796g},
  abstract = {Total mercury (THg), methylmercury (MeHg) and stable isotopes of nitrogen (delta N-15) and carbon (delta C-13) were measured in three invertebrate, five fish, three seabird and three marine mammal species of central West Greenland to investigate trophic transfer of mercury in this Arctic marine food web. The food web magnification factor (FWMF) estimated as the slope of the regression between the natural logarithm of THg or MeHg concentrations (mg kg(-1) dw) and tissue delta N-15 (parts per thousand) was estimated to 0.183 (SE = 0.052) for THg and 0.339 (SE = 0.075) for MeHg. The FWMFs were not only comparable with those reported for other Arctic marine food webs but also with quite different food webs such as freshwater lakes in the sub-Arctic, East Africa and Papua New Guinea. This suggests similar mechanisms of mercury assimilation and isotopic (delta N-15) discrimination among a broad range of aquatic taxa and underlines the possibility of broad ecosystem comparisons using the combined contaminant and stable isotope approach.},
  isbn = {1464-0325},
  journal = {Journal of Environmental Monitoring},
  keywords = {10135,BAFFIN-BAY,BIOMAGNIFICATION,CARBON,DELTA-N-15,diet,ISOTOPES,LAKE,NORTHWATER POLYNYA,Odobenus rosmarus,Phoca hispida,pollution,SEALS PHOCA-HISPIDA,SELENIUM,stable isotopes,TROPHIC RELATIONSHIPS,WATER POLYNYA},
  language = {English},
  mendeley-tags = {10135},
  number = {8}
}

@article{Riget2007a,
  title = {Temporal Trends of Mercury in Marine Biota of West and Northwest {{Greenland}}},
  author = {Riget, F and Dietz, R and Born, E W and Sonne, C and Hobson, K A},
  year = {2007},
  volume = {54},
  pages = {72--80},
  doi = {10.1016/j.marpolbul.2006.08.046},
  abstract = {Temporal trends in mercury concentrations ([Hg]) during the last two to three decades were determined in liver of shorthorn sculpin, ringed seal and Atlantic walrus from northwest Greenland (NWG, 77 degrees N) and in liver of shorthorn sculpin and ringed seal from central west Greenland (CWG, 69 degrees N) during the last decade. Stable-nitrogen (delta N-15) and carbon (delta C-13) isotope values were determined in muscle of ringed seals to provide insight into potential trophic level changes through time. Log-linear regressions on annual median [Hg] did not reveal any temporal trend in shorthorn sculpin from CWG and NWG and walrus from NWG. In ringed seals from NWG, an increase in [Hg] of 7.8\% per year was observed. When based on delta N-15-adjusted [Hg] this rate increased to 8.5\% but was still non-significant. In ringed seal from CWG no trend was found in [Hg] during the period 1994-2004. However, during the last part of the period (1999-2004) the [Hg] increased significantly. Including tissue delta N-15 values as a covariate had a marked effect on these results. The annual changes in delta N-15-adjusted [Hg] was estimated to -5.0\% for the whole period and 2.2\% during the last 5 years compared to -1.3\% and 12.4\%, respectively, for the non-adjusted [Hg]. (c) 2006 Elsevier Ltd. All rights reserved.},
  isbn = {0025-326X},
  journal = {Marine Pollution Bulletin},
  keywords = {9892,AMAP PROGRAM,BAFFIN-BAY,CONTAMINANT RESIDUES,diet,FOOD-WEB,Greenland,ISOTOPES,marine biota,mercury,nitrogen delta N-15,Odobenus rosmarus,ODOBENUS-ROSMARUS-ROSMARUS,Phoca hispida,pollution,QUALITY-ASSURANCE,RELATIONSHIPS,SEABIRD EGGS,SEALS PHOCA-HISPIDA,STABLE,stable isotopes,temporal trend,TROPHIC},
  language = {English},
