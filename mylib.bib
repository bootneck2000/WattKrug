@article{Nishiwaki1977,
  title = {Human Activities Disturbing Natural Migration Routes of Whales},
  author = {Nishiwaki, M and Sasao, A},
  year = {1977},
  pages = {113--120},
  abstract = {Human activities which disturbed natural migration routes of 2 whale populations were investigated. In Tokyo Bay [Japan] the annual catch of the Baird's beaked whale (Berardius bairdii) in the Boso whaling grounds is between 50-300. Although the whales showed no signs of average body length decrease, an apparent decrease of whales despite increasing catch per unit effort indicates that the maritime transportation has disturbed the migration routes of these whales. This also occurs on the northern coast of Kyushyu. The reason for the catch decline cannot be damage by whaling as in the minke whale (Balaenoptera acutorostrata). Catch per unit effect is, as a whole, increasing, but the number of whales caught is decreasing without average body length decrease. Great numbers of vessels are coming into and groing out of both areas, and the number is still increasing. Not only these whales, but also various species of marine mammals may be troubled by the buy traffic. Warnings about the activities by man which disturb or expel wild animals from their natural habitats and migration routes are suggested.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo.(29)}
}

@article{Nishiwaki1979,
  title = {Present Distribution of the Dugong Dugong-Dugon in the World},
  author = {Nishiwaki, M and Kasuya, T and Miyazaki, N and Tobayama, T and Kataoka, T},
  year = {1979},
  pages = {133--141},
  abstract = {Surveys on dugong distribution during the past 10 yr are reported. The species is distributed widely in the Indo-Pacific Ocean, between longitude 30.degree.E and 170.degree.E and between latitude of 30.degree.N and 30.degree.S. Although nothing is known on movement and seasonal migration of the species, discontinuity of distribution or of density suggests the presence of at least 5 populations. They are east Australian and east Papua New Guinean group, west Australia-Molucca-Philippine group, Sumatura-Malaysia-Andaman group, Indo-Sri Lanka group and east African and Madagascar group. Their range might have been continuous before depletion by human activities, and the first 3 populations may still be continuous dispersely. The 4th and 5th group may be on the verge of extinction. A total population of 30,000 individuals is estimated.},
