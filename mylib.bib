@article{Gunn1999,
  title = {Observations on the Short-Term Movements and Behaviour of Whale Sharks ({{Rhincodon}} Typus) at {{Ningaloo Reef}}, {{Western Australia}}},
  author = {Gunn, J S and Stevens, J D and Davis, T L O and Norman, B M and Gunn Stevens,JD, Davis TLO, Norman BM, J S},
  year = {1999},
  volume = {135},
  pages = {553--559},
  abstract = {The short-term movements and behaviour of whale sharks (Rhincodon typus Smith, 1828) during March 1994 and April 1997 are reported from data collected by acoustic tracking and archival tags at Ningaloo Reef on the north west coast of Western Australia. Sharks were tracked for up to 26 h and generally swam slowly at simeq0.7 m s-1 parallel to the reef edge; occasionally they swam in a wide arc adjacent to passes in the reef. All tracked sharks made regular dives through the water column, mostly from the surface to near the bottom. These dives did not appear to be related to hydrographic features, and the sharks were probably searching the water column for food. Most sharks were accompanied by other fishes, usually the golden trevally Gnathanodon speciosus.},
  journal = {Marine Biology},
  keywords = {Anim,Animals. Chordates. Fish. Nonhuman Vertebrates. Ve,Austr,Australia,behavior. hydrographic features. reef edge: habita,Behavior. Marine Ecology (Ecology,Behavioral Biology/Animal Behavior [07003],Chondrichthyes [85202],Chondrichthyes: Pisces,Chordata,Ecology,Environmental Biology/General,Environmental S,Gnathanodon speciosus (Osteichthyes). Rhincodon ty,Methods [07502],Ningaloo Reef (Western Australia,Osteichthyes [85206],Vertebrata},
