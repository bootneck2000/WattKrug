@article{Shaughnessy1993,
  title = {Population Size of the {{Cape}} Fur Seal {{Arctocephalus}} Pusillus. 1. {{From}} Aerial Photography.},
  author = {Shaughnessy, P D},
  year = {1993},
  volume = {130},
  pages = {1--70},
  abstract = {This is the second report in a series concerning estimates of the population size of the Cape fur seal Arctocephalus pusillus pusillus that were made during the 1970s. The number of pups was estimated in 16 of the 23 extant breeding colonies in South Africa and Namibia by a method based on the tagging of pups and their recapture. Most of the pups are born during November and December. Investigations at a particular colony (tagging, recapturing, harvesting) took place in the following year, the split year for each colony is referred to by the latter year. The programme was begun in 1971 and results presented here are for estimates made up to the 1979 season. Colonies chosen were those where seals were being harvested. Pups were selected for the estimating procedure as they are the only age class wholly represented in the colonies at any one time, they are recognizable and are amenable to handling. Pups were marked on the fore-flipper with monel-metal tags in mid-January when aged one to two months. Two recapture operations were made at most colonies, the first about a week after tagging and the second at the harvest of immature seals between five and nine months later. The proportion of pups which had shed tags by the time of the winter harvest varied between taggers. Within individual colonies it ranged from 0 to 0.43. Details are provided of the methods used to calculate the pup population estimates and their standard deviations, to make statistical comparisons between the estimates and to combine the estimates from a colony to obtain a best estimate. Data on the sex ratio of pups when they were tagged and the sex ratio of tagged and untagged pups at winter harvests indicate that tagging increased the mortality rate of pups in many of the colonies. Data used in estimating the pup population size of each colony are tabulated and the derivation of each estimate is described. The estimated number of pups in these 16 colonies summed to 210 000. The ratio of estimates from tagging and recapturing to those from aerial surveys at the same colonies and in the same season averaged 1,238. This ratio can be used to improve the accuracy of aerial survey estimates. The conditions that should be satisfied for valid estimates of population size based on tagging and recapturing are discussed with respect to these estimates of pup numbers in colonies of the Cape fur seal.},
  journal = {Invest. rep.},
  keywords = {aerial photography,animals. chordates. mammals. nonhuman mammals. non,Apparatus,arctocephalus pusillus,Arctocephalus pusillus (Otariidae).,Breeding Population. Field Apparatus. Field Method,Chord,Chordata,Development. Equipment,Developmental Biology/Embryology-Morphogenesis,Devices and Ins,Ecology,Environmental Biology/Wildlife Management-Aquatic,Ethiopian region).,Ge,General and Systematic Zoology/Mammalia,General/Field Ap,General/Field Me,Mammalia,Materials and Apparatus,Methods,Methods [16501],Otariidae [86180],Otariidae: Pinnipedia,population size,Reproductive System/General,South Africa (Africa,Vertebrata},
  number = {134}
}

