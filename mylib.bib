@article{Monteiro2015,
  title = {Intraseasonal Variability Linked to Sampling Alias in Air-Sea {{CO2}} Fluxes in the {{Southern Ocean}}},
  author = {Monteiro, Pedro M.S. and Gregor, Luke and L{\'e}vy, Marina and Maenner, Stacy and Sabine, Christopher L. and Swart, Sebastiaan},
  year = {2015},
  month = oct,
  volume = {42},
  pages = {8507--8514},
  publisher = {{Blackwell Publishing Ltd}},
  issn = {19448007},
  doi = {10.1002/2015GL066009},
  abstract = {The Southern Ocean (SO) contributes most of the uncertainty in contemporary estimates of the mean annual flux of carbon dioxide CO2 between the ocean and the atmosphere. Attempts to reduce this uncertainty have aimed at resolving the seasonal cycle of the fugacity of CO2 (fCO2). We use hourly CO2 flux and driver observations collected by the combined deployment of ocean gliders to show that resolving the seasonal cycle is not sufficient to reduce the uncertainty of the flux of CO2 to below the threshold required to reveal climatic trends in CO2 fluxes. This was done by iteratively subsampling the hourly CO2 data set at various time intervals. We show that because of storm-linked intraseasonal variability in the spring-late summer, sampling intervals longer than 2 days alias the seasonal mean flux estimate above the required threshold. Moreover, the regional nature and long-term trends in storm characteristics may be an important influence in the future role of the SO in the carbon-climate system. Key Points fCO2 and air-sea flux of CO2 strongly modulated by intraseasonal variability in the SO Uncertainty of the mean seasonal or annual air-sea flux is sensitive to sampling resolution A sampling resolution \textexclamdown 2 days is necessary in 30-40\% of the SO to reduce the uncertainty to \textexclamdown 10\%},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\8PLV7E7R\\Monteiro et al. - 2015 - Intraseasonal variability linked to sampling alias in air-sea CO2 fluxes in the Southern Ocean.pdf},
  journal = {Geophysical Research Letters},
  keywords = {alias,CO2,fluxes,sampling,Southern Ocean},
  number = {20}
}

