@article{Little1991,
  title = {Thyroid Morphology and Function and Its Role in Thermoregulation in the Newborn Southern Elephant Seal Mirounga-Leonina at Macquarie Island},
  author = {Little, G J},
  year = {1991},
  volume = {176},
  pages = {55--69},
  abstract = {The role of the thyroid gland in thermoregulation in the newborn southern elephant seal pup was investigated using morphological and endocrinological techniques. The thyroid gland of the newborn southern elephant seal pup exhibits markedly increased secretory activity during the first 24 h afer birth. Thyroid epithelial cell height was cuboidal to columnar for pups from birth to 48 h post-partum after which it decreased by five days of age. Ultrastructurally the thyroid epithelial cells show pseudopodia protruding into the lumen at zero, two and six hours after birth. After 24 h post-partum pseudopodia were rarely observed in thyroid follicles from two to 20 day old pups. The number of colloid droplets increased by six hours after birth and were distributed throughout the cytoplasm. At 24 hours and two days few colloid droplets are observed. Plasma T4 concentration increased three fold from birth to peak at six hours post-partum after which it steadily declined. Plasma concentration of T3 increased eight fold between birth and 24 hours post-partum. T3 levels remained high until five to seven days, then decreased to 20 days. The observed changes in thryoid epithelial cell height and ultrastructure is strongly suggestive of increased secretion of thyroid hormones during the first six hours of postnatal life. This pattern of thyroid activity is similar to that in other newborn mammals which have been examined. The thyroid gland of the southern elephant seal is markedly active at birth and is responsible for the elevated levels of T4 and T3, thus playing a vital role in maintaining the body temperature of the newborn seal when it enters the harsh environment of the sub-Antarctic.},
  journal = {Journal of Anatomy},
  keywords = {833,anatomy,energetics,Mirounga leonina,newborn,seals,southern elephant,thermoregulation,thyroid gland},
  mendeley-tags = {833},
  number = {55-69}
}

@article{Little1995,
  title = {Body Temperature in the Newborn Southern Elephant Seal, {{Mirounga}} Leonina, at {{Macquarie Island}}},
  author = {Little, G J},
  year = {1995},
  volume = {11},
  pages = {480--490},
  abstract = {Newborn southern elephant seal pups were reported by Laws (1953) to be 'to some extent poikilothermic at birth.' Rectal temperatures of known age southern elephant seal pups were recorded during the 1985 pupping season at Macquarie Island. The mean pup rectal temperature was found to be 38.1\textdegree C {$\pm$} 0.1\textdegree C SEM (n = 131, range = 36.5\textdegree{} - 39.1\textdegree C). Pups at two hours, six hours, and one day after birth had significantly higher rectal temperatures than pups two, three, or four days of age. Rectal temperatures of neonatal southern elephant seals were within the range observed for other pinnipeds, (but never as low as the 31\textdegree C previously observed for southern elephant seals at Signy Island in 1953). A significant though weak positive correlation was found between pup temperature and body weight. However, no correlation between pup temperature and age or any environmental factor was found. These observations demonstrated that southern elephant seal pups at Macquarie Island are homeothermic, rather than heterothermic from birth.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {278,Mirounga leonina,Mirounga leonina/southern elephant seal/Macquarie,ontogeny,PBS Record: 692,thermoregulation},
  mendeley-tags = {278,PBS Record: 692},
  number = {4}
}

@article{LittleS.J.A.P.Clevenger2002,
  title = {Do Wildlife Passages Act as Prey-Traps?},
  author = {Little S.J. A.P. Clevenger, R G Harcourt. and Little, Stuart J and Harcourt, Robert G and Clevenger, Anthony P},
  year = {2002},
  volume = {107},
  pages = {135--145},
  abstract = {A number of studies have proposed that wildlife passages beneath roads and railway lines might be exploited by mammalian predators as 'prey-traps' with prey-species being effectively funnelled into areas of high concentration. This proposition has raised the possibility that use of passages by predators may reduce the effectiveness of passages in conserving other forms of wildlife. We review the literature and conclude that evidence for the existence of prey-traps is scant, largely anecdotal and tends to indicate infrequent opportunism rather than the establishment of patterns of recurring predation. Most passage studies record no evidence of predation in or around passages. Conversely, there is some evidence that predator species use different passages than their prey.},
  journal = {Biological Conservation},
  keywords = {[00512] General biology - Conservation and resourc,[07502] Ecology: environmental biology - General a,[07518] Ecology: environmental biology - Wildlife,[85700] Mammalia,Animalia,Chordata,Chordates,mammal: predator [Mammalia],Mammalia: Animals,Mammals,Nonhuman Ve,predation,prey-traps,railway lines,roads,Vertebrata,Wildlife Management: Conservation,wildlife passages},
  number = {2}
}

