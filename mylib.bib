@article{Fogel2003,
  title = {Extending the Limits of Paleodietary Studies of Humans with Compound Specific Carbon Isotope Analysis of Amino Acids},
  author = {Fogel, M L and Tuross, N},
  year = {2003},
  volume = {30},
  pages = {535--545},
  doi = {10.1016/s0305-4403(02)00199-1},
  abstract = {Stable carbon isotopes in the bone collagen of prehistoric humans are valuable tools for determining human diet. We studied carbon isotopes in individual amino acids (IAA) in plants and collagen from herbivores and humans from North American prehistoric sites in order to determine whether more specific dietary information about Indians could be predicted. The VC of plant amino acids ranged extensively, whereas delta(13)C values of each amino acid from the C-3 (n = 3) and C-4 (n = 3) plant species were linearly related with a slope of 0.8. Essential amino acids from herbivores had delta(13)C values that were completely different from those measured in either C-3 or C-4 plants, suggesting metabolic resynthesis in the gut by microflora. The delta(13)C of essential amino acids from prehistoric North Americans, who had diets ranging from primarily maize-based (C-4) to hunter-gathers (C-3) subsistence, were highly correlated with delta(13)C values of herbivore essential amino acids. There was no significant correlation of delta(13)C in IAA from humans with those of plants. The delta(13)C of nonessential amino acids in human bone collagen can distinguish the presence of maize in the diet, whereas the delta(13)C of essential amino acids were transparent to a maize-derived carbon signal. Compound specific isotopic data on IAA distinguish between total carbon intake versus total protein intake and are useful for discerning the extent and nature of omnivory. (C) 2003 Elsevier Science Ltd. All rights reserved.},
  isbn = {0305-4403},
  journal = {Journal of Archaeological Science},
  keywords = {C-13,COLLAGEN,DIETARY-PROTEIN INTAKE,DIURNAL-VARIATIONS,ECOLOGY,humans,NITROGEN,paleodiet,plants,PLASMA-CONCENTRATIONS,RATIOS,STABLE CARBON,stable carbon isotopes},
  language = {English},
  number = {5}
}

