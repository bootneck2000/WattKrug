@article{Tedman1987,
  title = {Water and Sodium Fluxes and Lactation Energetics in Suckling Pups of {{Weddell}} Seals ({{Leptonychotes}} Weddellii)},
  author = {Tedman, R A and Green, B},
  year = {1987},
  volume = {212},
  pages = {29--42},
  abstract = {Estimates of the water and sodium fluxes of unrestrained Weddell seal pups were derived from the turnover of tritiated water and 22sodium chloride throughout the nursing period. Milk intake was calculated from water influx. There was a strong correlation between daily body weight gain in pups (.hivin.x = 1.98.+-. 0.44 kg/d) and daily weight loss by dams (.hivin.x = 4.55.+-. 1.24 kg/d; r = 0.85, P \textexclamdown{} 0.001). The maximum weight loss recorded was 249 kg over 38 days. This considerable drain on the dams' energy reserves amounts to a loss of almsot 60\% of the female's body weight after parturition. Mean total body water of pups decreased from 72.5\% at birth to 48.6\% at day 40 of lactation. Total milk consumption was positively correlated with body weight gain by pups (r = 0.87, P \textexclamdown{} 0.001), with daily milk intake ranging from 2.76 to 5.46 l/day (.hivin.x = 3.54.+-. 0.87 l/d). The pups gained 0.51.+-. 0.08 kg body weight for each litre of milk consumed, and the efficiency of conversion of milk energy to stored energy was 52.1.+-. 7.7\%. Sodium influx rates averaged 2.24.+-. 0.41 mmol/kg .cntdot. day. Approximately 70\% of sodium intake was derived from milk, with the remainder coming from the ingestion of small amounts of sea water. The high energy content of the milk (20.8 MJ/kg) and reduced milk yield (relative to body weight) means that pups can consume sufficient energy for rapid growth with comparatively brief nursing periods and short lactational duration. The relatively longer duration of lactation in the Weddell seal, during which the dams and pups engage in extensive swimming activities, has resulted in: (a) reduced daily energy intake by pups, and (b) increased percentage weight loss by dams compared to other phocids.},
  journal = {J. Zool., Lond.},
  keywords = {*Biochemistry/Physiological Water Studies (1970- ),*Developmental Biology/Embryology-Morphogenesis,*Ecology,*Metabolism/Energy and Respiratory Metabolism [130,*Metabolism/Minerals [13010],*Nutrition/General Studies,*Reproductive System/Physiology and Biochemistry [,378,8700,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Biochemical Studies/Carbohydrates [10068],Biochemical Studies/Lipids [10066],Biochemical Studies/Minerals [10069],Biochemical Studies/Proteins,body composition,energetics,Environmental Biology/Animal [07508],G,HTO,lactation,Leptonychotes weddellii,mass transfer,milk intake,Nursing Period Growth Weight Loss Milk Consumption,Nutritional Status and,Peptides and Amino A,Phocidae [86185],Radiation/Radiation and Isotope Techniques [06504],sea water drinking,seals,sodium flux,Weddell},
  mendeley-tags = {378},
  number = {29-42}
}

