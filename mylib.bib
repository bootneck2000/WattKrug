@article{Lodi1996,
  title = {Occurrence and Conservation of Southern Right Whales, {{Eubalaena}} Australis, on the Coast of {{Brazil}}},
  author = {Lodi, Liliane and Siciliano, Salvatore and Bellini, Claudio},
  year = {1996},
  volume = {39},
  pages = {307--328},
  abstract = {The present work reports 32 new records of sightings, including possible double countings, of southern right whales, Eubalaena australis, from 1973 to 1992 for localities from Ilha do Cardoso (25 degree 10'S), Sao Paulo State, to Nova Vicosa (17 degree 53'S), Bahia State. A female and her calf were sighted at open sea off southern Bahia, about 290 km north to its former known limit of occurrence. The highest record frequency was observed between July and October, when 78.1\% of the sightings were of mother-calf pairs. Threats to the species along Brazilian coast were identified from unpublished and published records of strandings between 1977 and 1992 (n=21) and interactions of southern right whales with fishing operations between 1981 and 1992 (n=9). The data presented here show the convenience of establishing conservation measures for the species, especially along Rio Grande do Sul and Santa Catarina States.},
  journal = {Papeis Avulsos de Zoologia},
  keywords = {[00512] General biology - Conservation and resourc,[07502] Ecology: environmental biology - General a,[07508] Ecology: environmental biology - Animal,[07516] Ecology: environmental biology - Wildlife,[62520] Chordata: general and systematic - Mammali,[62800] Animal distribution,[85805] Balaenidae,Balaenidae: Animals,Biogeography: Population Studies,Cetacea,Cetaceans,Chordates,conservation,Conservation,Ecology: Environmental Sciences,environmental sciences/ecology,Eubalaena australis [Balaenidae],Mammalia,Mammals,population studies/biogeography,southern right whale,Systematics and Taxonomy,Vertebrata,Wildlife Management: Conservation,zoogeography},
  number = {17}
}

@article{Lodi2007,
  title = {Southern Right Whale on the Coast of {{Rio}} de {{Janeiro State}}, {{Brazil}}: Conflict between Conservation and Human Activity},
  author = {Lodi, Liliane and Rodrigues, Marcelo Tardelli},
  year = {2007},
  volume = {87(1, Sp},
  pages = {SI) 105--107, FEB 2007},
  abstract = {Between 1993 and 2005, 68 sightings of southern right whales were recorded along 400 km of coastline between Paraty Bay (23 degrees 13'S 44 degrees 42'W) and Macae (22 degrees 22'S 41 degrees 47'W), Rio dejaneiro State, south-eastern Brazilian coast. Mother/calf pairs represented 66.1\% of sightings. only solitary individuals showed a distinct pattern Of Occurrence. Females with calf did not show a distinct pattern of occurrence suggesting their widespread distribution in the area. Analysis of the records and detailed accounts of the sightings of southern right whales reveal that there exist conflicts between the animals and human activities such as harrassement and collision with boats during attempted rescues, accidental entanglement in fishing nets and intentional mortality, which may, have a hearing in the conservatiou of the species in Brazilian waters.},
  journal = {Journal of the Marine Biological Association of the United Kingdom},
  keywords = {[00512] General biology - Conservation and resourc,[07502] Ecology: environmental biology - General a,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[62800] Animal distribution,[85805] Balaenidae,Balaenidae: Animals,Biogeography: Population Studies,Cetacea,Cetaceans,Chordates,Conservation,Environmental Sciences,Eubalaena australis: species,geographic distribution,Mammalia,Mammals,Marine Ecology: Ecology,southern right whale,Vertebrata}
}

@article{Loeb1997,
  title = {Effects of Sea-Ice Extent and Krill or Salp Dominance on the {{Antarctic}} Food Web.},
  author = {Loeb, V and Siegel, V and {Holm-Hanson}, O and Hewitt, R and Fraser, W and Trivelpiece, W and Trivelpiece, S and {Holm-Hansen}, O and Hewitt, R and Fraser, W and Trivelpiece, W and Trivelpiece, S and Seigel, V and {Holm-Hansen}, O and Hewitt, R and Fraser, W and Trivelpiece, W and Trivelpiece, S},
  year = {1997},
  volume = {387},
  pages = {897--900},
  abstract = {Krill (Euphausia superba) provide a direct link between primary producers and higher trophic levels in the Antarctic marine food web. The pelagic tunicate Salpa thompsoni can also be important during spring and summer through the formation of extensive and dense blooms. Although salps are not a major dietary item for Antarctic vertebrate predators, their blooms can affect adult krill reproduction and survival of krill larvae. Here we provide data from 1995 and 1996 that support hypothesized relationships between krill, salps and region-wide sea-ice conditions. We have assessed salp consumption as a proportion of net primary production, and found correlations between herbivore densities and integrated chlorophyll-a that indicate that there is a degree of competition between krill and salps. Our analysis of the relationship between annual sea-ice cover and a longer time series of air temperature measurements indicates a decreased frequency of winters with extensive sea-ice development over the last five decades. Our data suggest that decreased krill availability may affect the levels of their vertebrate predators. Regional warming and reduced krill abundance therefore affect the marine food web and krill resource management.},
  journal = {Nature},
  keywords = {oceanography salp krill sea ice Southern Ocean pro},
  number = {6636}
}

