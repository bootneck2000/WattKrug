@article{Jbabdi2009,
  title = {Multiple-Subjects Connectivity-Based Parcellation Using Hierarchical {{Dirichlet}} Process Mixture Models},
  author = {Jbabdi, S and Woolrich, M W and Behrens, T E J},
  year = {2009},
  volume = {44},
  pages = {373--384},
  doi = {10.1016/j.neuroimage.2008.08.044},
  abstract = {We propose a hierarchical infinite mixture model approach to address two issues in connectivity-based parcellations: (i) choosing the number of clusters, and (ii) combining data from different subjects. In a Bayesian setting, we model voxel-wise anatomical connectivity profiles as an infinite mixture of multivariate Gaussian distributions, with a Dirichlet process prior on the cluster parameters. This type of prior allows us to conveniently model the number of clusters and estimate its posterior distribution directly from the data. An important benefit of using Bayesian modelling is the extension to multiple subjects clustering via a hierarchical mixture of Dirichlet processes. Data from different subjects are used to infer on class parameters and the number of classes at individual and group level. Such a method accounts for inter-subject variability, while still benefiting from combining different subjects data to yield more robust estimates of the individual clusterings. (C) 2008 Elsevier Inc. All rights reserved.},
  isbn = {1053-8119},
  journal = {NeuroImage},
  keywords = {1.5 T,ALGORITHM,BRAIN,CORTEX,CYTOARCHITECTURE,DIFFUSION TRACTOGRAPHY,HIGH-RESOLUTION,NONPARAMETRIC PROBLEMS,SEGMENTATION,THALAMIC NUCLEI},
  language = {English},
  number = {2}
}

