@article{Lim2004,
  title = {Enhanced Partner Preference in a Promiscuous Species by Manipulating the Expression of a Single Gene},
  author = {Lim, M M and Wang, Z X and Olazabal, D E and Ren, X H and Terwilliger, E F and Young, L J},
  year = {2004},
  volume = {429},
  pages = {754--757},
  doi = {10.1038/nature02539},
  abstract = {The molecular mechanisms underlying the evolution of complex behaviour are poorly understood. The mammalian genus Microtus provides an excellent model for investigating the evolution of social behaviour. Prairie voles (Microtus ochrogaster) exhibit a monogamous social structure in nature, whereas closely related meadow voles (Microtus pennsylvanicus) are solitary and polygamous(1). In male prairie voles, both vasopressin and dopamine act in the ventral forebrain to regulate selective affiliation between adult mates, known as pair bond formation, as assessed by partner preference in the laboratory(2-4). The vasopressin V1a receptor (V1aR) is expressed at higher levels in the ventral forebrain of monogamous than in promiscuous vole species(5), whereas dopamine receptor distribution is relatively conserved between species. Here we substantially increase partner preference formation in the socially promiscuous meadow vole by using viral vector V1aR gene transfer into the ventral forebrain. We show that a change in the expression of a single gene in the larger context of pre-existing genetic and neural circuits can profoundly alter social behaviour, providing a potential molecular mechanism for the rapid evolution of complex social behaviour.},
  isbn = {0028-0836},
  journal = {Nature},
  keywords = {DOPAMINE,FORMATION,MONOGAMOUS PRAIRIE VOLE,NUCLEUS-ACCUMBENS,PAIR-BOND,PATERNAL BEHAVIOR,PENNSYLVANICUS,SOCIAL-BEHAVIOR,V-1A RECEPTOR,VASOPRESSIN RECEPTOR,VOLES MICROTUS-OCHROGASTER},
  language = {English},
  number = {6993}
}

@article{Lima1995,
  title = {Growth and Reproductive Patterns in the {{South American}} Fur Seal},
  author = {Lima, Mauricio and P{\'a}ez, Enrique and Paez, Enrique},
