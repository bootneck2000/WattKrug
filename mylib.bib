@article{Revelles2007,
  title = {Stable {{C}} and {{N}} Isotope Concentration in Several Tissues of the Loggerhead Sea Turtle {{Caretta}} Caretta from the Western {{Mediterranean}} and Dietary Implications},
  author = {Revelles, M and Cardona, L and Aguilar, A and Borrell, A and Fernandez, G and San Felix, M},
  year = {2007},
  volume = {71},
  pages = {87--93},
  abstract = {The isotopic concentrations of carapace scutes, skin, muscle and blood of loggerhead sea turtles (Caretta caretta) from the Balearic Archipelago were analysed to investigate the pattern of variation between tissues and to assess the position of this species in the trophic webs of the Algerian Basin. Skin showed higher delta C-13 values than muscle or carapace scutes and these showed higher values than blood. Conversely, muscle showed higher delta N-15 values than skin, skin showed higher values than blood and blood showed higher values than carapace scutes. Dead and live sea turtles from the same habitat did not differ in the concentration of stable isotopes. However, some of the tissues of the turtles caught in drifting long-lines in the oceanic realm showed higher delta C-13 values than those from the turtles caught by hand or in trammel nets over the continental shelf, although they did not differ in the delta N-15. Comparison of the concentration of stable isotopes in the turtles with that of other species from several areas of the Algerian Basin revealed that they consumed planktonic prey and that the trophic level of the sea turtles was higher than that of carnivorous cnidarians but lower than that of zooplanktophagous fish and crustaceans.},
  isbn = {0214-8358},
  journal = {Scientia Marina},
  keywords = {carbon,CARBON ISOTOPES,DELTA-C-13,DELTA-N-15,ENRICHMENT,feeding ecology,FEEDING ECOLOGY,FOOD WEBS,FRACTIONATION,nitrogen,NITROGEN,RATIOS,sea turtle,stable isotopes,tissues,trophic level,TURNOVER},
  language = {English},
  number = {1}
}

