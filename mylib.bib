@article{Martini1997,
  title = {Ecology of the Hagfish, Myxine Glutinosa l, in the Gulf of Maine .2. Potential Impact on Benthic Communities and Commercial Fisheries},
  author = {Martini, F and Lesser, M and Heiser, J B},
  year = {1997},
  volume = {214},
  pages = {97--106},
  abstract = {The Atlantic hagfish, Myxine glutinosa L., is found throughout the Gulf of Maine at depths greater than 50 m in areas of soft bottom substrata. A preliminary density estimate has been developed, based on trap survey data collected over a 5 year period in one area. Calculated densities range from 1:16.75 m(2) to 1:2 m(2), with a biomass estimated to be 8119 kg km(-2). These densities are comparable to those found for Pacific hagfish by other investigators. The energetic requirements of a hagfish of average size within the inner Gulf of Maine has been calculated to be approximately 2.39 kJ.day(-1). The estimated energetic requirement of hagfish populations at the minimum calculated density is 142 679 kJ.day(-1) km(-2). The daily requirements of hagfish at this density would be the energetic equivalent of 50 kg day(-1) km(-1) of shrimp flesh or 27.1 kg day(-1) km(-2) of fish flesh. On an annual basis, they would require 18.25 mt (metric tons) km(-2) of shrimp flesh or 9.9 mt.km(-2) of fish flesh. Given their abundance and habits, they may play a significant role in substratum turnover and nutrient recycling, including the removal of discarded by-catch. These positive effects on the benthic ecosystem may far outweigh their potential negative impacts on commercial fisheries, such as damage to captured groundfish or predation on shrimp. Hagfish and their eggs also form part of the diet of several species of groundfish and marine mammals. Nevertheless, hagfish are not usually included in models of energy Bow in the Gulf of Maine. It is not known what percentage of suitable habitat within the Gulf of Maine is occupied by M. glutinosa at high densities. If hagfish at our estimated average density are found in 5\% of suitable areas, their annual energetic demands would be roughly equivalent the caloric value of the combined annual shrimp and groundfish landings in the Gulf of Maine. It is therefore important that (1) large-scale survey efforts be undertaken to determine the actual distribution and abundance of M. glutinosa within the Gulf of Maine, and (2) hagfish be included in energetic models of the Gulf of Maine ecosystem and other ecosystems where hagfish are known to occur. (C) 1997 Elsevier Science B.V. [References: 41]},
  journal = {Journal of Experimental Marine Biology and Ecology},
  number = {1-2}
}

