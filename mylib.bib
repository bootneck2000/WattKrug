@article{Kelly1996,
  title = {Live Capture of Ringed Seals in Ice-Covered Waters.},
  author = {Kelly, B P},
  year = {1996},
  volume = {60},
  pages = {678--684},
  abstract = {Fifteen ringed seals (Phoca hispida), from a small pup to fully mature adults, were captured 1 or more times in nets designed to line seal breathing holes in sea ice. Seals surfacing to breathe triggered the fall of a weight, causing an extension of the nets to drop below the undersurface of the ice and to purse. Nets were monitored acoustically to alert investigators to captures. Seals entered half of the nets set, but escaped in more than half of those instances. Modifications of the net's trigger and diameter should increase the capture rate. [References: 14] 14},
  journal = {Journal of Wildlife Management},
