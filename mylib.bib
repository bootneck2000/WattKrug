@article{Sasaki2006,
  title = {Balaenoptera Omurai Is a Newly Discovered Baleen Whale That Represents an Ancient Evolutionary Lineage},
  author = {Sasaki, Takeshi and Nikaido, Masato and Wada, Shiro and Yamada, Tadasu K and Cao, Ying and Hasegawa, Masami and Okada, Norihiro},
  year = {2006},
  volume = {41},
  pages = {40--52},
  abstract = {Balaenoptera omurai, formerly classified as a small form of Bryde's whale, was recently reclassified as a new baleen whale species of the family Balaenopteridae. Although researchers have investigated the evolutionary history of Balaenopteridae and their relatives using molecular phylogenetic methods, the taxonomy of the ordinary Bryde's whale (Balaenoptera brydei) and small-form Bryde's whales (Balaenoptera edeni and B. omurai) remains unclear. We have used complete mtDNA sequences and short interspersed repetitive element (SINE) insertion patterns to construct the evolutionary history of both B. omurai and the taxonomically redefined species, R edeni. The combined results demonstrate that B. omurai forms a monophyletic lineage with B. musculus, B. brydei, B. edeni and B. borealis and that B. omurai and B. musculus successively diverged from their common ancestor. In addition, we also showed that B. edeni constitutes a sister taxon to B. brydei. Our data suggest that B. omurai evolved as an ancient independent lineage that diverged much earlier than B. borealis, B. brydei and B. edeni, which were previously believed to be closely related to B. omurai. (c) 2006 Elsevier Inc. All rights reserved.},
  journal = {Molecular Phylogenetics and Evolution},
  keywords = {[00504] General biology - Taxonomy,[01500] Evolution,[03502] Genetics - General,[03506] Genetics - Animal,[10062] Biochemistry studies - Nucleic acids,[62520] Chordata: general and systematic - Mammali,[85805] Balaenidae,[85810] Balaenopteridae [new taxon],[85820] Eschrichtidae,Antarctic minke,Balaena mysticetus: species,Balaenidae: Animals,Balaenoptera acutorostrata: species,Balaenoptera bonaerensis: species,Balaenoptera borealis: species,Balaenoptera brydei: species,Balaenoptera edeni: species,Balaenoptera musculus: species,Balaenoptera omurai: species,Balaenoptera physalus: species,Balaenopteridae: Animals,baleen whale,blue whale,bowhead whale,Bryde's whale,c,Caperea marginata: species,Cetacea,Cetaceans,Chordates,com,commo,common,Eden's whale,Eschrichtidae: Animals,Eschrichtius robustus: species,Eubalaena australis: species,Eubalaena japonica: species,Evolution and Adaptation,evolutionary lineage,Fin whale,gray whale,Humpback whale,Ma,Mamm,Mammalia,Mammals,Megaptera novaeangliae: species,mitochondrial DNA: mtDNA,Molecular Genetics: Biochemistry and Molecular Bio,nomenclature a,North Atlanti,northern right whale,puri,pygmy right whale,Sei whale,southern right whale,Systematics and Taxonomy,Vertebra,Vertebrata},
  number = {1}
