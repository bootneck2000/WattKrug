@misc{Anderson1997b,
  title = {Determination of the True Metabolizable Energy ({{TMEN}}) by Roosters of Feedstuffs Made from Seal by-Products},
  author = {Anderson, D M and White, L and MacLean, J},
  year = {1997},
  volume = {77},
  pages = {165--167},
  issn = {00083984},
  abstract = {TME-N values for various seal by-product feedstuffs were determined using roosters. Four samples of seal meal (seal meal 1991, seal meal 1992, seal meal 1994 (juveniles), seal meal 1994 ( mixed ages)) and three samples of seal meat (oven-dried at 50 degree C, oven-dried at 120 degree C, and freeze-dried) were given to 16 roosters (30 g: precision fed) housed in individual wire cages. Total collection of excreta from a 48-h period was used to provide samples for analysis of gross energy, nitrogen, and dry matter content. TME-N results indicate variability in quality of the meals, associated with the different raw materials used to produce the seal meals as well as year of production. The TME-N values for the seal meals ranged from 3896 kcal kg-1 to 4621 kcal kg-1 with an average value of 4283 kcal kg-1. The crude protein content of the seal meals ranged from 64.2 to 67.6\%, the crude fat content from 12.7 to 14.7\%, the calcium content from 5.38 to 8.98\% and the total phosphorus content from 3.16 to 4.79\%. Oven-drying the seal meat at 120 degree C significantly reduced TME-N (2643 kcal kg-1). The TME-N values for the freeze-dried and the low temperature oven-dried (50 degree C) seal meat were not significantly different (4008 kcal kg-1 and 4013 kcal kg-1, respectively).},
  journal = {Canadian journal of animal science},
  keywords = {5206,ANIMAL FEED,ANIMAL HUSBANDRY,BIRD,FOODS,HARP SEAL,MALE,MAMMAL,PHOCA GROENLANDICA,POULTRY,POULTRY INDUSTRY,RESEARCH ARTICLE,ROOSTER,SEAL BY PRODUCTS,SEAL MEAL,TRUE METABOLIZABLE ENERGY},
  mendeley-tags = {5206},
  number = {1}
}

@article{Anderson1999,
  title = {Community Reorganisation in the {{Gulf}} of {{Alaska}} Following Ocean Climate Regime Shift},
  author = {Anderson, Paul J and Piatt, John F.},
  year = {1999},
  volume = {189},
  pages = {117--123},
  issn = {01718630},
  doi = {10.3354/meps189117},
  abstract = {A shift in ocean climate during the late 1970s triggerd a reorganisation of community structure in the Gulf of Alaska ecosystem, as evidenced in changing catch composition on long-term (1953 to 1997) small-mesh trawl surveys. Forage species such as pandalid shrimp and capelin declined because of recruitment failure and predation, and populations have not yet recovered. Total trawl catch biomass declined \textquestiondown 50\% and remained low through the 1980s. In contrast, recruitment of high trophic-level groundfish improved during the 1980s, yielding a \textquestiondown 250\% increase in catch biomass during the 1990s. This trophic reorganisatoin apparently had negative effects on piscivorous sea birds and marine mammals.},
  isbn = {0171-8630},
  journal = {Marine Ecology Progress Series},
  keywords = {capelin,climate change,forage fish,groundfish,Gulf of Alaska,shrimp},
  pmid = {4762696}
}

