@article{Divine2010,
  title = {Holocene {{Antarctic}} Climate Variability from Ice and Marine Sediment Cores: {{Insights}} on Ocean-Atmosphere Interaction},
  author = {Divine, D. V. and Ko{\c c}, N. and Isaksson, E. and Nielsen, S. and Crosta, X. and Godtliebsen, F.},
  year = {2010},
  volume = {29},
  pages = {303--312},
  issn = {02773791},
  doi = {10.1016/j.quascirev.2009.11.012},
  abstract = {Holocene climate variability in the southeast Atlantic sector of the Southern Ocean and Antarctic is assessed and quantified through integration of available marine sediment core and Antarctic ice core data. We use summer sea surface temperature (SSST) and sea ice presence (SIP) reconstructions from two marine sediment cores recovered north (50 \textdegree S) and south (53.2 \textdegree S) of the present day Antarctic Polar Front (APF), as well as an atmospheric temperature and sea ice proxy from the EPICA ice core from Dronning Maud Land (EDML). We find reasonably good agreement in the timing of climate evolution in the analyzed series. Almost all records show a gradual glacial-to-Holocene climate transition, interrupted by the Antarctic cold reversal around 13 000 cal yr BP, and early Holocene climatic optimum (HCO) at about 11 000 cal yr BP. During the early HCO, the seasonal ice cover retreats to south of 53 \textdegree S; it then readvances in the course of the mid- to late Holocene. The maximum winter sea ice edge position during the recent 10 000 years varied mainly within 51-53 \textdegree S, with sporadic growth to north of 50 \textdegree S, a position similar to that during the last glacial. The onset of the Neoglacial period after ca 4000 yr BP is associated with a steepening of the SSST gradient between the marine core sites, strengthening of the westerlies and cooling in the inland ice sheet. The agreement in timing between elevated SSST during the early HCO and decreased deuterium excess in EDML and other ice cores from different locations in the East Antarctic suggests that the retreat of sea ice during the early HCO and weakening of the APF was a general feature of the East Antarctic climate during that time. \textcopyright{} 2009 Elsevier Ltd. All rights reserved.},
  isbn = {0277-3791},
  journal = {Quaternary Science Reviews},
  number = {1-2}
}

