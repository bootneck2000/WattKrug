  isbn = {0036-8075},
  journal = {Science},
  keywords = {Biodiversity,diversity,ecosystem,fisheries,impact,Marine ecosystems,population,quality,scale,spatial,spatial scales,Trends},
  number = {5800},
  pmid = {17082450}
}

