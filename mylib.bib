  title = {Occurrence of Mirounga Leonina Linnaeus (Pinnipedia, Phocidae) from Southernmost Brazil: {{Injury}} and Pathologies},
  author = {Drehmer Cesar, Jaeger and Ferigolo, Jorge and Borsato Eduardo, Sergio},
