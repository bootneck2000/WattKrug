@article{Pfeiffer2001,
  title = {Lingual Ultrastructure of the Long-Finned Pilot Whale ({{Globicephala}} Melas)},
  author = {Pfeiffer, D C and Wang, A and Nicolas, J and Pfeiffer, C J},
  year = {2001},
  volume = {30},
  pages = {359--365},
  abstract = {Microscopic studies on the cetacean tongue are limited and, to date, only a few ultrastructural reports on dolphins have been published. This report presents the initial description of the lingual ultrastructure of the long-finned pilot whale. The lingual integumental surface was smooth, lacking papillae, although flaking of outer stratum corneum cells could be observed at high resolution. The keratinocytes of the stratum spinosum of the epidermis resembled those of cetacean skin on other regions of the body. The similarities included the presence of cytoplasmic lipid droplets around the nuclei of stratum spinosum cells, a lingual feature not seen in terrestrial mammals. Keratin intermediate filaments were numerous and occasionally formed aggregates of circular whorls. At cell surfaces, bundles of keratin intermediate filaments were frequently observed inserting into desmosomal plaques. Pigment granules were not evident and organelles were sparse. Stratum corneal cells contained nuclear remnants (parakeratosis) and small multivesicular bodies, and the corneal layer was approximately 18 cells thick. The nuclei of the stratum basale keratinocytes possessed exceptionally numerous and deep clefts. The dermis was non-distinctive. The skeletal muscle of the tongue was arranged in widely separated fasiculi containing small numbers of muscle fibres. Typical fine structure of skeletal muscle bands and tubular elements was observed by transmission electron microscopy.},
  journal = {Anatomia, Histologia, Embryologia: Veterinary Medicine Series C},
  keywords = {Animals,Biochemical Studies/Proteins,Cetaceans,Chorda,Chordates,Cytology and Cytochemistry/Animal [02506],Delphinidae [85815],Delphinidae: Cetacea,Dental and Oral Biology/Physiology and Biochemistr,Dental and Oral System (Ingestion and Assimilation,dermis: integumentary system,Globicephala melas [long-finned pilot whale] (Delp,Integumentary System (Chemical Coordination and Ho,Integumentary System/Physiology and Biochemistry [,keratin,keratinocyte: integumentary system,Mammalia,Mammals,Muscle/Physiology and Biochemistry [17504],Muscular System (Movement and Support),Nonhuman Mammals,Nonhuman Vertebrates,Peptides and Amino A,skeletal muscle: muscular system,stratum corneal cell: integumentary system,stratum spinosum: integumentary system,tongue: dental and oral system,Vertebrata,Vertebrates},
  number = {6}
}

@article{Pfeiler2001,
  title = {Ecology and Population Genetics of Sonoran Desert Drosophila},
  author = {Pfeiler, E and Markow, T A},
  year = {2001},
  volume = {10},
  pages = {1787--1791},
  abstract = {Three species of cactophilic Drosophila endemic to the Sonoran Desert of North America, D. nigrospiracula, D. pachea and D. mettleri, experience marked differences in spatial resource availability, and the first two of these display significant differences in dispersal behaviour. We employed starch gel and cellulose acetate electrophoresis for eight allozyme loci to test for a relationship between these variables and genetic differentiation among geographical populations of each species. No evidence was found for population structure in any of the three species, populations of which were separated by geographical distances of up to 475 km. Allele frequencies for two loci, Mdh-1 and Est-2, in D. nigrospiracula and D. pachea were very similar to those obtained approximate to 30 years ago by other workers, indicating that the polymorphisms are remarkably stable under the stressful and variable conditions of the desert environment. High longevity, dispersal and multiple female remating are likely to contribute to the apparent high level of gene flow in all three species.},
  isbn = {0962-1083},
  journal = {Molecular Ecology},
  keywords = {allozyme,CACTOPHILIC DROSOPHILA,Drosophila,Drosophila mettleri,Drosophila nigrospiracula,EVOLUTION,genetic variability,NATURAL-POPULATIONS,pachea,PATTERNS,population structure},
  language = {English},
  number = {7}
}

@article{Phartiyal2011,
  title = {Glacial Lakes and Geomorphological Evolution of Schirmacher Oasis, East Antarctica, during Late Quaternary},
  author = {Phartiyal, Binita and Sharma, Anupam and Bera, S. K.},
  year = {2011},
  month = apr,
  volume = {235},
  pages = {128--136},
  issn = {10406182},
  doi = {10.1016/j.quaint.2010.11.025},
  abstract = {Large former glacial lakes and their sediments are described from the Schirmacher Oasis region of East Antarctica. The water bodies were present during the Late Quaternary ({$\sim$}10-3 ka BP) and have reduced in size by negative water balance. This desiccation can possibly be attributed to the combined effect of recession of glaciers feeding them, low melt water, low precipitation and strong winds. Seven representative sections from five dry lake beds have been studied using loss-on-ignition (LOI) and Magnetic Susceptibility (MS). The LOI indicates a very low organic content, while MS enables assumptions to be made about the reconstruction of changing detrital input. Detailed study of sediment profiles was used to reconstruct the evolution of the Schirmacher Oasis from 13 ka BP to the present. These lacustrine sediments are a very important source of information on the Quaternary geological history of the Schirmacher Oasis. \textcopyright{} 2010 Elsevier Ltd and INQUA.},
  journal = {Quaternary International},
  number = {1-2}
}

