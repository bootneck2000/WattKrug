@incollection{Trites2006,
  title = {Sea Lions of the World},
  booktitle = {Trites, {{AW}} [{{Editor}}], Atkinson, {{SK}} [{{Editor}}], {{DeMaster}}, {{DP}} [{{Editor}}], Fritz, {{LW}} [{{Editor}}], Gelatt, {{TS}} [{{Editor}}], Rea, {{LD}} [{{Editor}}], Wynne, {{KM}} [{{Editor}}]. {{Sea}} Lions of the World. , 2006.},
  author = {Trites, A W and Atkinson, S K and DeMaster, D P and Fritz, L W and Gelatt, T S and Rea, L D and Wynne, K M},
  year = {2006},
  publisher = {{Alaska Sea Grant College Program, Univ. Alaska.}},
  address = {{Fairbanks}},
  abstract = {This 664-page book presents the proceedings of the 22nd Lowell Wakefield Fisheries Symposium, entitled, Sea Lions of the World: Conservation and Research in the 21st Century, held in Anchorage, Alaska in September 2004. This book consists of 82 individually-authored and referenced papers, written in English, and divided into 5 main sections. Symposium and series details precede the first paper, along with proceedings acknowledgements. The first section, physiological ecology, includes: organochlorines in Steller sea lions (Eumetopias jubatus) in the north Pacific; female attendance and neonatal pup growth in Steller sea lions; and, heavy metal distribution in Southern sea lions (Otaria flavescens) from Argentina. The second section, foraging ecology, includes: predictability of prey available to Steller sea lions in southeastern Alaska; food consumption by sea lions; techniques for real-time active tracking of sea lions; and, movements of a juvenile southern sea lion in La Plata River estuary. Section three discusses population ecology and dynamics, including: mark-recapture estimate of pup production for the Australian sea lion (Neophoca cinerea) at Seal Bay Conservation Park; population status and trends of the California sea lions (Zalophus californianus californianus) in the Gulf of California; and, the impact of Klebsiella pneumoniae epidemics on New Zealand sea lion recruitment. The fourth sections deals with sea lion conservation and management, particularly: status and conservation of otariids in Ecuador and the Galapagos Islands; avoidance of artificial stimuli by the Steller sea lion; and, interactions between southern sea lions and artisanal fisheries in Piriaolis, Uruguay. The final section presents roundtable discussions on: telemetry instruments, analysis and attachment techniques; predation on sea lions; and, assessing the sea lion diet. A list of participants and an index follow the final paper. This book will be of particular interest to marine ecologists, conservationists, pollution biologists, physiologists and population biologists.},
