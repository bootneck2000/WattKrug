@article{Molyneux1978,
  title = {Arterio Venous Anastomoses in the Skin of Seals Part 1 the Weddell Seal Leptonychotes-Weddelli and the Elephant Seal Mirounga-Leonina Pinnipedia Phocidae},
  author = {Molyneux, G S and Bryden, M M},
  year = {1978},
  volume = {191},
  pages = {239--252},
  abstract = {The structure, distribution, density and innervation of arteriovenous anastomoses (AVA) were compared in the skin of Weddell and elephant seals as part of a study of the structure and function of arteriovenous anastomoses in mammals. In both genera AVA were coiled vessels with the segmental structure typical of "epithelioid" anastomoses and possessed a dense peripheral adrenergic innervation. In both Weddell and elephant seals there was no statistically significant difference between the mean density of AVA in body skin and flipper skin. In the majority, approximately 71\% of AVA occurred superficially in the dermis, fewer (23\%) occurred in the deeper dermis and 6\% were present in the thick hypodermis (blubber). The density of AVA in Weddell and elephant seals is approximately 8.times. greater than that reported in other animals and the superficial position of anastomoses over the whole of the body surface is characteristic of phocid seals. When open, AVA in Weddell and elephant seals allow maximal heat loss from the skin surface by passing large volumes of blood into the superficial veins. AVA in seals are important in dissipation of body heat, particularly when the animals are out of the water, and the entire surface area is thermoregulatory rather than specific regions such as the flippers.},
  journal = {Anatomical Record},
  keywords = {*Cardiovascular System/Anatomy [14502],*Cardiovascular System/Physiology and Biochemistry,*Integumentary System/Anatomy [18502],*Temperature: Its Measurement,7800,Anatomy and Histology,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Blood,Blood-Forming Organs and Body Fluids/Blood,Bones,Chordate Body Regions/Extremities (1970- ) [11318],Connective and Adipose Tis,Ecology,Effects and Regulat,Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Fasciae,General and Comparative/Com,General and Comparative/Gro,Joints,Mammal Flipper Dermis Hypodermis Blood Adrenergic,Mammalia-Unspecified [85700],Mathematical Biology and Statistical Methods [0450,Movement (1971- ) [12100],Nervous System/Anatomy [20502],Phocidae [86185]},
  number = {2}
}

