@article{Cornaglia2000,
  title = {Histopathological and Immunohistochemical Studies on Cetaceans Found Stranded on the Coast of {{Italy}} between 1990 and 1997},
  author = {Cornaglia, E and Rebora, L and Gili, C and Di Guardo, G},
  year = {2000},
  volume = {47},
  pages = {129--142},
  abstract = {Detailed histopathological and immunohistochemical studies were carried out on 24 cetaceans, 17 of which were striped dolphins (Stenella coeruleoalba), four bottlenose dolphins (Tursiops truncatus) and three Risso's dolphins (Grampus griseus), all found stranded on thr Italian coast between 1990 and 1997. The most frequently detected lesions were chronic pneumonia (73.7\% of the examined lungs), focal chronic pancreatitis (71.4\%), non-purulent encephalitis (50\%), chronic hepatitis (42.1\%), and chronic focal interstitial nephritis (31.2\%). The skin and the subcutaneous panniculus were often (33.3\%) affected by parasitic diseases (Phyllobothriim delphini and Pennella sp.). An appreciable percentage of animals showed lymphoid depletion in their lymphatic organs (47.2\%), as well as a high rate of parasitic infestations in their alimentary tracts (25\%). [References: 52]},
  journal = {Zentralblatt fur Veterinarmedizin - Reihe A},
  keywords = {Aquatic mammals,Bottle-nosed dolphins,British waters.,Dolphins stenella-coeruleoalba,Harbor porpoises,Incidental lesions,Morbillivirus infection,Neonatal asphyxia,Striped dolphin,Tursiops-truncatus,Veterinary Medicine/Animal Health in Current Conte},
