@article{Parodi1982a,
  title = {Positional Distribution of Fatty-Acids in Tri Glycerides from Milk of Several Species of Mammals},
  author = {Parodi, P W},
  year = {1982},
  volume = {17},
  pages = {437--442},
  abstract = {Milk triglycerides from the echidna (Tachyglossus aculeatus), koala (Phascolarctos cinereus), Tammar wallaby (Macropus eugenii), guinea pig (Cavia porcellus), dog (Canis familiaris), cat (Felis domesticus), Weddell seal (Leptonychotes weddelli), horse (Equus caballus), pig (Sus scrofa) and cow (Bos taurus) were subjected to fatty acid and stereospecific analysis to determine the positional distribution of the fatty acids in the triglycerides. The samples presented a wide range of fatty acids, most of which varied in content among species. The compositions of the acids at the 3 positions also varied among species, reflecting the content of these acids in the triglycerides. There was a general similarity in fatty acid positional distribution patterns for all the species with the exception of the echidna. The echidna exhibited a completely different fatty acid positional distribution pattern. The saturated acids were preferentially esterified at the sn-1-position while the unsaturated acids were selectively esterified at the sn-2-position. The triglyceride carbon number distribution of milk from the above species (with the exception of the Weddell seal) was determined by gas liquid chromatography and compared to that predicted by the 1-random-2-random-3-random fatty acid distribution hypothesis. Agreement was excellent between observed and predicted composition for echidna, koala, Tammar wallaby, guinea pig and pig milk, and agreement was reasonable for dog, cat, horse and cow milk. Results are discussed in relation to biochemical mechanisms.},
  journal = {Lipids},
  keywords = {*Biochemical Studies/Lipids [10066],*Biophysics/Molecular Properties and Macromolecule,*Comparative Biochemistry,*Reproductive System/Physiology and Biochemistry [,8300,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Biochemical Methods/Lipids [10056],Biophysics/General Biophysical Techniques [10504],Bovidae [85715],Canidae [85765],Caviidae [86300],Echidna Tachyglossus-Aculeatus Koala Phascolarctos,Equidae [86145],Felidae [85770],General [10010],Macropodidae [86075],Methods [16501],Movement (1971- ) [12100],Phalangeridae [86095],Phocidae [86185],Reproductive System/General,Suidae [85740],Tachyglossidae [86115]},
  number = {6}
}

@article{Parra2001,
  title = {Feasibility of Using Photo-Identification Techniques to Study the {{Irrawaddy}} Dolphin, {{Orcaella}} Brevirostris ({{Owen}} in {{Gray}} 1866)},
  author = {Parra, Guido J and Corkeron, Peter J},
  year = {2001},
  volume = {27},
  pages = {45--49},
  abstract = {Irrawaddy dolphins, Orcaella brevirostris, present a particular challenge to study. They live in shallow, turbid waters, are inconspicuous, have unpredictable surfacing patterns, low surfacing profiles, and are generally elusive animals. Photographs of the dorsal region of Irrawaddy dolphins were taken between December 1998 and November 1999 in Cleveland and Bowling Green Bays, North Queensland, Australia in order to assess the feasibility of using photo-identification techniques in studies of this species. Thirty-five individual Irrawaddy dolphins, all adults, were identified in Cleveland Bay and three in Bowling Green Bay. Distinctive features were notches on the dorsal fin, including deep scars and cuts along the dorsal region, white marks on dorsal fin, and distinct dorsal fin shapes. The use of photo-identification to study Irrawaddy dolphins is feasible. Photo-identification can contribute significantly to the study of Irrawaddy dolphins' ecology and conservation biology.},
  journal = {Aquatic Mammals},
  keywords = {Animals,Australa,Australasian,Australia,Bowling Green Bay (Queensland,Cetaceans,Chorda,Chordates,Cleveland Bay (Queensland,Delphinidae [85815],Delphinidae: Cetacea,dorsal fin,Ecology,Environmental Biology/Animal [07508],Environmental Biology/General,Environmental Biology/Oceanography [07512],Environmental Sciences),Mammalia,Mammals,Marine Ecology (Ecology,Methods [07502],Methods and Techniques,Nonhuman Mammals,Nonhuman Vertebrates,Orcaella brevirostris [Irrawaddy dolphin] (Delphin,Vertebrata,Vertebrates},
  number = {1}
}

@article{Parrish2000,
  title = {Identifying Diurnal Foraging Habitat of Endangered {{Hawaiian}} Monk Seals Using a Seal-Mounted Camera.},
  author = {Parrish, F A and Craig, M P and Ragen, T J and Marshall, G J and Buhleier, B M},
  year = {2000},
  volume = {16},
  pages = {392--412},
  abstract = {The Hawaiian monk seal (Monachus schauinslandi) is thought to be a foraging generalist, preying on numerous species in diverse habitats of the subtropical Northwestern Hawaiian Islands. Ac che atoll of French Frigate Shoals, recent evidence of emaciation and low survival in monk seals prompted a search for their specific prey communities and foraging habitat. A video camera (National Geographic Television's CRITTERCAM) fitted to 24 adult male seals documented benthic and demersal foraging on the deep slopes (50-80 m) of the atoll and neighboring banks. The number of bottom searches for prey was compared by year, time of day, type of bottom, individual seal, and length of bottom time. Analysis of variance identified a significant interaction of seal and bottom type, explaining 65\% of the coral variance. Seals fed on communities of cryptic fauna (fish and large invertebrates) in transitional "ecotone" regions of low relief where consolidated substrate, rubble, and talus bordered areas of sand. Independent areal surveys of bottom types throughout the atoll and neighboring banks suggest that the type of bottom selected as foraging habitat represents a relatively small percentage of the total benthic area available. [References: 46]},
  journal = {Marine Mammal Science},
  keywords = {6685,crittercam,diet,Monachus schauinslandi},
  mendeley-tags = {6685},
  number = {2}
}

