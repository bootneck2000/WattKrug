@article{DallaRosa2002,
  title = {Photo-Identification of Humpback Whales, {{Megaptera}} Novaeangliae, off the {{Antarctic Peninsula}}: 1997/98 to 1999/2000},
  author = {Dalla Rosa, Luciano and Secchi, Eduardo R and Kinas, Paul G and Santos, Marcos C O and Martins, Marcio B and Zerbini, Alexandre N and Bethlem, Claudia B P},
  year = {2002},
  volume = {47},
  pages = {555--561},
  abstract = {During three summer seasons (1997/98-1999/00), photographic sampling of humpback whales was conducted by Projeto Baleia/Brazilian Antarctic Programme in waters of the Antarctic Peninsula. Whales photographed totalled: 63 (1997/1998), 70 (1998/1999) and 21 (1999/2000). Of these, 74.6\% (n=47), 87.1\% (n=61) and 100\% (n=21), respectively, were represented by photographs categorised as quality 1 (excellent) or 2 (moderate). Inter-annual comparisons showed two matches: a whale photographed on 27 January 1998 in the Gerlache Strait was resighted on 11 January 1999 in the same region; the second on 3 February 1998 in the Gerlache Strait was resighted on 25 January 1999 at almost the same coordinates. These matches indicate that humpback whales may show fidelity to feeding grounds off the Antarctic Peninsula. Intra-annual comparisons showed two matches: a whale photographed on 22 January 1998 close to the King George Island and another on 27 January 1998 in the Bismarck Strait were resighted together on 7 March 1998 in the Gerlache Strait. Average indices of fluke colouration obtained for 1997/1998 and 1998/1999 were 2.39 (n=44) and 2.60 (n=53), respectively. Total average index, including photographs from the three periods, resulted in 2.54 (n=116). All values are significantly different from those obtained by Rosenbaum et al. (1995) for western and eastern Australia (p\textexclamdown 0.001) similar to that found for Colombia (p\textquestiondown 0.05) (non-parametric test of Kolmogorov-Smirnov). These results reinforce the view that humpback whales feeding in the western side of the Antarctic Peninsula probably originate from eastern South Pacific breeding grounds.},
  journal = {Memoirs of the Queensland Museum},
  keywords = {[07002] Behavioral biology - General and comparati,[07003] Behavioral biology - Animal behavior,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[37001] Public health - General and miscellaneous,[85810] Balaenopteridae,Balaenopteridae: Animals,Behavior,Cetacea,Cetaceans,Chordates,Environmental Sciences,feeding ground fidelity,fluke: coloration,intra-annual comparisons,Ma,Mammalia,Marine Ecology: Ecology,Megaptera novaeangliae: humpback whale [Balaenopte,Population Studies,Projeto Baleia/Brazilian Antarctic Program,Verteb},
  number = {2}
}

@article{Dalpadado2016,
  title = {Distribution and Abundance of Euphausiids and Pelagic Amphipods in {{Kongsfjorden}}, {{Isfjorden}} and {{Rijpfjorden}} ({{Svalbard}}) and Changes in Their Relative Importance as Key Prey in a Warming Marine Ecosystem},
  author = {Dalpadado, Padmini and Hop, Haakon and R{\o}nning, Jon and Pavlov, Vladimir and Sperfeld, Erik and Buchholz, Friedrich and Rey, Alina and Wold, Anette},
  year = {2016},
  volume = {39},
  pages = {1765--1784},
  issn = {07224060},
  doi = {10.1007/s00300-015-1874-x},
  abstract = {Euphausiid (krill) and amphipod dynamics were studied during 2006\textendash 2011 by use of plankton nets in Kongsfjorden (79\textdegree N) and adjacent waters, also including limited sampling in Isfjorden (78\textdegree N) and Rijpfjorden (80\textdegree N). The objectives of the study were to assess how variations in physical characteristics across fjord systems affect the distribution and abundance of euphausiids and amphipods and the potential for these macrozooplankton species to reproduce in these waters. The abundances of euphausiids and amphipods were higher in Kongsfjorden than in Rijpfjorden and Isfjorden, and the highest abun- dances were observed at the innermost stations of Kongs- fjorden, where Thysanoessa inermis and Themisto libellula dominated. The Atlantic species Thysanoessa longicaudata,Meganyctiphanes norvegica and Themisto abyssorum dominated at the outside Kongsfjorden. Inter-annual and seasonal variability in abundances of euphausiids and amphipods were evident. The presence of ripe euphausiids outside Kongsfjorden indicates that they may reproduce in these areas. Mature individuals of T. abyssorum were recorded mainly outside Kongsfjorden, whereas no mature or ripe T. libellula were present in both the inner and outer parts of this fjord. If the warming trend persists, as seen during the last decade, this would favour the Atlantic/boreal euphausiid species, while Arctic species, such as the amphipod T. libellula, may decline. Euphausiids and amphipods are major food of capelin (Mallotus villosus) and polar cod (Boreogadus saida), respectively, in this region, and changes in prey abundance will likely have an impact on the feeding dynamics of these important fish species.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\9RKMK7NJ\\Dalpadado et al. - 2016 - Distribution and abundance of euphausiids and pelagic amphipods in Kongsfjorden, Isfjorden and Rijpfjorden (Sv.pdf},
  journal = {Polar Biology},
  keywords = {Arctic fjord systems,Climate effect,Kongsfjorden,Macrozooplankton,Themisto,Thysanoessa}
}

