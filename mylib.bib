@article{Shimada1995,
  title = {Report of a Sighting Survey off the {{Solomon Islands}} with Comments on {{Bryde}}'s Whale Distribution},
  author = {Shimada, Hiroyuki and Pastene, Luis A},
  year = {1995},
  volume = {0},
  pages = {413--418},
  abstract = {This paper summarises the results of a sighting survey conducted around the Solomon Islands between 28 November and 11 December 1993. The objective of the survey was to obtain data on the distribution, abundance and stock identity of large whale species, particularly blue and Bryde's whales. The survey was carried out using two Japanese vessels, which covered a total of 2,000 n.miles on sighting effort in the research area. No blue whales were observed during the survey period. Fourteen schools (23 animals) of Bryde's whales and seven schools (12 animals) of sperm whales were sighted. Small cetacean species were also observed. All the Bryde's whales and most of the sperm whales were observed on the Pacific Ocean side of the research area. The sightings of the Bryde's whales involved four cases of mothers and calves. Some Bryde's whale individuals were observed in association with large shoals of pelagic fishes and sea birds. The range of the estimated body lengths for the Bryde's whales (except calves) was 10.1m-11.6m. The upper range is smaller than those reported for Bryde's whales from other geographical regions.},
  journal = {Report of the International Whaling Commission},
  keywords = {Anatomy and Histology,Animal Distribution (1971- ) [62800],animals. cetaceans. chordates. fish. mammals. nonh,Balaenopteridae [85810],Balaenopteridae: Cetacea,Biogeography (Population Studies). Ecology (Enviro,Body Length. Sea Bird. Species Associations.,Ch,Ecology,Environmental Biology/Animal [07508],fish (Pisces - Unspecified). Balaenopteridae (Bala,General and Comparative/Gro,Mammalia,Pacific Ocean (Pacific Ocean).,Vertebrata},
  number = {45}
