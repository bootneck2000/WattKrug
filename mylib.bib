@article{Hindell2020a,
  title = {Tracking of Marine Predators to Protect {{Southern Ocean}} Ecosystems},
  author = {Hindell, Mark A. and Reisinger, Ryan R. and {Ropert-Coudert}, Yan and H{\"u}ckst{\"a}dt, Luis A. and Trathan, Philip N. and Bornemann, Horst and Charrassin, Jean Beno{\^i}t and Chown, Steven L. and Costa, Daniel P. and Danis, Bruno and Lea, Mary Anne and Thompson, David and Torres, Leigh G. and {Van de Putte}, Anton P. and Alderman, Rachael and {Andrews-Goff}, Virginia and Arthur, Ben and Ballard, Grant and Bengtson, John and Bester, Marth{\'a}n N. and Blix, Arnoldus Schytte and Boehme, Lars and Bost, Charles Andr{\'e} and Boveng, Peter and Cleeland, Jaimie and Constantine, Rochelle and Corney, Stuart and Crawford, Robert J.M. and Dalla Rosa, Luciano and {de Bruyn}, P. J.Nico and Delord, Karine and Descamps, S{\'e}bastien and Double, Mike and Emmerson, Louise and Fedak, Mike and Friedlaender, Ari and Gales, Nick and Goebel, Michael E. and Goetz, Kimberly T. and Guinet, Christophe and Goldsworthy, Simon D. and Harcourt, Rob and Hinke, Jefferson T. and Jerosch, Kerstin and Kato, Akiko and Kerry, Knowles R. and Kirkwood, Roger and Kooyman, Gerald L. and Kovacs, Kit M. and Lawton, Kieran and Lowther, Andrew D. and Lydersen, Christian and Lyver, Phil O.B. and Makhado, Azwianewi B. and M{\'a}rquez, Maria E.I. and McDonald, Birgitte I. and McMahon, Clive R. and Muelbert, Monica and Nachtsheim, Dominik and Nicholls, Keith W. and Nord{\o}y, Erling S. and Olmastroni, Silvia and Phillips, Richard A. and Pistorius, Pierre and Pl{\"o}tz, Joachim and P{\"u}tz, Klemens and Ratcliffe, Norman and Ryan, Peter G. and Santos, Mercedes and Southwell, Colin and Staniland, Iain and Takahashi, Akinori and Tarroux, Arnaud and Trivelpiece, Wayne and Wakefield, Ewan and Weimerskirch, Henri and Wienecke, Barbara and Xavier, Jos{\'e} C. and Wotherspoon, Simon and Jonsen, Ian D. and Raymond, Ben},
  year = {2020},
  volume = {580},
  pages = {87--92},
  issn = {14764687},
  doi = {10.1038/s41586-020-2126-y},
  abstract = {Southern Ocean ecosystems are under pressure from resource exploitation and climate change1,2. Mitigation requires the identification and protection of Areas of Ecological Significance (AESs), which have so far not been determined at the ocean-basin scale. Here, using assemblage-level tracking of marine predators, we identify AESs for this globally important region and assess current threats and protection levels. Integration of more than 4,000 tracks from 17 bird and mammal species reveals AESs around sub-Antarctic islands in the Atlantic and Indian Oceans and over the Antarctic continental shelf. Fishing pressure is disproportionately concentrated inside AESs, and climate change over the next century is predicted to impose pressure on these areas, particularly around the Antarctic continent. At present, 7.1\% of the ocean south of 40\textdegree S is under formal protection, including 29\% of the total AESs. The establishment and regular revision of networks of protection that encompass AESs are needed to provide long-term mitigation of growing pressures on Southern Ocean ecosystems.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\7JGX5DT6\\Hindell et al. - 2020 - Tracking of marine predators to protect Southern Ocean ecosystems.pdf},
  journal = {Nature},
  number = {7801},
  pmid = {32238927}
}

