  volume = {90},
  pages = {387--395},
  abstract = {Twenty-four Mediterranean fin whales were tracked in open sea with a method based on the assessment of the animal differential position in respect of the observer's absolute position aboard a vessel, with the concomitant recording of the respiratory activity. Short distance video recording was also performed in two whales, permitting the simultaneous determination of single breath expiratory (TE) and inspiratory (TI) durations. In the 24 whales swimming at an average velocity of 1.39 (0.47) mcntdots-1 (mean (SD), range: 0.62-2.44 mcntdots-1), 2068 breaths organized in 477 respiratory cycles were observed. Each cycle entailed a prolonged apnoea dive phase (225 (91) s, Tdive) followed by a period near the surface (62 (28) s, surfacing), during which a series of breaths (4.6 (1.8)) was performed at short intervals. On the basis of track length and swimming velocity, two groups of animals were devised differing for convolution of the course (p\textexclamdown 0.001), extension of ranging territory (p\textexclamdown 0.01) and horizontal swimming velocity (p\textexclamdown 0.05), which may represent two distinct behaviours. A possibly general mechanism of control of breathing in cetaceans was found, consistent with a model of constant tidal volume and variable respiratory frequency. Coherently with this model,TE was independent of TI or Tdive, in line with a passive expiration, while TI appeared to be negatively correlated with Tdive (p\textexclamdown 0.05), otherwise suggesting, similarly with terrestrial mammals, a significant role of hypercapnic stimulation. The estimated O2 consumption of about 150 lcntdotmin-1 is in line with the general allometric regression for mammals and corresponds to an energetic expenditure of 85-95 kJcntdotkg-1cntdotday-1.},
  journal = {European Journal of Applied Physiology},
  keywords = {[16004] Respiratory system - Physiology and bioche,[16006] Respiratory system - Pathology,[85700] Mammalia,[85810] Balaenopteridae,Animalia,Balaenoptera physalus: species,Balaenopteridae: Animals,Cetacea,Cetaceans,Chordata,Chordates,expiration,locomotor behaviors,Ma,mammal: common [Mammalia],Mammalia,Mammalia: Animals,Mammals,Mediterranean fin,Nonhuman Ve,oxygen consumption,oxygen: 7782-44-7,respiratory pattern,Respiratory System: Respiration,single breath expiratory duration,single breath inspiratory duration,tidal volume,Verteb,Vertebrata},
  number = {3-4}
}

