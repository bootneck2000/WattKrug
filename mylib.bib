@article{Stewart1989,
  title = {Harbor Seal Tracking and Telemetry by Satellite},
  author = {Stewart, Brent S and Leatherwood, Stephen and Yochem, Pamela K and {Heide-J{\o}rgensen}, Mads-Peter M.-P. and {Heide-Jorgensen}, M.-P. and {Heide-J{\o}rgensen}, Mads-Peter M.-P.},
  year = {1989},
  volume = {5},
  pages = {361--375},
  abstract = {We tested a satellite Platform Transmitter Terminal (PTT) in the laboratory (on a float and on captive seals) and on a free-ranging harbor seal in the Southern California Bight to investigate the utility of satellite telemetry in documenting seals' at-sea behavior and movements. We used records from a microprocessor-based time-depth recorder (TDR) to interpret location and diving records from the PTT. For the free-ranging harbor seal, we obtained at least one uplink during 70\% (while the seal was at sea) to 82\% (while she was ashore) of satellite passes and at least one location each day. Of 62 locations determined by Service Argos for the free-ranging seal, 20 were verified from TDR records to have been at sea; these indicated that the seal may have ranged up to 48 km from the haul-out site, although most locations were within 5 km. The accuracies of locations calculated when the seal was at sea ({$\pm$} 15 km) were substantially less than when it was ashore ({$\pm$} 1.5 km), thus limiting at-sea tracking of seals by satellite to rather gross movements. Fewer transmissions were detected and locations calculated when the seal was actively diving than when it was swimming near the surface as it departed from or returned to the haul-out site. Consequently, average dive durations indicated by the PTT were substantially shorter than those calculated from TDR records. Documentation of foraging areas and detailed at-sea movements using satellite technology may not be possible for pinnipeds unless PTT-transmission rates are increased substantially from the 1 per 45 sec maximum rate now permitted by Service Argos.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {2247,diving,harbour,migrations,movements,PBS Record: 306,Phoca vitulina,satellite,satellite telemetry,satellite telemetry/harbor seal/Phoca vitulina ric,seals,TDR,techniques},
  mendeley-tags = {2247,PBS Record: 306},
  number = {4}
}

