@article{Miron2006,
  title = {Effect of Diet Quality on Carbon and Nitrogen Turnover and Isotopic Discrimination in Blood of a {{New World}} Nectarivorous Bat},
  author = {Miron, M L L and Herrera, M L G and Ramirez, P N and Hobson, K A},
  year = {2006},
  volume = {209},
  pages = {541--548},
  doi = {10.1242/jeb.02016},
  abstract = {Diet composition of carbon and nitrogen (C:N) could affect diet-tissue isotopic discrimination and elemental turnover rate in consumers but studies that test the nature of these changes are scarce. We compared carbon and nitrogen isotopic discrimination and turnover rates in individuals of Pallas' long-tongued bats Glossophaga soricina fed diets with protein soya isolate or amaranth grains as their main source of protein. Diets were of similar protein biological value but the soya diet had higher nitrogen content (2.2\%N) and lower C:N ratio (39.6) than the amaranth diet (1.3\%N, C:N=40.5). Most bats on the soya diet gained body mass whereas most bats on the amaranth diet lost body mass. Half-lives of carbon (24.3 +/- 3.8 days) and nitrogen (25.6 +/- 4.4 days) in bats switched to the soya diet were very similar. In contrast, in the bats switched to the amaranth diet, carbon half-life (39.7 +/- 3.4 days) was longer than that of nitrogen (25.0 +/- 6.0 days). The enrichment in N-15 between diet and blood was higher when bats were fed the amaranth diet (4.4 +/- 0.2 parts per thousand) than when they were fed the soya diet (3.3 +/- 0.2 parts per thousand). Similarly, bats on the amaranth diet had higher C-13 enrichment (2.0 +/- 0.2 parts per thousand) than bats on the soya diet (0.1 +/- 0.1 parts per thousand). Our results support recent hypotheses of the effect of nutrition on diet-tissue isotopic discrimination and turnover rate, and further shows that blood stable isotope analysis is an adequate approach to track seasonal dietary shifts in wild bats.},
  isbn = {0022-0949},
  journal = {Journal of Experimental Biology},
  keywords = {blood,C-13,carbon-13,ECOLOGY,fractionation,FRACTIONATION,FRUGIVOROUS BATS,Glossophaga,nectarivorous bat,nitrogen-15,POLLEN,PROTEIN,REQUIREMENTS,SEASONAL-CHANGES,soricina,stable isotope,STABLE-ISOTOPES,TISSUES},
  language = {English},
  number = {3}
}

@inproceedings{Miroslaw-Grabowska2007,
  title = {Reconstruction of Environmental Conditions of {{Eemian}} Palaeolake at {{Studzieniec}} ({{Central Poland}}) on the Basis of Stable Isotope and {{Cladocera}} Analyses},
  author = {{Miroslaw-Grabowska}, J and Niska, M},
  year = {2007},
  pages = {195--204},
  publisher = {{Pergamon-Elsevier Science Ltd}},
  doi = {10.1016/j.quaint.2006.08.003},
  abstract = {The results of isotopic and Cladocera investigations of the Eemian lacustrine sediments of Studzieniec palaeolake (Central Poland) are presented. The 12-m thick section contains silty sands and clayey silts on the bottom, then gyttja, and organic silts and peat in the upper part. Based on the results of stable isotope analysis of carbonates the 11 isotopic horizons (Is) were defined and characterised. Results of isotopic analysis correlated with Cladocera and pollen data enabled reconstruction of varying environment conditions. The environmental changes were caused by: a transition from the glaciation to the interglacial period expressed by a significant decrease in 6 (18)0 (Is 3); a warming of climate characterised by a positive trend in delta O-18(Is 3-6); an increase of biological activity noted as very high positive values of delta C-13 above+ 7 parts per thousand (Is 7). The fluctuations of the isotopic values at the upper part of the section probably point to a shallowing of the take due to sedimentary infill (Is 9-10). In the studied deposits 23 species of the subfossil Cladocera were identified and seven zones of faunal development were distinguished. The Studzieniec palaeolake was sufficiently a shallow reservoir. The Cladocera composition indicates the initial oligotrophic status of the lake and then its subsequent increase and the periods of higher density of macrophytes during the interglacial optimum. The low frequency of Cladocera remains in carbonate-rich deposits may be caused by a state of preservation of faunal assemblages or the fast rate of sediment accumulation. (c) 2006 Elsevier Ltd and INQUA. All rights reserved.},
  language = {English}
}

@article{Miroslaw-Grabowska2007a,
  title = {Isotope and {{Cladocera}} Data and Interpretation from the {{Eemian}} Optimum and Postoptimum Deposits, {{Kaliska}} Palaeolake ({{Central Poland}})},
  author = {{Miroslaw-Grabowska}, J and Niska, M},
  year = {2007},
  volume = {175},
  pages = {155--167},
  doi = {10.1016/j.quaint.2007.03.018},
  abstract = {During the Eemian optimum, calcareous gyttja and lake marl accumulated. The characteristic feature of calcareous gyttja is an occurrence of fragments of diatoms and plants, while in lake marl they are absent. In the carbonate-rich deposits no Cladocera remains are preserved. Based on the results of stable isotope analyses of carbonates, the eight isotopic horizons (Is) were defined and characterised. In the studied deposits, 15 species of subfossil Cladocera were identified and 6 zones of fauna development were distinguished. The defined Cladocera species are similar to ones known from the other Eemian site in Poland. The faunal taxa indicate the low trophy status of the lake initially, followed by an increase to eutrophic status. The Cladocera and isotopic compositions suggest that the hornbeam zone (E5) was a period of higher density of macrophytes as well as of an increase of biological activity associated with the low water level. The fluctuations of the isotopic curves caused by a shallowing of the basin and a change of sediment lithology are characteristic for the spruce zone (E6). The palaeolake transformed into a peatbog during the pine zone (E7). During the Early Vistulian renewed carbonate accumulation and Cladocera development took place indicating the repeated reservoir existence. (C) 2007 Elsevier Ltd and INQUA. All rights reserved.},
  isbn = {1040-6182},
  journal = {Quaternary International},
  keywords = {CENTRAL GERMANY,CENTRAL-EUROPE,CLIMATE,DENMARK,ECOLOGY,INDICATORS,OXYGEN,POLLEN,RECONSTRUCTION,STABLE-ISOTOPE},
  language = {English}
}

@article{Misarti2009,
  title = {Changes in Northeast {{Pacific}} Marine Ecosystems over the Last 4500 Years: Evidence from Stable Isotope Analysis of Bone Collagen from Archeological Middens},
  author = {Misarti, N and Finney, B and Maschner, H and Wooller, M J},
  year = {2009},
  volume = {19},
  pages = {1139--1151},
  doi = {10.1177/0959683609345075},
  abstract = {Changes in food web dynamics and ocean productivity over the past 4500 years are investigated using stable isotope analysis of nitrogen and carbon in collagen from animal bones preserved in coastal archeological middens on Sanak Island, along the eastern edge of the Aleutian archipelgo. Samples included Steller sea lions, Harbor seals, Northern fur seals, sea otters, Pacific cod and sockeye salmon. Sea otters had the highest delta C-13 (-11.9 +/- 0.7 parts per thousand) and lowest delta N-15 values (14.5 +/- 1.4 parts per thousand), Northern fur seals had the lowest delta C-13 values (-13.6 +/- 1.4 parts per thousand), and Steller sea lions had the highest delta N-15 values (18.4 +/- 1.4 parts per thousand) of the marine mammals. Cod isotope values were consistent with those of demersal organisms from near shore habitats (-12.5 +/- 0.9 parts per thousand delta C-13, 16.1 +/- 1.4 parts per thousand delta N-15), while salmon values were consistent with those of organisms existing in an open ocean habitat and at a lower trophic level (-15.2 +/- 1.4 parts per thousand d13C, 11.5 +/- 1.7 parts per thousand delta N-15). When comparing six different prehistoric time periods, two time periods had significantly different delta C-13 for salmon. Otters had significantly different delta N-15 values in two out of the six prehistoric time periods but no differences in delta C-13. The mean delta C-13, corrected for the oceanic Suess Effect, of modern specimens of all species (except Northern fur seals) were significantly lower than prehistoric animals. Several hypotheses are explored to explain these differences including a reduction in productivity during the twentieth century in this region of the Gulf of Alaska. If true, this suggests that North Pacific climate regimes experienced during the twentieth century may not be good analogs of North Pacific marine ecosystems during the late Holocene.},
  isbn = {0959-6836},
  journal = {Holocene, The},
  keywords = {ALEUTIAN ISLANDS,BERING-SEA,bone collagen,carbon,food webs,GADUS-MACROCEPHALUS,KILLER WHALES,late Holocene,LION EUMETOPIAS-JUBATUS,Marine ecosystem,middens,nitrogen,North Pacific,ocean productivity,PRINCE-WILLIAM-SOUND,SEQUENTIAL MEGAFAUNAL COLLAPSE,stable isotopes,STELLER SEA LIONS,TEMPERATURE VARIABILITY,TROPHIC RELATIONSHIPS},
  language = {English},
  number = {8}
}

