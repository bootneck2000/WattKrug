@article{Rybnikov2000,
  title = {Influence of Sedimentation Conditions on the Distribution of Macrobenthos in the Salt Lagoon of {{St}}. {{Paul Island}} ({{Pribilof}} Archipelago, the {{Bering Sea}})},
  author = {Rybnikov, P V and Poyarkov, S G and Dritz, A V},
  year = {2000},
  volume = {40},
  pages = {65--71},
  abstract = {A complex pattern of bottom fauna distribution was found in the salt lagoon of St. Paul Island. The bottom ecosystem of this comparatively small volume of water (slightly bigger than 0.5 km(2)) with practically oceanic salinity consisted of several distinct communities with different quantitative and qualitative structure. This pattern was formed due to a complex of interacting environmental factors such as particularities of sedimentation, tidal and wind currents and bottom relief. Detailed studies of sediments chemistry showed, that organic matter of both marine and terrestrial origin was present in bottom sediments. The ratio of marine and terrestrial organics varied in different parts of the lagoon, which was reflected in the bottom biota distribution. The influence of environmental factors on the structure of the salt lagoon benthic communities is discussed. [References: 10]},
  journal = {Okeanologiya},
  number = {1}
}

