@article{Darr2008,
  title = {Stable Isotope Trophic Shifts in White-Tailed Deer},
  author = {Darr, R L and Hewitt, D G},
  year = {2008},
  volume = {72},
  pages = {1525--1531},
  doi = {10.2193/2006-293},
  abstract = {Differences between diet and tissue isotope values known as trophic shifts (Delta delta C-13 and Delta delta N-15) occur during digestion and assimilation of consumed food. Consideration of trophic shifts is essential when using stable isotopes for dietary reconstruction but has received little attention for cervids. Therefore, our purpose was to determine C and N trophic shifts in tissues of captive white-tailed deer (Odocoileus virginianus) fed corn and alfalfa in known amounts over a 4-month period. Antler has also received limited consideration for use in dietary, reconstruction, thus, we analyzed tissue to expose variation among locations along the main beam and between antler components. We collected antler, hair, red blood cells (RBCs), and serum at the end of the feeding trial and analyzed them to determine C (delta C-13) and N (delta N-15) isotope values. Trophic shifts occurred between diet and all tissues for both isotopes with mean Delta delta C-13 = 1.19 +/- 2.23 parts per thousand and Delta delta N-15 = 4.93 +/- 0.74 parts per thousand. Antler trophic shifts were greater than those in all other tissues for delta C-13, whereas antler and RBCs shared similar trophic enrichment over diet but differed from hair and serum for Delta delta N-15. Trophic shift values were significantly related to diet in hair and serum for delta C-13 and antler and RBCs for Delta delta N-15. Isotope values for antler core and periphery plus antler locations along the main beam did not vary. Antler collagen significantly varied from whole antler for delta C-13 but not delta N-15. Our findings provide mean trophic shift values by tissue that Call be used for dietary reconstruction in the study and management of cervids.},
  isbn = {0022-541X},
  journal = {Journal of Wildlife Management},
  keywords = {BEARS,BIOGEOCHEMISTRY C-13,carbon,CARBON ISOTOPES,cervid,COLLAGEN,Delta delta C-13,Delta delta N-15,DIET,dietary,ECOLOGY,FOOD-WEB,FRACTIONATION,nitrogen,NITROGEN,Odocoileus virginianus,reconstruction,stable isotope,trophic shift,TURNOVER,white-tailed deer},
  language = {English},
  number = {7}
}

