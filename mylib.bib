@article{Seaborn2005,
  title = {Depot Fatty Acid Composition in Immature Green Turtles ({{Chelonia}} Mydas) Residing at Two near-Shore Foraging Areas in the {{Hawaiian Islands}}},
  author = {Seaborn, G T and Moore, M K and Balazs, G H},
  year = {2005},
  volume = {140},
  pages = {183--195},
  doi = {10.1016/j.cbpc.2004.09.017},
  abstract = {The lipid content and fatty acid composition of depot fat were determined for 58 immature Green turtle; (Chelonia mydas) residing at two near-shore foraging areas, Ahu-O-Laka, located in Kaneohe Bay on Oahu, and Kiholo Bay located on the island of Hawaii. Benthic flora at Kiholo was limited to a single algal species but included algae and seagrass at Ahu-O-Laka. Turtle straight carapace length ranged froth 38.6 to 59.2 cm, suggesting that the sample set included new recruits to up to 12-year residents. Fatty acid data were analyzed using principal components analysis (PCA). PC1 accounted for over 50\% of the variance. Turtles were generally delineated alone PC1 by the length of time on benthic foraging grounds. with high (\textquestiondown 0.75) negative loadings for the fatty acids 22:6n-3, 7M7H, t16:1n-10, 15:0, and 17:0 associated with relatively new recruits (suggesting a pelagic dietary source for these fatty acids) and high positive loadings for 12:0 and 14:0 associated with lone-teen residents. PC2 separated turtles primarily by capture location, with high positive loadings for 18:2n-6 and 18:3n-3 [the primary seagrass polyunsaturated fatty acids] associated with the Ahu-O-Laka turtles. Fatty acid profiles of turtles horn both locations differed substantially froth those of their benthic diets. suggesting considerable modification of dietary fatty acids and de novo biosynthesis. (C) 2004 Elsevier Inc. All rights reserved.},
  isbn = {1096-4959},
  journal = {Comparative Biochemistry and Physiology B-Biochemistry \& Molecular Biology},
  keywords = {algae,Chelonia mydas,DERMOCHELYS-CORIACEA,diet,fatty acids,FIBROPAPILLOMATOSIS,FISH,gas chromatography,HABITAT USE,INVERTEBRATES,lipid,LIPIDS,MARINE,marine turtle,SEA,seagrass,SIGNATURES,TRANS-6-HEXADECENOIC ACID},
