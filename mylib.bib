@article{Wada1988,
  title = {Genetic Differentiation between Two Forms of Short-Finned Pilot Whales off the Pacific Coast of Japan},
  author = {Wada, S},
  year = {1988},
  pages = {91--102},
  abstract = {The northern and southern forms of the short-finned pilot whale off the Pacific coast of Japan were examined by horizontal starch gel electrophoresis on 36 enzyme loci using 371 specimens. Two and five loci were variable in the northern and southern forms, respectively. The proportion of polymorphic loci under the 0.95 criterion and the value of the average heterozygosity per locus were 0.028 and 0.009 in the northern form and 0.056 and 0.008 in the southern form, respectively. No significant deviation in genotype frequencies from the Hardy-Weinberg expectations was seen in either form. Significant between-form difference in genic proportions revealed that the northern form is genetically isolated from the southern form. From the value of Nei's genetic distance, 0.0004, the degree of genetic differentiation between two forms was considered to be of the local population level.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Anatomy and Histology,Animal Distribution (1971- ) [62800],Animals,Biochemical Methods/Proteins,Biochemical Studies/Proteins,Cetaceans,Chorda,Chordata,Chordates,Coenzymes [10802],Comparative Biochemistry,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Enzymes/Chemical and Physical [10806],Enzymes/General and Comparative Studies,Enzymes/Methods [10804],Evolution [01500],General [10010],General and Comparative/Com,General and Systematic Zoology/Mammalia,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/Population Genetics (197,Mammalia,Mammals,Mathematical Biology and Statistical Methods [0450,Nonhuman Mammals,Nonhuman Vertebrates,Peptides and Amino A,Vertebrata,Vertebrates},
