@article{Schreiber1998,
  title = {Immunogenetic Evidence for the Phylogenetic Sister Group Relationship of Dogs and Bears ({{Mammalia}}, {{Carnivora}}: {{Canidae}} and {{Ursidae}}): {{A}} Comparative Determinant Analysis of Carnivoran Albumin, {{C3}} Complement and Immunoglobulin Mu-Chain},
  author = {Schreiber, Arnd and Eulenberger, Klaus and Bauer, Klausdieter},
  year = {1998},
  volume = {15},
  pages = {154--170},
  abstract = {Thirty-seven antigenic determinants were identified in the albumins, the immunoglobulin mu- and IgG(Fc) chains, and the C3 proteins of 51 carnivoran (sub)species from 31 genera, and in 12 noncarnivoran mammals. In addition to 19 determinants plesiomorphic for Carnivora as an order, 18 synapomorphic epitopes of carnivoran families revealed nine phylogenetic reaction groups: (1)canids, (2) ursids, (3) the racoon, (4) the Weddell seal, (5) the lesser panda, (6) the harbour seal, (7) mustelids, (8) viverrids and hyaenas, and (9) felids. These data identify Canoidea (Canidae, Ursidae, Phocidae, Procyonidae, Ailuridae, Mustelidae) and Feloidea (Viverridae, Hyaenidae, Felidae) as two fundamentally differentiated lineages of Carnivora, and confirm the inclusion of seals among the former. The Ursidae are the sister group of the Canidae. The antigenic determinants in the studied proteins do not subdivide the Canidae, Ursidae and Felidae into immunologically differentiated lineages.},
  isbn = {0254-9670},
  journal = {Experimental and Clinical Immunogenetics},
  keywords = {albumin,albumin. immunoglobulin mu-chain. immunoglobulin G,analysis,Animals. Carnivores. Chordates. Mammals. Nonhuman,bear (Ursidae). dog (Canidae). harbor seal (Phocid,Biochemical Studies/General [10060],C3 complement,Canidae,Canidae [85765],Canidae: Carnivora,Canoidea,Carnivora,Carnivora-Unspecified [85760],Chordata,comparative determinant,CYTOCHROME-B,Evolution [01500],Evolution and Adaptation. Immune System (Chemical,Felidae [85770],Feloidea,GENES,Genetics and Cytogenetics/Animal [03506],Hyaenidae [85775],immunoglobulin mu-chain,immunologically differentiated lineages. molecular,Immunology and Immunochemistry/General,Mammalia,Methods [34502],MITOCHONDRIAL,Mustelidae [85780],Phocidae [86185],phylogenetic systematics,Procyonidae [85785],SEQUENCES,Ursidae,Ursidae [85790],Vertebrata,Viverridae [85795]},
  language = {English},
  number = {3}
}

@article{Schreiber1998a,
  title = {Allozyme Variability in {{Black Grouse}} ({{Tetrao}} Tetrix), a Tetraonid with Lek Behaviour},
  author = {Schreiber, A and Weitzel, T and Strauss, E},
  year = {1998},
  volume = {139},
  pages = {55--66},
  abstract = {The allozyme variability of 38 genetic loci coding for blood proteins was compared in up to 95 Black Grouse originating from Bavaria, the Netherlands and two sites in Sweden, bred to restock the Central European lowland populations. Polymorphisms are described for Ada*, Pgd*, and Pgm-1*, yielding an overall fraction of polymorphic loci of P = 0.079, and an observed heterozygosity of H-0 = 0.015 (H-e = 0.018). The genotype distributions at the Ada* locus differed significantly between regional stocks, but unbiased standard distances measured D = 0.0060 at most. Considering the inferred importance of genetic drift for Black Grouse microevolution, these slight genetic distances do not provide a basis for judging the validity of a suggested subspecies from the Netherlands. The weight differences of the eggs laid by grouse from different regional stocks reached statistical significance. A heterosis effect is inferred from the heavier eggs produced by F-1 crosses between parents originating from disparate geographic origins.},
  isbn = {0021-8375},
  journal = {Journal Fur Ornithologie},
  keywords = {DIFFERENTIATION,effective population size,egg weight,Galliformes,genetic drift,GENETIC-STRUCTURE,LAGOPUS-LAGOPUS-LAGOPUS,POPULATIONS,TERRITORIALITY},
  language = {English},
