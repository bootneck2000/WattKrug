@article{Maitra2009,
  title = {Noise Estimation in Magnitude {{MR}} Datasets},
  author = {Maitra, R and Faden, D},
  year = {2009},
  volume = {28},
  pages = {1615--1622},
  doi = {10.1109/tmi.2009.2024415},
  abstract = {Estimating the noise parameter in magnitude magnetic resonance (MR) images is important in a wide range of applications. We propose an automatic noise estimation method that does not rely on a substantial proportion of voxels being from the background. Specifically, we model the magnitude of the observed signal as a mixture of Rice distributions with common noise parameter. The expectation-maximization (EM) algorithm is used to estimate all parameters, including the common noise parameter. The algorithm needs initializing values for which we provide some strategies that work well. The number of components in the mixture model also needs to be estimated en route to noise estimation and we provide a novel approach to doing so. Our methodology performs very well on a range of simulation experiments and physical phantom data. Finally, the methodology is demonstrated on four clinical datasets.},
  isbn = {0278-0062},
  journal = {IEEE Transactions on Medical Imaging},
  keywords = {Bayes information criterion (BIC),distribution,EM ALGORITHM,histogram-based estimate,image,IMAGES,mixture model,MODEL,model-based clustering,Rayleigh,Rice distribution,segmentation,VARIANCE},
  language = {English},
  number = {10}
}

