@article{Zentenosavin1997,
  title = {Plasma Haptoglobin Levels in Threatened {{Alaskan}} Pinniped Populations.},
  author = {Zentenosavin, T and Castellini, M A and Rea, L D and Fadely, B S and {Zenteno-Savin}, T and Castellini, M A and Rea, L D and Fadely, B S},
  year = {1997},
  volume = {33},
  pages = {64--71},
  abstract = {We evaluated the plasma concentration of the acute phase protein haptoglobin (Hp) from Steller sea lions (Eumetopias jubatus) and harbor seals (Phoca vitulina) in regions of Alaska (USA) where the populations of these pinnipeds were declining and compared the values with concentrations of Hp from the same species in areas where the populations mere stable. Samples were collected from 1992 through 1994 at sites in Southeast Alaska, Prince William Sound, the Gulf of Alaska, and the Aleutian Islands. Significantly higher levels of Hp were found in the samples from the areas of decline compared to those from stable populations. Based on these findings, we propose that one may be able to distinguish these compromised pinniped populations using Hp as a biomedical indicator. [References: 41]},
  journal = {Journal of Wildlife Diseases},
  keywords = {5093,Blood,Blood chemistry,blood parameters,Disease,diseases,Eumetopias jubatus,Harbor seal (phoca vitulina),Health,Island,Mass.,Number,Phoca vitulina,Sea lions,Serum-proteins,Steller sea lion (eumetopias jubatus),Stress.,Veterinary medicine/animal health.},
