@article{MercadoIII1999,
  title = {Environmental Constraints on Sound Transmission by Humpback Whales},
  author = {Mercado III, Eduardo and Frazer, L Neil},
  year = {1999},
  volume = {106},
  pages = {3004--3016},
  abstract = {Singing humpback whales in Hawaii produce a variety of sounds at high source levels (ca. 185 dB re: 1 muPa), in coastal waters 15-500 m deep. These sounds are attenuated and distorted as they propagate away from a singer, limiting the utilizable range of the sounds. In the current study, simulations based on normal-mode theory were used to investigate how the effects of shallow-water propagation constrain humpback whales' use of sound. It is shown that humpbacks can greatly affect transmission range by adjusting their positions and sounds in response to environmental factors. Source depth, in particular, is shown to be a major determinant of which frequencies propagate the farthest. A preliminary analysis of range-dependent distortion suggests that spectral cues can potentially provide listening whales with information about how far a sound has traveled.},
  journal = {Journal of the Acoustical Society of America},
  keywords = {[07003] Behavioral biology - Animal behavior,[07006] Behavioral biology - Animal communication,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[10502] Biophysics - General,[20001] Sense organs - General and methods,[85810] Balaenopteridae,Balaenopteridae: Animals,Behavior,Cetacea,Cetaceans,Chordates,Communication,Environmental Sciences,humpback whale [Balaenopteridae],Ma,Mammalia,Marine Ecology: Ecology,singing,sound attenuation,sound transmission environmental constraints,Verteb,vocalization},
  number = {5}
}

