@article{Koopman1999,
  title = {Hematology Values of Wild Harbor Porpoises ({{Phocoena}} Phocoena) from the {{Bay}} of {{Fundy}}, {{Canada}}},
  author = {Koopman, Heather N and Westgate, Andrew J and Read, Andrew J},
  year = {1999},
  volume = {15},
  pages = {52--64},
  abstract = {Clinical hematology values were determined for 29 harbor porpoises (Phocoena phocoena) released from herring weirs in the Bay of Fundy, Canada. Erythrocyte values exhibited narrow ranges, but there was a high degree of individual variability in counts of white blood cells. Total white cell counts ranged from 2l.6 to 15.5 x 109/liter, with an overall mean of 6.5 {$\pm$}2.7 x 109/liter. There were significant differences among reproductive classes in mean values of total red blood cells, hematocrit (HCT), mean cell volume (MCV), mean cell hemoglobin (MCHC) and total monocyte count. Wild harbor porpoises had fewer white blood cells, lower relative total number of neutrophils and lymphocytes, and higher percentages of monocytes and eosinophils than reported in the literature for captive porpoises. Compared to published values for other odontocetes, the hemograms of harbor porpoises were most similar to those of Pacific white-sided dolphins (Lagenorhynchus acutus). These hematology data represent a baseline from free-ranging harbor porpoises that can be used as a reference for long-term monitoring of the health of this population and as a tool for rehabilitation facilities.},
