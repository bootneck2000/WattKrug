@article{Slip1992a,
  title = {Body Mass Loss Utilisation of Blubber and Fat and Energetic Requirements of Male Southern Elephant Seals Mirounga-Leonina during the Moulting Fast},
  author = {Slip, D J and Gales, N J and Burton, H R},
  year = {1992},
  volume = {40},
  pages = {235--243},
  abstract = {The energetic requirements of male southern elephant seals, Mirounga leonina, were estimated from mass loss, and changes in blubber mass determined by ultrasound in 11 seals over the moulting fast. Mean rate of mass loss was 9.60 .+-. 2.25 kg day-1 or 6.46 .+-. 0.77 g kg-1day -1, with about 63\% of this lost as fat. Blubber was depleted by about 48\% over the moulting period. The relative distribution of blubber remained unchanged after the moult, and seals lost blubber at similar rates over all areas of the body. Energy expenditure was estimated to be 7.54 .+-. 2.82 MJ kg-1 over the mean 35.6-day moulting period.},
  journal = {Aust. J. Zool},
  keywords = {945,body composition,drugging,energetics,mass loss,metabolic rate,Mirounga leonina,molting,ultrasound},
  mendeley-tags = {945},
