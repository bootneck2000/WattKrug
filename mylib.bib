@article{Bernadelli1996,
  title = {Tuberculosis in Sea Lions and Fur Seals from the South-Western {{Atlantic}} Coast.},
  author = {Bernadelli, A and Bastida, R and Loureiro, J and Michelis, H and Romano, M I and Cataldi, A and Costa, E and Bernardelli, A and Bastida, R and Loureiro, J and Michelis, H and Romano, M I and Cataldi, A and Costa, E},
  year = {1996},
  volume = {15},
  pages = {985--1005},
  abstract = {Diverse pathological conditions causing the strandings and/or deaths of several species of sea lions and seals on the northern coast of the province of Buenos Aires are being studied Tuberculosis was diagnosed in six cases of strandings, involving two otariid seal species (one Otaria flavescens and five Arctocephalus australis), between March 1989 and December 1992. Necropsies were performed on all six cases. Granulomatous lesions were observed in the prescapular and hepatic lymph nodes. Lesions were also seen in the lungs, pleura, liver spleen and peritoneum. Bacteriological isolation was attempted from all the samples. The isolates were identified as belonging to the Mycobacterium tuberculosis complex. Some showed characteristics consistent with M. bovis, whereas others demonstrated properties of M. tuberculosis. Genomic deoxyribonucleic acid (DNA) from these strains was analysed by restriction fragment length polymorphism (RFLP), using IS6110, a genetic marker found only in the Mycobacterium tuberculosis complex. Using the IS6110 probe, similar fingerprints were obtained, suggesting a common source of infection. However, the pattern of DNA differed from DNA patterns of M. bovis isolated from humans and cattle in Argentina, which generally contain a unique 1.9 kbp band. These results suggest that mycobacteria isolated from wild seals form a different grouping inside the M. tuberculosis complex. This is the first time that tuberculosis has been detected in wild seals from the south-western Atlantic coast.},
  journal = {Revue Scientifique et Technique Office International des Epizooties},
  keywords = {5122,animals. bacteria. chordates. eubacteria. mammals.,Arctocephalus australis,Argentina (South America. Neotropical region).,Bacteria. Otariidae:,Bacterial Disease. Blood and Lymphatics. Buenos Ai,Biochemical Studies/Nucleic Acids,Biochemistry and Molecular Biophysics. Blood and L,Blood,Blood-Forming Organs and Body Fluids/Blood,Digestive System/Pathology [14006],diseases,fur seal (Otariidae). sea lion (Otariidae). seal (,General and Miscellaneous/Diagnostic [1,General and Miscellaneous/Necrosis (197,Genetics of Bacteria and Viruses [31500],Medical and Clinical Microbiology/Bacteriology [36,Mycobacteriaceae (1992- ) [08881],Mycobacteriaceae: Eubacteria,Otaria byronia,Otariidae [86180],Pathology,Purines and Pyr,Respiratory System/Pathology [16006]},
