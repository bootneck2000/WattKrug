@article{Was2008,
  title = {Evidence for Population Structuring of Blue Whiting ({{Micromesistius}} Poutassou) in the {{Northeast Atlantic}}},
  author = {Was, A and Gosling, E and McCrann, K and Mork, J},
  year = {2008},
  volume = {65},
  pages = {216--225},
  doi = {10.1093/icesjms/fsm187},
  abstract = {Many marine fish species are characterized by large population sizes, strong migratory behaviour, high fecundity, and pelagic eggs and larvae that are subject to passive transport by ocean currents, all factors that tend to reduce the rate of development of genetic partitioning among localized populations. The blue whiting (Micromesistius poutassou) is a commercially important gadoid that exhibits all these characteristics, although to date there has been little evidence of genetic heterogeneity except at the latitudinal extremes of its range in the NE Atlantic. Genetic variation was analysed at five microsatellite loci in 16 samples, 14 comprising spawning adults, collected along the continental shelf from 44 degrees N to 60 degrees N, a distance of similar to 1900 km. Although pairwise F-ST values were low (0.0-0.040; mean 0.0097), more than 40\% of the estimates were significant, with Celtic Sea and Bay of Biscay samples significantly differentiated from samples from the Porcupine Bank, Hebridean Shelf, Sulisker Bank, and Papa Bank. There was also significant differentiation between samples taken in different years on Rockall Bank. Mantel tests revealed no significant isolation by distance. We used a landscape genetics approach, which combines spatial and genetic information, to detect barriers to gene flow. Four zones of lowered gene flow were identified, generally in concordance with hydrographic patterns, fish spawning behaviour, and the simulated transport of larvae in the NE Atlantic Ocean.},
  isbn = {1054-3139},
  journal = {ICES Journal of Marine Science},
  keywords = {blue whiting,COD GADUS-MORHUA,gene flow,genetic differentiation,GENETIC-STRUCTURE,HERRING CLUPEA-HARENGUS,HETEROZYGOTE DEFICIENCY,landscape genetics,LANDSCAPE GENETICS,Micromesistius poutassou,MICROSATELLITE MARKERS,microsatellites,NORTHWEST ATLANTIC,POLLOCK,SPAWNING GROUNDS,TROUT ONCORHYNCHUS-CLARKI,WALLEYE},
  language = {English},
  number = {2}
}

