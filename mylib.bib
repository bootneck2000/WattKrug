@article{Wells2008,
  title = {Feeding Ecology of Red Snapper {{Lutjanus}} Campechanus in the Northern {{Gulf}} of {{Mexico}}},
  author = {Wells, R J D and Cowan, J H and Fry, B},
  year = {2008},
  volume = {361},
  pages = {213--225},
  doi = {10.3354/meps07425},
  abstract = {We used stable isotopes and stomach content analyses to describe diet of red snapper Lutjanus campechanus in the northern Gulf of Mexico (GOM). Approximately 1000 fish were collected over 2 yr to test possible effects of ontogeny, habitat, and a non-trawl artificial reef permit area on red snapper diets. Stable isotopes of carbon (delta C-13), nitrogen (delta N-15), and sulfur (delta 34S) were measured in both red snapper and potential primary producers. Ontogenetic shifts in diet occurred with increasing red snapper size-at-age, resulting in higher delta(13) C and nitrogen delta N-15 and lower delta S-34 in larger fish. Stomach content results supported ontogenetic shifts in diet by showing a change in diet from zooplankton, mysid shrimp, and squid for juvenile red snapper (ages 0 to 1) to diets dominated by benthic crustaceans and fishes for adults (ages 2+). Habitat-specific differences in isotopes and stomach contents of similarly sized fish were identified; however, feeding differences appeared to reflect ontogeny more than habitat type. In addition, seasonal differences, both in delta C-13 and in prey identified from stomach contents, were detected, but were minimal. Red snapper from areas outside a single non-trawl reef permit area had higher delta N-15 and lower delta S-34 values than for conspecifics collected inside the non-trawl reef permit area. This study highlights the use of stable isotopes in detecting red snapper feeding differences inside and outside of an artificial reef permit area in the northern GOM, but additional studies are needed to verify if similar trends are present in other areas.},
  isbn = {0171-8630},
  journal = {Marine Ecology-Progress Series},
  keywords = {artificial reef permit area,BENTHIC MICROALGAE,CARBON,DELTA-C-13,DELTA-N-15 ANALYSIS,feeding,FISH,FOOD WEBS,habitat,HABITAT,MARINE,ontogeny,red snapper,stable isotopes,STABLE-ISOTOPE ANALYSES,stomach contents,TROPHIC IMPORTANCE},
  language = {English}
}

