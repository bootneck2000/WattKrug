@article{BradshawCorey2000,
  title = {Modeling Tag Loss in {{New Zealand}} Fur Seal Pups},
  author = {Bradshaw Corey, J A and Barker Richard, J and Davis Lloyd, S and Bradshaw, Corey J A and Barker, Richard J and Davis, Lloyd S},
  year = {2000},
  volume = {5},
  pages = {475--485},
  abstract = {Mark-recapture studies of pinnipeds commonly use double-tagging to reduce bias of parameter estimates and to allow estimation of tag retention rates. However, most tag retention estimates assume independence of tag loss. Here we were able to identify when individual New Zealand fur seal (Arctocephalus forsteri) pups had lost both tags; therefore, we tested the assumption of no association between the tag-loss rates of left and right tags. We also tested for differences in tag retention among three different types of plastic tag (Allflex(R) cattle, mini and button tags), between two attachment types (i.e., fixed or swivel), and whether retention varied among years and colonies sampled. We found strong evidence of within-individual tag loss association for most tags in most years, but little evidence that this varied among colonies. We found that ignoring within-individual association of tag loss led to a bias in estimated tag retention of 7.4-10.1\%. Smaller rocks and greater crevice and ledge densities in colonies were associated with lower probabilities of tag retention. We suggest researchers should attempt to use permanent marks in combination with tags to assess unbiased estimates of tag retention.},
  journal = {Journal of Agricultural, Biological, \& Environmental Statistics.},
  keywords = {[00512] General biology - Conservation and resourc,[04500] Mathematical biology and statistical metho,[07502] Ecology: environmental biology - General a,[07516] Ecology: environmental biology - Wildlife,[10515] Biophysics - Biocybernetics,[86180] Otariidae,Allflex cattle tag: equipment,Arctocephalus forsteri: New Zealand fur seal,button tag: equipment,Chordates,Mammalia,Mammals,mini tag: equipment,Models and Simulations: Computational Biology,Nonhuman V,Otariidae: Animals,Pinnipedia,pup,tag loss modeling: tag retention,Vertebrat,Wildlife Management: Conservation},
  number = {4}
}

