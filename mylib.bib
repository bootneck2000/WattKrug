@article{Patterson1998,
  title = {Evidence for Infanticide in Bottlenose Dolphins - an Explanation for Violent Interactions with Harbour Porpoises},
  author = {Patterson, I A P and Reid, R J and Wilson, B and Grellier, K and Ross, H M and Thompson, P M},
  year = {1998},
  volume = {265},
  pages = {1167--1170},
  abstract = {Most harbour porpoises found dead on the north-east coast of Scotland show signs of attack by sympatric bottlenose dolphins? but the reason(s) for these violent interactions remain(s) unclear. Post-mortem examinations of stranded bottlenose dolphins indicate that five out of eight young calves from this same area were also killed by bottlenose dolphins. These data, together with direct observations of an aggressive interaction between an adult bottlenose dolphin and a dead bottlenose dolphin calf, provide strong evidence for infanticide in this population. The similarity in the size range of harbour porpoises and dolphin calves that showed signs of attack by bottlenose dolphins suggests chat previously reported interspecific interactions could be related to this infanticidal behaviour. These findings appear to provide the first evidence of infanticide in cetaceans (whales, dolphins and porpoises). We suggest that infanticide must be considered as a factor shaping sociality in this and other species of cetaceans, and may have serious consequences for the viability of small populations. [References: 19]},
  journal = {Proceedings of the Royal Society of London - Series B: Biological Sciences},
  keywords = {Aggression,Bottlenose dolphin,Cetacea,Conservation biology,Experimental biology.,Infanticide,Nosed dolphins,Pups.,Social structure.},
  number = {1402}
}

