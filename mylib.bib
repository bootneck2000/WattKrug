@article{Sibatani1993,
  title = {Stability of Arbitrary Structures Its Implications for Heredity and Evolution .2},
  author = {Sibatani, A},
  year = {1993},
  volume = {86},
  pages = {165--173},
  abstract = {Following Part I of this paper, I analyze, in Part II, the behaviour of various biological systems: the ''Hyponica'' tomatoes growing into a tremendous size without prior genetic selection; alternative, either innate or acquired, appearance of certain biological properties, such as the blindness of cave fish, ability of birds to sing in a species-specific fashion with dialects and to migrate over a long distance, or emergence of eusociality among hymenopterans which need not depend on the inclusive fitness. I generalize that both innate and acquired abilities among organisms are generated by preformed structures, only minor points of which may be modified genetically or environmentally, leading to the expression or non-expression of the properties in question. This may reflect configurational transformation of a structure, so that the innate ability may, under certain circumstances, be visibly governed by genetic factors. I feel that the evolution in recent geological periods depended mostly on the structures already extant in the biosphere of the earth. Evolution of such structures themselves, however, has so far largely remained beyond the scope of contemporary evolutionary biology.},
  isbn = {0035-6050},
  journal = {Rivista Di Biologia-Biology Forum},
  language = {English},
  number = {2}
}

