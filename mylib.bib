  keywords = {Animals,Biophysics/General Biophysical Techniques [10504],Cetaceans,Chorda,Chordata,Chordates,Coenzymes [10802],Comparative Biochemistry,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Environmental Biology/Oceanography [07512],Enzymes/Chemical and Physical [10806],Enzymes/General and Comparative Studies,General [10010],General and Systematic Zoology/Mammalia,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/Population Genetics (197,Mammalia,Mammals,Nonhuman Mammals,Nonhuman Vertebrates,Vertebrata,Vertebrates},
