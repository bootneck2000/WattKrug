@article{Taddei2001,
  title = {Genotoxic Hazard of Pollutants in Cetaceans: {{DNA}} Damage and Repair Evaluated in the Bottlenose Dolphin ({{Tursiops}} Truncatus) by the {{Comet Assay}}},
  author = {Taddei, F and Scarcelli, V and Frenzilli, G and Nigro, M},
  year = {2001},
  volume = {42},
  pages = {324--328},
  abstract = {Single cell gel electrophoresis (or Comet Assay) was used for evaluation of the in vitro genotoxicity of hydrogen peroxide (used as a positive control), polychlorinated biphenyls is (PCBs) (Aroclor 1254) and methyl mercury chloride, in isolated bottlenose dolphin leukocytes. Results showed that hydrogen peroxide and methyl mercury induced DNA strand breakage in a dose-dependent manner, while PCBs did not induce a clear dose-effect response at the Iom doses investigated. Efficiency in repairing DNA breakage induced by methyl mercury was also evaluated. Findings demonstrated that dolphin cells cure characterized by higher efficiency in DNA repair when compared to human leukocytes. The observed resistance to methyl mercury toxicity in dolphins was hypothesized to be a defence strategy developed to combat high dietary exposure and compensate for limited capacity to excrete persistent pollutants. (C) 2001 Elsevier Science Ltd. All rights reserved. [References: 28]},
  journal = {Marine Pollution Bulletin},
  keywords = {Aquatic Sciences in Current Contents(R)/Agricultur,Biomarkers,Cells,Dna damage.,Ecotoxicology,In-vitro,Lymphocytes,Mercury,Methyl mercury,Pcbs,Pcbs.,Selenium,Stenella-coeruleoalba,Striped dolphins,Tursiops truncatus,Vitamin},
  number = {4}
}

