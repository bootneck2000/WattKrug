@article{Douglas2004,
  title = {The Oceanic Sink for Anthropogenic {{CO2}}},
  author = {Sabine, Christopher L. and Feely, Richard A. and Gruber, Nicolas and Key, Robert M. and Lee, Kitack and Bullister, John L. and Wanninkhof, Rik and Wong, C. S. and Wallace, Douglas W.R. and Tilbrook, Bronte and Millero, Frank J. and Peng, Tsung Hung and Kozyr, Alexander and Ono, Tsueno and Rios, Aida F. and Douglas, W R and Frank, J},
  year = {2004},
  month = jul,
  volume = {305},
  pages = {367--371},
  issn = {00368075},
  doi = {10.1126/science.1097403},
  abstract = {Using inorganic carbon measurements from an international survey effort in the 1990s and a tracer-based separation technique, we estimate a global oceanic anthropogenic carbon dioxide (CO2) sink for the period from 1800 to 1994 of 118 {$\pm$} 19 petagrams of carbon. The oceanic sink accounts for {$\sim$}48\% of the total fossil-fuel and cement-manufacturing emissions, implying that the terrestrial biosphere was a net source of CO2 to the atmosphere of about 39 {$\pm$} 28 petagrams of carbon for this period. The current fraction of total anthropogenic CO2 emissions stored in the ocean appears to be about one-third of the long-term potential.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\6PWZ6QQT\\Sabine et al. - 2004 - The oceanic sink for anthropogenic CO2.pdf;C\:\\Users\\Andy\\Zotero\\storage\\DU7VZ7Q4\\Sabine et al. - Unknown - The Oceanic Sink for Anthropogenic CO 2.pdf},
