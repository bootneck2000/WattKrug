@article{Jones1981a,
  title = {Food Habits of Smaller Marine Mammals from Northern California {{USA}}},
  author = {Jones, R E},
  year = {1981},
  volume = {42},
  pages = {409--433},
  abstract = {General food habits are discussed for 11 spp. of small marine mammals [Phoca vitulina, Mirounga angustirostris, Eumetopias jubatus, Zalophus californianus, Callorhinus ursinus, Phocoena phocoena, Phocoenoides dalli, Delphinus delphis, Lagenorhynchus obliquidens, Grampus griseus and Kogia simus] beach-cast in northern California. The collection method allowed tabulation only of the kinds, numbers and percentages of fish, molluskan and crustacean prey. Dominant food species for all male Z. californianus were Merluccius productus (62.8\% occurrence), Engraulis mordax (23.8\%), Scorpaenidae (6.3\%) and Porichthys notatus (3.2\%). Octopus and Loligo also occurred in 7 (23.0\%) of 30 California sea lions examined. Nine of 19 individuals of E. jubatus contained food remnants of fish; 10 new dietary items are reported. Seven of the 9 also fed on invertebrates, including 4 kinds of cephalopods. Scorpaenidae (31.2\% occurrence), M. productus (21.7\%), Pleuronectidae (17.3\%) and Chilara taylori (11.8\%) were the principal fishes identified. Eight of 12 P. vitulina stomachs contained food (6 with fish, 2 with invertebrates). Embiotocids (41.9\% occurrence), Lycodopsis pacifica (27.9\%), Pleuronectidae (9.3\%) and Hexagrammos decagrammus (9.3\%) were the dominant fishes. The only cephalopod identified from Phoca was Octopus. The stomachs of all 7 individuals of L. obliguidens examined contained food. Osmerid fishes, Porichthys and juvenile rockfishes were the most frequent items identified. The presence of 5 genera of cephalopods suggests that Lagenorhynchus can take a wide variety of prey from several habitats. Juvenile Scorpaenidae, Engraulis, Merluccius and Microgadus made up 97\% of the diet of 20 individuals of Phocoena phocoena. The abundant cephalopod Loligo was a primary invertebrate food item and was ingested whole.},
  journal = {Proceedings of the California Academy of Sciences},
  keywords = {5161,Callorhinus ursinus,diet,Eumetopias jubatus,Mirounga angustirostris,Phoca vitulina,stomach content analyses,Zalophus californianus},
