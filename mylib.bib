@article{Slip1994,
  title = {Allozyme Variation in the Leopard Seal, {{Hydrurga}} Leptonyx},
  author = {Slip, David J and Green, Ken and Burton, Harry R and Mitchell, Peter J and Adams, Mark and Slip David, J and Green, Ken and Burton Harry, R and Mitchell Peter, J and Adams, Mark},
  year = {1994},
  volume = {17},
  pages = {1--5},
  abstract = {Blood samples collected from Leopard Seals, Hydrurga leptonyx, from Heard Island and Macquarie Island were surveyed electrophoretically for allozyme variation in blood proteins. Thirty four proteins encoded by a minimum of 39 genetic loci were surveyed; six of these were found to be polymorphic, but only one could be considered polymorphic at the 95\% level of significance. The mean observed heterozygosity was 0.011 +- 0.007, which is the lowest yet recorded for a species of Antarctic seal. Hydrurga leptonyx exhibited fixed allelic differences with the Southern Elephant Seal, Mirounga leonina, at 26\% of loci screened.},
  journal = {Australian Mammalogy},
  number = {1-5}
}

