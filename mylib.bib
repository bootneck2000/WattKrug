@article{Brooke1999,
  title = {Exploitation of Inland-Breeding {{Antarctic}} Petrels by South Polar Skuas},
  author = {Brooke, M. D.L. and Keith, D. and R{\o}v, N.},
  year = {1999},
  volume = {121},
  pages = {25--31},
  issn = {00298549},
  doi = {10.1007/s004420050903},
  abstract = {During the austral summer of 1996/1997 we studied south polar skuas at Svarthamaren, Dronning Maud Land, Antarctica, where the world's largest known colony of Antarctic petrels is found. Our censuses suggested approximately 250 full-grown skuas and 140,000 breeding pairs of petrels were present. During their breeding season, skuas did not visit the open sea at least 200 km from the site; they relied entirely on prey caught and scavenged from the petrel colony. Because the site is so isolated, we asked whether the prey (petrels) had swamped the predators (skuas), or whether there was evidence that predator numbers were limited by the size of the prey population. Particularly at the end of the petrel incubation period, we found a close correspondence between the energy required by adult skuas and their chicks, ascertained from time budget studies, and the rate at which petrel eggs disappeared from the colony. This suggests that, in this closed system, the predator population was limited by the prey population, and that predator swamping was not an advantage that petrels gained by nesting in this remote location.},
  journal = {Oecologia},
  keywords = {Antarctica,Daily energy expenditure,Predation rate,Predator swamping,Time budget},
  number = {1}
}

@article{Brookens2007,
  title = {Trace Element Concentration in the {{Pacific}} Harbor Seal ({{Phoca}} Vitulina Richardii) in Central and Northern {{California}}.},
  author = {Brookens, T J and Harvey, J T and O'Hara, T M},
  year = {2007},
  volume = {372},
  pages = {676--692},
  abstract = {To determine concentrations of trace elements (THg, MeHg, Se, and Pb) in tissues of the Pacific harbor seal (Phoca vitulina richardii), live (n = 186) and dead seals (n = 53) were sampled throughout central and northern California from March 2003 to January 2005. There were significant differences in THg concentrations in blood and hair based on age (p \textexclamdown{} 0.001). Adult male harbor seals had greater THg concentrations in their hair than adult female harbor seals (p \textexclamdown{} 0.003). THg concentrations in liver increased linearly with age and delta N-15 (p \textexclamdown{} 0.001); whereas, MeHg concentrations in liver increased exponentially until approximately 5 years of age with an asymptote at 1.3 mu g/g wet weight. MeHg expressed as a percentage of THg (\%MeHg) was best described by a decay function (r(2) = 0.796, p \textexclamdown{} 0.001), decreasing to a minimum at 4 years of age. Hepatic Se increased with age and was in equimolar ratios with THg in adults; whereas, molar ratio of Se:THg in pups deviated from a 1:1 ratio. Significant differences among study locations in THg concentrations in blood and hair were not detected. Assessing the possible effect of sampling location on Hg concentrations, however, was confounded and limited by lack of equal sample sizes for basic age and sex cohorts, a common dilemma in pinniped research. (c) 2006 Elsevier B.V. All rights reserved.},
  isbn = {0048-9697},
  journal = {Science of the Total Environment},
  keywords = {9887,ARCTIC ALASKA/,blood,BOWHEAD WHALES,ELEMENTS,FOOD-WEB,hair,harbor seals,HEAVY-METALS,INORGANIC MERCURY,lead,liver,mercury,MERCURY,METHYL,NONESSENTIAL,Phoca vitulina,pollution,RINGED SEALS,SAN-FRANCISCO BAY,selenium,stable isotopes,STABLE-ISOTOPE ANALYSIS},
  language = {English},
  mendeley-tags = {9887},
  number = {2-3}
}

@article{Brookens2008,
  title = {Total Mercury Body Burden in {{Pacific}} Harbor Seal, {{Phoca}} Vitulina Richardii, Pups from Central {{California}}.},
  author = {Brookens, T J and O'Hara, T M and Taylor, R J and Bratton, G R and Harvey, J T},
  year = {2008},
  volume = {56},
  pages = {27--41},
  doi = {10.1016/j.marpolbul.2007.08.010},
  abstract = {To determine body and tissue compartment-specific burdens (mg) of total mercury (THg), tissues were weighed and analyzed for THg concentration (mu g/g fw) in Pacific harbor seal (Phoca vitulina richardii) pups from central California in 2006. THg concentrations were related as follows: hair \textquestiondown\textquestiondown{} liver = kidney = pelt \textquestiondown{} muscle \textquestiondown{} other = heart \textquestiondown{} brain \textquestiondown{} blubber \textquestiondown{} bone. THg burden, however, was related as: pelt = muscle \textquestiondown{} liver = other \textquestiondown{} kidney = blubber \textquestiondown{} brain = heart \textquestiondown{} bone. THg concentration and burden in muscle were strongly associated with delta N-15.delta C-13 and delta N-15 values were significantly greater in muscle than liver, and delta C-13 was significantly lesser the longer animals were in rehabilitation. Because THg concentration and burden in muscle correlated most significantly with other tissue compartments, we recommend that muscle from the specific sites we sampled be used instead of liver or hair for biomonitoring THg in harbor seals. Assessment of proportional THg burdens within each tissue compartment for harbor seals pups included use of a conceptual model, allowing for more complete visual characterization of THg body burden. (c) 2007 Elsevier Ltd. All rights reserved.},
  isbn = {0025-326X},
  journal = {Marine Pollution Bulletin},
  keywords = {10378,ALASKA/,ARCTIC,body burden,conceptual model,ELEMENTS,harbor seal,HEAVY-METALS,INORGANIC MERCURY,mercury,METHYL MERCURY,NONESSENTIAL,NORTH-SEA,ORGANIC MERCURY,Phoca vitulina,PHOCOENA-PHOCOENA,pollution,stable isotopes,STABLE-ISOTOPE,TRACE-ELEMENTS},
  language = {English},
