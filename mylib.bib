  year = {2004},
  volume = {131},
  pages = {425--434},
  abstract = {Concentrations of polychlorinated biphenyls (PCBs), DDTs, chlordanes, HCHs, hexachlorobenzene (HCB), dieldrin, heptachlor epoxide, tris(4-chlorophenyl)methane (TCPMe), and tris(4-chlorophenyl)methanol (TCPMOH) were measured in the blubber of California sea lions (Zalophus californianus) collected in 2000. DDTs were the most predominant contaminants, followed by PCBs, chlordanes, TCPMe, HCHs, TCPMOH, dieldrin, and heptachlor epoxide. Concentrations of PCBs and DDTs varied from a few mug/g to several hundreds of mug/g on a lipid weight basis. Concentrations of DDTs have declined by an order of magnitude over the last three decades in California sea lions; nevertheless, the measured concentrations of PCBs and DDTs in California sea lions are still some of the highest values reported for marine mammals in recent years. Concentrations of organochlorines were highly correlated with one another. Concentrations of PCBs and DDTs in the blubber of gray whale, humpback whale, northern elephant seal, and harbor seal, and in the adipose fat of sea otter, were lower than the levels found in California sea lions, and were in the range of a few to several mug/g on a lipid weight basis. Copyright 2004 Elsevier Ltd. All rights reserved.},
  journal = {Environmental Pollution},
  keywords = {[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[10060] Biochemistry studies - General,[37015] Public health - Air,[54600] Pest control: general,[85780] Mustelidae,[85820] Eschrichtidae,[86180] Otariidae,[86185] Phocidae,118-74-1,118-74-1Q,27575-78-6,293731-84-7Q,3010-80-8,58-89-9,87-68-3Q,8863,Animalia,blubber,California sea lion,Carnivora,Carnivores,Cetacea,Cetaceans,chlordane: 12789-03-6,Chordata,Chordates,common [Eschrichtidae],common [Mustelidae],common [Otariidae],common [Phocidae],DDT: 50-29-3,dieldrin: 60-57-1,Enhydra lutris: species,Environmental Sciences,Eschrichtidae: Animals,Eschrichtius robustus: species,gray whale,harbor seal,HCH: hexachlorocyclohexane,heptachlor epoxide: 1024-57-3,hexachlorobenzene: HCB,Mammalia,Mammals,Marine Ecology: Ecology,Mirounga augustirostiris: species,Mustelidae: Animals,Nonhuman Mammals,Nonhuman Vertebrates,northern elephant seal,organochlorine pesticides: pollutant,Otariidae: Animals,Pesticides,pesticides and herbicides,Phoca vitulina: species,Phocidae: Animals,Pinnipedia,Pinnipeds,pollutant,pollution,Pollution Assessment Control and Management,polychlorinated biphenyls: 92-52-4,sea otter,tris(4-chlorophenyl)methane: TCPMe,tris(4-chlorophenyl)methanol: TCPMOH,Vertebrata,Vertebrates,water and soil pollution,Zalophus californianus,Zalophus californianus: species},
