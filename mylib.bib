@article{Leblanc2000,
  title = {Groswater Technological Organization: {{A}} Decision-Making Approach},
  author = {Leblanc, S},
  year = {2000},
  volume = {37},
  pages = {23--37},
  abstract = {In this study, lithic technology is viewed as the result of a conscious decision-making process aimed towards the solution of foraging problems. From this perspective, this paper demonstrates how the structure of the environment conditions foraging strategies and how these in turn are supported by technological strategies. This approach is applied to the lithic organization of the Groswater Paleo-Eskimo (2800-2100 B.P..) in the Gulf of Si. Lawrence area. Regional lithic and faunal resource distribution suggest that the acquisition of high quality Cow Head cherts and the harp seal migration routes form the basis of Groswater foraging patterns. In order to adapt to the availability and distribution of these resources, specific and regional foraging patterns were adopted. This flexibility in foraging patterns was supported by the use of high quality Cow Head cherts and lithic management strategies that allowed for an adaptable, reliable, and transportable technology. [References: 54]},
  journal = {Arctic Anthropology},
  number = {2}
}

