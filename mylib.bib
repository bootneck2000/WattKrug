@article{Cherel2009,
  title = {Whisker Isotopic Signature Depicts Migration Patterns and Multi-Year Intra- and Inter-Individual Foraging Strategies in Fur Seals},
  author = {Cherel, Y and Kernaleguen, L and Richard, P and Guinet, C},
  year = {2009},
  volume = {5},
  pages = {830--832},
  doi = {10.1098/rsbl.2009.0552},
  abstract = {The movement and dietary history of individuals can be studied using stable isotope records in archival keratinous tissues. Here, we present a chronology of temporally fine-scale data on the trophic niche of otariid seals by measuring the isotopic signature of serially sampled whiskers. Whiskers of male Antarctic fur seals breeding at the Crozet Islands showed synchronous and regular oscillations in both their delta C-13 and delta N-15 values that are likely to represent their annual migrations over the long term (mean 4.8 years). At the population level, male Antarctic fur seals showed substantial variation in both delta C-13 and delta N-15 values, occupying nearly all the 'isotopic space' created by the diversity of potential oceanic habitats (from high Antarctica to the subtropics) and prey (from Antarctic krill to sub-antarctic and subtropical mesopelagic fishes). At the individual level, whisker isotopic signatures depict a large diversity of foraging strategies. Some seals remained in either subantarctic or Antarctic waters, while the migratory cycle of most animals encompassed a wide latitudinal gradient where they fed on different prey. The isotopic signature of whiskers, therefore, revealed new multi-year foraging strategies of male Antarctic fur seals and is a powerful tool for investigating the ecological niche during cryptic stages of mammals' life.},
  isbn = {1744-9561},
  journal = {Biology Letters},
  keywords = {CARBON,ECOLOGY,GROWTH,individual specialization,INDIVIDUAL SPECIALIZATION,INVESTIGATE,NICHES,otariid,PREDATORS,SEASONAL-CHANGES,Southern Ocean,SOUTHERN-OCEAN,stable isotopes,STABLE-ISOTOPES},
  language = {English},
  number = {6}
}

