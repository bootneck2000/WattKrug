@article{Fea1999,
  title = {Seasonal Variation in the Diet of {{New Zealand}} Fur Seals ({{Arctocephalus}} Forsteri) at {{Otago Peninsula}}, {{New Zealand}}},
  author = {Fea, Nyree I and Harcourt, Robert and Lalas, Chris and Fea, Nyree I and Harcourt, Robert and Lalas, Chris},
  year = {1999},
  volume = {26},
  pages = {147--160},
  abstract = {We examined the diet of New Zealand fur seals (Arctocephalus forsteri) at a rookery on Otago Peninsula, New Zealand, by analysing diagnostic remains from 500 faecal samples and 84 regurgitates collected between July 1993 and September 1994. In total, 27 taxa (species or genera) were identified. Small fish were numerically dominant in faecal samples, with five fish species (three species of lanternfish (Myctophidae), ahuru (Auchenoceros punctatus) and juvenile red cod (Pseudophycis bachus)) accounting for over 90\% of prey items. Regurgitates occurred only seasonally and contained predominantly cephalopod remains (99\% of prey items). Numerical analyses may prove misleading as an indicator of the composition of seat diet because the contribution of large fish that dominate estimates of prey biomass are under-represented. Estimates of prey biomass were made by combining estimates from both faecal and regurgitate samples. Possible biases created by using this method are considered. Aseasonal variation in prey composition was apparent, with arrow squid (Nototodarus sloanii) dominant in summer and autumn, replaced by a combination of barracouta (Thrysites atun), mackerel (Trachurus sp.) and New Zealand octopus (Octopus maorum) in winter and spring.},
  isbn = {1448-5494},
  journal = {Wildlife Research},
  keywords = {[07003] Behavioral biology - Animal behavior,[07502] Ecology: environmental biology - General a,[13202] Nutrition - General studies,[14001] Digestive system - General and methods,[61100] Cephalopoda,[85200] Pisces,[86180] Otariidae,6344,Anima,Animalia,Arctocephalus forsteri,Arctocephalus forsteri: New Zealand fur seal,Behavior,Cephalopoda: Animals,cephalopods: prey [Cephalopoda],Chordata,Chordates,diet,diet composition,Environmental Sciences,feces analyses,feces: digestive system,Fish,fish: prey [Pisces],Invertebrata,Invertebrates,Mammalia,Mammals,Marine Ecology: Ecology,Mollusca,Mollusks,Nonhuman V,Nonhuman Vertebr,numerical analysis: analytical method,nutritional s,Otariidae: Animals,Pinnipedia,Pisces: Animals,pred,prey biomass,puke analyses,regurgitates: digestive system,rookery,seasonal variation,Vertebrat,Vertebrata},
  mendeley-tags = {6344},
