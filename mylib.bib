@article{Moller2001,
  title = {Coastal Bottlenose Dolphins from Southeastern {{Australia}} Are {{Tursiops}} Aduncus According to Sequences of Mitochondrial {{DNA}} Control Region.},
  author = {Moller, L M and Beheregaray, L B and M{\"o}ller, L M and Beheregaray, L B},
  year = {2001},
  volume = {17},
  pages = {249--263},
  abstract = {Sequence analysis of the mitochondrial DNA control region was used to clarify the taxonomic status of two coastal bottlenose dolphin populations from southeastern Australia currently classified as Tursiops truncatus. A 368-bp segment of the control region of 57 biopsy-sampled, photo-identified dolphins of Jervis Bay and Port Stephens was compared to published sequences of T. truncatus and T. aduncus from different oceanic regions. Sequence divergence between haplotypes from southeastern Australia and T. aduncus was much lower than that from T. truncatus. Analyses using two different methods of phylogenetic reconstruction unambiguously placed all haplotypes from southeastern Australia in a group composed exclusively of T. aduncus. The results strongly indicated that these two bottlenose dolphin populations belong to T. aduncus, extending the range of the species to subtropical waters of the Western South Pacific Ocean. [References: 32]},
  journal = {Marine Mammal Science},
  keywords = {7000,Animal Sciences in Current Contents(R)/Agricultura,Biology.,Bottlenose dolphin,Chinese waters,Differentiation,DNA,genetics,Genus tursiops,Humpback whales,Mitochondrial dna control region,Molecular-genetic identification,Phylogenetic analysis,Populations,Southeastern australia.,Southern-hemisphere,Sympatric morphotypes,Taxonomy,Tursiops aduncus,Tursiops truncatus},
  mendeley-tags = {7000},
