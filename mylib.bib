@article{Bastien2003,
  title = {Characterization of a Mosaic Minisatellite Locus in the Mitochondrial {{DNA}} of {{Norway}} Spruce [{{Picea}} Abies ({{L}}.) {{Karst}}.]},
  author = {Bastien, D and Favre, J M and Collignon, A M and Sperisen, C and Jeandroz, S},
  year = {2003},
  volume = {107},
  pages = {574--580},
  doi = {10.1007/s00122-003-1284-2},
  abstract = {A mosaic minisatellite region has been identified in the mitochondrial genome of Norway spruce (Picea abies). The array was composed of three tandem repeats PaTR1 (32 bp), PaTR2a (26 bp) and PaTR2b (26 bp). PaTR2a and PaTR2b differed by one base substitution. The analysis of 92 trees covering the whole natural distribution area of the species allowed detection of 11 length variants ranging from 131 bp to 447 bp. This high intra-specific polymorphism relies on variation in the number of the tandem repeats. Population genetic parameters estimated among 14 populations suggested high population differentiation (Gst = 0.749). The phylogenetic analysis of the 11 sequenced length variants has been performed using a parsimony approach. The topology of the tree showed a good association of groups with geographical origin and a low level of size homoplasy. The phylogenetic reconstruction also suggests that this minisatellite locus has mainly evolved by an increase in the repeat copy number.},
  isbn = {0040-5752},
  journal = {Theoretical and Applied Genetics},
  keywords = {EVOLUTION,GENE,GENOME,heteroplasmy,minisatellite,mtDNA,PHYLOGEOGRAPHY,Picea abies,POLYMORPHISM,POPULATION DIFFERENTIATION,REPEATED SEQUENCES,REPEATS,REVEALS,TANDEM,VARIABLE NUMBER,VNTR},
  language = {English},
  number = {3}
}

@article{Bastow2002,
  title = {Elevated Salinity and Isotopic Composition of Fish Otolith Carbonate: {{Stock}} Delineation of Pink Snapper, {{Pagrus}} Auratus, in {{Shark Bay}}, {{Western Australia}}},
  author = {Bastow, T P and Jackson, G and Edmonds, J S},
  year = {2002},
  volume = {141},
  pages = {801--806},
  abstract = {Analysis of stable isotopes of oxygen and carbon in the otolith carbonate of pink snapper, Pagrus auratus, from several locations in Shark Bay, Western Australia, indicated that snapper are highly location specific. The hypersaline (36 to \textquestiondown 60permill) Shark Bay, on the coast of Western Australia, generated strongly characteristic isotopic signatures in the otolith carbonate of snapper collected from the various locations indicating low levels of individual movement of the species. Oxygen isotopes showed enrichment in 18O in otolith carbonate with salinity (0.10: DELTA delta18O/DELTA salinity permill) typical for the evaporation of seawater. The enrichment in 13C (up to 1.75permill) was attributed to the incorporation of metabolically derived CO2 from an enrichment of 13C in the food web within Shark Bay. This was possibly a result of lower concentrations of dissolved CO2 with increasing salinity causing a reduction in isotope fractionation during photosynthesis. Results complement recent genetic and tagging studies and provide further evidence of the complex nature of snapper stock structure in the Shark Bay region.},
  journal = {Marine Biology},
  keywords = {[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[20004] Sense organs - Physiology and biochemistry,[37001] Public health - General and miscellaneous,[85206] Osteichthyes,carbon isotopes,carbonate: 3812-32-6,Chordata,Chordates,commercial species [Ostei,dissolved carbon dioxide,Environmental Sciences,Fish,fisheries biology,food webs,individual movements,isotopic composition,Marine Ecology: Ecology,Nonhuman V,Osteichthyes: Animals,otolith: sensory system,oxygen isotopes,Pagrus auratus: species,photosynthesis,Pisces,population structure,Population Studies,salinity,seawater evaporation,stock delineation,Vertebrata},
  number = {5}
}

