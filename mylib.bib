@article{Mead1982,
  title = {Biological Observations on Mesoplodon-Carlhubbsi Cetacea Ziphiidae},
  author = {Mead, J G and Walker, W A and Houck, W J},
  year = {1982},
  pages = {1--25},
  abstract = {M. carlhubbsi is a regular part of the fauna along with west coast of North America. Its southern limit is unknown. Its northern limit is Vancouver Island [Canada]. It is the dominant species of Mesoplodon stranding throughout its range. M. ginkgodens is represented by 1 stranding (Moore and Gilmore, 1965), M. densirostris by 1 stranding (Schonewald, 1978) and M. hectori by 4 strandings (Mead, 1981). These probably dwell primarily outside the California Current [USA]. M. stejnegeri occurs to the north of the range of M. carlhubbsi and is commonly represented in collections from Alaska. M. carlhubbsi is about 250 cm at birth and reaches a maximum of 532 cm in both sexes. Its minimum length at physical maturity appears to be about 500 cm. Aside from the head in adult males, the body shape is typical of ziphiids. The north Pacific species could not be separated using the measuresments of Norris (1961). the head in adult males is the most striking feature. It is black with a few white scars and naturally white areas on the tip of the rostrum and anterior to the blowhole. In the female the tip of the rostrum is distinctly lighter than the rest of the head. In the males a strong pair of teeth protrudes from the mandibular symphysis. The gums in M. carlhubbsi come well up onto the tooth, leaving just a small amount of exposed crown.},
  journal = {Smithsonian Contributions to Zoology.(344)}
}

