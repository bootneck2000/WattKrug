@article{Henjes2007,
  title = {Response of the Larger Protozooplankton to an Iron-Induced Phytoplankton Bloom in the {{Polar Frontal Zone}} of the {{Southern Ocean}} ({{EisenEx}})},
  author = {Henjes, Joachim and Assmy, Philipp and Klaas, Christine and Smetacek, Victor},
  year = {2007},
  volume = {54},
  pages = {774--791},
  issn = {09670637},
  doi = {10.1016/j.dsr.2007.02.005},
  abstract = {The responses of larger (\textquestiondown 50 {$\mu$}m in diameter) protozooplankton groups to a phytoplankton bloom induced by in situ iron fertilization (EisenEx) in the Polar Frontal Zone (PFZ) of the Southern Ocean in austral spring are presented. During the 21 days of the experiment, samples were collected from seven discrete depths in the upper 150 m inside and outside the fertilized patch for the enumeration of acantharia, foraminifera, radiolaria, heliozoa, tintinnid ciliates and aplastidic thecate dinoflagellates. Inside the patch, acantharian numbers increased twofold, but only negligibly in surrounding waters. This finding is of major interest, since acantharia are suggested to be involved in the formation of barite (BaSO4), a palaeoindicator of both ancient and modern high-productivity regimes. Foraminifera increased significantly in abundance inside and outside the fertilized patch. However, the marked increase of juveniles after a full-moon event suggests a lunar periodicity in the reproduction cycle of some foraminiferan species rather than a reproductive response to enhanced food availability. In contrast, adult radiolaria showed no clear trend during the experiment, but juveniles increased threefold, indicating elevated reproduction. Aplastidic thecate dinoflagellates almost doubled in numbers and biomass but also increased outside the patch. Tintinnid numbers decreased twofold, although biomass remained constant because of a shift in the size spectrum. Empty tintinnid loricae, however, increased by a factor of two, indicating that grazing pressure on this group mainly by copepods, intensified during EisenEx. The results show that iron-fertilization experiments can shed light on the biology and the role of these larger protists in pelagic ecosystem, which will improve their use as proxies in paleoceanography. \textcopyright{} 2007 Elsevier Ltd. All rights reserved.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\PBWLP4AX\\Henjes et al. - Unknown - doi10.1016j.dsr.2007.02.005.pdf},
  journal = {Deep-Sea Research Part I: Oceanographic Research Papers},
  keywords = {Acantharia,Barite,Iron fertilization,Polar Front,Protozooplankton,Southern Ocean},
  number = {5}
}

