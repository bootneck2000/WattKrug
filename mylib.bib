@article{Nachtigall1990,
  title = {Successful Maintenance and Research with a Formerly Stranded Risso's Dolphin Grampus-Griseus},
  author = {Nachtigall, P E and Pawloski, J L and Schroeder, J P and Sinclair, S},
  year = {1990},
  volume = {16},
  pages = {8--13},
  abstract = {A stranded female Risso's dolphin was recovered from a mud flat near Boston, Massachusetts [USA] and rehabilitated by the team at New England Aquarium. Microbiological studies revealed a number of potential pathogens, and the Grampus was successfully treated with antibiotics. She was transferred to the Naval Ocean Systems Center's Hawaii Laboratory and has since been maintained there for over six years. We have quantified the number of calories required to maintain the animal's weight of 341 kg, examined and described the functioning of her eyes, failed to demonstrate echolocation, found high frequency hearing deficits as compared to other cetaceans, and demonstrated flexible trainability. This Grampus demonstrates that stranded animals can be a valuable resource for obtaining information about a species.},
  journal = {Aquatic Mammals},
  number = {1}
}

