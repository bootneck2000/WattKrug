@article{Ullrey1984,
  title = {Blue-Green Color and Composition of Stejnegers Beaked Whale Mesoplodon-Stejnegeri Milk},
  author = {Ullrey, D E and Schwartz, C C and Whetter, P A and Rajeshwar Rao, T R and Euber, J R and Cheng, S G and Brunner, J R},
  year = {1984},
  volume = {79},
  pages = {349--352},
  abstract = {From a lactating Stejneger's beaked whale stranded at Ninilchik, Alaska [USA] 200 ml of milk were obtained on Oct. 21, 1980. Total solids (41\%) were similar to values reported for sperm and beluga whales, while fat (17\%) was half as great and crude protein (17\%) was 2-4 times greater than in milk of these species. Lactose was not detected. Ca (0.22\%) was greater than reported for pigmy sperm whales but less than for blue whales. P (0.07\%) was less than for any of the above species. Na and K concentrations were 0.13\% and 0.11\%, respectively. Values (.mu.g/g) for other elements analyzed (Mg, 42; Fe, 35; Cu, 2.6; Zn, 1.5; Mn, 0.3; Se, 0.36) have not been reported for whale milk. Based on SDS[sodium dodecyl sulfate]-gel electropherograms, this whale milk did not contain a whey protein corresponding to cattle milk .alpha.-lactalbumin. A blue-green pigment in the milk was identified as biliverdin.},
  journal = {Comparative Biochemistry \& Physiology B},
