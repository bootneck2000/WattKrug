@article{Lucas2000,
  title = {Cetacean Strandings on Sable Island, Nova Scotia, 1970-1998},
  author = {Lucas, Zoe N and Hooker, Sascha K},
  year = {2000},
  volume = {114},
  pages = {45--61},
  abstract = {Two hundred and sixty-seven cetaceans, in 102 stranding events, were recorded between 1970 and 1998 on Sable Island off the coast of Nova Scotia. Seventeen species were represented: Blue Whale (1 single stranding), Fin Whale (1 single stranding), Minke Whale (3 single strandings), Humpback Whale (4 single strandings), Sperm Whale (S strandings, 13 animals), Pygmy Sperm Whale (3 strandings, 4 animals), Dwarf Sperm Whale (2 single strandings), Northern Bottlenose Whale (3 single strandings), Sowerbys Beaked Whale (1 single stranding), Killer Whale (1 single stranding), Long-finned Pilot Whale (37 strandings, 173+ animals), White-beaked Dolphin (1 stranding, 2 animals), Atlantic White-sided Dolphin (9 strandings, 13 animals), Risso's Dolphin (1 single stranding), Striped Dolphin (8 strandings, 22 animals), Short-beaked Common Dolphin (4 strandings, 6 animals), Harbour Porpoise (11 strandings, 13 animals). The records of the Dwarf Sperm Whale and that of the Risso's Dolphin are the first for eastern Canada. The record of the Sowerbys Beaked Whale is the first reported stranding in Nova Scotia. Humpback, Minke, and Killer whales, and Short-beaked Common Dolphins have not previously been recorded stranded on Sable Island. The majority of stranding events (84) were of a single animal; nine involved two animals; eight involved 3-10 animals; and one event involved over 130 animals. Recorded strandings increased from 1.9 strandings/year between 1970-1989 to 7.1 strandings/year between 1990-1998. Mass strandings of multiple male Sperm Whales have occurred three times (all since 1990). All Atlantic White-sided Dolphin strandings investigated were also comprised of male animals.},
  journal = {Canadian Field-Naturalist},
  keywords = {Animals,Balaenoptera acutorostrata [Minke whale] (Balaenop,Balaenoptera borealis [Sei whale] (Balaenopteridae,Balaenoptera musculus [blue whale] (Balaenopterida,Balaenoptera physalus [fin whale] (Balaenopteridae,Balaenopteridae [85810],Balaenopteridae: Cetacea,Behavior,Behavioral Biology/Animal Behavior [07003],Canada,Cetaceans,Ch,Chord,Chorda,Chordata,Chordates,Delphinidae: Cetacea,Delphinus delphis [short-beaked common dolphin] (D,Ecology,Environmental Biology/Wildlife Management-Aquatic,Globicephala melas [long-finned pilot whale] (Delp,Grampus griseus [Risso's dolphin] (Delphinidae),Hyperoodon ampullatus [northern bottlenose whale],Kogia breviceps [pygmy sperm whale] (Physeteridae),Kogia simus [dwarf sperm whale] (Physeteridae),Lagenorhynchus acutus [Atlantic white-sided dolphi,Lagenorhynchus albirostris [white-beaked dolphin],Mammalia,Mammals,Megaptera novaeangliae [humpback whale] (Balaenopt,Mesoplodon bidens [Sowerby's beaked whale] (Ziphii,Nonhuman Mammals,Nonhuman Vertebrates,North America,Orcinus orca [killer whale] (Delphinidae),Phocoena phocoena [harbor porpoise] (Delphinidae),Physeter macrocephalus [sperm whale] (Physeteridae,Physeteridae: Cetacea,Sable Island (Nova Scotia,Stenella coeruleoalba [striped dolphin] (Delphinid,Vertebrata,Vertebrates,Wildlife Management (Conservation),Ziphiidae: Cetacea},
  number = {1}
