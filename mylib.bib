@article{DeMuizon1980,
  title = {Late Tertiary Seals of the South Atlantic Ocean},
  author = {De Muizon, C and Hendey, Q B},
  year = {1980},
  pages = {82(3)},
  abstract = {A lectotype is designated for Prionodelphis rovereti Frenguelli, 1922 from Argentina and it is assigned to the Cetacea, while the monachine seal 'Prionodelphis' capensis Hendey et Repenning, 1972, from South Africa is assigned to the new genus, HOMIPHOCA. A nearly complete skull and mandible is designated as a paratype of H. capensis and this, and other, additional material is described. H. capensis is morphologically intermediate between living monk seals of the genus Monachus (Phocidae, Monachinae, Monachini) and the seals of Antarctica (Phocidae, Monachinae, Lobodontini). It is assigned to the latter group and, contrary to earlier opinion, is suggested to be more closely related to the crabeater, Lobodon carcinophagus, than any other living seal.},
