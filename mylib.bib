@article{Sokolov1997,
  title = {Distribution and Numbers of the Black Sea Dolphins Surveyed from Ships},
  author = {Sokolov, V E and Yaskin, V A and Yukhov, V L},
  year = {1997},
  volume = {76},
  pages = {364--370},
  abstract = {The surveys of distribution and population density of the Black Sea dolphins, Delphinus delphis, Tursiops truncatus and Phocaena phocaena, were carried out from ships in 1985-1987. The data on frequency of occurrence of the dolphins in different parts of the sea and on school size distribution are presented. The mean number of individuals per 100 km(2) of the surveyed area in the shelf zone amounted to 29.2 +/- 7.7 for D. delphis, 4.5 +/- 1.4 for T. truncatus and 5.7 +/- 1.4 for P. phocaena. The dolphin population density decreased towards the central pans of the sea (especially in T. truncatus). Extrapolating the data on population density in the northern sea part to the whole area of the Black Sea the total number of dolphins is estimated as 113.2 +/- 30.3 thousand, the number of D. delphis, P. phocaena and T. truncatus being 96.0 +/- 30.5; 10.3 +/- 3.4; 6.9 +/- 2.6 thousand respectively. [References: 27]},
