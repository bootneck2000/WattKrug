@article{Geertjes2001,
  title = {Genetic Relationships among One Non-Endemic and Two Endemic Mediterranean Triplefin Blennies (Pisces, Blennioidei)},
  author = {Geertjes, G J and Kamping, A and {van Delden}, W and Videler, J},
  year = {2001},
  volume = {22},
  pages = {255--265},
  abstract = {Three triplefin blennies occur sympatrically in the Mediterranean Sea; Tripterygion tripteronotus and T melanurus are endemic, whereas T delaisi is also found in the Eastern Atlantic. Although very similar in morphology, ecology and behaviour, some striking differences exist among reproductive strategies. Several authors proposed hypotheses on the evolution of these species. In order to enhance insight into the genetic structure of this genus, an enzyme electrophoretic survey was performed. Samples of 40 to 45 specimens of each species were collected near Calvi (Corsica, France). Twenty-four enzyme loci were analysed, of which 17 appeared polymorphic. T delaisi showed a high level of average observed heterozygosity (H-o) of 0.140, as opposed to very low levels of 0.009 and 0.021 in T tripteronotus and T melanurus, respectively. Nei's genetic distance was 0.21 between T delaisi and T tripteronotus, 0.35 between T delaisi and T melanurus and 0.45 between T tripteronotus and T melanurus. We hypothesise that divergence of these species started before the Pleistocene and that the endemic species survived the Pleistocene glaciations in refugia within the Mediterranean. The possibility that T. tripteronotus and T delaisi diverged through sympatric speciation is discussed.},
  isbn = {0173-9565},
  journal = {Marine Ecology-Pubblicazioni Della Stazione Zoologica Di Napoli I},
  keywords = {allozymes,divergence,DIVERSITY,ELECTROPHORESIS,evolutionary history,FISHES,LAKE-VICTORIA,MARINE,MATE CHOICE,Mediterranean,palaeoecology,PERCIFORMES,speciation,SPECIATION,SYSTEMATICS,Tripterygion,VARIABILITY},
