}

@article{Hobson1996,
  title = {Stable Carbon and Nitrogen Isotopic Fractionation between Diet and Tissues of Captive Seals: Implications for Dietary Reconstructions Involving Marine Mammals},
  author = {Hobson, K A and Schell, D M and Renouf, D and Noseworthy, E},
  year = {1996},
  month = mar,
  volume = {53},
  pages = {528--533},
  issn = {0706-652X ER},
  doi = {10.1139/f95-209},
  abstract = {Nous avons mesur\&\#233; des rapports d'isotopes stables pour le carbone ([13]C/[12]C) et l'azote ([15]N/[14]N) dans les griffes, les moustaches, la peau, le poil et le sang de phoques captifs, soit des phoques du Groenland (Pagophilus groenlandicus), des phoques communs (Phoca vitulina) et des phoques annel\&\#233; (Phoca hispida), soumis \&\#224; un r\&\#233;gime alimentaire constant de hareng (Clupea harengus) pendant au moins 2 ans. De plus, on a mesur\&\#233; les rapports isotopiques dans le muscle et le foie de deux phoques du Groenland, ainsi que dans les poumons, les reins, le coeur et la rate d'un phoque du Groenland mort en captivit\&\#233;. Les plages des valeurs de s\&\#233;paration isotopique observ\&\#233;es pour le hareng du r\&\#233;gime alimentaire (\&\#948;[13]C: -20,3 \&\#177; 0,7\&\#8240;; \&\#948;[15]N: 13,0 \&\#177; 0,4\&\#8240;, n = 33) et pour ces tissus \&\#233;taient comprises entre +1,7 et 3,1\&\#8240; (sang et foie, respectivement), dans le cas de l'azote, et dans celui du carbone, ces plages \&\#233;taient comprises entre +0,6 et +3,2\&\#8240; (foie et moustaches, respectivement). On n'a d\&\#233;cel\&\#233; aucune diff\&\#233;rence, pour ce qui est des valeurs de s\&\#233;paration isotopique, entre des esp\&\#232;ces ou groupes d'\&\#226;ges. Ces valeurs permettront une reconstruction plus pr\&\#233;cise du r\&\#233;gime alimentaire, bas\&\#233;es sur l'analyse isotopique des tissus des phoques et d'autres mammif\&\#232;res marins. Pour deux phoques du Groenland captifs, les valeurs du carbone et de l'azote pr\&\#233;sentaient de petites variations dans le sens de la longueur sur six moustaches (plage des \&\#233;carts-types pour \&\#948;[13]C: 0,21 \&\#224; 0,57\&\#8240;; pour \&\#948;[15]N: 0,25 \&\#224; 0,45\&\#8240;), mais on pouvait aussi y voir certains signes de corr\&\#233;lation inverse.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\GUUCA9LQ\\Hobson et al. - 1996 - Stable carbon and nitrogen isotopic fractionation between diet and tissues of captive seals implications for diet.pdf},
  isbn = {0706-652X},
  journal = {Canadian Journal of Fisheries and Aquatic Sciences},
  keywords = {Accumulation biologique,Alimentation,Azote,Biological accumulation,Captivit\&\#233,Captivity,Carbon,Carbone,Carnivora,Clupea harengus,Clupeidae,Composition isotopique,Dermoskeleton,Diet,Feeding,gime alimentaire,Isotopic composition,Mammalia,Marine environment,Milieu marin,Nitrogen,Organ,Organe,Pagophilus groenlandicus,Phan\&\#232,Phoca hispida,Phoca vitulina,Phocidae,Pinnipedia,Pisces,Piscivore,Piscivorous,R\&\#233,re,Relation trophique,Tissu,Tissue,Trophic relation,Vertebrata},
  number = {3},
