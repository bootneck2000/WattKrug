@article{Schwartz1994,
  title = {Body-Organ Weight Relationships of near-Term and Newborn Tiger Sharks, {{Galeocerdo}} Cuvier, Captured off {{North Carolina}}},
  author = {Schwartz, Frank J},
  year = {1994},
  volume = {110},
  pages = {104--107},
  abstract = {Body-organ weight relationships are presented for near-term (NT) and free-swimming (FS) newborn tiger sharks, Galeocerdo cuvier, captured in the Atlantic Ocean during shark fishing tournaments off Shallotte, North Carolina. Body-organ weight relationships for heart, spleen, gonad, liver, eye, intestine, and kidney are compared between NT and FS specimens. Changes in tiger shark body-organ weight relationships from those determined herein may serve as early indicators of metabolic changes and/or that something is affecting their biological well-being.},
  journal = {Journal of the Elisha Mitchell Scientific Society},
  number = {2}
}

@article{Schwartz1998,
  title = {History of the Poor Boy Shark Tournament in {{North Carolina}}, 1982-1996},
  author = {Schwartz, Frank J},
  year = {1998},
  volume = {114},
  pages = {149--158},
  abstract = {The Poor Boy Shark Tournament existed at Shallotte Point, North Carolina, from 1982-1996. Catch, effort, and morphometric data were gathered for 15 species of sharks (718 specimens), 12 being carcharhinids. Atlantic sharpnose shark (Rhizoprionodon terraenovae), tiger shark (Galeocerdo cuvier), and blacktip shark (Carcharhinus limbatus) accounted for 82\% of the catches and 72\% of the total catch weights. Tournaments in July and August produced the most sharks (n = 696). No statistical differences were noted between monthly catch landings, catch weight or catch per unit effort (CPUE's). A female Galapagos shark, (Carcharhinus galapagensis), was the most unexpected capture.},
  journal = {Journal of the Elisha Mitchell Scientific Society},
  number = {3}
}

