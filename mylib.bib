@article{Hurford1996,
  title = {Splenic Contraction, Catecholamine Release, and Blood Volume Redistribution during Diving in the {{Weddell}} Seal},
  author = {Hurford, William E and Hochachka, Peter W and Schneider, Robert C and Guyton, Gregory P and Stanek, Kevin S and Zapol, David G and Liggins, Graham C and Zapol, Warren M},
  year = {1996},
  volume = {80},
  pages = {298--306},
  abstract = {The spleen of the Weddell seal (Leptonychotes weddelli) may contract and inject red blood cells (RBCs) into the peripheral circulation during diving, but evidence for this hypothesis is indirect. Accordingly, we measured splenic dimensions by ultrasonography, plasma catecholamine concentrations, hemoglobin concentration, and hematocrit in five Weddell seals before and after intravenous epinephrine during halothane anesthesia and while awake at the surface after voluntary dives. Spleen size was reduced immediately after epinephrine injection or after the seal surfaced. Within the first 2 min after the seal surfaced, cephalocaudal splenic length was 71 +- 2\% (mean +- SD; P lt 0.05) and splenic thickness was 71 +- 4\% (P lt 0.05) of the maximal resting values. Splenic size increased (half-time = 6-9 min) after the seal surfaced and was inversely correlated with plasma epinephrine and norepinephrine concentrations. Hemoglobin concentration increased from 17.5 +- 5.3 g/dl (measured during general anesthesia) to 21.9 +- 3.7 g/dl (measured in the first 2 min after surfacing). At these same times, the hematocrit increased from 44 +- 12 to 55 +- 8\%. These values decreased (half-time = 12-16 min) after the seal surfaced. We estimate 20.1 liters of RBCs were sequestered at rest, presumably in the spleen, and released either on epinephrine injection or during diving. Catecholamine release and splenic contraction appear to be an integral part of the voluntary diving response of Weddell seals.},
  journal = {Journal of Applied Physiology},
  keywords = {animals. chordates. mammals. nonhuman mammals. non,Biochemical Studies/Porphyrins and Bile Pigments [,Biochemical Studies/Proteins,Biochemistry/Gases (1970- ) [10012],Blood,Blood and Lymphatics (Transport and Circulation).,Blood Oxygen. Breath-Hold Diving. Epinephrine. Hem,Blood-Forming Organs and Body Fluids/Blood,Blood-Forming Organs and Body Fluids/Lympha,Chorda,Cytology and Cytochemistry/Animal [02506],Ecology,Endocrine System/Neuroendocrinology (1972- ) [1702,Environmental Biology/Animal [07508],Epinephrine. Norepinephrine. Oxygen.,External Effects/Pressure [10606],Leptonychotes weddelli (Phocidae).,Mammalia,Metabolism/Energy and Respiratory Metabolism [1300,Metabolism/Porphyrins and Bile Pigments [13013],Metabolism/Proteins,Nervous System/Physiology and Biochemistry [20504],Peptides and Amino A,Peptides and Amino Acids [130,Phocidae [86185],Phocidae: Pinnipedia,Respiratory System/Physiology and Biochemistry [16,Vertebrata},
  number = {1}
}

