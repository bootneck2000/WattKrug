@article{Hidaka1983,
  title = {Ddt Compounds and Poly Chlorinated Bi Phenyl Isomers and Congeners in Weddell Seals Leptonychotes-Weddelli and Their Fate in the Antarctic Marine Ecosystem},
  author = {Hidaka, H and Tanabe, S and Tatsukawa, R},
  year = {1983},
  volume = {47},
  pages = {2009--2018},
  abstract = {The whole-body burdens and concentrations of .SIGMA.DDT (the sum of p,p'-DDE and p,p'-DDT) and PCB polychlorinated biphenyl in the Weddell seal, L. weddelli, caught near Syowa Station, Antarctica, were determined by detailed biometric measurements of their organs and tissues and analyses of .SIGMA.DDT and PCB in them. The concentration levels of .SIGMA.DDT and PCB in Weddell seals were lower than those in various species of marine mammals from other oceans. The low levels may have been due to the low concentration of these chemicals in the food of Weddell seals and in the seawater under Antarctic fast ice. The concentration ratio of .SIGMA.DDT between the food organisms of seals and seawater under Antarctic fast ice was higher than those of other ocean ecosystems.},
  journal = {Agricultural and Biological Chemistry},
  keywords = {*Ecology,*Pest Control,*Public Health: Environmental Health/Air,*Toxicology/Environmental and Industrial Toxicolog,8400,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Apparatus [60016],Biochemical Studies/General [10060],Dental and Oral Biology/General,Ecology,Economic Entomology/Chemical and Physical Control,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,General,General and Miscellaneous/General [1250,Herbicides [54600],Infection and Therapy [221,Mammalia-Unspecified [85700],Marine Mammal Marine Organism Food Chain,Methods [19001],Organisms-Unspecified [00500],Pathology,Pesticides,Phocidae [86185],Routes of Immunization,Water an},
