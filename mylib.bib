@article{Iwasaki1997,
  title = {Life History and Catch Bias of {{Pacific}} White-Sided ({{Lagenorhynchus}} Obliquidens) and Northern Right Whale Dolphins ({{Lissodelphis}} Borealis) Incidentally Taken by the {{Japanese}} High Seas Squid Driftnet Fishery},
  author = {Iwasaki, Toshihide and Kasuya, Toshio},
  year = {1997},
  volume = {0},
  pages = {683--692},
  abstract = {Information on the life history of Pacific white-sided dolphins and northern right whale dolphins was deduced from animals incidentally taken by Japanese high seas squid driftnet fisheries in 1988-90 in the waters between 34degree-47degreeN and 170degreeE-145degreeW (n = 242 and 259, respectively). Age was determined by counting cemental and dentinal growth layers. The following values for biological parameters of Pacific white-sided dolphins were revised from those given in Ferrero and Walker (1996): neonatal length (93.7 cm); age at male sexual maturity (9-12 years); and length at cessation of growth (177.1-183.3 cm for females, 183.8-184.9 cm for males and at 5-10 years for both sexes). Other parameter values obtained supported those given by Ferrero and Walker (1996). The calving season for Pacific white-sided dolphins started before the sampling period and lasted until August. Females and males attained sexual maturity at 170-230 cm and at 170-220 cm, respectively and both sexes lived to nearly 30 years. The estimated number of mature females in the sample (assuming an age of 7 years, i.e. all individuals older than the oldest immature) was smaller than the number of calves of the year. All sampled sexually mature females were lactating. This suggests that adult individuals were present in the fishing ground but were less susceptible to driftnets. A gap in age composition was found between 9-15 years for females and 14-17 years for males, possibly because: (1) individuals of those age ranges are scarce in the population; (2) those age classes are found outside the driftnet ground; or (3) they respond to the driftnets differently from other age classes. No new information for northern right whale dolphins was found to add to that provided by Ferrero and Walker (1993), probably due to our smaller sample size. Calves were born in June-August at 80-100 cm in body length. Females reached sexual maturity at 180-220 cm and ceased growing at around 190-230 cm at about 5-10 years of age, while males attained sexual maturity at 210-230 cm or at 9-13 years and apparently continue growing at least until 13 years or the maximum age of the present sample. The oldest female was aged at 23 years. Under representation of adult individuals and an age gap were less in evidence for northern fight whale dolphins than for Pacific white-sided dolphins.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals,Cetaceans,Chorda,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Japan (Palearctic region),Lagenorhynchus-obliquidens [Pacific white-sided do,Lissodelphis-borealis [northern right whale dolphi,Mammalia,Mammals,Nonhuman Mammals,Nonhuman Vertebrates,Resource Management,Vertebrata,Vertebrates,Wildlife Management (Conservation)},
  number = {47}
}

