  number = {2}
}

@article{Boyd1990a,
  title = {Age Distribution of Breeding Female {{Antarctic}} Fur Seals in Relation to Changes in Population Growth Rate.},
  author = {Boyd, Ian L and Lunn, N J and Rothery, P and Croxall, J P},
