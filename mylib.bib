  volume = {19},
  pages = {34--35},
  abstract = {A seal carcass, tentatively identified as that of a crabeater seal (Lobodon carcinophagus), was discovered on Tvora (0.degree.5'W, 72.degree.12'S) just to the east of the Jutulstraumen in western Dronning Maud Land, Antarctica. Either the carcass was discarded by a previous expedition, or the seal wandered from the coast to its death, a journey of some 240 km from the present day ice shelf, and 1200 m above sea level. There are difficulties with both these explanations, the first as the location of the carcass is highly inaccessible, the second because of the distances and the nature of the terrain.},
