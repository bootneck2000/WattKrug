@article{Brabetz2000,
  title = {Comparative Analyses of Secondary Gene Products of 3-Deoxy-{{D}}-Manno-Oct-2-Ulosonic Acid Transferases from {{Chlamydiaceae}} in {{Escherichia}} Coli {{K}}-12},
  author = {Brabetz, W and Lindner, B and Brade, H},
  year = {2000},
  volume = {267},
  pages = {5458--5465},
  abstract = {The waaA gene encoding the essential, lipopolysaccharide (LPS)-specific 3-deoxy-dmanno-oct-2-ulosonic acid (Kdo) transferase was inactivated in the chromosome of a heptosyltransferase I and II deficient Escherichia coli K-12 strain by insertion of gene expression cassettes encoding the waaA genes of Chlamydia trachomatis, Chlamydophila pneumoniae or Chlamydophila psittaci. The three chlamydial Kdo transferases were able to complement the knockout mutation without changing the growth or multiplication behaviour. The LPS of the mutants were serologically and structurally characterized in comparison to the LPS of the parent strain using compositional analyses, high performance anion exchange chromatography, matrix-assisted laser desorption/ionization time-of-flight mass spectrometry and specific monoclonal antibodies. The data show that chlamydial Kdo transferases can replace in E. coli K-12 the host's Kdo transferase and retain the product specificities described in their natural background. In addition, we unequivocally proved that WaaA from C. psittaci transfers predominantly four Kdo residues to lipid A, forming a branched tetrasaccharide with the structure alpha-Kdo-(2 \textendash\textquestiondown{} 8)-[alpha-Kdo-(2 \textendash\textquestiondown{} 4)]-alpha-Kdo-(2 \textendash\textquestiondown{} 4)-alpha-Kdo.},
  isbn = {0014-2956},
  journal = {European Journal of Biochemistry},
  keywords = {BIOSYNTHESIS,Chlamydiaceae,DELETION,EXPRESSION,genetic complementation,GLYCOSYLTRANSFERASES,KDO TRANSFERASE,KDTA,lipopolysaccharide,LIPOPOLYSACCHARIDE EPITOPE,multifunctional 3-deoxy-D-manno-oct-2-ulosonic aci,product specificity,STRAIN,STRUCTURAL-ANALYSIS,TRACHOMATIS},
  language = {English},
  number = {17}
}

