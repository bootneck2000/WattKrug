@article{Chamberlain2005,
  title = {Pleistocene to Recent Dietary Shifts in {{California}} Condors},
  author = {Chamberlain, C P and Waldbauer, J R and {Fox-Dobbs}, K and Newsome, S D and Koch, P L and Smith, D R and Church, M E and Chamberlain, S D and Sorenson, K J and Risebrough, R},
  year = {2005},
  volume = {102},
  pages = {16707--16711},
  doi = {10.1073/pnas.0508529102},
  abstract = {We used carbon and nitrogen isotopes to investigate changes in the diet of California condors from the Pleistocene to the recent. During the Pleistocene, condors from California fed on both terrestrial megafauna and marine mammals. Early accounts reported condors feeding on the carcasses of marine mammals, but by the late 1700s, condor diets had shifted predominantly to terrestrial animals, following the commercial harvesting of marine mammals and the development of cattle ranching on land. At present, dairy calves provided by humans significantly augment condor diet, constituting an artificial support of the current population. Reestablishing a marine mammal component in the condor diet may be an effective strategy for fostering viable condor populations independent of direct human subsidies.},
  isbn = {0027-8424},
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  keywords = {ATMOSPHERIC CO2,C-13,CARBON,carbon isotopes,COLLAGEN,ECOLOGY,FEATHERS,FUR SEALS,ISLANDS,NITROGEN,nitrogen isotopes,paleodiet,STABLE-ISOTOPES},
  language = {English},
  number = {46}
}

@article{Chamberlain2006,
  title = {Collembolan Trophic Preferences Determined Using Fatty Acid Distributions and Compound-Specific Stable Carbon Isotope Values},
  author = {Chamberlain, P M and Bull, I D and Black, H I J and Ineson, P and Evershed, R P},
  year = {2006},
  volume = {38},
  pages = {1275--1281},
  doi = {10.1016/j.soilbio.2005.09.022},
  abstract = {The trophic preferences of soil invertebrates such as Collembola are often determined by the analysis of gut contents" or through visual observations of the location of individuals. As an alternative approach, two species of Collembola, Folsomia candida and Proisotoma minuta, were offered a choice of the soil fungus Cladosporium cladosporioides or the bacterial feeding nematode Panagrellus redivivus; each exhibited distinctfatty acid profiles and stable carbon isotopic compositions. Over 21 days, the fatty acids i15:0, i17:0, 18:1(n-7) and 18:2(n-6) all increased in abundance in both collembolan species consistent with direct routing from the nematode dietary choice which contained a high concentration of these components. Collembolan fatty acid delta C-13 values increased by between 5.7 and 21.6 parts per thousand over 21 days reflecting those of the nematode diet. Therefore, both fatty acid profiles and delta C-13 values were consistent with a strong feeding preference of F. candida and P. minuta for the nematodes over the offered fungi. In fact, neither collembolan species consumed any detectable amount of C cladosporioides. Comparison of the delta C-13 values of the 16:0 and 18:0 fatty acids (which are biosynthesised by the Collembola as well as directly incorporated from the diet) and the 16: I(n-7) and 18:2(n-6) components (which are not biosynthesised by the Collembola) demonstrated that the input of distinct pools of C can lead to large shifts in delta C-13 values between diet and consumer. The fatty acids that were not biosynthesised by Collembola better reflected the delta C-13 values of the diet helping to differentiate between biosynthesised and directly incorporated compounds; an important prerequisite in the interpretation of compound-specific delta C-13 values in trophic behaviour tests. The combination of fatty acid distributions and delta C-13 values is a significant improvement on traditional methods of examining feeding preferences, since it determines directly the assimilated dietary carbon rather than relying on indirect observations, such as the proximity of individuals to a defined food source. (c) 2005 Elsevier Ltd. All rights reserved.},
  isbn = {0038-0717},
  journal = {Soil Biology \& Biochemistry},
  keywords = {collembola,diet,DIETARY,ECOLOGY,fatty acids,FOLSOMIA-CANDIDA,FRACTIONATION,fungi,FUNGI,GRAZING PREFERENCES,INDICATORS,isotopes,lipid,nematode,NEMATODES,PROISOTOMA-MINUTA,SOIL,stable carbon},
  language = {English},
  number = {6}
}

@article{Chambers1992,
  title = {Foraging Ecology of Southern Elephant Seals in Relation to the Bathyrnetry and Productivity of the {{Southern Ocean}}},
  author = {Chambers, C and Fedak, M. A. and McConnell, B. J. and Chambers, C and Fedak, M. A.},
  year = {1992},
  volume = {4},
  pages = {393--398},
  publisher = {{Cambridge Univ Press}},
  issn = {13652079},
  doi = {10.1017/S0954102092000580},
  abstract = {Southern elephant seals ( Mirounga leonina ) are among the most proficient of mammalian divers and are a major component of the Antarctic food web. Yet little is known of their movements or interaction with their oceanic environment. Specially designed satellite-link data loggers allowed us to visualize the 3-D movements of elephant seals as they swam rapidly from South Georgia to distant (up to 2650 km) areas of Antarctic continental shelf. One seal dived continuously to the sea bed in one small area for a month, implying consumption of benthic prey. Dives here were shorter even though average swimming velocity was lower. It is suggested that the physiological requirements of feeding and digestion reduced the aerobic dive limit. Long distance travel to relocatable hydrographic or topographical features, such as shelf breaks, may allow large predators to locate prey more consistently than from mid-ocean searches.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\89UJDVNB\\Mcconnell, Chambers, Fedak - 1992 - Foraging ecology of southern elephant seals in relation to the bathyrnetry and productivity of the S.pdf},
  isbn = {0954-1020},
  journal = {Antarctic Science},
  keywords = {Antarctica,dive physiology,foraging,Mirounga,southern elephant seal,southern elephant seal Mirounga leonina pinniped p},
  number = {04}
}

@article{Chambers2000,
  title = {Microsatellites: Consensus and Controversy},
  author = {Chambers, G K and MacAvoy, E S},
  year = {2000},
  volume = {126},
  pages = {455--476},
  abstract = {Microsatellite DNA loci have recently been adopted for many biological applications. Comparative studies across a wide range of species has revealed many details of their mutational properties and evolutionary life cycles. Experience shows that a full understanding of these processes is essential to ensure the effective use of microsatellites as analytical tools. In this article, we review the controversies that have arisen as biologists have taken up this new technology and the emerging consensus that has resulted from their debates. We point to the need for comparative DNA sequencing studies to produce input data for a new generation of theoretical models of microsatellite behaviour. We conclude by presenting our own conceptual model, 'Snakes and Ladders', as an aid to theory development. (C) 2000 Elsevier Science Inc. All rights reserved.},
  isbn = {0305-0491},
  journal = {Comparative Biochemistry and Physiology B-Biochemistry \& Molecular Biology},
  keywords = {ALLELE FREQUENCIES,allele frequency spectra,ANOPHELES-GAMBIAE,COMPREHENSIVE GENETIC-MAP,DNA,DNA repair,DNA synthesis,infinite alleles model,microsatellites,MISMATCH REPAIR,neutral theory,POPULATION-STRUCTURE,SACCHAROMYCES-CEREVISIAE,SIMPLE REPETITIVE,SIMPLE SEQUENCE DNA,simple tandem repeats,stepwise mutation model,STEPWISE MUTATION MODEL,TANDEM REPEAT LOCI,Tuatara (Sphenodon punctatus)},
  language = {English},
  number = {4}
}

@article{Chambers2008,
  title = {Diet of the {{Mogollon}} Vole as Indicated by Stable-Isotope Analysis (Delta {{C}}-13 and Delta {{N}}-15)},
  author = {Chambers, C L and Doucett, R R},
  year = {2008},
  volume = {68},
  pages = {153--160},
  abstract = {There are no published studies on the diet of Mogollon voles (Microtus mogollonensis) although this species occurs throughout the Southwest in montane forestlands. Mogollon voles are believed to be herbivorous, selecting the vegetative portion of grass as their dominant food source. Herbivores frequently select more easily digested C-3 plants over C-4 plants; we thus expected Mogollon voles would feed primarily on C-3 plants. We collected hair samples from Mogollon voles captured in northern Arizona between 1967 and 2003 and plant samples from some capture sites. Then we compared stable carbon (delta C-13) and nitrogen (delta N-15) isotope ratios to investigate dietary preferences for C-3 or C-4 plants. Mean isotope ratios for C-3 plants we sampled were -26.84 parts per thousand (s = 0.17) for delta C-13 and -0.02 parts per thousand (s = 0.32) for delta N-15. For C-4 plants, mean isotope ratios for delta C-13 and delta N-15 were -15.04 parts per thousand (s = 0.38) and -0.74 parts per thousand (s = 0.55), respectively. Mogollon voles were largely herbivorous based on delta N-15 (mean and standard error: 3,77 +/- 0.17 parts per thousand) and used C-3 plants more than C-4 based on delta C-13 (-24.21 +/- 0.14 parts per thousand). Activities that lead to changes in plant species composition or reduction in C-3 plants in montane grasslands and forests (e.g., excessive ungulate grazing) may reduce habitat quality for Mogollon voles.},
  isbn = {1527-0904},
  journal = {Western North American Naturalist},
  keywords = {Arizona,CALIFORNIA VOLE,CARBON,carbon stable isotope,diet,DYNAMICS,ECOLOGY,HAIR,ISOTOPES,livestock grazing,Microtus mogollonensis,MICROTUS-MOGOLLONENSIS,Mogollon vole,nitrogen,NITROGEN,NORTHERN ARIZONA,POPULATIONS,PRAIRIE,stable isotope},
  language = {English},
  number = {2}
}

