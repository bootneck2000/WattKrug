@article{Gurshin2004,
  title = {Short-Term Survival and Movements of {{Atlantic}} Sharpnose Sharks Captured by Hook-and-Line in the North-East {{Gulf}} of {{Mexico}}.},
  author = {Gurshin, C W D and Szedlmayer, S T},
  year = {2004},
  volume = {65},
  pages = {973--986},
  publisher = {{Blackwell Publishing Limited}},
  abstract = {Ultrasonic telemetry was used to compare post-release survival and movements of Atlantic sharpnose sharksRhizoprionodon terraenovaein a coastal area of the north-east Gulf of Mexico. Ten fish were caught with standardized hook-and-line gear during June to October 1999. Atlantic sharpnose sharks were continuously tracked after release for periods of 0\textperiodcentered 75 to 5\textperiodcentered 90 h and their positions recorded at a median interval of 9 min. Individual rate of movement was the mean of all distance and time measurements for each fish. Mean {$\pm$} s.e. individual rate of movement was 0\textperiodcentered 45 {$\pm$} 0\textperiodcentered 06 total lengths per second( L\textexclamdown sub\textquestiondown T\textexclamdown/sub\textquestiondown{} s\textexclamdown sup\textquestiondown -1\textexclamdown/sup\textquestiondown ) and ranged from 0\textperiodcentered 28 to 0\textperiodcentered 92 L\textexclamdown sub\textquestiondown T\textexclamdown/sub\textquestiondown{} s\textexclamdown sup\textquestiondown -1\textexclamdown/sup\textquestiondown{} over all fish. Movement patterns did not differ between jaw and internally hooked Atlantic sharpnose sharks. Individual rate of movement was inversely correlated with bottom water temperature at capture( r\textexclamdown sup\textquestiondown 2\textexclamdown/sup\textquestiondown{} = 0\textperiodcentered 52,P = 0\textperiodcentered 05). No consistent direction in movement was detected for Atlantic sharpnose sharks after release, except that they avoided movement towards shallower areas. Capture-release survival was high(90\%), with only one fish not surviving,i.e. this particular fish stopped movement for a period of 10 min. Total rate of movement was total distance over total time(m min\textexclamdown sup\textquestiondown -1\textexclamdown/sup\textquestiondown ) for each Atlantic sharpnose shark. Mean total rate of movement was significantly higher immediately after release at 21\textperiodcentered 5 m min\textexclamdown sup\textquestiondown -1\textexclamdown/sup\textquestiondown{} over the first 1\textperiodcentered 5 h of tracking, then decreased to 11\textperiodcentered 2 m min\textexclamdown sup\textquestiondown -1\textexclamdown/sup\textquestiondown{} over 1\textperiodcentered 5\textendash 6 h, and 7\textperiodcentered 7 m min\textexclamdown sup\textquestiondown -1\textexclamdown/sup\textquestiondown{} over 3\textendash 6 h( P = 0\textperiodcentered 002), which suggested initial post-release stress but quick recovery from capture....ABSTRACT FROM AUTHOR},
  isbn = {00221112},
  journal = {Journal of Fish Biology},
  keywords = {14454145,ATLANTIC sharpnose shark,BIOTELEMETRY,Gulf of,MEXICO,RHIZOPRIONODON,SHARKS,tagging,telemetry,WATER temperature},
  mendeley-tags = {14454145},
  number = {4}
}

@article{Guruge1996,
  title = {Distribution, Biomagnification, and Elimination of Butyltin Compound Residues in Common Cormorants (Phalacrocorax Carbo) from Lake Biwa, Japan},
  author = {Guruge, K S and Tanabe, S and Iwata, H and Taksukawa, R and Yamagishi, S},
  year = {1996},
  volume = {31},
  pages = {210--217},
  abstract = {Concentrations of butyltin compounds (BTs) were determined in various body tissues of common cormorants (Phalacrocorax carbo) collected from the Lake Biwa, Japan. Elevated concentrations of butyltins were detected in the feathers of cormorants. Among other organs and tissues, butyltin levels were also higher in the kidney (290 +/- 150 ng/g) and liver (270 +/- 260 ng/g), ranging from 115 to 544 ng/g and 142 to 1007 ng/g (wet wt basis), respectively. The accumulation of BTs in cormorant bodies was in the order of MBT \textquestiondown{} DBT \textquestiondown{} TBT and their organ specific burdens were in the order of muscle greater than or equal to feathers \textquestiondown{} skin \textquestiondown{} liver \textquestiondown{} rest of the tissues and organs. The higher levels of BTs residues in feather suggested the excretion of about one fourth of their body burden during a complete molting cycle, which has been a natural detoxification mechanism in these birds. Based on the whole body concentrations of BTs in cormorants (42-160 ng/g wet wt) and fish (10-55 ng/g wet wt) biomagnification factors were assessed to be in the range of 1.1-4.1. To our knowledge, this is the first fundamental study to substantially indicate the contamination and kinetics of BTs in wild birds. [References: 42]},
  journal = {Archives of Environmental Contamination and Toxicology},
  number = {2}
}

@article{gutt_circumpolar_2013,
  title = {Circumpolar Overview and Spatial Heterogeneity of {{Antarctic}} Macrobenthic Communities},
  author = {Gutt, Julian and Griffiths, Huw J. and Jones, Christopher D.},
  year = {2013},
  month = dec,
  volume = {43},
  pages = {481--487},
  issn = {18671616},
  doi = {10.1007/s12526-013-0152-9},
  abstract = {The geographical coverage of a comprehensive dataset on Antarctic macrobenthic communities is provided for the first time. Since the sampling methods applied since the 1950s vary considerably, a robust analysis was carried out. The results show firstly, that all main types of communities, especially suspension and mobile or infaunal deposit feeders, can occur everywhere. Thus, their biogeography is hardly predictable and assumed to be shaped by complex biological interactions. Secondly, the often-mentioned dominance of communities composed of suspension feeders and associated fauna can be confirmed. \textcopyright{} 2013 Senckenberg Gesellschaft f\"ur Naturforschung and Springer-Verlag Berlin Heidelberg.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\2U2CTZHR\\Gutt, Griffiths, Jones - 2013 - Circumpolar overview and spatial heterogeneity of Antarctic macrobenthic communities.pdf;C\:\\Users\\Andy\\Zotero\\storage\\HDKI6DIZ\\Gutt, Griffiths, Jones - 2013 - Circumpolar overview and spatial heterogeneity of Antarctic macrobenthic communities(2).pdf},
  isbn = {1252601301},
  journal = {Marine Biodiversity},
  keywords = {Biogeographic pattern,Infauna,Macrobenthic classification,Mobile deposit feeders,Suspension feeders},
  number = {4}
}

@article{Gutt1994,
  title = {New {{Results}} on the {{Fish}} and {{Shrimp}} Fauna of the {{Weddel}} Sea and {{Lazarev}} Sea ({{Antartic}})},
  author = {Gutt, J. and Ekau, W. and Gorny, M},
  year = {1994},
  volume = {7},
  pages = {91--102},
  abstract = {A total of 151 demersal fishes and 555 shrimps were recorded on 1785 photographs which represent 1607 m2 sea floor of the shelf and upper slope of the Weddell Sea (Halley Bay near-shore area) and of the Lazarev Sea. The Lazarev Sea showed a high number of species (24) and an average abundance of 7.24 nI100 m2. In the Halley Bay near-shore area only 11 species were found, however the abundance was high with 15.66 dl00 m2. The species composition of these areas was compared using cluster analysis with previous results from adjacent areas. The Lazarev Sea was combined with the Halley Bay near-shore and the Kapp Nowegia areas to an area-cluster "north" which was different from an area-cluster "south" which comprised the Gould/Vahsel Bay, Vestkapp and Halley Bay off-shore areas. The most abundant species were Trematomus lepidorhinus in the Lazarev Sea and T. scotti in the Halley Bay near-shore area. The shrimp fauna was dominated in the Halley Bay near-shore area by Choris- mus antarcticus with an abundance of 33.45 dl00 m2 whereas in the Lazarev Sea the three generally most abundant Antarctic shrimps C. antarcticus, Notoc- rangon antarcticus and Nematocarcinus lanceopes showed values between 1.25 and 3.42 dl00 m2. Between the two shelf-inhabiting species C. antarcticus and N. antarcticus no difference in depth zonation was found. A small scale analysis of the occurrence of N. antarcticus and N. lanceopes indicated random disper- sion patterns at most investigated stations.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\GYA5KMY5\\Gun, Werner, Gorny - 1994 - New results on the fish and shrimp fauna of the Weddell Sea and Lazarev Sea (Antarctic).pdf},
  journal = {Proc. NIPR Symp. Plola Biol}
}

@article{Gutt1996,
  title = {Habitat Partitioning of Dominant High {{Antarctic}} Demersal Fish in the {{Weddell Sea}} and {{Lazarev Sea}}},
  author = {Gutt, Julian and Ekau, Werner},
  year = {1996},
  volume = {206},
  pages = {25--37},
  issn = {00220981},
  doi = {10.1016/0022-0981(95)00186-7},
  abstract = {Using underwater photography twelve, structural habitat characteristics of the six most abundant demersal high Antarctic fish species were investigated. Two categories of relationships between fishes and benthos were found: (1) Trematomus lepidorhinus (Pappenheim) and T. loennbergi (Regan) preferred rich epibenthic communities dominated by sessile suspension feeders. The fish used this three-dimensional structure to both settle on and to hide in. (2) Prionodraco evansii (Regan), Dolloidraco longedorsalis (Rhoule) and Trematomus scotti (Boulenger) occurred mostly in areas free of stones and biogenous debris and with generally less epifauna. For Chionodraco myersi (Dewitt and Tyler), no significant link with the benthic habitat was found; it seemed to have an intermediate position between the groups mentioned above.},
  journal = {Journal of Experimental Marine Biology and Ecology},
  keywords = {Antarctic,Artedidraconidae,Bathydraconidae,Channichthyidae,Fish,Habitat,Lazarev Sea,Nototheniidae,Weddell Sea},
  number = {1-2}
}

