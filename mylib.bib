@article{Inoue1999,
  title = {Cloning and Sequencing of a Bottle-Nosed Dolphin ({{Tursiops}} Truncatus) Interleukin-1 Alpha and-1 Beta Complementary {{DNAs}}},
  author = {Inoue, Y and Itou, T and Ueda, K and Oike, T and Sakai, T},
  year = {1999},
  volume = {61},
  pages = {1317--1321},
  abstract = {The bottle-nosed dolphin (Tursiops truncatus) IL-1 alpha and IL-1 beta cDNA were cloned from mitogen stimulated peripheral blood mononuclear cells (PBMC) RNA utilizing the reverse transcription-polymerase chain reaction (RT-PCR). The sequences of these cDNAs showed that dolphin IL-1 alpha and IL-1 beta clones contained open reading frames encoding 265 and 266 amino acids, respectively. Comparison of the deduced amino acid showed that dolphin IL-1 alpha sequence shared 77, 77, 77, 74, 71, 65 and 57\% similarity with the bovine, ovine, porcine, equine, feline, human and mouse IL-1 alpha sequences, respectively. Similarly, the amino acid sequence showed that dolphin IL-1 beta shared 77, 77, 74, 69, 65, 64 and 63\% similarity with the bovine, ovine, porcine, equine, feline, human and mouse IL-1 beta sequences, respectively. The relatedness of dolphin IL-1 alpha and IL-1 beta were relatively distant with 21\% amino acid homology. [References: 23]},
  journal = {Journal of Veterinary Medical Science},
  keywords = {1-beta,Bottle-nosed dolphin,Cdna.,Expression,Il-1 alpha,Il-1 beta.,Killer whale,Molecular-cloning,Orcinus-orca,Veterinary Medicine/Animal Health in Current Conte},
  number = {12}
}

@article{Inoue1999a,
  title = {Cloning and Sequencing of a Bottle-Nosed Dolphin ({{Tursiops}} Truncatus) Interleukin-4-Encoding {{cDNA}}},
  author = {Inoue, Yuuki and Itou, Takuya and Sakai, Takeo and Oike, Tatsuya},
  year = {1999},
  volume = {61},
  pages = {693--696},
  abstract = {Using polymerase chain reaction (PCR), a bottle-nosed dolphin (Tursiops truncatus) interleukin-4 (IL4) cDNA was cloned and sequenced. IL4 specific primers were based on the 5' and 3' untranslated regions of the human and murine IL4 gene. The dolphin IL4 cDNA is 528 base pairs in length and contains an open reading frame of 402 nucleotides coding an IL4 precursor of 133 amino acids, with the putative signal peptide of 24 amino acids. Analysis of the mature amino acid sequence shows three potential N-linked glycosylation sites and three disulfide bonds. Comparison of the predicted amino acid sequence shows that dolphin IL4 shares 77, 74, 58 and 41\% identity with the bovine, ovine, human and mouse IL4s, respectively.},
  journal = {Journal of Veterinary Medical Science},
  keywords = {Animals,Biochemical Studies/General [10060],Biophysics/General Biophysical Studies [10502],Cetaceans,Chorda,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Endocrine System/General [17002],Genetics and Cytogenetics/Animal [03506],Immune System (Chemical Coordination and Homeostas,Immunology and Immunochemistry/General,interleukin-4: complementary DNA expression,Mammalia,Mammals,Methods [34502],molec,Molecular Genetics (Biochemistry and Molecular Bio,Nonhuman Mammals,Nonhuman Vertebrates,Tursiops truncatus [bottle-nosed dolphin] (Delphin,Vertebrata,Vertebrates},
  number = {6}
}

@article{Inoue1999b,
  title = {Cloning and Sequencing of the Bottle-Nosed Dolphin ({{Tursiops}} Truncatus) Interferon-Gamma Gene},
  author = {Inoue, Y and Itou, T and Oike, T and Sakai, T},
  year = {1999},
  volume = {61},
  pages = {939--942},
  abstract = {The bottle-nosed dolphin (Tursiops truncatus) interferon-gamma (IFN-gamma) cDNA was cloned from mitogen stimulated peripheral blood mononuclear cells (PBMC) RNA utilizing the reverse transcription-polymerase chain reaction (RT-PCR). The dolphin IFN-gamma cDNA was 585 base pairs in length and contained an open reading frame of 498 nucleotides encoding an IFN-gamma precursor of 166 amino acids, with cleavage of the putative signal peptide of 19 amino acids. Analysis of the mature amino acid sequences revealed two potential N-linked glycosylation sites. Comparison of the predicted amino acid sequence showed that dolphin IFN-gamma shares 86, 85, 63 and 42\% similarity with the bovine, ovine, human and mouse IFN-gamma(s), respectively. [References: 20]},
  journal = {Journal of Veterinary Medical Science},
  keywords = {Cdna,Chain-reaction,Dolphin (bottle-nosed),Expression,Ifn-gamma,Ifn-gamma.,Immune interferon,Killer whale,Molecular-cloning,Nucleotide.,Orcinus-orca,Veterinary Medicine/Animal Health in Current Conte},
