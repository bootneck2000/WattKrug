@article{Fujise1993,
  title = {Cruise Report of the 1991/92 {{Japanese}} Research in {{Area IV}} under a Special Permit for {{Southern Hemisphere}} Minke Whales},
  author = {Fujise, Yoshihiro and Ishikawa, Hajime and Saino, Shigeo and Nagano, Masatsugu and Ishii, Kenta and Kawaguchi, Sou and Tanifuji, Shigeru and Kawashima, Shuu-Ichi and Miyakoshi, Hiroshi},
  year = {1993},
  volume = {0},
  pages = {357--371},
  abstract = {The cruise for Japanese research under a special permit took place from December 1991 to March 1992 in the Antarctic Area IV (south of 55 degree S, 70-130 degree E) using one research base and three sighting and sampling vessels. The research area was divided into two sectors: West and East which were further divided in latitudinal strata. All the strata, except the North, were surveyed twice. In this cruise, a sighting vessel was allocated in the south sub-areas for improving the searching effort. The other two vessels were engaged in sampling as well as sighting in all the areas surveyed. The fleet surveyed a total of 18,204.5 n.miles and made 616 primary (2,061 animals) and 478 secondary (1,668 animals) sightings of minke whales. The distribution of minke whales was biased to the west and the highest density was observed in Prydz Bay. On the other hand, no whale was observed in the East-Middle stratum in the Second period. Of particular interest was the occurrence of twenty-six schools of right whales which were observed as primary sightings in the Middle and South strata in the Second period. A total of 288 (165 males and 123 females) ordinary form minke whales were caught from primary sightings. Preliminary analyses of this catch showed that patterns of reproductive segregation of minke whales were similar to those observed in the 1989/90 research carried out in the same Area: mature females were concentrated in the South strata, especially in Prydz Bay, immature animals occurred in the Middle strata and mature males were distributed in all the surveyed areas.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals,Balaenidae [85805],Balaenidae: Cetacea,Balaenopteridae: Cetacea,beaked whale (Ziphiidae),Behavior,Behavioral Biology/Animal Behavior [07003],blue whale (Balaenopteridae),cetaceans,Ch,Chord,Chorda,Chordat,Chordata,chordates,Delphinidae: Cetacea,dolphin (Delphinidae),Ecology,Ecology (Environmental Sciences),Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Sciences),fin whale (Balaenopteridae),humpback whale (Balaenopteridae),Mammalia,mammals,Marine Ecology (Ecology,nonhuman mammals,nonhuman vertebrates,Physeteridae: Cetacea,pilot whale (Delphinidae),Reproductive System (Reproduction),Reproductive System/Physiology and Biochemistry [1,right whale (Balaenidae),Sei whale (Balaenopteridae),sperm whale (Physeteridae),Vertebrata,vertebrates,Ziphiidae: Cetacea},
  number = {43}
}

