@article{Cockcroft1989,
  title = {Shark Predation on Indian Ocean Bottlenose Dolphins Tursiops-Truncatus off Natal South Africa},
  author = {Cockcroft, V G and Cliff, G and Ross, G J B},
  year = {1989},
  volume = {24},
  pages = {305--310},
  abstract = {The incidence of shark induced scars on Indian Ocean bottlenose dolphins caught in gill nets off Natal, on the south-east coast of southern Africa, was monitored between January 1983 and June 1987. The occurrence of dolphin remains in sharks caught in these nets between January 1980 and December 1985 was also recorded. Of the dolphins caught, 10.3\% exhibited scars or wounds consistent with shark bites. Only 1.2\% of over 6000 sharks caught contained cetacean remains. Four species of shark, the Zambesi (Carcharhinus leucas), the tiger (Galeocerdo cuvieri), the great white (Carcharodon carcharias) and the dusky shark (Carcharihinus obscurus) were implicated as dolphin predators. Estimates from the number of these four species caught annually and the frequency of occurrence of dolphin flukes and vertebrae in their stomach suggest that a minimum of 20 bottlenose dolphins or 2,2\% of the estimated population in southern Natal coastal waters are killed each year by sharks.},
  journal = {South African Journal of Zoology},
  keywords = {Anim,Animal Distribution (1971- ) [62800],Animals,Cetaceans,Chondrichthyes [85202],Chondrichthyes: Pisces,Chorda,Chordata,Chordates,Delphinidae: Cetacea,Digestive System/General,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Wildlife Management-Aquatic,Fish,Mammalia,Mammals,Methods [14001],Nonhuman Mammals,Nonhuman Vertebrates,Nutrition/General Studies,Nutritional Status and,Vertebrata,Vertebrates},
  number = {4}
}

@article{Cockcroft1990,
  title = {Age Growth and Reproduction of Bottlenose Dolphins Tursiops-Truncatus from the East Coast of Southern Africa},
  author = {Cockcroft, V G and Ross, G J B},
  year = {1990},
  volume = {88},
  pages = {289--302},
  abstract = {Age and reproductive parameters were determined for bottlenose dolphins Tursiops truncatus captured in shark nets off Natal, on the southeast coast of southern Africa. Calibration of dentinal and cemental growth-layer-group(GLG) readings, using a known-age captive-born dolphin, indicated that dentinal and cemental GLGs are deposited annually, at least up to an age of 6 years. Female growth in length and mass and male growth in length are best described by von Bertalanffy growth curves. Male growth in mass is characterized by a growth spurt at puberty. Most growth occurs during the suckling years. Both sexes reach physical maturity and their asymptotic size .sbd.243 cm and 176 kg for males, and 238 cm and 160 kg for females.sbd.between 12 and 15 years. Both males and females may reach ages in excess of 40 years, based on counts of GLGs in teeth. Females attain sexual maturity between 9 and 11 years of age, 2 or 3 years earlier than males. Mating and birth are seasonally diffuse, although there is a peak of births in summer. The calf is born at a mean length and mass of 103 cm and 13.8 kg, respectively, after a gestation period of about 1 year. Lactation lasts between 18 months and two years, although there is evidence of an extended mother and calf association of up to 3 years. Postpubertal female ovulation rate is 0.28/year, and the estimated calving interval is approximately 3 years. There is no evidence that females become reproductively senescent with increasing age. Estimates of population replacement suggest that man-induced mortality may equal or exceed the replacement rate.},
  journal = {Fishery Bulletin},
  keywords = {Animals,Cetaceans,Chorda,Chordat,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Dental and Oral Biology/Anatomy [19002],Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Ge,General and Miscellaneous/Necrosis (197,General and Systematic Zoology/Mammalia,General/Field Me,Genetics and Cytogenetics/Sex Differences [03510],Hominidae: Primates,Humans,Mammalia,Mammals,Materials and Apparatus,Mathematical Biology and Statistical Methods [0450,Methods,Nonhuman Mammals,Nonhuman Vertebrates,Pathology,Primates,Reproductive System/Physiology and Biochemistry [1,Vertebrata,Vertebrates},
  number = {2}
}

@article{Cockcroft1990a,
  title = {Dolphin Catches in the Natal South Africa Shark Nets 1980 to 1988},
  author = {Cockcroft, V G},
  year = {1990},
  volume = {20},
  pages = {44--51},
  abstract = {Between January 1980 and December 1988, 279 Indian Ocean bottlenose dolphins Tursiops truncatus, 316 common dolphins Delphinus delphis and 67 indopacific humpback dolphins Sousa plumbea were caught in shark nets off Natal. Four other species of dolphin (Stenella longirostris, Stenella coeruleoalba, Lagenodelphis hosei and Pseudorca crassidens) were less frequently captured. Humpback and bottlenose dolphins were captured throughout the year reflecting their year-round residence in the Natal inshore zone. In contrast, common dolphin captures occurred predominantly in winter and were closely associated with the Natal 'sardine run'. The annual catch of common dolphins showed significant interannual variation, probably a function of the extent of the 'sardine run'. Captures of bottlenose and common dolphins occurred at most netted beaches off Natal, the level of catch being well correlated with the number of nets set at any particular beach. The majority of humpback dolphin catches occurred in northern Natal, probably indicating their relative abundance in this area. Similar numbers of males and females were captured of both humpback and bottlenose dolphins. Captures of the former were dominated by adolescent and mature dolphins, while captures of calves and mature females dominated the latter. Significantly more female than male common dolphins were captured. The implications and significance of the incidental death of dolphins of these species is discussed.},
  journal = {South African Journal of Wildlife Research},
  keywords = {Anim,Animal,Animals,Cetaceans,Chondrichthyes [85202],Chondrichthyes: Pisces,Chorda,Chordata,Chordates,Delphinidae: Cetacea,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Fish,General and Miscellaneous/Necrosis (197,General Biology/Conservation,Mammalia,Mammals,Nonhuman Mammals,Nonhuman Vertebrates,Osteichthyes: Pisces,Pathology,Resource Management,Vertebrata,Vertebrates},
