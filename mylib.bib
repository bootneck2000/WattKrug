  keywords = {Animals. Chordates. Mammals. Nonhuman Mammals. Non,Arctocephalus townsendi [Guadalupe fur seal] (Otar,Blood,Blood-Forming Organs and Body Fluids/Blood,Chord,Ecology,Environmental Biology/General,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,hematology. post-release survival. rehabilitation.,Mammalia,Methods [07502],North,Otariidae [86180],Otariidae: Pinnipedia,Point Lobos State Reserve (California,Resource Management,serum: blood and lymphatics.,USA,Vertebrata,Wildlife Management (Conservation).},
  number = {2}
