@misc{Arnason1972,
  title = {The Role of Chromosomal Rearrangement in Mammalian Speciation with Special Reference to {{Cetacea}} and {{Pinnipedia}}},
  author = {{\'A}rnason, {\'U}lfur},
  year = {1972},
  volume = {70},
  pages = {113--8},
  issn = {0018-0661},
  abstract = {The karyotypes of 17 cetaceans and 18 pinnipeds are surveyed. Within the Cetacea only two different chromosome numbers have been found, viz. 2n = 42 and 2n = 44. Within the Pinni- pedia three different chromosome numbers have been described, viz. 2n = 32, 2n = 34 and 2n = 36. The material indicates that the orders Cetacea and Pinnipedia are characterized by a remarkable stability of their karyotypic patterns. Factors cooperating towards karyotypic stability may be sought in the reproductive biology of these animals - late sexual maturity and small progeny - as well as in their ecology - good mobility in an environment without distinct niches. In such animals, the main mode of speciation should be a allopatric. The orders Insectivora and Rodentia on the other hand which both display great karyotype variability would accordingly represent a different mode of speciation. The species belonging to these orders have early sexual maturity and large progeny; their mobility is often limited and the distribution discontinuous. Consequently, in Insectivora and Rodentia stasipatric speciation should be frequent.},
  journal = {Hereditas},
  keywords = {1808,Arctocephalus australis,Arctocephalus philippi,Callorhinus ursinus,chromosomes,Cystophora cristata,Erignathus barbatus,Eumetopias jubatus,evolution,genetics,Halichoerus grypus,Leptonychotes weddellii,Mirounga angustirostris,Monachus schauinslandi,Phoca caspica,Phoca fasciata,Phoca groenlandica,Phoca hispida,Phoca sibirica,Phoca vitulina,Zalophus californianus},
  mendeley-tags = {1808},
  number = {1},
  pmid = {4680630}
}

@misc{Arnason1974,
  title = {Comparative Chromosome Studies in {{Cetacea}}.},
  author = {Arnason, U},
  year = {1974},
  volume = {77},
  pages = {1--36},
  issn = {0018-0661},
  abstract = {The karyology was studied in 9 species of cetaceans, viz. in 5 odontocetes and 4 mysticetes. Chromosome measurements and idiograms of 8 species are presented. Comparisons were made between the karyotypes of the different species on the basis of conventional staining methods as well as by autoradiography and by Q-, G-, and C-banding techniques. All cetaceans so far studied have 2n =44, except the sperm and pygmy sperm whales, which have 2n =42 and karyotypes entirely different from those of the 2n =44 species. All of the latter, except the killer whale, have closely concordant karyotypic morphology. Specific attention was payed to the C-heterochromatin, both because of its large amount and its striking pattern. The amount of C-heterochromatin varied from 10-15 \% of the total chromosome length in the odontocetes to 25-30 \% in the mysticetes. In both of them the distribution of C-heterochromatin in the karyotypes was mainly interstitial and terminal and to a lesser extent centromeric. Size hetero- morphism in C-bands was frequently observed between the homologues of the same pair. The pronounced karyotypic agreement between the odontocetes and mysticetes, both in general chromosome morphology and in C-band pattern, is incompatible with the theory of a diphyletic origin of the Odontoceti and Mysticeti.},
  journal = {Hereditas},
  keywords = {2253,chromosomes,Cystophora cristata,Erignathus barbatus,Eumetopias jubatus,genetics,Halichoerus grypus,Leptonychotes weddellii,Mirounga angustirostris,Odobenus rosmarus,Phoca fasciata,Phoca groenlandica,Phoca hispida,Phoca vitulina,Zalophus californianus},
  mendeley-tags = {2253},
  number = {1},
  pmid = {4137586}
}

@misc{Arnason1977,
  title = {The Relationship between the Four Principal Pinniped Karyotypes},
  author = {{\'A}rnason, U},
  year = {1977},
  volume = {87},
  pages = {227--242},
  issn = {00180661},
  abstract = {The karyotypes of 5 pinnipeds, Arctocephalus pusillus 2n = 36, Callorhinus ursinus 2n = 36, Odobenus rosmarus 2n = 32, Monachus schauinslandi 2n = 34 and Phoca fasciata 2n = 32, were studied. Based on the present and previously studied material a comparison based on G-band patterns was made between the 4 principal pinniped karyotypes. The otariid and odobenid karyotypes are closely related, the otariid karyotype being the more ancestral. The 2n = 32 phocid karyotype has evolved from the 2n = 34 karyotype by a 2-pair fusion. The similarity between the 2n = 36 otariid and the 2n = 34 phocid karyotypes is greater than the similarity between either of these karyotypes and any carnivore karyotype. The karyological analysis thus support the thoery of a monophyletic origin of the Pinnipedia even if it cannot be completely excluded that the recent pinnipeds evolved from different ancestors that shared the same karyotype.},
  journal = {Hereditas},
  keywords = {1917,Arctocephalus pusillus,Callorhinus ursinus,karyotype,karyotypes,Marine,Monachus schauinslandii,Odobenus rosmarus,Phoca fasciata,Pinnipedia},
  mendeley-tags = {1917},
