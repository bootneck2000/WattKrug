@article{Kloeser1992,
  title = {Adjustment of Anisakid Nematode Life Cycles to the High Antarctic Food Web as Shown by Contracaecum-Radiatum and Contracoecum-Osculatum in the Weddell Sea},
  author = {Kloeser, H and Ploetz, J and Palm, H and Bartsch, A and Hubold, G},
  year = {1992},
  volume = {4},
  pages = {171--178},
  abstract = {The infestation of Weddell seals and several fish species by the anisakid nematodes Contracaecum osculatum and C. radiatum was compared. Nematode numbers in Weddell seal stomachs ranged from 30 560 to 122 640. Third stage larvae from seals and fish were separated into a short and long type. The short type was related to C. radiatum and the long type to C. osculatum. The short type was more abundant in pelagic fish species, whereas the long type prevailed in benthic fish species. Fish-feeding channichthyids Cryodraco antarcticus and Chionodraco myersi seemed to play an important role as paratenic hosts for the third stage larvae of both Contracaecum species. Different advantageous and detrimental features of a benthic versus a pelagic life cycle under high Antarctic ecological conditions are discussed. Varying abundance of the two nematode species in hosts may be controlled by differences in their life cycles, which follow either a pelagic or a benthic food web. Crucial importance is thus given to the local availability of pelagic versus benthic food resources for Weddell seals.},
  journal = {Antarctic Science},
  keywords = {*Developmental Biology/Embryology-Morphogenesis,*Digestive System/Pathology [14006],*Ecology,*Invertebrata,*Nutrition/General Studies,*Parasitology/General [60502],9200,Anatomy and Histology,Animals. Invertebrates. Helminths. Aschelminths. C,Comparative and Experimental Morpho,Cryodraco-Antarcticus Chionodraco-Myersi Larvae St,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],G,General and Comparative/Com,Nematoda [51300],Nutritional Status and,Osteichthyes [85206],Phocidae [86185],Pisces-Unspecified [85200]},
  number = {2}
}

@article{Kloeser1992a,
  title = {Morphological Distinction between Adult Contracaecum-Radiatum and Contracaecum-Osculatum Nematoda Anisakidae from the Weddell Seal Leptonychotes-Weddelli},
  author = {Kloeser, H and Ploetz, J},
  year = {1992},
  volume = {21},
  pages = {129--132},
  abstract = {Morphological characters of the anisakid nematodes Contracaecum radiatum and C. osculatum from the Weddell Sea are reviewed. Both species occur in stomachs of seals in high southern latitudes. The investigation aims at providing some reliable criteria for quantitative routine light microscopy. Characters allowing a safe identification of the two species are: spicules and tail structures in males; lips, interlabia and collar in both sexes. Oesophageal shape and interlabial striation cannot be recommended for identification purposes.},
  journal = {Zoologica Scripta},
  keywords = {*Anatomy and Histology,*Digestive System/Pathology [14006],*Invertebrata,*Parasitology/General [60502],9200,Animals. Invertebrates. Helminths. Aschelminths.,Comparative and Experimental Morpho,General and Comparative/Co,General and Comparative/Mi,General and Systematic Zoology/Asch,Nematoda [51300],Stomach Light Microscopy},
  number = {2}
}

