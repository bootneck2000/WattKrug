@article{Kuronuma1993,
  title = {Institutional Management of an International Mixed Good - the Iwc and Socially Optimal Whale Harvests},
  author = {Kuronuma, Y and Tisdell, C A},
  year = {1993},
  volume = {17},
  pages = {235--250},
  abstract = {This paper illustrates and discusses the applicability of the economic theory of 'common property' (res communis) resources to whale management. It reexamines empirical evidence about the economic irrationality of the economic management of 'common property' resources with reference to several whale stocks, and analyses the past management of whale resources by the International Whaling Commission (IWC). It shows that the collective management of whale stocks as a private good by the IWC has not resulted in collective efficiency as defined in the IWC's original convention. It also analyses the current situation, in the context of the IWC's international management of whales as a mixed good, which may be considered to be its present management objective. This discussion indicates the need for further research to determine the externality costs of harvesting (or not harvesting) each whale species, so that the IWC can achieve an optimal solution from a potential Paretian improvement perspective. At the present time a Kaldor-Hicks optimum appears not to prevail in whaling. [References: 26]},
  journal = {Marine Policy},
  keywords = {\& development.,Geography,planning},
  number = {4}
}

@article{Kusagaya,
  title = {Sevoflurane Anesthesia for Weddell Seals in the Antarctica},
  author = {Kusagaya, Hiromitsu and Sato, Katsufumi},
  volume = {2002},
  pages = {A--94},
  abstract = {(Introduction) A safe and easy immobilization procedure is essential for behavioural studies which are based on animal-mounted recording equipment. Although inhalation anesthetics present many advantages, their application requires a variety of equipment and, furthermore, the low temperature environment of the Antarctica can cause difficulties for vaporizing volatile anaesthetics. Therefore most researchers have prefered injection of ketamine combined with diazepam for Weddell seals in the field. In this study, we present sevoflurane anesthesia without a vaporizer for seals in the Antarctica. (Methods) Nine adult female Weddell seals were studied near Syowa Station (69degree00'S, 39degree35'E), Antarctica, between November 7 and December 6, 1999. Anesthesia was performed in order to attach data loggers and tags on the seals. Seals were captured using head bags. The apex of the bag formed a respiratory chamber in front of the seal's head. Sevoflurane (liquid) was administered directly into this chamber used as a vaporizing chamber. The concentration of sevoflurane evaporating into the air at -5 to -10degreeC is about 5 \%, which is the adequate concentration for induction of anesthesia. A dose of 5 ml of Sevoflurane was administered to induce narcosis and doses of 2 ml were administered as multiple follow-up doses to maintain anesthesia. The body weight of each seal was calculated according to length and girth. The experimental protocol was conducted with prior approval from the National Institute of Polar Research Ethics Committee. (Results) The air temperature ranged from -4 to -12degreeC (-7.6+-2.7degreeC) during the field studies. The seal's body weight ranged from 248 to 410 kg (331+-64 kg). An initial dose of 5 ml of sevoflurane was adequate to induce anesthesia within 1 minute after application. Three minutes after the induction of narcosis, a follow-up dose of 2 ml sevoflurane was necessary and administrations at 2 minute intervals were adequate to maintain anesthesia. The need for additional anesthetic was assessed from the degree of muscle relaxation and the quality of respiration observed in the anesthetized seals. Respiratory arrest was observed in two seals for nearly 1 minute, but the seals returned to normal respiration after being touched and/or prodded. Three seals exhibited slight movements of the body and/or head raising during anesthesia. No reaction to the tag attachment was observed in 5 cases and only slight movement in the other 3 cases. Nine minutes after the final administration of sevoflurane, the seals raised their heads and started to move. Eleven minutes after the last dose of sevoflurane, normal communication was observed between mothers and pups. The total anesthesia time ranged from 9 to 76 min (42+-26 min) depending on the time required for mounting or retrieving the data loggers. The total dose of sevoflurane required to maintain proper conditions during anesthesia ranged from 5 to 77 ml (34+-25 ml) per seal. (Conclusion) In our study, adequate immobilization was ensured by sevoflurane anesthesia in all seals, without any fatalities or other complications. This simple method can provide safe and practical anesthesia for Weddell seals in the field where it is difficult to transport and use sophisticated anaesthesia equipment.},
  journal = {Anesthesiology Abstracts of Scientific Papers Annual Meeting.(2001)}
}

@article{Kusagaya2001,
  title = {A Safe and Practical Inhalation Anaesthesia for {{Weddell}} Seals},
  author = {Kusagaya, Hiromitsu and Sato, Katsufumi},
  year = {2001},
  volume = {24},
  pages = {549--552},
  abstract = {Nine adult female Weddell seals were anaesthetized during the breeding season using the inhalation anaesthetic sevoflurane. The seals were captured with a head bag. Sevoflurane was administered and vaporized into the bag. A dose of 5 ml sevoflurane induced narcosis 1 min after application. Anaesthesia was maintained by multiple follow-up doses of 2 ml at an interval of 2 min. The average duration for complete recovery was 11degree3 min after the terminal application. Sevoflurane is a reliable volatile anaesthetic that requires a minimum of equipment even under the low temperature regime of Antarctica.},
