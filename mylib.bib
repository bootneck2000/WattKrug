@article{Zhao2012,
  title = {Distribution and Long-Range Transport of Polyfluoroalkyl Substances in the {{Arctic}}, {{Atlantic Ocean}} and {{Antarctic}} Coast},
  author = {Zhao, Zhen and Xie, Zhiyong and M{\"o}ller, Axel and Sturm, Renate and Tang, Jianhui and Zhang, Gan and Ebinghaus, Ralf},
