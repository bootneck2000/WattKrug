@article{Ehrich2011,
  title = {Stable Isotope Analysis: {{Modelling}} Lipid Normalization for Muscle and Eggs from Arctic Mammals and Birds},
  author = {Ehrich, Doroth{\'e}e and Tarroux, Arnaud and Stien, Jenny and Lecomte, Nicolas and Killengreen, Siw and Berteaux, Dominique and Yoccoz, Nigel G.},
  year = {2011},
  month = jan,
  volume = {2},
  pages = {66--76},
  issn = {2041210X},
  doi = {10.1111/j.2041-210X.2010.00047.x},
  abstract = {1. Lipids are more depleted in 13C than proteins. Variable lipid contents in tissues affect therefore the measurements of stable carbon isotope ratios.Model based (also called mathematical) normali- zation has been suggested to correct d13C values using the ratio of carbon to nitrogen (C{$\fracslash$}N) as a proxy for lipid content.This approach has not been thoroughly validated for terrestrial animals and it is not clear towhat extent it is generally applicable or species {$\fracslash$} tissue specific. 2. Ratios of stable carbon isotopes (d13C) were obtained formuscle samples of 22mainly terrestrial arctic mammal and bird species and for egg samples of 32 bird species fromnine sites in the circum- polar Arctic. We used linear and nonlinear equations to model the difference in d13C between samples from which lipids had been extracted chemically and bulk tissue samples. Models were compared on the basis of a model selection criterion (AIC) and of prediction error as estimated by cross-validation. 3. For muscle samples, a linear and a nonlinear equation performed equally well. The observed values were also well predicted by a previously published general equation for aquatic organisms. For egg samples, a nonlinear equation fitted separately to waterfowl and non waterfowl bird species fitted the data best. Prediction errorswere, however, larger than formuscle samples. 4. The generality of the inferred normalization equations was assessed by applying them to a second data set froma similar ecosystem, but produced in the frame of another study.The predicted lean d13C values werewithin0\AE 5\&of the observed values for 73\%of the muscle samples, but only for 27\%of the egg samples. 5. Based on our results, we recommend model based normalization of d13Cvalues as an economic way to deal with varying lipid contents in muscle samples of mammals and birds. For egg samples, on the contrary, model based predictions had large errors. Therefore,we recommend chemical lipid extraction in order to estimate lipid-free d13Cvalues for egg content.},
  isbn = {2041210X},
  journal = {Methods in Ecology and Evolution},
  keywords = {?? 13C,?? 15N,C/N ratio,Cross-validation,Lipid content,Lipid correction,Lipid extraction,Mathematical normalization,Model selection,Trophic relationships},
  number = {1}
}

