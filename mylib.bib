@article{Teixeria1979,
  title = {Marine Mammals of the Portuguese Coast},
  author = {Teixeria, A M A P},
  year = {1979},
  volume = {44},
  pages = {221--238},
  abstract = {The marine mammals known from Portuguese Iberian waters were studied to elucidate which species may be found there and their present-day status. Data were collected between Oct. 1976 to April 1978 and came from museum collections, bibliography references, recent strandings on the coast, visits to several fish markets and from some observations conducted at sea. Nineteen species [Phoca vitulina, Pusa hispida, Halichoerus grypus, Phocoena phocoena, Delphinus delphis, Stenella coeruleoalba, Tursiops truncatus, Grampus griseus, Pseudorca crassidens, Orcinus orca, Globicephala sp., Ziphius cavirostris, Physeter macrocephalus, Kogia breviceps, Eubalaena glacialis, Megaptera novaeangliae, Balaenoptera musculus, B. physalus and B. acutorostrata] were identified. Among the odontocetes, 1 sp., D. delphis, was quite common; 5 others, P. phocoena, S. coeruleoalba, T. truncatus, Z. cavirostris and P. macrocephalus, showed up regularly. With the possible exception of B. physalus, mysticetes should be considered rare. Very infrequent seal reports referred only to 3 spp., P. vitulina, H. grypus and P. hispida.},
  journal = {Zeitschrift fuer Saeugetierkunde},
  number = {4}
}

@article{Telfer2006,
  title = {Diet of Four Rock-Dwelling Macropods in the {{Australian}} Monsoon Tropics},
  author = {Telfer, W R and Bowman, Dmjs},
  year = {2006},
  volume = {31},
  pages = {817--827},
  doi = {10.1111/j.1442-9993.2006.01644.x},
  abstract = {fAn unusually high diversity of macropods inhabit the rocky areas in the monsoon tropics of the Northern Territory, Australia, yet the mechanisms that allow their niche separation are not clear. Previous studies suggest that the nabarlek, Petrogale concinna, may have a more grazing diet than the short-eared rock-wallaby, Petrogale brachyotis, with whom it coexists. Thus, diet may be an important mechanism of niche separation between these species. We examined the diet of the four sympatric species (the black wallaroo Macropus bernardus, common wallaroo Macropus robustus, P. brachyotis and P. concinna) to determine whether there are differences in the dominant plant groups eaten by the species across the landscape and with season. Diets were determined with a macroscopic analysis of the seed and fruit content of scats and an analysis of the C-12 to C-13 isotope ratios of scats using mass spectrometry. In the dry season the rock-wallaby species predominantly consumed browse and/or forbs, and the larger wallaroos predominantly consumed grass. However, there was large variation across the landscape in the dry season diets of P. brachyotis, M. bernardus and M. robustus; including high proportions of grass eaten at some sites and high proportions of browse at other sites. In the wet season, greater proportions of grass were eaten by P. brachyotis and M. bernardus than in the dry season. Generally, there was little evidence to support the previous suggestion that P. concinna is more of a grazer than P. brachyotis, but there was some evidence than M. bernardus consumes greater amounts of browse and/or forbs than M. robustus.},
  isbn = {1442-9985},
  journal = {Austral Ecology},
  keywords = {carbon isotope ratio,feeding ecology,HARE-WALLABY,KAKADU-NATIONAL-PARK,Macropus,MARSUPIALIA,NEW-SOUTH-WALES,NORTHERN-TERRITORY,Petrogale,PETROGALE-ASSIMILIS,rock-wallaby,RUFOUS,STABLE CARBON ISOTOPES,TANAMI DESERT,VEGETATION CHANGE,WET-DRY TROPICS},
  language = {English},
  number = {7}
}

