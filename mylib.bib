@article{Mannel2007,
  title = {Altitudinal Gradients of Grassland Carbon and Nitrogen Isotope Composition Are Recorded in the Hair of Grazers},
  author = {Mannel, T T and Auerswald, K and Schnyder, H},
  year = {2007},
  volume = {16},
  pages = {583--592},
  doi = {10.1111/j.1466-8238.2007.00322.x},
  abstract = {Aim The hair of grazers provides an isotopic record of environmental and nutritional signals. Here, we assess the effect of altitude on the carbon and nitrogen isotope composition of the hair of ruminant grazers and its relation to grassland vegetation, to evaluate the use of hair isotope data for ecosystem reconstruction, animal nutritional ecology and biogeochemical studies in montane environments. Location European Alps. Methods We sampled grassland vegetation (pure C-3) and the hair of ruminants along an altitudinal gradient (400-2500 m), and analysed their isotope composition (delta C-13 and delta N-15). Results were compared with published effects of altitude on C-13 in C-3 plants at the species level and on N-15 at the community level. The study was complemented with a comparison of diet and hair isotope composition in ruminants held in confinement. Results delta C-13 of hair increased (c. 1.1 parts per thousand km(-1)) and delta N-15 decreased (c. 1.1 parts per thousand km(-1)) with altitude. The same changes occurred in local grassland vegetation, and in regional to global grassland data sets. Offsets between hair and vegetation C-13 or N-15 ('diet-hair shift') were independent of altitude. Sheep (Ovis aries) and cattle (Bos taurus) exhibited a C-13 shift near +3 parts per thousand, but that of goats (Capra hircus) was larger (+4.2 parts per thousand) in alpine environments and in confinement. The diet-hair shift for N-15 was more variable (+2.1 to +3.6 parts per thousand). Main conclusions Grazer hair provides a faithful spatially and temporally integrated record of grassland isotope composition, useful for ecosystem and environment reconstruction. The effect of altitude on hair N-15 is important for studies of trophic relationships: an altitude shift of 2000 m produced the same effect in hair N-15 as would a shift from an animal tissue-based to a plant-based diet. The similarity of altitude effects on delta C-13 of individual plant species, vegetation and hair indicates that the effect of altitude on species-level 'intrinsic water use efficiency' scales up linearly to the community and landscape level.},
  isbn = {1466-822X},
  journal = {Global Ecology and Biogeography},
  keywords = {alps,altitude,cattle,delta C-13,delta N-15,DIET,EXTENSIVELY MANAGED GRASSLAND,goats,isotope ecology,MAMMALIAN HERBIVORES,METROSIDEROS-POLYMORPHA,N-15,NATURAL-ABUNDANCE,NET PRIMARY PRODUCTIVITY,PRECIPITATION GRADIENT,sheep,stable isotopes,STABLE-ISOTOPES,SYMBIOTIC N-2 FIXATION,trophic shift,WATER AVAILABILITY},
  language = {English},
  number = {5}
}

