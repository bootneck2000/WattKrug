@article{Miyazaki1994b,
  title = {Skull Morphology of Two Forms of Short-Finned Pilot Whales off the Pacific Coast of Japan},
  author = {Miyazaki, Nobuyuki and Amano, Masao},
  year = {1994},
  volume = {0},
  pages = {499--508},
  abstract = {Populations of the short-finned pilot whale off the Pacific coast of Japan have been known to comprise two morphotypes generally referred as the northern form and the southern form. We compared skull morphometry for specimens of the two forms. The northern form has a proportionally wider cranium and rostrum in both sexes, and was distinguishable from the southern form by principal component and linear discriminant analyses. We consider that these two geographical forms should be treated as separate species. The degree of sexual dimorphism in the size and shape of the skull appears to be different in each form; dimorphism in size was more evident in the northern form, whereas that in shape was more prominent in the southern form. This tendency is consistent with sexual dimorphism in body length or in head and dorsal fin shape.},
  journal = {Report of the International Whaling Commission},
  keywords = {Anatomy and Histology,animals,Bones,cetaceans,Chorda,Chordata,Chordate Body Regions/Head (1970- ) [11304],chordates,Connective and Adipose Tis,Delphinidae (Delphinidae),Delphinidae [85815],Delphinidae: Cetacea,Ecology,Environmental Biology/Oceanography [07512],Environmental Sciences),Fasciae,General and Comparative/Gro,General and Systematic Zoology/Mammalia,General Biology/Taxonomy,General Life Studies,Genetics,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/Population Genetics (197,Joints,Mammalia,mammals,Marine Ecology (Ecology,Morphology,Nomenclature and Termino,nonhuman mammals,nonhuman vertebrates,Population Genetics (Population Studies),Skeletal System (Movement and Support),Systematics and Taxonomy,Vertebrata,vertebrates},
  number = {44}
