@article{Kasuya1984,
  title = {Age Determination and Growth of the Short-Finned Pilot Whale Globicephala-Macrorhynchus off the Pacific Coast of Japan},
  author = {Kasuya, T and Matsui, S},
  year = {1984},
  pages = {57--92},
  abstract = {Data and specimens from 373 female and 170 male G. macrorhynchus collected off the Pacific coast of central Japan over an 8-mo. period were studied. The deposition rate of dentinal growth layers was annual, the hematoxylin-stainable layer being formed from May-Oct. and the unstainable layer from Dec.-Feb. The annual deposition of cemental layers continued after dentine deposition ceased, enabling the age of old individuals to be determined. The maximum age attained by females was 62 yr, that of males 45 yr. Females almost ceased growth at sexual maturity (9 yr) and reached the asymptotic length of 364 cm at age 22 yr. Male growth was similar to that of females until age 9 yr, when the secondary male growth spurt started. Males attained an asymptotic length of 473.5 cm at 27 yr. Body length could be converted into age with an accuracy of .+-.2 yr, up to a body length of 280 cm (females, equivalent to age 5 yr) or 320 cm (males, age 8 yr). The relationship between body weight (W, kg) and body length (L, cm) of fetal and postnatal individuals of both sexes was described by log W = 2.28873 log L + log (2.77 .times. 10-5).},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Anatomy and Histology,Animal Distribution (1971- ) [62800],Animals,Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Dental and Oral Biology/Anatomy [19002],Developmental Biology/Embryology-General and Descr,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Ge,General and Comparative/Gro,General and Miscellaneous/Comparative,General and Systematic Zoology/Mammalia,Mammalia,Mammals,Nonhuman Mammals,Nonhuman Vertebrates,Pediatrics [25000],Physiology,Reproductive System/Physiology and Biochemistry [1,Vertebrata,Vertebrates},
  number = {35}
}

@article{Kasuya1984a,
  title = {Behavior and Segregation of the Dalls Porpoise Phocoenoides-Dalli in the Northwestern North Pacific Ocean},
  author = {Kasuya, T and Jones, L L},
  year = {1984},
  pages = {107--128},
  abstract = {The life history of Dall's porpoise, P. dalli (True, 1885) that are incidentally caught by the Japanese salmon mothership fishery in the northewestern North Pacific was studied during a 34-day cruise conducted Aug.-Sept. 1982, after the fishing season. A total of 710 Dall's porpoise were sighted and 80 were caught using hand-held harpoons. The species' southern limit was at 41.degree.N, at a surface water temperature of 18.degree.-19.degree. C and overlapped the range of Lissodelphis and Lagenorhynchus. Distribution of the truei-type was limited to the Japanese coastal waters and the number sighted was negligible east of 155.degree.E. Density of Dall's porpoise was higher in the western and northern parts of the research area and lower in the southeast. More Dall's porpoise rode the ship's bow wave during mid-day than in the morning or evening and in areas where the surface water temperature was 11.degree. C or above. In areas with a surface water temperature of 11.degree. C or below, most of the Dall's porpoise avoided the ship. The latter areas had a high number of mother-calf pairs and calves possibly weaned, none of which rode the bow wave. Adults not accompanying calves were sighted in both areas. School size was not different between the 2 areas. Most of the specimens were taken in the southern part of the study area. Males predominated and most were 2-6 yr old, around the age of attainment of sexual maturity. Lactating individuals were significanlty scarce in the sample. The dalli-type reached sexual maturity at a smaller body length than the truei-type. Based upon comparisons of results from this cruise with those obtained from the salmon mothership fishery since June-Sept. 1978, females in the state of late pregnancy, lactation or pregnancy and simultaneous lactation are mainly distributed in the northern area, and the southern area is mainly occupied by males and some females not accompanied by calves.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Behavioral Biology/Animal Behavior [07003],Cetaceans,Chorda,Chordata,Chordates,Circadian Rhythms and Other Periodic Cycles [07200,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Effects and Regulati,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,External Effects/Temperature as a Primary Variable,General and Systematic Zoology/Mammalia,Mammalia,Mammals,Nonhuman Mammals,Nonhuman Vertebrates,Pediatrics [25000],Reproductive System/Physiology and Biochemistry [1,Temperature: Its Measurement,Vertebrata,Vertebrates},
  number = {35}
}

@article{Kasuya1985,
  title = {Growth of Dalls Porpoise Phocoenoides-Dalli in the Western North Pacific and Suggested Geographical Growth Differentiation},
  author = {Kasuya, T and Shiraga, S},
  year = {1985},
  pages = {139--152},
  abstract = {Some growth parameters of the western North Pacific P. dalli-type Dall's porpoise were estimated from 167 specimens taken with hand-held harpoons on two cruises and compared with data obtained previously from porpoises killed incidentally in the salmon gill net fishery. These parameters were compared with previously published figures for the Japanese coastal population. Individuals from the Pacific coast of Japan (96\% were P. truei-type) attained sexual maturity at body lengths 12 to 17 cm larger than P. dalli-type individuals in the offshore waters. This is an indication of genetic differentiation between the two populations in addition to the previously reported external pigmentation. The possible usefulness of the growth parameters for the detection of genetic isolation between two major color types off the Pacific coast of Japan is indicated.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Anatomy and Histology,Animal Distribution (1971- ) [62800],Animals,Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Ge,General and Comparative/Com,General and Systematic Zoology/Mammalia,General/Field Me,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/Population Genetics (197,Integumentary System/Anatomy [18502],Mammalia,Mammals,Materials and Apparatus,Methods,Methods [16501],Nonhuman Mammals,Nonhuman Vertebrates,Reproductive System/General,Vertebrata,Vertebrates},
  number = {36}
}

@article{Kasuya1985a,
  title = {Effect of Exploitation of Reproductive Parameters of the Spotted and Striped Dolphins off the Pacific Coast of Japan},
  author = {Kasuya, T},
  year = {1985},
  pages = {107--138},
  abstract = {Age composition and reproductive status of samples from two species of dolphins [Stenella coeruleoalba and S. attenuata] taken in the Japanese drive fishery are analyzed. A slight decline in the minimum age at attainment of sexual maturity was noted in females of the lightly exploited spotted dolphin. Females of the more intensely exploited striped dolphin underwent a decline in the mean age at sexual maturation from 9.7 years (1956 cohort) to 7.2 years (1970 cohort), accompanied by a decline of the minimum age at maturity. A more tentative finding on the species in the shortening of the mean reproductive cycle from 4.00 years (1955) to 2.76 years (1977). This is a direct result primarily of the probable change in the lactation period but also of the change in the resting period and in the proportion of lactating females simultaneously pregnant. Exploitation and response of the population has probably changed the age composition in the striped dolphin more than that of the spotted dolphin.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animals,Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Wildlife Management-Aquatic,Ge,General and Systematic Zoology/Mammalia,Mammalia,Mammals,Methods [16501],Nonhuman Mammals,Nonhuman Vertebrates,Reproductive System/General,Vertebrata,Vertebrates},
  number = {36}
}

@article{Kasuya1986,
  title = {Distribution and Behavior of Baird's Beaked Whales Berardius-Bairdii off the Pacific Coast of Japan},
  author = {Kasuya, T},
  year = {1986},
  pages = {61--84},
  abstract = {Aerial sighting records from the last 25 years and ship board sightings in 1984 indicate that the Baird's beaked whales which occur off the Pacific coast of Japan in summer through autumn live in schools of 1 to 30 individuals (average \textexclamdown{} 10). The schools stay underwater for up to about one hour, 4 to 5 times longer than the time at surface. Baird's beaked whales in the area are seasonally distributed on the continental slope at depth of 1,000 to 3,000 m, and north of 34.degree. N latitude under the influence of the subsurface cold Oyashio Current. The whales appear off the Boso Peninsula near the southern limit of their range on the Japanese Pacific coast in early summer reaching a peak in August, and then move north along the continental slope, peaking in October-November off the Pacific coast of Hokkaido. This seasonal movement is discontinuous to that of this species in the Sea of Japan and Okhotsk Sea, suggesting that these three areas are inhibited by separate populations. However, the northern range of the Pacific coast population if still unconfirmed and their distribution in December to May is unknown.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Behavioral Biology/Animal Behavior [07003],Cetaceans,Chordata,Chordates,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],General and Systematic Zoology/Mammalia,General/Field Me,Mammalia,Mammals,Materials and Apparatus,Methods,Nonhuman Mammals,Nonhuman Vertebrates,Vertebrata,Vertebrates,Ziphiidae [85840],Ziphiidae: Cetacea},
  number = {37}
}

@article{Kasuya1986a,
  title = {Perinatal Growth of Delphinoids Information from Aquarium Reared Bottlenose Dolphins and Finless Porpoises},
  author = {Kasuya, T and Tobayama, T and Saiga, T and Kataoka, T},
  year = {1986},
  pages = {85--98},
  abstract = {The early postnatal growth of bottlenose dolphins and finless porpoises was studied using 97 body length records of 61 individuals born in aquariums. The growth rates observed were similar to those estimated independently for wild dolphins assuming that dentinal growth layers are deposited annually. The perinatal growth parameters thus estimated were also close to those predicted using published interspecific relationships. These results suggest that (1) the dentinal growth layers are deposited annually in these species and (2) the interspecific relationships of the parameters can be used to examine the correctness of growth layer interpretation.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animals,Cetaceans,Chorda,Chordata,Chordates,Circadian Rhythms and Other Periodic Cycles [07200,Delphinidae [85815],Delphinidae: Cetacea,Dental and Oral Biology/Anatomy [19002],Developmental Biology/Embryology-Morphogenesis,Ge,General and Systematic Zoology/Mammalia,Mammalia,Mammals,Nonhuman Mammals,Nonhuman Vertebrates,Vertebrata,Vertebrates},
  number = {37}
}

@article{Kasuya1987,
  title = {Distribution of Mother-Calf Dall's Porpoise Pairs as an Indication of Calving Grounds and Stock Identity},
  author = {Kasuya, T and Ogi, H},
  year = {1987},
  pages = {125--140},
  abstract = {Eighty nine mother-calf Dall's porpoise pairs [Phocoenoides dalli] were sighted in August and September 1982, 1983 and 1985 in the Bering Sea an the western North Pacific (outside the principal range of the truei-type population). These sightings were analyzed with an attempt to determine the range of the calving ground and the identity of the stocks. Three discrete concentrations of such pairs were found in the study area, two in the Pacific area north of 45.degree. N and another in the central Bering Sea. The dalli-type Dall's porpoises in the surveyed area represent at least two local stocks each breeding to the north and south of the western Aleutian Islands. In addition to these, there is probably another stock which calves off the east coasts of the northern Kuril Islands, [USSR] although its relationship with the Sea of Japan-Okhotsk Sea stock needs additional examination.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,Mammalia,Mammals,Methods [16501],Nonhuman Mammals,Nonhuman Vertebrates,Pediatrics [25000],Reproductive System/General,Vertebrata,Vertebrates},
  number = {38}
}

@article{Kasuya1988,
  title = {Distribution of Sperm Whale Stocks in the North Pacific},
  author = {Kasuya, T and Miyashita, T},
  year = {1988},
  pages = {31--76},
  abstract = {Two contrary opinions on the segregation pattern of sperm whale stocks in the North Pacific, i.e. longitudinal vs. latitudinal, were tested using whaling operation data, results of recent sighting cruises, and movements of marked whales. While Japanese coastal sperm whaling was exploiting the breeding schools, the operation gradually changed from summer to winter and from north to south. In the late 1950s and 1960s most of the whales were taken during summer in the cold Oyashio Current area. During the 1970s whales were taken in the warm Kuroshio Current area in summer and in the Oyashio area in other seasons. In the 1980s most of the whaling occurred in the Kuroshio Current area during the winter. The last phase is certainly undesirable for the industry using whaling stations opened for the northern ground. In recent years sperm whale sightings are rare in summer in the previous whaling grounds north of the Kuroshio Current and its extension. These changes in the whaling operation and the whale distribution are explained by assuming two latitudinally segregating sperm whale stocks and ealier depletion of the northern one. In the summer adult males move to colder waters segregating from their breeding population as well as adult males of different stocks. This supported by additional information from blood types, movement of marked whales, operation of Japanese pelagic whaling, and recent whale sightings. We further deduced that the eastern North Pacific is probably inhabited by a single sperm whale stock, although presence of some local stocks is not fully excluded. The present study also indicates the importance of ocean currents and water masses for the evolution of sperm whale stocks, and provided an example that a habitat vacancy produced by the depletion of one stock is not easily reoccupied by nearby stocks. The successive exploitation of different components of one stock or exploitation of more than one stock with overlapping time period could have masked possible changes in the population structure and some density dependent life history parameters.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Behavioral Biology/Animal Behavior [07003],Cetaceans,Chord,Chordata,Chordates,Ecology,Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,General Biology/History and Archaeology [00522],Mammalia,Mammals,Methods [16501],Nonhuman Mammals,Nonhuman Vertebrates,Physeteridae [85830],Physeteridae: Cetacea,Reproductive System/General,Vertebrata,Vertebrates},
  number = {39}
}

@article{Kasuya1988a,
  title = {Re-Examination of Life History Parameters of Long-Finned Pilot Whales in the Newfoundland Waters Canada},
  author = {Kasuya, T and Sergeant, D E and Tanaka, K},
  year = {1988},
  pages = {103--120},
  abstract = {Age dependent life history parameters of the long-firmed pilot whale were analyzed using recent technique of aging which allowed accurate age estimate for old individuals and materials taken in 1954 from the drive fishery off Newfoundland and once used by Sergeant (1962). In both sexes mean growth ceases at ages between 21 and 25 years, when natural mortality increases. Males live to age 36 years or about 10 years shorter than females. Natural mortality is dependent on age in both sexes, and male mortality exceeds that of females of the same age, thus causing age related decline of male proportion in the population. Pregnancy rate is not apparently dependent on age of females and the possibility of a large proportion of postreproductive females is rejected, which is different from feature known on the short-finned pilot whale. Additionally, long-finned pilot whales differ from short-finned pilot whales in the younger age at maturation, shorter longevity and higher proportion of adult males, suggesting less specialized reproductive strategy and difference in the social structure.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Behavioral Biology/Animal Behavior [07003],Behavioral Biology/General and Comparative Behavio,Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Ge,General and Miscellaneous/Necrosis (197,General and Systematic Zoology/Mammalia,Genetics and Cytogenetics/Sex Differences [03510],Mammalia,Mammals,Mathematical Biology and Statistical Methods [0450,Methods [16501],Nonhuman Mammals,Nonhuman Vertebrates,Pathology,Reproductive System/General,Vertebrata,Vertebrates},
  number = {39}
}

@article{Kasuya1988b,
  title = {Segregation of Two Forms of Short-Finned Pilot Whales off the Pacific Coast of Japan},
  author = {Kasuya, T and Miyashita, T and Kasamatsu, F},
  year = {1988},
  pages = {77--90},
  abstract = {Two forms of the short-finned pilot whale are known off the Pacific coast of Japan. The northern form, having larger body size, distinct saddle mark and round contour of the head seen from the top, inhabits the coastal waters between fronts of the cold Oyashio Current and warm Kuroshio Current, or 12.degree.-24.degree.C in surface water temperature and 35.degree.-43.degree.N in latitude. The southern form, having smaller body size, indistinct saddle mark and square shaped contour of adult male head, is known from wide range of the coastal and offshores waters south of the Kuroshio Front (over 18.degree.C and south of 39.degree.N) with some degree of possible density gap within the range. Their geographical ranges may occasionally overlap in the boundary area, but mixed schools of two forms are believed to be very rare. The geographical and social segregation, individually identifiable morphological differentiation, and similarity in their life history characteristics suggest that they can be dealt as separate subspecies or local stocks of the short-finned pilot whale. Although north/south segregation of the corresponding forms might exist in the eastern North Pacific, current information is insufficient for further consideration.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Anatomy and Histology,Animal Distribution (1971- ) [62800],Animals,Behavioral Biology/Animal Behavior [07003],Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Ge,General and Comparative/Com,General and Comparative/Gro,General and Systematic Zoology/Mammalia,General Biology/Conservation,General Biology/Taxonomy,Mammalia,Mammals,Nomenclature and Termino,Nonhuman Mammals,Nonhuman Vertebrates,Resource Management,Vertebrata,Vertebrates},
  number = {39}
}

@article{Kasuya1991,
  title = {Density Dependent Growth in {{North Pacific}} Sperm Whales},
  author = {Kasuya, T},
  year = {1991},
  volume = {7},
  pages = {230--257},
  abstract = {Data from the North Pacific sperm whale (Physeter catodon Linnaeus, 1758) fishery were examined for a possible density dependent change in growth during 40 yr harvesting after World War II. Early in this period males from the eastern stock were 16.8 m or less in length. By the early 1970s the largest males in the catch exceeded 16.8 m in length and reached 18.9 m in the late 1970s. The proportion of males measuring over 16.8 m, among sexually mature males ( greater than or equal to 14.0 m), increased from 0 to \textquestiondown{} 20\% during the 1970s. Increases in the maximum size of males were possibly preceded by a change in the frequency distribution of body lengths in the middle 1960s when only 10\% of the postwar catch had been taken. Testis weights suggested an increase in body length at sexual maturity. Two of the three putative North Pacific stocks showed similar growth changes. Adult males taken in the Bering Sea did not show such changes during the exploitation which ended in 1972 because of overfishing. Females showed no detectable change in body size.},
  journal = {Marine Mammal Science},
  number = {3}
}

