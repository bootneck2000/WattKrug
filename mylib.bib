@article{Thompson1982,
  title = {A Long Term Study of Low Frequency Sounds from Several Species of Whales off Oahu Hawaii {{USA}}},
  author = {Thompson, P O and Friedl, W A},
  year = {1982},
  pages = {1--19},
  abstract = {Two bottom-mounted hydrophones north of Oahu were monitored from December, 1978, through April, 1981. Hydrophone output was tape recorded and analyzed at higher tape playback speeds. Stereotyped sounds were classified into 6 categories and identified causal whale species for 5 of the categories: humpback whale (Megaptera novaeangliae) vocalizations, fin whale (Balaenoptera physalus) short pulses, blue whale (B. musculus) long pulses, sperm whale (Physeter macrocephalus) clicks, pilot whale (Globicephala macrorhynchus) thumps and the boing sound. At least 1 kind of whale sound was recorded on 459 of 578 recording days. Sounds were received most frequently in winter and spring seasons and least frequently in July and Oct. Humpback whale vocalizations were the most common sounds recorded. Humpback whale and boing sounds were highly seasonal with regular yearly occurrences. Sperm whale sounds occured at a low level throughout the year. Fin whale, blue whale and pilot whale sounds each occurred year bimodality, which may result from the whales' seasonal migratory movement in Hawaiian waters. The whale sounds in the recordings were characterized and identified; intra-seasonal changes in humpback whale songs, sounds associated with pilot whale thumps, seasonal changes in the fin whale pulses and typical repetition intervals for boing sounds. The study provides unique biogeographic information on whale distribution and acoustic behavior.},
  journal = {Cetology},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Balaenopteridae [85810],Balaenopteridae: Cetacea,Behavioral Biology/Animal Behavior [07003],Behavioral Biology/Animal Communication (1971- ) [,Cetaceans,Ch,Chord,Chorda,Chordates,Delphinidae: Cetacea,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Mammalia,Mammals,Nervous System/Physiology and Biochemistry [20504],Nonhuman Mammals,Nonhuman Vertebrates,Physeteridae: Cetacea,Psychiatry/Psychophysiology [21003],Vertebrata,Vertebrates},
