@article{Szewczyk1998,
  title = {A Knowledge-Based Search Framework for Designing Composite Structures},
  author = {Szewczyk, Z P},
  year = {1998},
  volume = {16},
  pages = {289--299},
  abstract = {In this paper, a search framework is presented that makes a genetic algorithm (GA) a practical engineering tool for searching discrete and nonconvex design spaces. It is shown that "near optimal" designs can be relatively quickly found if three problems are addressed: (i) the dimensionality of a design space is reasonably reduced, (ii) fast function evaluations are available, and (iii) genetic operators are tailored to the application art hand. In our work, the number of active design variables is reduced by using a rule-based fuzzy logic inference engine to process knowledge about the structure's behaviour. The use of a parallel computing environment for structural analysis in conjunction with data retrieval from binary-like trees effectively reduces the time required to perform Genetic searching. Three different selection operators along with a permutation-like operator for the reduced problem are evaluated for their effectiveness in locating the global optimum. As an example, the stacking sequence for maximising a budding load for a stiffened square panel with a circular cut-out and subject to thermal and shear loading is designed.},
  isbn = {0934-4373},
  journal = {Structural Optimization},
  keywords = {DECOMPOSITION,DISTRIBUTED-MEMORY COMPUTERS,GENETIC ALGORITHMS,OPTIMIZATION},
  language = {English},
  number = {4}
}

@article{Szpak2009,
  title = {A Late Holocene Vertebrate Food Web from Southern Haida Gwaii (Queen Charlotte Island, Bristish Colombia).},
  author = {Szpak, P and Orchard, T J and Grocke, D R and Gr{\"o}cke, D R},
  year = {2009},
  volume = {36},
  pages = {2734--2741},
  doi = {10.1016/j.jas.2009.08.013},
  abstract = {This study presents isotopic data (delta C-13 and delta N-15 from bone collagen) for 104 samples representing 29 vertebrate taxa from late pre-contact through to contact era (ca. 2000 - 100 BP) Haida Gwaii (British Columbia, Canada) from a wide variety of mostly marine organisms. The results demonstrate the considerable isotopic variability that characterizes potential prey items in coastal contexts and underscores the need for baseline faunal data to interpret human subsistence practices. Based on these data, a detailed marine food web was constructed, which provides insight into local ecological conditions. We present a simple method for quantifying the trophic level of ancient fauna using delta N-15 of bone collagen. Finally, we discuss the implications of this study for the reconstruction of human diet. (C) 2009 Elsevier Ltd. All rights reserved.},
  isbn = {0305-4403},
  journal = {Journal of Archaeological Science},
  keywords = {11088,archaeology,BONE-COLLAGEN,CARBON,COAST,DELTA-N-15 ANALYSIS,diet,Ecology,FEEDING ECOLOGY,food web,Food web,FORAGING AREAS,Haida Gwaii,Marine diet,MARINE MAMMALS,NORTHERN FUR SEALS,Northwest Coast,stable isotopes,Stable isotopes,STABLE-ISOTOPE ANALYSIS,Trophic level,TROPHIC RELATIONSHIPS},
  language = {English},
