@article{Pemberton1994,
  title = {Pup Production and Distribution of the {{Australian}} Fur Seal, {{Arctocephalus}} Pusillus Doriferus, in {{Tasmania}}.},
  author = {Pemberton, D and Kirkwood, R J},
  year = {1994},
  volume = {21},
  pages = {341--352},
  abstract = {In Tasmanian waters Australian fur seals, Arctocephalus pusillus doriferus, breed on five islands in Bass Strait with non-breeding haul-out sites situated in Bass Strait and along the south-eastern and southern Tasmanian coastline. Estimates of pup production were obtained over four breeding seasons between 1989 and 1993 by aerial photography, ground counts and mark-recapture censuses. Pupping commences in late October, with 90\% of pups born between 2 and 20 December. Pup mortality is estimated at 15\% by early January, when ground censusing was conducted. Pup production of breeding colonies in Tasmanian waters was highest in 1991, with 5130 pups estimated to have been born.},
  journal = {Wildlife Research},
  keywords = {[01008] Methods - Field methods,[01012] Methods - Photography,[07518] Ecology: environmental biology - Wildlife,[16501] Reproductive system - General and methods,[25508] Development and Embryology - Morphogenesis,[86180] Otariidae,267,aerial photography,aerial survey,Apparatus,Arctocephalus pusillus,Arctocephalus pusillus doriferus [Otariidae],breeding,capture-mark-recapture,census,Chordates,count,Development,Devices and Instrumentation,Equipment,ground survey,Mammalia,Mammals,mark-recapture,Methods and Techniques,Nonhuman V,Otariidae: Animals,Pinnipedia,pup production,Reproductive System: Reproduction,Vertebrat,Wildlife Management: Conservation},
