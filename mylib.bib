@article{Libertelli2004,
  title = {Predation on Cephalopods by {{Pygoscelis}} Papua and {{Arctocephalus}} Gazella at {{South Orkney Islands}}},
  author = {Libertelli, Marcela M and Daneri, Gustavo A and Piatkowski, Uwe and Coria, Nestor R and Carlini, Alejandro R},
  year = {2004},
  volume = {25},
  pages = {267--274},
  abstract = {The cephalopod diet of the gentoo penguin, Pygoscelis papua and the Antarctic fur seal, Arctocephalus gazella was comparatively analyzed at Laurie Island, South Orkney Islands. A total of 125 stomach samples were collected by the water off-loading method from gentoo penguins during the autumns of 1993, 1995 and 1996, and 39 fur seal scats were collected from mid March to April 1988. Cephalopods preyed upon by gentoo penguins were represented by 1974 beaks (1628 lower, 346 upper) which occurred in 50.4\% of the samples. Lower beaks identified belonged exclusively to the squid Psychroteuthis glacialis. The mean lower rostral length (LRL) of these beaks was 1.1 mm (range 0.4-1.8 mm). From the Antarctic fur seal scats 103 beaks (41 lower, 62 upper) were removed from 60.6\% of scats which contained prey remains. The cephalopod species identified were Slosarczykovia circumantarctica and P. glacialis which constituted 78.8\% and 21.1\% in terms of numbers, respectively. The mean lower rostral length for S. circumantarctica was 2.7 mm (range 2.0-3.5 mm), while that of P. glacialis was 1.6 mm (range 1.0-2.5 mm). The foraging behaviour of the two top predators was analyzed and discussed according to the composition and size of their cephalopod prey.},
  journal = {Polish Polar Research},
  keywords = {[07002] Behavioral biology - General and comparati,[07003] Behavioral biology - Animal behavior,[07502] Ecology: environmental biology - General a,[07508] Ecology: environmental biology - Animal,[14004] Digestive system - Physiology and biochemi,[61100] Cephalopoda,[62800] Animal distribution,[64026] Invertebrata: comparative,[85562] Sphenisciformes,[86180] Otariidae,Anima,Antarctic fur seal,Arctocephalus gazella: species,Aves,beak,Behavior,Biogeography: Population Studies,Birds,Cephalopoda: Animals,Chordat,Chordates,common,diet,Environmental Scienc,experimental mo,foraging behavior,gentoo penguin,Invertebrata,Invertebrates,Mammalia,Mammals,Mollusca,Mollusks,Nonhum,Nonhuman V,Otariidae: Animals,Pinnipedia,prey [Ce,prey [Cephalopo,Psychroteuthis glacialis: species,Pygoscelis papua: species,Slosarczykovia circumantarctica: species,Sphenisciformes: Animals,stomach: digestive system,Terrestrial Ecology: Ecology,Vertebrat,Vertebrata},
