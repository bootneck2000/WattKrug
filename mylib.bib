  pages = {5137--5146},
  issn = {00489697},
  doi = {10.1016/j.scitotenv.2010.07.038},
  abstract = {Total mercury (Hg) concentrations were measured in teeth of ringed seals from Qeqertarsuaq, central West Greenland (1982 to 2006) and Ittoqqortoormiit, central East Greenland (1986 to 2006). Stable isotopic ratios of carbon (13C/12C) and nitrogen (15N/14N) were determined as well to provide insights into diet variations between regions or through time. Mercury concentrations decreased the first years of life of the animals suggesting that Hg had been transferred from the mother to the foetus and newborn. The Hg concentrations in teeth were significantly lesser in ringed seals from central West Greenland compared to those from central East Greenland. Carbon and nitrogen stable isotopic values measured in the animals differed also significantly between the two regions. Increasing temporal trends of dental Hg concentrations between 1994 and 2006 were observed in ringed seals from both central West Greenland and central East Greenland. These increases were attributed to global changes in environmental Hg levels since no temporal trends in ??15N values were found to support the hypothesis of a diet shift over time. Furthermore, a decreasing temporal trend in ??13C values was observed in the teeth of seals from central East Greenland, and explained by a likely change over time towards more pelagic feeding habits; alternatively, the so-known Seuss effect was thought to be responsible for this decrease. Finally, it was concluded that the tooth of ringed seal was a good monitoring tissue to assess Hg trends. ?? 2010 Elsevier B.V.},
  isbn = {0048-9697},
  journal = {Science of the total environment},
  keywords = {11451,Carbon,Mercury,Nitrogen,Phoca hispida,Ringed seal,Spatial and temporal trends,Stable isotopes,Teeth},
  mendeley-tags = {11451},
  number = {21},
  pmid = {20696465}
}

@misc{Aubail2011,
