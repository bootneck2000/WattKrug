@article{Wynen2000,
  title = {Postsealing Genetic Variation and Population Structure of Two Species of Fur Seal ({{Arctocephalus}} Gazella and {{A}}-Tropicalis)},
  author = {Wynen, Louise P and Goldsworthy, Simon D and Guinet, Christophe and Bester, Marthan N and Boyd, Ian L and Gjertz, Ian and Hofmeyr, Greg J G and White, Robert G W G and Slade, Rob},
  year = {2000},
  volume = {9},
  pages = {299--314},
  abstract = {Commercial sealing in the 18th and 19th centuries had a major impact on the Antarctic and subantarctic fur seal populations (Arctocephalus gazella and A. tropicalis) in the Southern Ocean. The intensive and unrestricted nature of the industry ensured substantial reductions in population sizes and resulted in both species becoming locally extinct at some sites. However, both species are continuing to recover, through the recolonization of islands across their former range and increasing population size. This study investigated the extent and pattern of genetic variation in each species to examine the hypothesis that higher levels of historic sealing in A. gazella have resulted in a greater loss of genetic variability and population structure compared with A. tropicalis. A 316-bp section of the mitochondrial control region was sequenced and revealed nucleotide diversities of 3.2\% and 4.8\% for A. gazella and A. tropicalis, respectively. There was no geographical distribution of lineages observed within either species, although the respective Phi(ST) values of 0.074 and 0.19 were significantly greater than zero. These data indicate low levels of population structure in A. gazella and relatively high levels in A. tropicalis. Additional samples screened with restriction endonucleases were incorporated, and the distribution of restriction fragment length polymorphism (RFLP) and sequence haplotypes were examined to identify the main source populations of newly recolonized islands. For A. tropicalis, the data suggest that Macquarie Island and Iles Crozet were probably recolonized by females from Marion Island, and to a lesser extent Ile Amsterdam. Although there was less population structure within A. gazella, there were two geographical regions identified: a western region containing the populations of South Georgia and Bouvetoya, which were the probable sources for populations at Marion, the South Shetland and Heard Islands; and an eastern region containing the panmictic populations of Iles Kerguelen and Macquarie Island. The latter region may be a result of a pronounced founder effect, or represent a remnant population that survived sealing at Iles Kerguelen. [References: 75] 75},
  isbn = {0962-1083},
  journal = {Molecular Ecology},
  keywords = {6737,Animals. Chordates. Mammals. Nonhuman Mammals. Non,Arctocephalus,Arctocephalus gazella,Arctocephalus gazella [Antarctic fur seal] (Otarii,Arctocephalus tropicalis,Atlantic Ocean).,Bouvetoya (South Atlantic Ocean,Chord,Chordata,DNA,DYNAMICS,Ecology,endonucleases. mitochondrial DNA.,Environment/Ecology in Current Contents(R)/Agricul,Environmental Biology/General,F-STATISTICS,fur seal,General and Systematic Zoology/Mammalia,genetic variability. population structure. postsea,genetics,Genetics and Cytogenetics/Animal [03506],GEORGIA,HEARD-ISLAND,Mammalia,MARION-ISLAND,Methods [07502],Molecular Genetics (Biochemistry and Molecular Bio,mtDNA,Otariidae [86180],Otariidae: Pinnipedia,population genetics,population structure,PRINCE-EDWARD-ISLANDS,Prince-edward-islands. Marion-island. Restriction,RESTRICTION DATA,SEQUENCE,SOUTHERN-OCEAN,subantarctic,VARIABILITY,Vertebrata},
  language = {English},
  mendeley-tags = {6737},
  number = {3}
}

