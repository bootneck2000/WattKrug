@article{DeHaro1997,
  title = {Ecology and Behaviour of the {{Peale}}'s Dolphin, {{Lagenorhynchus}} Australis ({{Peale}}, 1848), at {{Cabo Virgenes}} (52 Degrees 30'{{S}}, 68 Degrees 28'{{W}}), in {{Patagonia}}, {{Argentina}}},
  author = {{de Haro}, J Cristian and Iniguez, Miguel A},
  year = {1997},
  volume = {0},
  pages = {723--727},
  abstract = {Studies were carried out in January and February from 1992-1996 on the ecology and behaviour of Peale's dolphins, Lagenorhynchus australis, at Cabo Virgenes (52degree30'S, 68degree28'W). The dolphins often swam in kelp beds Macrocystis pyrifera (99.8\% of the total sighting); 66.0\% (n = 1,420) of the sightings were related to medium tide. Animals were found in small groups in herds of between 1-13 (mean = 2.114; SD = 1.156; n = 1,769). Dolphins surfaced three to four times per minute and then disappear for 1-130 seconds (mean = 3.5; SD = 23.3; n = 3,179). Interactions with Commerson's dolphins, Cephalorhynchus commersonii, southern right whales, Eubalaena australis, great grebes, Podiceps major, Magellanic penguins, Spheniscus magellanicus, kelp gulls, Larus dominicanus, South American sea lions, Otaria byronia, and Imperial shags, Phalacrocorax atriceps, were recorded. The behavioural patterns most frequently recorded were coordinated and parallel movements, surfacing quickly, headfirst re-entry leaps, humping, spinning, tailslaps and surfacing and diving slowly.},
  journal = {Report of the International Whaling Commission},
  keywords = {[00512] General biology - Conservation and resourc,[07516] Ecology: environmental biology - Wildlife,[14300] Phaeophyta,[85518] Charadriiformes,[85550] Pelecaniformes,[85554] Podicipediformes,[85562] Sphenisciformes,[85805] Balaenidae,[85815] Delphinidae,[86180] Otariidae,Algae,Aves,Balaenidae: Animals,behavior,Birds,Cephalorhynchus-commersonii: Commerson's dolphin [,Cetacea,Cetaceans,Charadriiformes: Animals,Chorda,Chordat,Chordata,Chordates,Delphinidae: Animals,ecology,Eubalaena-australis: southern right whale [Balaeni,Lagenorhynchus-australis: Peale's dolphin [Delphin,Larus-dominicanus: kelp gull [Charadriiformes],Macrocystis-pyrifera: kelp [Phaeophyta],Mammal,Mammalia,Mammals,Microorganisms,Nonhu,Nonhum,Nonhuma,Nonhuman V,Nonvascular Pla,Otaria-byronia: South American sea lion [Otariidae,Otariidae: Animals,Pelecaniformes: Animals,Phaeophyta: Algae,Phalacrocorax-atriceps: Imperial shag [Pelecanifor,Pinnipedia,Plantae,Podiceps-major: great grebe [Podicipediformes],Podicipediformes: Animals,Sphenisciformes: Animals,Spheniscus-magellanicus: Magellanic penguin [Sphen,Vertebrat,Vertebrata,Wildlife Management: Conservation},
