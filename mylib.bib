@article{Reinig1981,
  title = {Isolation and Characterization of Relaxin from the Sand Tiger Shark Odontaspis-Taurus},
  author = {Reinig, J W and Daniel, L N and Schwabe, C and Gowan, L K and Steinetz, B G and O'Byrne, E M},
  year = {1981},
  volume = {109},
  pages = {537--543},
  abstract = {A peptide with relaxin activity in guinea pigs but not in mice was extracted from the ovaries of pregnant sand tiger sharks (O. taurus). The structural similarity of this peptide to porcine relaxin includes molecular size (.apprx. 6000 daltons), number of chains, and, possibly, disulfide cross-links. The relaxin-type peptide isolated from shark ovaries contains the amino acid residues Ty, Pro, and His which are absent in the porcine hormone. The amino acid composition of shark relaxin, therefore, resembles that of porcine insulin to a greater extent than does the amino acid composition of porcine relaxin. Shark relaxin may be a primitive relaxin that has undergone fewer mutations than porcine relaxin since the putative duplication of the insulin gene. The putative duplication of the insulin gene, which might have given rise to relaxin, has occurred much earlier than the separation of sharks from the general branch of animals that eventually gave rise to mammals.},
  journal = {Endocrinology},
  number = {2}
}

