@article{Condy1977,
  title = {Results of the 4th Seal Survey in the King-Haakon-Vii Sea Antarctica},
  author = {Condy, P R},
  year = {1977},
  volume = {Research},
  pages = {10--13},
  abstract = {The 4th in the series of annual seal censuses in the King Haakon VII Sea, Antarctica, was conducted in Jan. and Feb. 1977. An area of 288 km2 of pack ice was studied. Estimates of crude density for Weddell and leopard seals were similar to values obtained in the previous censuses, but estimates for crabeater and Ross seals were lower than recorded previously. The density of these 2 spp. decreased eastwards from Trolltunga. Crabeater seals were the most abundant species, followed by Ross seals. Weddell and leopard seals were equally the least abundant species. In terms of biomass per unit area, crabeater seals were the largest contributors, followed in order of importance by Ross seals, Adelie penguins Pygoscelis adeliae leopard seals, Weddell seals and emperor penguins Aptendytes forsteri. Species group sizes, diurnal rhythm and distribution according to ice floe size and surface topography and pack ice concentration, were similar to that which occurred during the previous censuses.},
  journal = {South African Journal of Antarctic},
  keywords = {*Ecology,*Metabolism/Energy and Respiratory Metabolism [130,*Methods,8000,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Aptenodytes-Forsteri Pygoscelis-Adeliae Weddell Se,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Environmental Biology/Wildlife Management-Aquatic,General/Field M,Materials and Apparatus,Phocidae [86185],Sphenisciformes [85562]},
