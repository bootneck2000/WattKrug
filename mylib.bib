@article{Laakso2001,
  title = {How Does Environmental Variation Translate into Biological Processes?},
  author = {Laakso, J and Kaitala, V and Ranta, E},
  year = {2001},
  volume = {92},
  pages = {119--122},
  abstract = {Birth and death rates, as so many other biological processes, are usually not linearly related to environmental variation. Common examples of non-linear response forms include unimodal ``optimum-type'' responses and various saturating responses. These responses filter the signal coming from the environment to a corresponding biological process. We explored how different types of environmental signal may be trans-formed to a biological process. We were interested in the effect of the filter on modulation of (1) the variance of the signal, on (2) the variance-covariance structure between the signal and the filtered signal, and on (3) the match between the power spectra of the signal and the filtered signal. We found that the filters will change the frequency distribution (mean, variance, modality) of the signal. Especially symmetric filters that have a single peak of optimum will change signal structure so that there either exists or does not exist a correlation between the signal and the filtered signal. When the correlation exists it may be either positive or negative depending on the signal's mode relative to the filter structure. Also, the power spectrum properties of the signal may be dramatically transformed after passing the filter, e.g., blue noise can turn into red noise. Our results strongly suggest that studies on the influence of external signals on biological processes, such as population dynamics, should explic-itly consider how the signal is transferred to biological processes.},
  journal = {Oikos}
}

@misc{Labansen2007,
  title = {Spring Diet of Ringed Seals ({{Phoca}} Hispida) from Northwestern {{Spitsbergen}}, {{Norway}}},
  author = {Labansen, Aili L and Lydersen, C and Haug, T and Kovacs, K M},
  year = {2007},
  volume = {64},
  pages = {1246--1256},
  doi = {10.1093/icesjms/fsm090},
  abstract = {Complete gastro-intestinal tracts (GITs) from 267 ringed seals from five different locations in Spitsbergen were collected during spring of the years 2002\textendash 2004. Diet was assessed based on hard part remains from prey. Invertebrates constituted ,2\% of all prey (relative frequency, Ni). Fish otoliths were found in all seals; 1.7, 34.3, and 64.0\% of the recovered otoliths were found in the stomach, small and large intestines, respectively, emphasizing the importance of analysing the whole GIT, not only the stomach. Otoliths from stomachs and small intestines with minimal signs of erosion were measured to back-calculate pre-ingested prey size and biomass. Based on measured polar cod (Boreogadus saida) otoliths (n {$\frac{1}{4}$} 7007), the ringed seals fed on fish in the length range 44.4\textendash 229.2 mm, primarily consuming the youngest year classes. Adult females ate smaller polar cod more often than adult males or juveniles. Polar cod domi- nated the diet, with a frequency of occurrence (FO) of 100\%, Ni of 71.9\%, and a biomass contribution of 77.2\%. The taxon Stichaeidae was the second most frequent prey type (FO {$\frac{1}{4}$} 55.6\%) followed by Cottidae (FO {$\frac{1}{4}$} 35.6\%). The diet of ringed seals from one locality markedly differed from the others, with a greater species diversity, low Ni of polar cod (15\%), and a dominance of Stichaeidae (Ni {$\frac{1}{4}$} 67\%). Location of sampling, as well as sex and age of the seals, had significant influences on ringed seal diet in spring.},
  journal = {ICES journal of marine science},
  keywords = {10002,3900 nuuk,9294,9296 tromsø,a,accepted 6 may 2007,advance access publication 6,and k,arctic,boreogadus saida,c,diet,foraging,greenland,greenland institute of natural,haug,institute of marine research,july 2007,kovacs,l,labansen,lydersen,m,marine ecosystem,MD,norway,norwegian polar institute,pbag 570,present address of a,pusa,received 2 may 2006,resources,spitsbergen,t,tromsø},
  mendeley-tags = {10002},
