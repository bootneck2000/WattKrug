@article{Brandt1992,
  title = {{{COMPARATIVE}}-{{STUDIES ON ADRENOCORTICOLYTIC DDT}}-{{METABOLITES}}},
  author = {Brandt, I and Jonsson, C J and Lund, B O},
  year = {1992},
  volume = {21},
  pages = {602--605},
  abstract = {The persistent DDT metabolite 3-methylsulfonyl-DDE (MeSO2-DDE) was originally identified in Baltic grey seals, a population with a high frequency of adrenocortical hyperplasia. We have found that MeSO2-DDE is metabolized to a reactive and cytotoxic intermediate that binds covalently to the adrenal zona fasciculata in mice. The formation of reactive metabolite seems to be catalyzed by cytochrome P-450-11beta, a mitochondrial P-450 form that is expressed specifically in the adrenal cortex. The subsequent lesion, originating in the mitochondria, results in necrosis of the zona fasciculata and decreased plasma corticosterone levels. The persistent DDT metabolites o,p'-DDD and p,p'-DDD are metabolically activated and bound by mink and otter adrenal P-450 in vitro, and both isomers induce necrosis and focal bleedings in the zona fasciculata/reticularis in vivo in mink. In chickens, MeSO 2-DDE and o,p'-DDD are activated and covalently bound by adrenal P-450 in vitro and both compounds are toxic to the adrenal interrenal cells in vivo. In conclusion, our results show that MeSO2- DDE, o,p'-DDD and p,p'-DDD are metabolized to cytotoxic intermediates in the adrenal cortex of mammals and birds, albeit with major species differences.},
  isbn = {0044-7447},
  journal = {Ambio},
  keywords = {ACTIVATION,ADRENAL-CORTEX,BINDING,LUNG,MICE,MOUSE,RAT,TISSUES,TOXICITY},
  language = {English},
  number = {8}
}

@article{Brandt2007,
  title = {Introduction to {{ANDEEP}}, Summary and Outlook},
  author = {Brandt, Angelika and Ebbe, Brigitte and Gooday, Andrew J.},
  year = {2007},
  volume = {54},
  pages = {1645--1651},
  issn = {09670645},
  doi = {10.1016/j.dsr2.2007.07.001},
  abstract = {The multidisciplinary international project ANDEEP (Antarctic deep-sea benthic biodiversity: colonisation history and recent community patterns) involved a two-leg expedition to the Weddelland Scotia seas in 2002 and a third expedition in 2005 to the Cape and Agulhas basins, Weddell Sea, Bellingshausen Sea and Drake Passage (Fig. 1). In 2004, we published the first results, based on the material collected during ANDEEP I/II (Brandt and Hilbig, 2004). This second volume concerns work done since 2004, including results based on material obtained during ANDEEP III. These three expeditions yielded a very rich and unique collection of material and data. Much work remains to be done and publications will continue to appear in the literature for many years to come. However, the end of the directly funded phase of the project provides a good opportunity to revisit the original questions that we had hoped to answer, to determine our success in doing so, and to define remaining gaps in our knowledge of the deep Southern Ocean faunas. Generally, the goals that were set for ANDEEP have been reached. In particular, there has been an increase in our knowledge of the scale and patterns of species diversity in the deep ocean and an improved understanding of the origins of the abyssal fauna of the Southern Ocean. Many of the remaining gaps have emerged from the knowledge we gained and thus are part of the success of the project rather than an indication of failure. \textcopyright{} 2007 Elsevier Ltd. All rights reserved.},
  journal = {Deep-Sea Research Part II: Topical Studies in Oceanography},
  keywords = {Biodiversity,Deep sea,Makrofauna,Megafauna,Meiofauna,Southern Ocean},
  number = {16-17}
}

