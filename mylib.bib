@article{Trusel2013,
  title = {Satellite-Based Estimates of {{Antarctic}} Surface Meltwater Fluxes},
  author = {Trusel, Luke D. and Frey, Karen E. and Das, Sarah B. and Munneke, Peter Kuipers and Van Den Broeke, Michiel R.},
  year = {2013},
  volume = {40},
  pages = {6148--6153},
  publisher = {{John Wiley \& Sons, Ltd}},
  issn = {00948276},
  doi = {10.1002/2013GL058138},
  abstract = {This study generates novel satellite-derived estimates of Antarctic-wide annual (1999-2009) surface meltwater production using an empirical relationship between radar backscatter from the QuikSCAT (QSCAT) satellite and melt calculated from in situ energy balance observations. The resulting QSCAT-derived melt fluxes significantly agree with output from the regional climate model RACMO2.1 and with independent ground-based observations. The high-resolution (4.45 km) QSCAT-based melt fluxes uniquely detect interannually persistent and intense melt (\textquestiondown 400 mm water equivalent (w.e.) year-1) on interior Larsen C Ice Shelf that is not simulated by RACMO2.1. This supports a growing understanding of the importance of a f\"ohn effect in this region and quantifies the resulting locally enhanced melting that is spatially consistent with recently observed Larsen C thinning. These new results highlight important cryosphere-climate interactions and processes that are presently not fully captured by the coarser-resolution (27 km) regional climate model. Key Points Novel satellite-based estimates of Antarctic surface meltwater production Broad agreement among satellite, ground, and climate model melt results High melt on inner Larsen C Ice Shelf likely results from a f\"ohn effect \textcopyright 2013. American Geophysical Union. All Rights Reserved.},
  isbn = {0094-8276},
  journal = {Geophysical Research Letters},
  keywords = {Antarctica,ice shelves,remote sensing,surface melt},
  number = {23}
}

