@article{Jeffreys1992,
  title = {Identification of the Skeletal Remains of {{Mengele}},{{Josef}} by {{DNA}} Analysis},
  author = {Jeffreys, A J and Allen, M J and Hagelberg, E and Sonnberg, A},
  year = {1992},
  volume = {56},
  pages = {65--76},
  abstract = {There has been considerable controversy over the identity of the skeletal remains exhumed in Brazil in 1986 and believed to be those of Dr Josef Mengele, the Auschwitz 'Angel of Death'. Bone DNA analysis was therefore conducted in an attempt to provide independent evidence of identity. Trace amounts of highly degraded human DNA were successfully extracted from the shaft of the femur. Despite the presence of a potent inhibitor of DNA amplification, microsatellite alleles could be reproducibly amplified from the femur DNA. Comparison of the femur DNA with DNA from Josef Mengele's son and wife revealed a bone genotype across 10 different loci fully compatible with paternity of Mengele's son. Less than 1 in 1800 Caucasian individuals unrelated to Mengele's son would by chance show full paternal inclusion. DNA analysis therefore provides very strong independent evidence that the remains exhumed from Brazil are indeed those of Josef Mengele.},
  isbn = {0379-0738},
  journal = {Forensic Science International},
  keywords = {AMPLIFICATION,ANCIENT BONE DNA,BONE,DINUCLEOTIDE REPEAT POLYMORPHISMS,DNA TYPING,GENE,LOCI,MENGELE,MICROSATELLITE,MINISATELLITES,MITOCHONDRIAL-DNA,PATERNITY,SEQUENCE},
  language = {English},
  number = {1}
}

