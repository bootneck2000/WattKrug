  volume = {76},
  pages = {1249--1255},
  abstract = {We describe patterns of age-specific growth and reproductive rates for female South American fur seals, Arctocephalus australis, in Uruguay. Females achieve body weight of 41.7 kg at 10 years of age and adult length of 128.9 cm at 10 years of age. Pregnancy rates showed significant interannual differences, suggesting effects from environmental factors and demographic variability. Fetuses from lactating females were smaller than fetuses from nonlactating females. We suggest that simultaneous lactation and pregnancy affect the amount of energy devoted to embryonic growth.},
