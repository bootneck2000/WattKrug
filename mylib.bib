@article{Kakuda2003,
  title = {Genetic Variability of {{Stejneger}}'s Beaked Whale ({{Mesoplodon}} Stejnegeri) Stranded on the Shore of {{Sea}} of {{Japan}} Based on Mitochondrial {{DNA}} Sequences},
  author = {Kakuda, Tsuneo and Yamada, Tadasu K},
  year = {2003},
  volume = {3},
  pages = {93--96},
  abstract = {Stejneger's beaked whale (Mesoplodon stejnegeri) is a species of the family Ziphiidae, which distributes in northern part of the North Pacific ream including the Japanese waters. Since species-level distinction of the genus Mesoplodon is difficult by field, our knowledge of its geographic distribution depends mainly on the records of their stranding. The ecology, life history, and population structure of this species have not been studied sufficiently. This species had been regarded as extremely rare, but according to our data collection since late 1980's, 5 to 20 cases of stranding of the species have been recognized every year. The material of this study consists of skin samples from 25 individuals of Stejneger's beaked whale which stranded on the coast of the Sea of Japan during the period from 1994 to 2001. Full sequences of mitochondrial DNA D-loop region of all individuals and two alleles of microsatellite were determined and compared. As a result, it became clear that there are two genetically different maternal population/s of Stejneger's beaked whale in this area. Further more, result of microsatellite analysis suggests that the males of this species take different act from the maternal population. Although the relation between this dimorphism and geographic distribution is not yet clear, our result suggests the existence of two or more genetically distinct populations in one population.},
  journal = {Honyurui Kagaku},
  number = {Supplement}
}

