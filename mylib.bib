@article{Gales1994,
  title = {Use of Bioelectrical Impedance Analysis to Assess Body Composition of Seals.},
  author = {Gales, Rosemary and Renouf, Deane and Worthy, Graham A J and Gale, Rosemary and Renouf, Deane and Worthy, Graham A J and Gales, Rosemary and Renouf, Deane and Worthy, Graham A J},
  year = {1994},
  volume = {10},
  pages = {1--12},
  abstract = {Bioelectrical impedance analysis (BIA) measures resistance and reactance of a current as it passes through an organism. The validity of using BIA as a tool to measure body water content, and hence body composition and condition, was tested on harp and ringed seals. The resistance and reactance readings from BIA were compared to estimates of total body water (TBW) determined via tritiated water dilution. The relationship between resistance and TBW (\% of body mass) was linear after logarithmic transformation and the two variables were highly correlated. We describe the electrode configuration and placements which provide reliable results in these seals. Our findings indicate that BIA has considerable potential as an inexpensive, rapid, and reliable technique for estimating body composition of phocid seals.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science.},
  keywords = {1032,bioelectrical impedance,bioelectrical impedance/body composition/condition,biolelectrical impedance body composition conditio,body composition,PBS Record: 561,Phoca groenlandica,Phoca hispida},
  mendeley-tags = {1032,PBS Record: 561},
  number = {1}
}

@article{Gales1994b,
  title = {Diet of the {{Australian}} Fur Seal in {{Tasmania}}.},
  author = {Gales, Rosemary and Pemberton, David},
  year = {1994},
  volume = {45},
  pages = {653--664},
  abstract = {In Tasmanian waters, fish were the most prevalent prey taxa in the diet of Arctocephalus pusillus doriferus, with cephalopods occurring less frequently. Occurrence of crustaceans and birds was negligible. Most prey remains of cephalopods were obtained from regurgitates, whereas faeces provided most fish remains. Twenty-five species of fish were identified from faecal and regurgitate samples, with redbait (Emmelichthys nitidus), jack mackerel (Trachurus declivis) and leatherjackets (Monacanthidae) constituting the main prey species. There was an inverse relationship between the occurrence of fish and that of cephalopods in the samples from Bass Strait, with fish predominating in winter and cephalopods in summer. Size estimates of prey indicated that mainly adult fish and squid were eaten. Most samples contained remains of a single species, suggesting the use of monospecific aggregations of prey items.},
  journal = {Australian Journal of Marine \& Freshwater Research},
  keywords = {[07508] Ecology: environmental biology - Animal,[13202] Nutrition - General studies,[14001] Digestive system - General and methods,[25508] Development and Embryology - Morphogenesis,[61100] Cephalopoda,[75100] Crustacea,[85200] Pisces,[85206] Osteichthyes,[85500] Aves,[86180] Otariidae,76,adult,Anima,Animalia,Arctocephalus pusillus,Arctocephalus pusillus doriferus [Otariidae],Arthropoda,Arthropods,Aves [Aves],Aves: Animals,bird [Aves],Birds,cephalopod [Cephalopoda],Cephalopoda: Animals,Chordata,Chordates,Crustacea [Crustacea],Crustacea: Animals,crustacean [Crustacea],Crustaceans,Development,diet,Digestive System: Ingestion and Assimilation,Ecology: Environmental Sciences,Emmelichthys nitidus [Osteichthyes],fecal matter,feces analyses,Fish,fish [Pisces],Inver,Invertebrata,Invertebrates,Mammalia,Mammals,Mollusca,Mollusks,Nonhuman V,Nonhuman Vertebr,Nonhuman Vertebra,Nutrition,nutritional s,Osteichthyes: Animals,Otariidae: Animals,Pinnipedia,Pisces,Pisces: Animals,prey size,puke,regurgitate,Trachurus declivis [Osteichthyes],Vertebrat,Vertebrata},
