@article{Murphy1982a,
  title = {Free Amino-Acids in the Blood of Fetal and Maternal Weddell Seals Leptonychotes-Weddelli},
  author = {Murphy, B J and Hochachka, P W and Zapol, W M and Liggins, G C},
  year = {1982},
  volume = {242},
  pages = {R85--R88},
  abstract = {The content of free amino acids in whole blood was measured in near-term gravid female Weddell seals (L. weddelli) and compared with fetal amino acid profiles during rest and during experimental diving. With the exception of taurine and glutathione, ninhydrin-reactive components of acid extracts of blood occurred in higher concentrations on the fetal side of the placenta than on the maternal side. Compared with humans the Weddell seal displayed higher ratios of fetal arterial to maternal arterial levels for aspartate, glycine, alanine, valine, tyrosine, phenylalanine and total branched-chain amino acids. In the resting state the total free amino acid concentration in maternal blood was only .apprx. 70\% as large as the total amino acid concentration in fetal blood, compared with a value of \textquestiondown{} 80\% for humans. Only modest changes in the concentrations of specific amino acids occurred during simulated awake diving, but the overall maternal pools of glycine, glutamate and glutamine were augmented, creating favorable conditions for uptake by the fetus.},
  journal = {American Journal of Physiology},
  keywords = {*Aerospace and Underwater Biological Effects/Physi,*Blood,*Comparative Biochemistry,*Developmental Biology/Embryology-Experimental [25,*Metabolism/Proteins,*Physiology,*Reproductive System/Physiology and Biochemistry [,8200,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Biochemical Methods/Proteins,Biochemical Studies/Proteins,Blood-Forming Organs and Body Fluids/Blood,General [10010],General and Miscellaneous/Comparative,Hominidae [86215],Human Placenta Metabolic Comparison Diving,Peptides and Amino A,Peptides and Amino Acids [13,Phocidae [86185]},
