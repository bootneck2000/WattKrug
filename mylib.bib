@article{Berube2002,
  title = {Genetic Identification of a Small and Highly Isolated Population of Fin Whales ({{Balaenoptera}} Physalus) in the {{Sea}} of {{Cortez}}, {{Mexico}}},
  author = {Berube, Martine and Jorge, Urban R and Dizon, Andrew E and Brownell, Robert L and Palsboll, Per J},
  year = {2002},
  volume = {3},
  pages = {183--190},
  abstract = {For many years, researchers have speculated that fin whales are year-round residents in the Sea of Cortez (=Gulf of California). Previous work by Berube and co-workers has shown that the degree of genetic diversity among fin whales in the Sea of Cortez at nuclear and mitochondrial loci is highly reduced. However, the relatively unobstructed connection with the North Pacific Ocean argues that Sea of Cortez fin whales are part of a much larger eastern North Pacific population given the extensive migratory ranges observed in fin whales and baleen whales in general. The low degree of genetic variation might thus simply be due to historic fluctuations in the effective population size of an eastern North Pacific population. In order to test if the reduced genetic variation detected among fin whales in the Sea of Cortez is due to small population size or a past bottleneck in an otherwise large eastern North Pacific population, we analyzed the geographic distribution of genetic variation at a single mitochondrial (control region) and 16 nuclear loci in samples collected from fin whales in the eastern North Pacific (n=12) as well as the Sea of Cortez (n=77). Our results showed that fin whales observed in the Sea of Cortez constitute a highly isolated and thus evolutionary unique population, which warrants special conservation measures given the current low estimate of abundance of approximately 400 individuals.},
  journal = {Conservation Genetics},
  keywords = {[00512] General biology - Conservation and resourc,[03502] Genetics - General,[03506] Genetics - Animal,[03509] Genetics - Population genetics,[07502] Ecology: environmental biology - General a,[07516] Ecology: environmental biology - Wildlife,[10062] Biochemistry studies - Nucleic acids,[10064] Biochemistry studies - Proteins,[62800] Animal distribution,[85810] Balaenopteridae,Balaenoptera physalus: species,Balaenopteridae: Animals,Cetacea,Cetaceans,Chordates,common,DNA loci: mitochondrial,effective population size,fin whale,genetic diversity,genetic variation [geographic distribution],Ma,Mammalia,migratory ranges,Molecular Genetics: Biochemistry and Molecular Bio,nuclear,peptides,population bottleneck,Population Genetics: Population Studies,puri,Verteb,Wildlife Management: Conservation},
  number = {2}
}

