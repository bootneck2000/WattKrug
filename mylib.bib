@article{Pastene1997,
  title = {Intra- and Inter-Oceanic Patterns of Mitochondrial {{DNA}} Variation in the {{Bryde}}'s Whale, {{Balaenoptera}} Edeni},
  author = {Pastene, Luis A and Goto, Mutsuo and Itoh, Shunsuke and Wada, Shiro and Kato, Hidehiro},
  year = {1997},
  volume = {0},
  pages = {569--574},
  abstract = {Restriction fragment length polymorphisms (RFLPs) of the mitochondrial DNA (mtDNA) control region were identified and used to examine patterns of mtDNA variation within and between ocean basins in the typical form Bryde's whale. Samples from four oceanic regions were examined: western North Pacific (including three sampling localities between longitude 169degreeE and the outer edge of the Kuroshio Current); eastern South Pacific (Peruvian); western South Pacific (south Fijian); and eastern Indian Ocean (south Javan). The PCR-amplified control region was digested with four polymorphic restriction enzymes that recognised five unique restriction sites in a total of 370 whales. Genetic distances among nine unique haplotypes ranged from 0.0073 to 0.0336. Intra-oceanic region nucleotide diversity values ranged from 0.0035 to 0.0073 with the highest value found in the western North Pacific region. The geographic differentiation of mtDNA variation was tested using the analysis of molecular variance (AMOVA) and the randomised chi-square test of independence. No significant differences were observed in the three localities examined in the western North Pacific. Our analyses further revealed that: (1) Bryde's whales from the four oceanic regions are genetically different; and (2) the interoceanic (Indian Ocean-Pacific Ocean) genetic differences are more pronounced than those found within the Pacific Ocean. Since a RFLP analysis captures only a small portion of the genetic variability, sequencing of the mtDNA control region is suggested to further examine the genetic diversity within oceanic regions, particularly within the western North Pacific.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals. Cetaceans. Chordates. Mammals. Nonhuman M,Balaenoptera-edeni [Bryde's whale] (Balaenopterida,Balaenopteridae [85810],Balaenopteridae: Cetacea,Ch,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Genetics and Cytogenetics/Animal [03506],Mammalia,mitochondrial DNA.,Pacific Ocean (Pacific Ocean).,Population Genetics (Population Studies). Wildlife,Resource Management,restriction fragment length polymorphism.,Vertebrata},
  number = {47}
}

