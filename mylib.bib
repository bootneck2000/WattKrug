  author = {{Angell-James}, J E and {de Burgh Daly}, M and Elsner, R},
  year = {1978},
  volume = {234},
  pages = {H730--H739},
  issn = {03636135},
  abstract = {With use of single- and few-fiber preparations of the carotid sinus nerve of the anesthetized seal Phoca vitulina, the relationships between impulse frequency in baroreceptor fibers and the static and dynamic pressures in the carotid sinus were established and found to be similar to those in terrestrial mammals. In isolated perfused carotid sinus preparations, there was an inverse relationship between mean sinus pressure on the one hand and heart rate and arterial blood pressure on the other. The 'baroreflex' control of heart rate as a closed-loop system was studied by relating the pulse interval to the systolic and mean arterial blood pressures during pressor tests produced by intravenous phenylephrine before, during, and after an experimental dive. During a dive, resetting of the baroreflex toward bradycardia occurred together with an increase in the gain of the reflex control of pulse interval ( DELTA pulse interval/ DELTA blood pressure) at a given reference systolic pressure. Evidence is presented that the increased gain may be solely the result of a shift in the whole curve, so that the same arterial pressure now corresponds to a steeper portion of the curve. During an experimental dive, the gain of the carotid sinus baroreceptor reflex control of heart rate ( DELTA heart rate/ DELTA carotid sinus pressure) was also increased.},
  journal = {The American journal of physiology},
  keywords = {745,arterial baroreceptors,circulation,diving,heart rate,Phoca vitulina},
