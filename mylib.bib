@article{PageGoldsworthyS.D.andHindellM.A.2001,
  title = {Vocal Traits of Hybrid Fur Seals: {{Intermediate}} to Their Parental Species},
  author = {{Page Goldsworthy, S.D. {and} Hindell, M.A.}, B and Page, Brad and Goldsworthy, Simon D and Hindell, Mark A},
  year = {2001},
  volume = {61},
  pages = {959--967},
  abstract = {Vocal communication is important for species recognition in colonial breeding species such as fur seals, especially where closely related species that can hybridize breed sympatrically. This is the first study to describe the calls of hybrid fur seals. We investigated whether these vocalizations are intermediate to those of their parental species (Antarctic, Arctocephalus gazella, subantarctic, A. tropicalis, and New Zealand, A. forsteri) and discuss the evolutionary implications of hybrids having intermediate vocal traits. Hybrid males' bark calls were intermediate between two distinct groups formed by A. tropicalis and A. gazella/A. forsteri. Patterns of intermediate call characteristics were also discernible for pup attraction calls (given by females) but not for full threat calls (given by males), nor female attraction calls (given by pups); however, for all call types hybrid calls were distinct from those of their parental species. The pattern of hybrid calls being intermediate is consistent with the expectation that call traits are genetically inherited.},
  journal = {Animal Behaviour},
  keywords = {7148,Animals. Chordates. Mammals. Nonhuman Mammals. Non,Antarctic (Antarctic Region). New Zealand (Austral,Arctocephalus forsteri (Otariidae): female,Arctocephalus gazella,Arctocephalus tropicalis,Behavior. Communication. Genetics.,Behavioral Biology/Animal Behavior [07003],Behavioral Biology/Animal Communication (1971- ) [,Behavioral Biology/General and Comparative Behavio,Chord,Evolution [01500],evolution. species recognition. vocal communicatio,fur se,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/General [03502],hybrids,Mammalia,Otariidae [86180],Otariidae: Pinnipedia,Vertebrata,vocalization},
  mendeley-tags = {7148},
  number = {5}
}

