@article{Hindell1994a,
  title = {Body Mass Loss of Moulting Female Southern Elephant Seals, {{Mirounga}} Leonina, at {{Macquarie Island}}},
  author = {Hindell, M A and Slip, D J and Burton, H R and Hindell Mark, A and Slip David, J and Burton Harry, R and Hindell, M A and Slip, D J and Burton, H R},
  year = {1994},
  volume = {14},
  pages = {275--278},
  abstract = {Thirteen female southern elephant seals moulting at Macquarie Island lost an average of 4.46 +- 0.80 kg/day (10.01 +- 1.20 g/kg/day). There was no significant difference between this rate of body mass loss and that reported for moulting female southern elephant seals from South Georgia. Moulting female southern elephant seals however exhibited larger mass specific mass loss than either female northern elephant seals or male southern elephant seals, indicating a higher metabolic cost of moult in these animals.},
  journal = {Polar Biology},
  keywords = {1041,Biology.,drugging,energetics,HOBART.,mass loss,Mirounga leonina,molting,Reprint available from: Hindell MA. UNIV TASMANIA},
