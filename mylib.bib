@article{Mowat2006,
  title = {Major Components of Grizzly Bear Diet across {{North America}}},
  author = {Mowat, G and Heard, D C},
  year = {2006},
  volume = {84},
  pages = {473--489},
  abstract = {We measured stable carbon and nitrogen isotope ratios in guard hair of 81 populations of grizzly bears (Ursus arctos L., 1758) across North America and used mixing models to assign diet fractions of salmon, meat derived from terrestrial sources, kokanee (Oncorhynchus nerka (Walbaum in Artedi, 1792)), and plants. In addition, we examined the relationship between skull size and diet of bears killed by people in British Columbia. The majority of carbon and nitrogen assimilated by most coastal grizzly bear populations was derived from salmon, while interior populations usually derived a much smaller fraction of their nutrients from salmon, even in areas with relatively large salmon runs. Terrestrial prey was a large part of the diet where ungulates were abundant, with the highest fractions observed in the central Arctic, where caribou (Rangifer tarandus (L., 1758)) were very abundant. Bears in some boreal areas, where moose (Alces alces (L., 1758)) were abundant, also ate a lot of meat. Bears in dryer areas with low snowfall tended to have relatively high meat diet fractions, presumably because Ungulates are more abundant in Such environments. Kokanee were an important food in central British Columbia. In areas where meat was more than about a third of the diet, males and females had similar meat diet fractions, but where meat was a smaller portion of the diet, males usually had higher meat diet fractions than females. Females reached 95\% of their average adult skull length by 5 years of age, while males took 8 years. Skull width of male grizzly bears increased throughout life, while this trend was slight in females. Skull size increased with the amount of salmon in the diet, but the influence of terrestrial meat on size was inconclusive. We suggest that the amount of salmon in the diet is functionally related to fitness in grizzly bears.},
  isbn = {0008-4301},
  journal = {Canadian Journal of Zoology-Revue Canadienne De Zoologie},
  keywords = {BRITISH-COLUMBIA,BROWN BEARS,CALLORHINUS-URSINUS,CARBON,FORAGING ECOLOGY,INCORPORATING CONCENTRATION-DEPENDENCE,MIXING MODELS,PACIFIC SALMON,SEALS,STABLE-ISOTOPE ANALYSIS,URSUS-ARCTOS},
  language = {English},
  number = {3}
}

@article{Moyes1984,
  title = {Composition of the Mineral Phase of Dentine in Southern Elephant Seals and {{Antarctic}} Fur Seal Teeth},
  author = {Moyes, A B and Doige, D W},
  year = {1984},
  volume = {64},
