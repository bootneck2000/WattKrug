@article{McFarlane1996,
  title = {Gross Pathology of the Weddell Seal (Leptonychotes Weddelli) in the Vestfold Hills, East Antarctica.},
  author = {McFarlane, R A},
  year = {1996},
  volume = {22},
  pages = {27--33},
  abstract = {A long term monitored population of Weddell seal (Leptonychotes weddelli) that hauls out on the fjord and coastal sea ice of the Vestfold Hills, near Davis (68 degree 31'S, 78 degree 12'E) Antarctica was monitored throughout the Antarctic summer of 1990-1991 for examples of morbidity and mortality concurrent to primary research projects of the Australian Antarctic Division. Ocular, skin and respiratory disease and postpartum discharges and diarrhoea were observed and pup mortality was investigated by post mortem investigation. Other literature describing pathology in the Weddel seal is reviewed.},
