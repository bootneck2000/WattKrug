@article{Georgenascimento1995,
  title = {Micro-Evolutionary Implications of Allozymic and Morphometric Variations in Sealworms Pseudoterranova Sp (Ascaridoidea, Anisakidae) among Sympatric Hosts from the Southeastern Pacific-Ocean},
  author = {Georgenascimento, M and Llanos, A and {George-Nascimento}, M and Llanos, A},
  year = {1995},
  volume = {25},
  pages = {1163--1171},
  abstract = {We found significant morphometric and electrophoretic differences between sealworm larvae collected from four sympatric fish host species off the central coast of Chile. The South American sea lion, Otaria byronia, is a suitable host and most likely the only definitive host species in the study area. Morphological patterns of caudal papillae in adult males collected from sea lions and electrophoretic evidence from larvae and adults substantiate our conclusion that they belong to just one, new species yet to be described. The genetic and morphometric differences found between sealworm larvae from sympatric fish hosts may be due to selective pressures arising from the internal environment of the intermediate hosts, although they may serve only for passing sequential filters along the life cycle. The discussion deals with the roles that definitive and intermediate hosts may play in the micro-evolutionary processes of sealworms.},
  isbn = {0020-7519},
  journal = {International Journal for Parasitology},
  keywords = {2682,ASCARIDIDA,ATLANTIC,CARNIVORA,CONTRACAECUM-OSCULATUM NEMATODA,DIFFERENTIATION,ECOLOGY,genetic variation,GENETIC VARIATION,GENETIC-VARIABILITY,MICRO-EVOLUTION,morphology,MORPHOLOGY,Otaria byronia,OTARIA-BYRONIA,OTARIID SEALS,parasites,POPULATIONS,SOUTHEASTERN PACIFIC OCEAN},
  language = {English},
