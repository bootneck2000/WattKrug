@inproceedings{PageWellingA.ChambellantM.andGoldsworthyS.D.2001,
  title = {The Population Status of Fur Seals at {{Heard Island}}},
  booktitle = {Southern Hemisphere Marine Mammal Conference, Phillip Island, Australia, May 2001},
  author = {{Page Welling, A., Chambellant, M., {and} Goldsworthy, S.D.}, B},
  year = {2001},
  volume = {http://cs-},
  abstract = {Fur seals were eliminated at Heard Island by sealers soon after its discovery and first landing in the 1850s. The original population is thought to have been small, with records suggesting only 500 skins were taken from the island. The first recorded breeding of Antarctic fur seals (Arctocephalus gazella) since sealing was reported in early 1963 (2 pups). The most recent survey of the Heard Island fur seal population was undertaken between December 2000 and March 2001, when 1,012 pup births (mean pupping date 11 December) were reported. This represents 3-fold increase since the last complete census in 1987/88 (13 years), when 284 births were recorded. Pups counts available for eight breeding seasons since 1962/63, indicate that the population is increasing at 20.2\% per annum. Based on pup births, the breeding population is estimated to be between 3,542-4,554 seals. The numbers of seals counted ashore increased from November and peaked in late February/early March at 28,436 seals, and indicates that in addition to the breeding population, a significant number of seals born at other locations also use the island. Most of these comprised of moulting sub-adult and adult males. One subantarctic fur seal pup was born, the same number recorded in 1987/88, suggesting that this species may not be colonizing the island as has been speculated.}
}

