@misc{Addison1974,
  title = {Organochlorine Residue Levels in {{Arctic}} Ringed Seals: Variation with Age and Sex},
  author = {Addison, R F and Smith, T G},
  year = {1974},
  volume = {25},
  pages = {335--337},
  issn = {0030-1299},
  abstract = {Residues of p,p,\"A{$\leq$}-DDT, p,p,\"A{$\leq$}-DDE and PCBs were found in blubber samples of Canadian Arctic ringed seals Pusa hispida (Schreb.), at concentrations in the low ppm range. In males, residue concentrations increased with age: slopes of the curves relating p,p,\"A{$\leq$}-DDE and p,p,\"A{$\leq$}-DDT to age differed significantly (P \textexclamdown{} 0.01) from zero, but the relationship between PCB and age was weaker (P \textexclamdown{} 0.05). In females, these relationships were absent: slopes relating residue concentraion to age did not differ significantly from zero. /// \textendash\^u\textemdash\AA\textemdash\c{C}\textendash{$\infty$}\textemdash\c{C}\textendash{$\int$}\textendash{$\prod$} p,p'-DDT, p.p'-DDE \textendash{$\prod$} PCB \textendash{$\pm$}\textemdash\~a\textendash\textordfeminine\textendash{$\prod$} \textendash\ae\textendash{$\pm$}\textendash{$\Omega$}\textendash{$\infty$}\textemdash\"A\textemdash\'E\textendash{$\partial$}\textendash\textmu\textendash{$\Omega$}\textemdash\~a \textendash{$\leq$} \textendash\o\textemdash\"A\textendash\ae\textendash{$\pm$}\textendash{$\infty$}\textemdash\"O \textendash{$\partial$}\textendash{$\prod$}\textemdash\"A\textendash\ae\textendash{$\leq$}\textendash\ae\textendash{$\pi$} \textemdash\c{C}\textendash{$\int$}\textendash{$\infty$}\textendash{$\Omega$}\textendash{$\prod$} \textendash{$\int$}\textendash{$\infty$}\textendash{$\Omega$}\textendash{$\infty$}\textendash\textyen\textemdash\AA\textendash{$\int$}\textendash{$\prod$}\textemdash\"O \textendash{$\infty$}\textemdash\"A\textendash{$\int$}\textemdash\c{C}\textendash{$\prod$}\textemdash\'a\textendash\textmu\textemdash\AA\textendash{$\int$}\textendash{$\prod$}\textemdash\"O \textemdash\c{C}\textemdash\'e\textendash\textordfeminine\textendash\textmu\textendash{$\Omega$}\textendash\textmu\textendash{$\pi$} \textendash{$\leq$} \textendash{$\Omega$}\textendash{$\prod$}\textendash{$\sum$}\textendash{$\int$}\textendash{$\prod$}\textemdash\"O \tex