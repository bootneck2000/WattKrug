@article{Dawbin1992,
  title = {Sounds of a Pygmy Right Whale ({{Caperea}} Marginata)},
  author = {Dawbin, William H and Cato, Douglas H},
  year = {1992},
  volume = {8},
  pages = {213--219},
  abstract = {This is the first report of recordings of sounds from the pygmy right whale, Caperea marginata. The recordings were obtained in the presence of a juvenile in the harbor at Portland, on the southeastern corner of the Australian continent. Only one type of sound was heard\textendash a short thump-like pulse or tone burst with a downsweep in frequency and decaying amplitude, with most energy between 60 and 120 Hz. The pulses occurred predominantly in pairs and once in a trio. The sounds are simpler than those of most baleen whales, but they show some similarity in characteristics. Source levels are in the lower end of the range determined for other species. There was no evidence to indicate the purpose of these sounds.},
