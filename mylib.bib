@article{Evans1998,
  title = {Factors Influencing the Evolution of Social Behaviour in Australian Crab Spiders (Araneae, Thomisidae)},
  author = {Evans, T A},
  year = {1998},
  volume = {63},
  pages = {205--219},
  abstract = {The social Diaea are non-territorial, periodically-social spiders that do not weave a snare web, a Factor considered to be important in spider sociality. Maternal care and heritable retreats are factors common to most group living animals, including social Diaea; suggesting that they are important factors in the evolution of spider sociality. A 4 year survey, along with field and laboratory experiments revealed that mother spiders provided crucial care in the form of a protective Eucalyptus leaf nest and large prey for their offspring. After the mother's death, the nest was inherited and expanded by the offspring. Larger groups built larger, more protective nests, but expended less individual effort doing so, and so survived better than smaller groups. (C) 1998 The Linnean Society of London. [References: 57]},
  journal = {Biological Journal of the Linnean Society},
  keywords = {Anelosimus-eximius,Biology.,Communal behaviour,Ecology.,Eusociality,Foundation,Maternal care,Protective retreat.,Sex-ratio,Size,Theridiidae},
  number = {2}
}

