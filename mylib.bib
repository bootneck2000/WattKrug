@article{Pizzorno1998,
  title = {Review of Strandings and Additional Information on Humpback Whales, {{Megaptera}} Novaeangliae, in {{Rio}} de {{Janeiro}}, Southeastern {{Brazilian}} Coast (1981-1997)},
  author = {Pizzorno, Jose Luis A and {Lailson-Brito Jr.}, Jose and Dorneles, Paulo R and Azevedo, Alexandre F and {do N. Gurgel}, Izabel Maria G},
  year = {1998},
  volume = {0},
  pages = {443--446},
  abstract = {Every year, humpback whales migrate to low latitude areas as part of their annual life cycle. The coast of Rio de Janeiro is an important part of the migratory route of humpback whales along the southwest tropical Atlantic Ocean. This paper presents new information on 8 strandings, 3 coastal sightings and 3 interactions between humpback whales and fishery activities along Rio de Janeiro State coast. Data gathered in this paper indicate the need for long-term studies focusing on humpback whales along the Brazilian southeastern coast.},
