@article{Norris1980,
  title = {Behavior of the Hawaiian {{USA}} Spinner Dolphin Stenella-Longirostris},
  author = {Norris, K S and Dohl, T P},
  year = {1980},
  volume = {77},
  pages = {821--850},
  abstract = {The Hawaiian spinner dolphin, S. longirostris, was recorded from Kure Atoll to the island of Hawaii. It enters atoll lagoons or specific coves or swims over shallow sandy areas, usually near deep water, to rest. Access to nighttime feeding grounds may regulate the location of these rest areas. Rest areas are generally 50 m or less in depth. Natural scars and marks allowed study of movements and school structure. Schools are fluid assemblages of variable size and composition. Only small subgroups within schools may have long-term integrity. Spinner dolphins exhibit several aerial patterns including spinning which is mostly associated with sound production upon reentry, and each is typical of a specific school activity level. Sounds may serve as omnidirectional sound sources maintaining school cohesion beyond the limits of vision. The daily cycle of spinner dolphins consists of nighttime feeding, morning approach to shore, morning-midday rest and travel to feeding grounds near dusk. Feeding is upon scattering layer fish, squid and shrimp. Dolphins very commonly show scars from large sharks and from the small squaloid shark, Isistius brasiliensis, which scoops disc-shaped pieces of blubber from them. These wounds heal to form dollar-shaped scars.},
  journal = {Fishery Bulletin},
  keywords = {Anim,Animalia,Animals,Arthropoda,Arthropods,Associated Structures and Functions/,Behavioral Biology/Animal Behavior [07003],Behavioral Biology/Animal Communication (1971- ) [,Biochemical Studies/General [10060],Cephalopoda [61100],Cephalopoda: Mollusca,Cetaceans,Chondrichthyes: Pisces,Chorda,Chordata,Chordates,Crustaceans,Delphinidae: Cetacea,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,Fish,Integumentary System/Pathology [18506],Invertebrata,Invertebrates,Malacostraca: Crustacea,Mammalia,Mammals,Methods (1970- ) [52801],Methods [20001],Mollusks,Movement (1971- ) [12100],Nonhuman Mammals,Nonhuman Vertebrates,Nutrition/General Studies,Nutritional Status and,Sense Organs,Soil Science/General,Vertebrata,Vertebrates},
