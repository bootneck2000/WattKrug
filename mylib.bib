@article{Frick2010,
  title = {An Emerging Disease Causes Regional Population Collapse of a Common {{North American}} Bat Species.},
  author = {Frick, Winifred F and Pollock, Jacob F and Hicks, Alan C and Langwig, Kate E and Reynolds, D Scott and Turner, Gregory G and Butchkoski, Calvin M and Kunz, Thomas H},
  year = {2010},
