@article{Stoll1999,
  title = {New Early Winter {{fCO2}} Data Reveal Continuous Uptake of {{CO2}} by the {{Weddell Sea}}},
  author = {Stoll, M. H. C. and Baar, H. J. W. DE and Hoppema, M. and FAHRBACH, E.},
  year = {1999},
  month = jul,
  volume = {51},
  pages = {679--687},
  publisher = {{Informa UK Limited}},
  issn = {0280-6509},
  doi = {10.1034/j.1600-0889.1999.t01-2-00008.x},
  abstract = {The Antarctic Ocean has been thought to be unimportant for the uptake of CO2 since upwelling of CO2-enriched deep waters would favour outgassing. Here we present the first direct fCO2 measurements obtained in early winter under the ice which, combined with estimated entrainment rates, show that the Weddell Sea, an area of intense upwelling manifested by the doming structure of the cyclonic gyre, has the capability to be almost continuously a sink for atmospheric CO2. A flux, effective after the ice cover disappears, is estimated to be \textendash{} 0.74 + 0.7 mmol/m-2 d-1. Combined with a flux estimate in late autumn (- 2.0 mmol/m2 d-1) integrated over the area of the central Weddell Gyre, a carbon uptake of 0.24 \texttimes{} 1013 gC y-1 ({$\approx$} 2.4 \texttimes{} 10-3 GtC y-1 being {$\approx$} 1\textperthousand{} of global uptake) is computed, which is about a third of the strength of the biological pump of the Weddell Sea.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\HPPRW6DC\\STOLL et al. - 1999 - New early winter fCO2 data reveal continuous uptake of CO2 by the Weddell Sea.pdf},
  journal = {Tellus Series B-chemical and Physical Meteorology},
  number = {3}
}

@article{Stolz2006,
  title = {Arsenic and Selenium in Microbial Metabolism},
  author = {Stolz, J E and Basu, P and Santini, J M and Oremland, R S},
  year = {2006},
  volume = {60},
  pages = {107--130},
  doi = {10.1146/annurev.micro.60.080805.142053},
  abstract = {Arsenic and selenium are readily metabolized by prokaryotes, participating in a full range of metabolic functions including assimilation, methylation, detoxification, and anaerobic respiration. Arsenic speciation and mobility is affected by microbes through oxidation/reduction reactions as part of resistance and respiratory processes. A robust arsenic cycle has been demonstrated in diverse environments. Respiratory arsenate reductases, arsenic methyltransferases, and new components in arsenic resistance have been recently described. The requirement for selenium stems primarily from its incorporation into selenocysteine and its function in selenoenzymes. Selenium oxyanions can serve as an electron acceptor in anaerobic respiration, forming distinct nanoparticles of elemental selenium that may be enriched in Se-76. The biogenesis of selenoproteins has been elucidated, and selenium methyltransferases and a respiratory selenate reductase have also been described. This review highlights recent advances in ecology, biochemistry, and molecular biology and provides a prelude to the impact of genomics studies.},
  isbn = {0066-4227},
  journal = {Annual Review of Microbiology},
  keywords = {ALCALIGENES-FAECALIS,arsenate reductase,arsenite,biogeochemical cycles,CRYSTAL-STRUCTURE,ELEMENTAL SELENIUM,ESCHERICHIA-COLI,FRESH-WATER BACTERIA,MONO LAKE WATER,organoarsenicals,oxidase,POULTRY LITTER,RESPIRING BACTERIUM,selenate respiration,selenocysteine,SP-NOV.,STABLE-ISOTOPE RATIOS},
  language = {English}
}

