  booktitle = {Behavior of Marine Animals Current Perspectives in Research Vol 3 Cetaceans . 1979. 438.},
  author = {Winn, H E and Olla, B L},
  year = {1979},
  abstract = {Included in this book are 12 research and review papers by contributing authors concerned with the behavior and natural history of whales, porpoises and dolphins. Topics discussed include use and potential of radiotelemetry in field studies, humpback whale identification by fluke photographs, the natural history of Dall's porpoise, the northern right whale dolphin in the Pacific, bottlenose whale natural history and humpback dolphin socioecology. Additional papers are devoted to social structure in sperm whales, significance and behavior of entrapped baleen whales, behavioral reactions of the beluga to playback of its sounds, the whistle repertoire of the north Atlantic pilot whale in relationship to its behavior and environment, the whistle of the Atlantic bottlenose dolphin and sounds of the Mysticeti. Of interest to marine ecologists, cetologists and behavioral biologists, this book also includes many photographs, diagrams, tables and references, and a subject index is provided. Individual papers are indexed in Bioresearch Index.},
