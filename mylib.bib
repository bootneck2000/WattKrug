@article{Perry2000,
  title = {{{DNA}} Sequence Analysis Identifies Genetically Distinguishable Populations of Harp Seals ({{Pagophilus}} Groenlandicus) in the {{Northwest}} and {{Northeast Atlantic}}.},
  author = {Perry, E A and Stenson, G B and Bartlett, S E and Davidson, W S and Carr, S M and M., Carr. S and Carr, S M},
  year = {2000},
  volume = {137},
  pages = {53--58},
  abstract = {Harp seals (Pagophilus groenlandicus Erxleben, 1777) comprise three populations based upon whelping areas in the Greenland Sea, White Sea, and Northwest Atlantic. The last comprises two subpopulations, one whelping in the Gulf of St. Lawrence ("Gulf") and one on the pack ice of the southern Labrador/northern Newfoundland coastal shelf ("Front"). A total of 40 female seals from the four whelping areas were collected during the 1990 and 1992 whelping seasons. DNA sequence variation was examined in a 307 bp region of the mitochondrial cytochrome b gene. Eleven variable nucleotide positions defined 13 genotypes: a significant fraction of the genotypic variance (F-ST = 0.12, or 0.09 as measured by Weir's coancestry coefficient theta) is attributable to differentiation between Northwest and Northeast Atlantic populations. There was no significant differentiation between the two whelping areas in the Northwest Atlantic, or between the Greenland Sea and White Sea. These findings suggest significant reproductive isolation exists between trans-Atlantic breeding populations.},
  isbn = {0025-3162},
  journal = {Marine Biology},
  keywords = {7249,COD,DNA,EVOLUTION,GADUS-MORHUA,genetics,LOCATIONS,MITOCHONDRIAL,Phoca groenlandica,PHOCA-GROENLANDICA},
