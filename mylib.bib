@article{Arrigo1995,
  title = {High Resolution Study of the Platelet Ice Ecosystem in {{McMurdo Sound}}, {{Antarctica}}: Biomass, Nutrient, and Production Profiles within a Dense Microalgal Bloom},
  author = {Arrigo, K. R. and Dieckmann, G. and Gosselin, M. and Robinson, D. H. and Fritsen, C. H. and Sullivan, C. W.},
  year = {1995},
  volume = {127},
  pages = {255--268},
  issn = {01718630},
  doi = {10.3354/meps127255},
  abstract = {Vertical distributions of inorganic nutrients (nitrate, nitrite, ammonium, phosphate, and silicic acid) and microalgal and bacterial biomass were monitored within both the lower congelation ice and the platelet ice layer. Profiles of dissolved organic matter (amino acids and simple sugars) and heterotrophic protists were also obtained. The platelet ice was unusual because, although concentrations of regenerated nutrients were often high, the elemental composition of particulates remained near the Redfield ratios and detrital abundance was low. The coincidence of NO2 and NO3 peaks at a depth of 0.65 to 0.75 m suggests that bacterial nitrification may also occur in the platelet ice. -from Authors},
  journal = {Marine Ecology Progress Series},
  number = {1-3}
}

@article{Arrigo1997a,
  title = {Primary Production in {{Antarctic}} Sea Ice},
  author = {Arrigo, Kevin R. and Worthen, Denise L. and Lizotte, Michael P. and Dixon, Paul and Dieckmann, Gerhard},
  year = {1997},
  month = apr,
  volume = {276},
  pages = {394--397},
  issn = {00368075},
  doi = {10.1126/science.276.5311.394},
  abstract = {A numerical model shows that in Antarctic sea ice, increased flooding in regions with thick snow cover enhances primary production in the infiltration (surface) layer. Productivity in the freeboard (sea level) layer is also determined by sea ice porosity, which varies with temperature. Spatial and temporal variation in snow thickness and the proportion of first-year ice thus determine regional differences in sea ice primary production. Model results show that of the 40 teragrams of carbon produced annually in the Antarctic ice pack, 75 percent was associated with first-year ice and nearly 50 percent was produced in the Weddell Sea.},
  isbn = {00368075{\r 1}0959203},
  journal = {Science},
  number = {5311},
  pmid = {9103193}
}

@article{Arrigo2008,
  title = {Primary Production in the {{Southern Ocean}}, 1997-2006},
  author = {Arrigo, Kevin R. and {van Dijken}, Gert L. and Bushinsky, Seth},
  year = {2008},
  month = aug,
  volume = {113},
  pages = {C08004},
  publisher = {{Blackwell Publishing Ltd}},
  issn = {21699291},
  doi = {10.1029/2007JC004551},
  abstract = {Estimates of primary production in the Southern Ocean are difficult to obtain but are essential if we are to understand its role in the global carbon cycle. Here we present a 9-year time series of daily primary production calculated from remotely sensed ocean color, sea surface temperature, and sea ice concentration using a primary production algorithm parameterized specifically for use in Southern Ocean waters. Results suggest that total annual production in waters south of 50\textdegree S averaged 1949 {$\pm$} 70.1 Tg C a-1 (where a is years) between 1998 and 2006, approximately half that of previous estimates. The large but relatively unproductive pelagic province accounted for {$\sim$}90\% of Southern Ocean production, while area normalized rates of production were greatest on the much smaller continental shelf (109 g C m-2 a-1). Surprisingly, production in the marginal ice zone was only slightly higher than in the pelagic province. The Ross Sea was the most productive sector of the Southern Ocean (mean = 503 Tg C a-1), followed closely by the Weddell Sea (mean = 477 Tg C a-1). Unlike the Arctic Ocean, there was no secular trend in either sea ice cover or annual primary production in the Southern Ocean during our 9-year study. Interannual variability in annual production was most closely tied to changes in sea ice cover, although changes in sea surface temperature also played a role. Only 31\% of the variation in annual production was explained by the Southern Annular Mode. Annual primary production could increase in the future as stronger winds increase nutrient upwelling.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\AKRF3ALF\\Arrigo, van Dijken, Bushinsky - 2008 - Primary production in the Southern Ocean, 1997-2006.pdf},
  isbn = {0148-0227},
  journal = {Journal of Geophysical Research: Oceans},
  number = {8}
}

@article{Arrigo2015a,
  title = {Environmental Controls Ofmarine Productivity Hot Spots around {{Antarctica}}},
  author = {Arrigo, K. R. and {van Dijken}, Gert L. and Strong, Aaron},
  year = {2015},
  volume = {120},
  pages = {1--22},
  issn = {2169-9291},
