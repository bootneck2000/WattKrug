@article{Hebert1992,
  title = {Root Lodging Resistance in Forage Maize - Genetic-Variability of Root-System and Aerial Part},
  author = {Hebert, Y and Barriere, Y and Bertholeau, J C},
  year = {1992},
  volume = {37},
  pages = {173--183},
  abstract = {The F1 hybrids of 9 maize lines crossed according to a half diallel design were studied in order to investigate the genetic variability of root system and aerial part traits involved in the resistance to root lodging. It is concluded that several traits have to be considered jointly to explain the genetic differences in behaviour of the material: the number of roots on some internodes, the diameter of the roots, the length of the first internodes and, mainly, the root growth direction. The structure of the aerial part of the plant also has some relationships with the lodging susceptibility. Evidences of the probable implication of development (early growth, flowering date) are discussed in terms of root / stalk competition and breeding.},
