@article{Hurt2016,
  title = {Evidence for the Introduction, Reassortment and Persistence of Diverse Influenza {{A}} Viruses in {{Antarctica}}},
  author = {Hurt, AC and Su, YCF and Aban, M and Peck, H and Lau, H},
  year = {2016},
  volume = {90},
  doi = {doi:10.1128/JVI.01404-16},
  abstract = {Avian influenza virus (AIV) surveillance in Antarctica during 2013 revealed the 44 prevalence of evolutionarily distinct influenza viruses of H11N2 subtype in Ad\'elie 45 penguins. Here we present results from the continued surveillance of AIV on the 46 Antarctic Peninsula during 2014 and 2015. In addition to the continued detection of 47 H11 subtype viruses during 2014 in a snowy sheathbill, we isolated a novel H5N5 48 subtype virus during 2015 in a chinstrap penguin. Gene sequencing and phylogenetic 49 analysis revealed that the H11 virus detected in 2014 had a \textquestiondown 99.1\% nucleotide 50 similarity to the H11N2 viruses isolated in 2013, suggesting continued prevalence of 51 this virus over multiple years in Antarctica. However, phylogenetic analysis of the H5N5 52 virus showed that their genome segments were recently introduced into the continent, 53 except for the NP gene that was similar to that in the endemic H11N2 viruses. Our 54 analysis indicates geographically diverse origins for the H5N5 virus genes; with the 55 majority of its genome segments derived from North American lineage viruses, but the 56 neuraminidase gene derived from a Eurasian lineage virus. In summary, we show the 57 persistence of AIV lineages over multiple years in Antarctica; recent introduction of 58 gene segments from diverse regions; and reassortment between different AIV lineages 59 in Antarctica, which together, significantly increases our understanding of AIV ecology 60 in this fragile and pristine environment.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\REICEKTT\\Hurt et al. - 2016 - Evidence for the introduction, reassortment and persistence of diverse influenza A viruses in Antarctica.pdf},
  journal = {Journal of Virology},
  number = {17}
}

@article{Hurtado2004,
  title = {Contrasting Population Genetic Patterns and Evolutionary Histories among Sympatric {{Sonoran Desert}} Cactophilic {{Drosophila}}},
  author = {Hurtado, L A and Erez, T and Castrezana, S and Markow, T A},
  year = {2004},
  volume = {13},
  pages = {1365--1375},
  doi = {10.1111/j.1365-294X.2004.02169.x},
  abstract = {We studied population genetic differentiation in the sympatric Sonoran Desert cactophilic flies Drosophila pachea, D. mettleri and D. nigrospiracula across their continental and peninsular ranges. These flies show marked differences in ecology and behaviour including dispersal distances and host cactus specialization. Examination of a fragment of the mitochondrial cytochrome oxidase subunit I gene (mtCOI) reveals that the Sea of Cortez has constituted an effective dispersal barrier for D. pachea, leading to significant genetic differentiation between the continental and peninsular ranges of this species. No genetic differentiation was detected, however, within its continental and peninsular ranges. In contrast, our mtCOI-based results for D. mettleri and D. nigrospiracula are consistent with a previous allozyme-based study that showed no significant genetic differentiation between continental and peninsular ranges of these two species. For D. mettleri, we also found that the insular population from Santa Catalina Island, California, is genetically differentiated with respect to continental and peninsular localities. We discuss how differences in the genetic structure patterns of D. pachea, D. mettleri and D. nigrospiracula may correspond to differences in their dispersal abilities, host preferences and behaviour.},
  isbn = {0962-1083},
  journal = {Molecular Ecology},
  keywords = {BAJA-CALIFORNIA,cactophilic,CALIFORNIA PENINSULAR DESERT,Desert,DIFFERENTIATION,Drosophila,EREMICUS SPECIES,GROUP,HUMAN MITOCHONDRIAL-DNA,mitochondrial COI,NATURAL-POPULATIONS,phylogeography,POLYMORPHISM,REPRODUCTIVE ISOLATION,Sea of Cortez,SEQUENCES,Sonoran,STATISTICAL TESTS,vicariance},
  language = {English},
  number = {6}
}

