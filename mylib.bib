@article{Moilanen2004,
  title = {{{SPOMSIM}}: Software for Stochastic Patch Occupancy Models of Metapopulation Dynamics},
  author = {Moilanen, A},
  year = {2004},
  volume = {179},
  pages = {533--550},
  doi = {10.1016/j.ecolmodel.2004.04.019},
  abstract = {Classical metapopulations are groups of local populations living in networks of spatially distinct habitat patches in a balance between local extinctions and recolonizations of empty habitat. Models are needed for understanding and predicting metapopulation dynamics in changing landscapes. One particularly important question is what is the effect of habitat loss to the persistence of a metapopulation. A class of metapopulation models that have been successfully used in practical applications are called stochastic patch occupancy models (SPOMs), which model the presence/absence of the species on habitat patches as a Markov chain. The presence-absence assumption makes the model relatively parameter sparse, facilitates empirical data collection, and enables rigorous parameter estimation. This study reviews theory of SPOMs and describes a computational tool, called SPOMSIM, which allows one to simulate SPOMs and estimate parameters for them. SPOMSIM offers a range of choices for submodels; alternatives are provided for the functional forms of local extinction, the dispersal kernel, computation of connectivity, the colonization function, the implementation of the rescue effect and the implementation of regional stochasticity. SPOMSIM includes also, among other things, a utility based on hierarchical clustering for the analysis of the structure of a patch network, a reserve network optimization algorithm, and a patch system editor which makes it possible to investigate the consequences of changes in landscape structure. Potential uses for SPOMSIM include scientific metapopulation studies, teaching and conservation management. (C) 2004 Elsevier B.V. All rights reserved.},
  isbn = {0304-3800},
  journal = {Ecological Modelling},
  keywords = {BAYESIAN-ANALYSIS,BIODIVERSITY,computer software,DISTRIBUTIONS,EXTINCTION,FRAGMENTED,incidence function model,LANDSCAPES,metapopulation dynamics,occupancy model,PARAMETER-ESTIMATION,POPULATION VIABILITY ANALYSIS,reserve network design,SIMULATION,SIZE,spatial population dynamics,stochastic patch,SURVIVAL},
  language = {English},
  number = {4}
}

