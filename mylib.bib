@article{Maiden2000,
  title = {High-Throughput Sequencing in the Population Analysis of Bacterial Pathogens of Humans},
  author = {Maiden, M C J},
  year = {2000},
  volume = {290},
  pages = {183--190},
  abstract = {High-throughput nucleotide sequence determination technologies present new opportunities for studies of bacterial pathogens by enabling the accumulation of large volumes of biodiversity information from isolate collections. Population studies, which combine these data with epidemiological, phylogenetic, and evolutionary concepts, provide insights into the behaviour of pathogens that are unavailable from other approaches as they address questions of relevance to pathogenesis from the perspective of the infectious organism rather from that of the host. Hypothesis-driven analyses applied to these data permit the determination of microbial population diversity and structure, the identification of the mechanisms of generic change in bacterial populations, and the generation of models of pathogen evolution. The nucleotide sequence-based population studies performed to date demonstrate a spectrum of nucleotide sequence diversity, population structure, and evolutionary mechanisms among pathogenic bacteria. The rapid development of nucleotide sequence determination and analysis techniques provides the tools necessary for the prosecution of population studies on an increasing number of bacterial pathogens.},
  isbn = {1438-4221},
  journal = {International Journal of Medical Microbiology},
  keywords = {bacterial population biology,biodiversity,CLONES,DIVERSITY,DNA sequencing,ESCHERICHIA-COLI POPULATIONS,GENETIC-STRUCTURE,HELICOBACTER-PYLORI,high-througput,IDENTIFICATION,MENINGOCOCCAL DISEASE,MOLECULAR EVOLUTION,NEISSERIA-MENINGITIDIS,pathogens,RECOMBINATION},
  language = {English},
  number = {2}
}

@article{Maier1999,
  title = {On the Evolutionary Biology of Early Mammals - {{With}} Methodological Remarks on the Interaction between Ontogenetic Adaptation and Phylogenetic Transformation},
  author = {Maier, W},
  year = {1999},
  volume = {238},
  pages = {55--74},
  abstract = {Some methodological questions of comparative anatomy and phylogenetic systematics are reconsidered using information from the early evolutionary differentiation of mammals. It is argued that any comparative approach necessarily implies systematic premises. Reconstruction of the 'groundplans' of inferred last common ancestors is a rewarding methodical tool in evolutionary biology: It provides a solid basis for discussing subsequent anagenetic transformations and allows asking more precise questions on the adaptiveness of presumed forerunners. Another important category in phylogenetic reasoning is the organism concept which should be conceived as the entire life history including form-function relations at all ontogenetic stages. Comparative anatomy should be transformed into comparative ontogeny or comparative life history study. Ontogenetic adaptations are the major source of evolutionary transformations; therefore study of mutual relationships between ontogeny and phylogeny is regarded as the central method in evolutionary biology. This methodological approach is exemplified using the last common mammalian ancestor. Both comparative ontogeny and palaeontology indicate that the last common ancestor species of extant mammals must have lived around the Triassic-Jurassic boundary. Comparative life history allows the development of precise concepts on the reproductive system of that ancestor. In this study, focus will be on structural adaptations of the neonate, assumed to be an immature (altricial), nidicolous hatchling largely dependent on maternal care and food. Such maternal care makes only sense in endothermic parents, equipped with fur and skin glands. It is certain that those young were fed from milk glands (lactation), but this liquid food had to be suckled and swallowed actively by the young. A suite of diagnostic characters of mammals, such as a muscularized tongue and its hyoid fixation, cheeks and lips with their hyoidal (facial) muscles, secondary palate (with muscularized velum), complete larynx, akinetic skull construction and other features are considered to have evolved as adaptations of the early postnatal stage. Considering the evolutionary appearance of the secondary palate in Upper Permian therapsids, it is concluded that mammalian reproductive biology may date much further back than previously thought. On the other side, the,gradual evolutionary differentiation of the mammalian dentition and mastication during the Jurassic, culminating in the monophyodontic tribosphenic molar type, is also considered to be based on these perinatal adaptations. It thus appears that perinatal adaptations in a very peculiar type of reproduction were a key innovation in mammalian evolution. [References: 143]},
  journal = {Zoologischer Anzeiger},
  keywords = {Animal Sciences in Current Contents(R)/Agricultura,Larynx.,Life history,Mechanisms,Methodology,Ontogeny,Origins.,Perinatal adaptations,Phylogeny,Secondary palate,Suckling,Tetrapods,Therapsids},
  number = {1-2}
}

@article{Maiers1996,
  title = {Use of {{DNA}} Microsatellites in Beluga Whale ({{Delphinapterus}} Leucas) Population Genetics.},
  author = {Maiers, L D and Friesen, M K and Wiens, A V and Clayton, J W},
  year = {1996},
  volume = {2115},
  pages = {17 pp.},
  abstract = {The potential of nuclear DNA microsatellite analysis for use as a marker for population genetic studies of beluga whales (Delphinapterus leucas) was tested. One microsatellite locus was amplified in beluga samples from five different locations using primers developed for the long-finned pilot whale (Globicephala melas). The distribution of genotypes among whales sampled at each location was in agreement with the Castle-Hardy-Weinberg equilibrium. The test could riot be performed on the St. Lawrence whales where only two alleles were found distributed as 17 homozygotes and 1 heterozygote. Examination of the five alleles amplified revealed significant allele frequency differences among beluga from Alaska, Mackenzie Delta, Nastapoka River, and St. Lawrence River. Comparison of the allele frequencies among males and females where there were sufficient samples (Alaska, Mackenzie Delta, and Nastapoka River) showed no significant differences. Significant allele frequency differences were riot found among whales sampled at Pt. Lay, Alaska and whales sampled at Norton Sound, Alaska. This result, however, may be a reflection of the small sample size (n=13) from Norton Sound. Future studies of beluga whale population genetics and stock identification should focus on the analysis of more microsatellite loci to increase the resolving power of the technique.},
  journal = {Can. Techn. Rep. Fish. Aquat. Sci.},
  keywords = {8467,animals,beluga whale (Monodontidae),Cell Biology,cetaceans,Chor,Chord,Chordata,chordates,Cytology and Cytochemistry/Animal [02506],Delphinapterus leucas,Delphinapterus leucas (Monodontidae),DNA,General and Systematic Zoology/Mammalia,genetics,Genetics,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/Population Genetics (197,mammal (Mammalia - Unspecified),Mammalia,Mammalia - Unspecified: Mammalia,mammals,Monodontidae [85825],Monodontidae: Cetacea,nonhuman mammals,nonhuman vertebrates,Population Genetics (Population Studies),Systematics and Taxonomy,Vertebrata,vertebrates},
