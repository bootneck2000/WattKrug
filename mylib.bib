@article{Caudron1997,
  title = {Pinniped Social Systems: A Review.},
  author = {Caudron, A K},
  year = {1997},
  volume = {61},
  pages = {153--160},
  abstract = {As for 95\% of known mammals, polygyny is the most common form of social system in Pinnipeds breeding aggregations. The form (female defence, resource defence or lek) and the degree (slight, moderate or extreme) of polygyny vary a lot among Phocids and Otariids. The determinants of Pinnipeds mating systems were described by Bartholomew (1970) and resumed by Boness (1991). We comment here some factors which are particular to Pinnipeds compared to other mammals, and some factors for which research on Pinnipeds brought new insights into mammal polygyny as a whole. Recent studies show for example that social system features are deeply influenced by breeding site topography in grey seals, by meteorological conditions (air temperature) in fur seals, by predation in ice-breeding seals, by the energetics of Phocids versus Otariids and by the pattern of females distribution on breeding site. Intraspecific variability or plasticity in social systems and alternative breeding strategies used by some individuals may be far more frequent and play a more important role than previously suspected. [References: 43]},
  journal = {Mammalia},
  keywords = {5332,Animal sciences.,Callorhinus ursinus,Cystophora cristata,Cystophora-cristata,energetics,Erignathus barbatus,Eumetopias jubatus,Gray seal.,Grey seals,Halichoerus grypus,Harbor seal,Hooded seals,Lobodon carcinophagus,mating systems,Neophoca cinerea,Odobenus rosmarus,Odobenus-rosmarus-rosmarus,Phoca hispida,Phoca vitulina,Phoca-hispida,polygyny,predation,Seals halichoerus-grypus,Thermoregulatory behavior,Underwater vocalizations},
