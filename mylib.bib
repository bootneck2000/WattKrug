@article{Rosel1999,
  title = {Mitochondrial {{DNA}} Variation in the Critically Endangered Vaquita {{Phocoena}} Sinus {{Norris}} and {{MacFarland}}, 1958},
  author = {Rosel, Patricia E and {Rojas-Bracho}, Lorenzo},
  year = {1999},
  volume = {15},
  pages = {990--1003},
  abstract = {The vaquita, Phocoena sinus, is one of two critically endangered cetacean species, and is listed as an endangered species in both the United States and Mexico. These listings result from a small population size, estimated to be 224 animals, and a rapid decline in abundance (18\% per annum) thought to be caused by human activities. To characterize the genetic composition of the vaquita, we have sequenced a portion of the mitochondrial DNA control region from 43 individuals collected between 1985 and 1993. All animals had identical sequences. While low genetic variability has been reported for cetacean species, this complete lack of polymorphism in the control region is unique. This result is concordant with the hypothesis that the evolutionary history of the species includes a bottleneck or founder event, possibly at species inception, followed by a small long-term effective population size. We recommend parallel studies of nuclear variability, which could provide understanding of the basic biology of the vaquita for use in conservation efforts.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {6512,conservation genetics/control region/mtDNA,DNA,genetics,PBS Record: 1436,Phocoena sinus},
  mendeley-tags = {6512,PBS Record: 1436},
  number = {4}
}

@article{RoselMGHaygood&WFPerrin.1995,
  title = {Phylogenetic Relationships among the True Porpoises ({{Cetacea}}: {{Phocoenidae}}).},
  author = {Rosel MG Haygood \& WF Perrin., P E},
  year = {1995},
  volume = {4},
  pages = {463--474.},
  abstract = {Portions of the cytochrome b gene and control region of the mitochondrial DNA molecule were sequenced to investigate systematic relationships among the six extant species of true porpoises, (Cetacea: Phocoenidae). Phylogenetic analyses of mitochondrial cytochrome b sequences support a close relationship between Burmeister's porpoise, Phocoena spinipinnis, and the vaquita, Phocoena sinus, and the association of these two species with the spectacled porpoise, Australophocaena dioptrica. The latter result is not in concordance with a recent morphological reclassification which groups A. dioptrica with Dall's porpoise, Phocoenoides dalli, in the subfamily Phocoenoidinae. The molecular analysis found no support for this grouping. A. dioptrica was originally described as a member of the genus Phocoena, and our results support returning it to that genus at this time. Finally, the data suggest that the tropical species, Neophocaena phocaenoides, the finless porpoise, may represent the most basal member of the family. The control region sequences corroborated the relationships among the closely related taxa P. sinus, P. spinipinnis and A. dioptrica, but were unable to resolve the deeper branches of the tree, probably as a result of a high level of saturation of these sequences.},
  journal = {Molecular Phylogenetics and Evolution},
  number = {4}
}

@article{RoselPEHeyningJE1994,
  title = {Genetic Analysis of Sympatric Morphotypes of Common Dolphins (Genus {{Delphinus}})},
  author = {Rosel PE Heyning, JE, Dizon A E},
  year = {1994},
  volume = {119},
  pages = {159--167},
  abstract = {Sympatric populations of two forms of the common dolphin, currently recognized collectively as Delphinus delphis Linnaeus, occur in several areas of the world's oceans. A molecular genetic study was initiated to determine whether these forms are genetically distinct in the Northeast Pacific. We compared mitochondrial DNA sequences from the control region and cytochrome b gene between specimens of the long-beaked and the short-beaked morphotypes collected between 1986 and 1989 off the coast of southern California. Additional short-beaked specimens collected from the eastern tropical Pacific (in 1978 and 1982) and the Black Sea (in 1989) were also compared. There were no shared mitochondrial DNA haplotypes between the two morphotypes, and both gene regions exhibited frequency and fixed nucleotide substitutions between the two morphotypes. This genetic differentiation, coupled with unique morphological characters of the short-beaked and long-beaked morphotypes determined in a parallel study, indicate that although sympatric, these populations of common dolphin are reproductively isolated from one another and may represent separate species},
  journal = {Marine Biology}
}

@article{RoselRTiedemann&MWalton1999,
  title = {Genetic Evidence for Restricted Trans-{{Atlantic}} Movements of the Harbor Porpoise, {{Phocoena}} Phocoena.},
  author = {Rosel R Tiedemann \& M Walton, P E},
  year = {1999},
  volume = {133},
  pages = {583--591},
  abstract = {The study of dispersal and genetic exchange among populations of marine species is often confounded by the difficulty of defining the barriers to movement for the highly vagile marine vertebrate species or species with passive dispersal of gametes or larvae. In many cases, our delineations of a "population" are based on assumptions concerning the habitat preferences of that species, when in fact we have only partial and often imperfect information on the ecology of these species. This is particularly true for most marine mammal species. For example, for the harbour porpoise, Phocoena phocoena, fourteen regional subpopulations have been described in the North Atlantic. To what degree these populations experience genetic interchange is relatively unknown, particularly on the larger scale of the North Atlantic as a whole. Further, this compartmentalization of harbour porpoise populations in the North Atlantic has resulted in a regional focus of research projects to verify the local subpopulation designations, and has diminished focus on broader scales. With the recent completion of several regional genetic studies of harbour porpoise population structure in the North Atlantic, came the unusual opportunity to combine datasets in an effort to broaden the geographic scope of focus. Three mitochondrial DNA control region datasets representing the Northeast and Northwest Atlantic regions were pooled and reanalyzed to examine the degree of trans-Atlantic exchange among harbour porpoise populations, and to examine the evolutionary history of the species in the North Atlantic. The movement of animals across the Atlantic appears to occur at a fairly low level. Further, the colonization of the North Atlantic has occurred from the North Pacific across the Canadian Arctic. Genetic variability in the Northeast Atlantic is significantly lower than that of the Northwest Atlantic, and suggests a more recent recolonization, perhaps since the last glacial maxima, for this region. A disjunction in haplotypic frequencies between the Northwest and Northeast Atlantic probably occurs between Greenland and Iceland but the exact location and source of the disjunction has yet to be determined.},
  journal = {Marine Biology}
}

@article{RoselSCFranceJYWang&TDKocher1999,
  title = {Genetic Structure of Harbour Porpoise {{Phocoena}} Phocoena Populations in the Northwest {{Atlantic}} Based on Mitochondrial and Nuclear Markers},
  author = {Rosel SC France, JY Wang, \& TD Kocher, P E and Rosel, P E and France, S C and Wang, J Y and Kocher, T D},
  year = {1999},
  volume = {8},
  pages = {S41--S54.},
  abstract = {The harbour porpoise, Phocoena phocoena, experiences high levels of non-natural mortality due to interactions with commercial fisheries throughout its range. To accurately evaluate the significance of this bycatch, information on population structure is needed. We have examined the population structure of this species in the Northwest Atlantic Ocean using mitochondrial DNA sequence and nuclear microsatellite data. Samples from four previously proposed summer breeding populations - Gulf of Maine, eastern Newfoundland, the Gulf of St. Lawrence, and West Greenland - were analyzed. Control region sequences revealed a significant partitioning of genetic variation among most of these summer populations, indicating that Northwest Atlantic harbour porpoises should not be considered one panmictic population. Analysis of females alone yielded the highest levels of population subdivision, suggesting females are more philopatric than males. At least three management units may be defined for harbour porpoises in the Northwest Atlantic based on these data. Analysis of six microsatellite loci failed to detect significant population subdivision. Male-mediated gene flow may maintain homogeneity among nuclear loci, while female philopatry is sufficient to produce a signal of population subdivision in the maternally inherited mtDNA genome. MtDNA analyses also indicate that winter aggregations of harbour porpoises along the U.S. mid-Atlantic states are comprised of animals from more than one summer breeding population.},
  journal = {Molecular Ecology},
  number = {12 Suppl 1}
}

