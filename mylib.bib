@misc{Addison1977,
  title = {Organochlorine Residues in Maternal Blubber, Milk, and Pup Blubber from Grey Seals (\textexclamdown i\textquestiondown{{Halichoerus}} Grypus\textexclamdown/I\textquestiondown ) from {{Sable Island}}, {{Nova Scotia}}},
  author = {Addison, R F and Brodie, P F},
  year = {1977},
  volume = {34},
  pages = {937--941},
  issn = {0015-296X},
  doi = {doi:10.1139/f77-146},
  abstract = {Residues of DDT group insecticides and of PCBs were measured in samples of maternal blubber, milk, and pup blubber from grey seals (Halichoerus grypus) from Sable Island, N.S. Mean {$\Sigma$}DDT and PCB levels in maternal blubber lipid were 14.0 and 14.5{$\mu$}g/g, respectively. Concentrations of DDT and PCBs in milk lipid were approximately 60 and 30\%, respectively, of those found in maternal blubber lipid, suggesting a partial barrier to passage of these residues through mammary tissue. Concentrations in pup blubber lipid were the same as, or slightly higher than, those in milk lipid.We estimated that a grey seal will lose about 30\% of its total {$\Sigma$}DDT burden and about 15\% of its PCB burden through lactation; this would be approximately balanced by its estimated annual intake of these residues from food. Thus, the observation that female seals show no increase in residue burdens with age (in contrast to males) is explained. Key words: organochlorine, DDT, DDE, PCB, seal, blubber, milk. FR: Nous avons mesur\'e les r\'esidus d'insecticides du groupe DDT et de BPC dans des \'echantillons de graisse maternelle, de lait et de graisse de chiots de phoques gris (Halichoerus grypus) de l'\^ile de Sable, N.-E. Les niveaux moyens de {$\Sigma$}DDT et de BPC dans les lipides de la graisse maternelle sont respectivement de 14.0 et 14.5{$\mu$}g/g. Les concentrations de DDT et de BPC dans les lipides du lait sont d'environ 60 et 30\% respectivement de celle que l'on trouve dans les lipides de la graisse maternelle, ce qui sugg\`ere la pr\'esence d'une barri\`ere partielle au passage de ces r\'esidus \`a travers le tissus mammaire. Les concentrations dans les lipides de la graisse des chiots sont les m\^emes ou l\'eg\`erement plus \'elev\'ees que celles des lipides du lait.On estime qu'un phoque gris perd environ 30\% de sa charge totale de {$\Sigma$}DDT et environ 15\% de sa charge de BPC durant la lactation; ceci serait approximativement contrebalanc\'e par l'absorption annuelle estim\'ee de ces r\'esidus en provenance de la nourriture. On peut donc expliquer de cette fa\c{c}on l'observation que les phoques femelles ne montrent pas d'augmentation dans les charges de r\'esidus avec l'\^age (par contraste avec les m\^ales).},
  journal = {Journal of the fisheries research board of canada},
  keywords = {3880,Halichoerus grypus,milk,mother-pup transfer,pollution},
  mendeley-tags = {3880}
}

