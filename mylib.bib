@article{Garlich-Miller1998,
  title = {Growth and Sexual Dimorphism of Atlantic Walruses (Odobenus Rosmarus Rosmarus) in Foxe Basin, Northwest Territories, Canada.},
  author = {{Garlich-Miller}, J L and Steward, R E A and Stewart, R E A},
  year = {1998},
  volume = {14},
  pages = {803--818},
  abstract = {Growth of Atlantic walruses (Odobenus rosmarus rosmarus) was investigated using morphological data collected in association with Inuit subsistence walrus hunts. Four growth models were examined. The growth parameters of a constrained Richards model were used to quantify growth and to test for sexual dimorphism. The asymptotic length of male walruses (315.2 cm {$\pm$} 3.8 (SE), n = 103) was significantly larger (t = 7.21, df = 191, P \textexclamdown{} 0.05) than the asymptotic length of females (276.6 cm {$\pm$} 3.4, n = 90). Sexual size dimorphism in adults was due to a longer growth period and a faster growth rate in males. The predictive equation relating mass (M, kg) to standard length (SL, cm) was: Log10M = 3.74 + 2.68(Log10SL), n = 25, r2 = 0.98. There were no significant differences in the size of male walruses from Foxe Basin collected in the 1950s and this study. There were too few data to compare females. There were no significant differences in size between walruses sampled in Greenland and Foxe Basin in the 1980s and 1990s. Foxe Basin walruses were significantly larger than walruses sampled in northern Hudson Bay in the 1950s. Female Atlantic walruses sampled in Foxe Basin were larger than female Pacific walruses (Odobenus rosmarus divergens) sampled in Alaska.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {5922,growth,Odobenus rosmarus,PBS Record: 945,walrus/Odobenus rosmarus/growth},
  mendeley-tags = {5922,PBS Record: 945},
  number = {4}
}

@article{Garlich-Miller1999,
  title = {Female Reproductive Patterns and Fetal Growth of {{Atlantic}} Walruses ({{Odobenus}} Rosmarus Rosmarus) in {{Foxe Basin}}, {{Northwest Territories}}, {{Canada}}},
  author = {{Garlich-Miller}, J L and Stewart, R E A},
  year = {1999},
  volume = {15},
  pages = {179--191},
  abstract = {We examined the reproductive tracts of 79 female Atlantic walruses (Odobenus rosmarus rosmarus) caught in July and August by Inuit hunters in northern Foxe Basin, NWT, Canada. We found no evidence of past or present ovulation in animals less than 5 yr old, but the poor representation of juvenile and adolescent animals precluded statistical analysis of the average age of maturity. The ovulation frequency of 64 mature females (0.52) indicated biennial ovulation, while the pregnancy rate (0.33) and birth rate (0.30) suggested that females give birth once every three years. The sex ratio of 17 fetuses was not significantly different from 1:1. Fetuses increased 2.9 mm d-1 in crown-rump length and 0.12g1/3d-1 in mass over the range of collection dates. Based on the inverse regressions of fetal growth, implantation occurred in late June-early July.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {6072,energetics,Odobenus rosmarus,PBS Record: 967,population parameters,reproduction,walrus/reproduction/Odobenus rosmarus},
  mendeley-tags = {6072,PBS Record: 967},
  number = {1}
}

