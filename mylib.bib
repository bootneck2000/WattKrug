@article{Denbow2008,
  title = {Archaeological Excavations at {{Bosutswe}}, {{Botswana}}: Cultural Chronology, Paleo-Ecology and Economy},
  author = {Denbow, J and Smith, J and Ndobochani, N M and Atwood, K and Miller, D},
  year = {2008},
  volume = {35},
  pages = {459--480},
  doi = {10.1016/j.jas.2007.04.011},
  abstract = {Excavations at the site of Bosutswe on the eastern edge of the Kalahari Desert in Botswana have uncovered over 4 m of deposit ranging in age from CE 700 to 1700. Our research has produced quantitative and qualitative measures of the material and ecological dimensions that structured the everyday actions and behaviors through which social identities were constituted, maintained, and transformed during the period when the polities of Toutswe, Mapungubwe, Great Zimbabwe and Khami rose to power. By examining the material dimensions that underlay shifting relations of production, exchange, and social stratification we are able to contextualize the social judgments that ascribed value to material goods and food ways, while specifying the ways these were used to create and naturalize social relationships and power differentials. Stable isotope analyses, combined with evidence of vitrified dung, further enable us to suggest changes in herd management strategies used by the inhabitants of the site to compensate for ecological changes brought about by long-term occupation, while at the same time enabling them to economically tie subordinates to them as social divisions became more rigidly defined after CE 1300. The cultural and economic changes that took place at Bosutswe thus directly impact our understanding of the social transformations that immediately preceded contemporary configurations of ethnicity in Botswana. (c) 2007 Elsevier Ltd. All rights reserved.},
  isbn = {0305-4403},
  journal = {Journal of Archaeological Science},
  keywords = {agro-pastoral ecology,ASSEMBLAGES,ATMOSPHERIC CO2,CARBON,carbon and nitrogen isotopes,DIET,EASTERN BOTSWANA,IRON-AGE,ISOTOPIC COMPOSITION,Kalahari,KALAHARI,metallurgy,political economy,RECONSIDERATION,SOUTHERN AFRICA,Southern African iron age,vitrified dung},
  language = {English},
  number = {2}
}

