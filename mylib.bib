@article{Oosthuizen2000,
  title = {Bacular and Testicular Growth and Allometry in the Cafe Fur Seal {{Arctocephalus}} p. Pusillus ({{Otariidae}})},
  author = {Oosthuizen, W H and Miller, E H},
  year = {2000},
  volume = {16},
  pages = {124--140},
  abstract = {The baculum in Arctocephalus p. pusillus reaches up to 14.1 cm in length, 13.5 g in mass, and 1.3 g/cm in density (= mass/length). A pubertal growth spurt occurs between 2 and 3 yr of age, when bacular length increases by 28\%, mass by 124\%, and density by 77\%; concurrently, body length increases by 14\%. A second, weaker spurt occurs at social maturity (9-10 yr of age). Testes grow most rapidly between 1 and 2 yr of age, when testicular length increases by 29\%. After 3 yr of age, growth in bacular and testicular length slows, and bacular mass continues to increase approximately linearly. Bacular and testicular lengths average 6.8\% and 3.4\% (respectively) of body length in adults, compared with 9.9\% and 5.7\% in the promiscuous harp seal (Pagophilus groenlandicus). Bacular length, mass, and density, and testicular length, are positively allometric to body length over growth; bacular length is isometric to testicular length. Among animals of the same age, bacular length and mass are positively allometric to body length in young animals, with negative allometry or isometry thereafter; testicular length is isometric to body length in young animals and negatively allometric thereafter. Patterns of early growth and allometry of the baculum and testes are interpreted as adaptations for mating opportunities, years before territoriality is possible. The baculum and testes of adult Cape fur seals and other otariids are small compared with those of most phocids, because sperm competition among male otariids is weak.},
  journal = {Marine Mammal Science},
  keywords = {2000 week 07,6577,Animal Sciences in Current Contents(R)/Agricultura,Animals. Chordates. Mammals. Nonhuman Mammals. Non,Arctocephalus pusillus,Arctocephalus pusillus pusillus [Cape fur seal] (O,baculum: reproductive system. testicle: reproducti,Bag X2,body length. growth spurt. sperm competition.,Chord,Chordata,Development. Reproductive System (Reproduction).,Developmental Biology/Embryology-Morphogenesis,Environmental Sciences.,Ge,General and Systematic Zoology/Mammalia,Mammalia,Mathematical Biology and Statistical Methods [0450,morphometrics,Otariidae [86180],Otariidae: Pinnipedia,Phocidae [86185],Reprint available from: Oosthuizen WH. Sea Fisheri,Reproduction. Tropicalis. Selection. Pinnipeds. Su,Reproductive System/Anatomy [16502],sex organs,South Africa.,Sperm competition. Breeding-season. Sexual-behavio,Vertebrata,ZA-8012 Cape Town},
  mendeley-tags = {6577},
  number = {1}
}

