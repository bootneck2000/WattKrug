@article{Robineau1989,
  title = {The Cetacean Species of the Kerguelen Islands Indian Ocean},
  author = {Robineau, D},
  year = {1989},
  volume = {53},
  pages = {265--278},
  abstract = {Nine cetacean species (Mysticeti = 3, Odontoceti = 6) have been identified in the vicinity of the Kerguelen Islands (in the Indian sector of Anrarctic ocean). Among whalebone whales Balaenoptera acutorostrata is regularly encountered, Eubalaena australis is rare and Megaptera novaeangliae very rare. Unidentified balaenopterids are quite frequently seen. Among toothed whales, Mesoplodon layardi is reported in this area for the first time. Cephalorhynchus commersonii is the only commonly found delphinid species, Orcinus orca is an occasional visitor, Globicephala melaena and Physeter catodon are rarely observed. Two skulls of Lagenorhynchus cruciger, found on the coast, and a recent sighting indicate that this species is also present; however the occurrence of Lagenorhynchus obscurus and phocoena dioptrica cannot be confirmed.},
  journal = {Mammalia},
  number = {2}
}

