  volume = {20},
  pages = {9--12},
  abstract = {The Subantarctic fur seal (Arctocephalus tropicalis) population at Gough Island in the South Atlantic Ocean is continuing to increase rapidly since its recovery from exploitation. The intrinsic rate of increase is however slowing down on established breeding colony beaches in the western sector as congested conditions develop. The rate of increase on the more recently colonised breeding colony sites on the east coast is high but some beaches here remain unexploited by breeders despite the increased density on the west coast. The small breeding population of southern elephant seals (Mirounga leonina) either remained stable, or declined very slowly, over the past 17 years.},
