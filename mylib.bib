@article{Meyer2002,
  title = {Feeding and Energy Budgets of {{Antarctic}} Krill {{Euphausia}} Superba at the Onset of Winter - {{I}}. {{Furcilia III}} Larvae},
  author = {Meyer, B. and Atkinson, A. and St{\"o}bing, D. and Oettl, B. and Hagen, W. and Bathmann, U. V.},
  year = {2002},
  volume = {47},
  pages = {943--952},
  issn = {00243590},
  doi = {10.4319/lo.2002.47.4.0943},
  abstract = {Physiological condition and feeding behavior of furcilia larvae were investigated in autumn (April 1999) in the southwestern Lazarev Sea prior to the critical overwintering period. Furcilia stage III (FIII) larvae were most abundant, so only these were used for all analyses (dry mass [DM], elemental and biochemical composition, gut content) and experiments (metabolic and ingestion rates, selective feeding behavior). Chlorophyll a (Chi a) concentrations in the mixed layer were \textexclamdown 0.1 {$\mu$}g L-1. Respiration rates of freshly caught FIII larvae were between 0.4 and 1.2 {$\mu$}l O2 mg-1 DM h-1, similar to larvae fed for 7 d on high food concentrations (4 {$\mu$}g Chi a L-1). Excretion rates ranged between 0.01 and 0.02 {$\mu$}g NH4 mg-1 DM h-1 Their atomic O:N ratio of 72 indicated that lipids were the main metabolic substrate of FIII larvae in the field. The daily C ration ranged from 0.4\% at the lowest food concentration of 3 {$\mu$}g C L-1 to 28\% at the highest enriched food concentration of 216{$\mu$}g C L-1 whereas clearance rates decreased with increasing food concentrations. In natural seawater, 115 ml mg-1 C h-1, and in natural seawater enriched with ice biota, 24 ml mg-1 C h-1, the clearance rates on specific phytoplankton taxa revealed no significant difference across a food size range of 12-220 {$\mu$}m. The study suggests that during periods of low food supply in the water column, larvae have to exploit ice biota to cover their metabolic demands.},
  journal = {Limnology and Oceanography},
  number = {4}
}

