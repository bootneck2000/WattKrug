@article{Raynal1991,
  title = {Cetaceans with Two Dorsal Fins},
  author = {Raynal, M and Sylvestre, J-P},
  year = {1991},
  volume = {17},
  pages = {31--36},
  abstract = {Cetacean species continue to be discovered nowadays. The search for new species is thus fully justified. Six accounts of cetaceans-or alleged cetaceans-with two dorsal fins are analyzed in this article. They seem to refer, respectively, to an unidentified stranded animal, possibly a large shark; a terratological dolphin; and two distinct species still unknown to science: a small odontocete (?Delphinus rhinoceros, Quoy and Gaimard, 1824), and a large mysticete (Amphiptera pacifica, Giglioli, 1870).},
