}

@article{Blanco2001,
  title = {Diet of the Bottlenose Dolphin ({{Tursiops}} Truncatus) in the Western {{Mediterranean Sea}}},
  author = {Blanco, C and Salomon, O and Raga, J A},
  year = {2001},
  volume = {81},
  pages = {1053--1058},
  abstract = {The stomach contents of 16 bottlenose dolphins Tursiops truncatus (Cetacea: Odontoceti) stranded in the Spanish Mediterranean coast were examined. Remains and size of prey were analysed and correlated with the ecological characteristics and behavioural patterns of this dolphin. Fish and cephalopods represented the main diet components, and hake Merluccius merluccius was the most important prey. The food habits were considered as mainly demersal according to the characteristics of the prey. The study suggested ontogenic and sexual differences in feeding behaviour based on diet composition and hake size. The potential causative factors, particularly as they relate to dolphin social structure, are discussed. [References: 47]},
  journal = {Journal of the Marine Biological Association of the United Kingdom},
  keywords = {Aquatic Sciences in Current Contents(R)/Agricultur,Behavior,Cetaceans,Nosed-dolphins,Prey.},
  number = {6}
}

