@article{Meek2001,
  title = {Effects of Stress during Pregnancy on Maternal Behavior in Mice},
  author = {Meek, L R and Dittel, P L and Sheehan, M C and Chan, J Y and Kjolhaug, S R},
  year = {2001},
  volume = {72},
  pages = {473--479},
  abstract = {The effects of stress experienced during pregnancy and raising stressed offspring on maternal behavior were investigated in SwissWebster mice. Dams were either stressed or not stressed during pregnancy, and raised either prenatally stressed or nonstressed cross-fostered pups. Maternal behaviors such as grooming, nursing, pup retrieval and maternal aggression were assessed during the first 4 days after birth. Nonstressed dams raising stressed pups and stressed dams raising nonstressed pups groomed and nursed their pups significantly less than did control dams (stressed dams raising stressed pups and nonstressed dams raising nonstressed pups). Nonstressed ams raising stressed pups were also the slowest to retrieve both the first and last pup in retrieval tests. Nonstressed darns raising nonstressed pups were significantly less aggressive than other dams. In contrast, stressed dams raising stressed pups exhibited high levels of nursing and grooming, retrieved their pups rapidly and were very aggressive towards an intruder. These results indicate that raising stressed pups, or experiencing stress during a pregnancy can have significant effects on maternal behaviors. Stressed dams raising stressed pups exhibit maternal care comparable to that of nonstressed darns raising nonstressed pups at least for nesting/nurturing behaviors, and show increased levels of aggression and pup retrieval. (C) 2001 Elsevier Science Inc. All rights reserved. [References: 37]},
  journal = {Physiology \& Behavior},
  keywords = {Antecedents,Association.,Birth-weight,Cross-fostering.,Experience,Life,Maternal behavior,Mother infant interaction,Neurobiology,Olfactory-bulb,Prenatal stress,Psychology in Current Contents(R)/Social \& Behavio,Rats},
  number = {4}
}

