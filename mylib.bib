  year = {1999},
  pages = {23--34},
  abstract = {Several species of cetaceans were observed during a survey of the central-eastern waters of Taiwan between June 1996 and July 1997. Risso's dolphins (Grampus griseus) were encountered most frequently and Fraser's dolphins (Lagenodelphis hosei) comprised the majority of the total number of cetaceans observed. Spinner (Stenella longirostris), Pantropical spotted (S. attenuata) and Bottlenose dolphins (Tursiops truncatus) were also observed frequently. False killer (Pseudorca crassidens), Killer (Orcinus orca), Pygmy or Dwarf sperm (Kogia sp.) and beaked whales (Ziphiidae) were also seen.},
