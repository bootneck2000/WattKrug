@article{Gemmell2001,
  title = {Low Reproductive Success in Territorial Male {{Antarctic}} Fur Seals ({{Arctocephalus}} Gazella) Suggests the Existence of Alternative Mating Strategies},
  author = {Gemmell, Neil J and Burg, Theresa M and Boyd, Ian L and Amos, William and Gemmell Burg, T.M., Boyd,I.L., Amos, W., N J and Gemmell, Neil J and Burg, Theresa M and Boyd, Ian L and Amos, William},
  year = {2001},
  volume = {10},
  pages = {451--460},
  abstract = {Microsatellites were used to conduct an analysis of paternity of Antarctic fur seals (Arctocephalus gazella) from Bird Island, South Georgia. At most, only 28\% of pups at our study site could be assigned a father, even though the majority (apprx90\%) of candidate males within this colony were sampled. The behavioural and genetic evidence from this study suggests that a number of alternative mating strategies may exist within this fur seal population. Holding a land-based territory conferred an advantage to male reproductive success. However, this advantage was much smaller than expected from behavioural observations. At least 70\% of fur seal pups born at our study site in a given year are not fathered by males who held a territory or were observed copulating with females in the previous year, implying that there exists a pool of males that seldom venture ashore at this site. To explain this discrepancy we suggest that female choice is an integral component of the Antarctic fur seal mating system and that aquatic mating may play a much larger role in the Antarctic fur seal than previously thought.},
  journal = {Molecular Ecology},
  keywords = {7124,alternative mating strategies. copulation. female,Animals. Chordates. Mammals. Nonhuman Mammals. Non,Antarctic Region): South,Arctocephalus gazella,Arctocephalus gazella [Antarctic fur seal] (Otarii,Behavior. Reproduction.,Behavioral Biology/Animal Behavior [07003],Behavioral Biology/General and Comparative Behavio,Bird Island (Antarctica,Chord,DNA,fur seal Antarctic Antarctica Arctocephalus gazell,genetics,Mammalia,mating systems,Otariidae [86180],Otariidae: Pinnipedia,reproduction,Reproductive System/Physiology and Biochemistry [1,Vertebrata},
