@article{Reiman1993,
  title = {The Maximum Range of Vocal Communication in Air between a Harbor Seal ({{Phoca}} Vitulina) Pup and Its Mother},
  author = {Reiman, A J and Terhune, J M},
  year = {1993},
  volume = {9},
  pages = {182--189},
  abstract = {The transmission losses with distance of four pure tones (0.5, 1, 2, 4 kHz) were measured in the air 9 cm above the surface of the coastal waters in the Bay of Fundy. The study was conducted between May and July 1992, on warm days with low winds. The measured transmission losses were as much as 11 dB less than predicted by spherical spreading (6 dB/distance doubled), at 400 m (0.5 kHz). This enhanced sound transmission is probably due to the air temperature profile which increases with height above the water's surface. Such a profile causes sound waves to refract towards the water, thereby reducing spreading losses. High-frequency sound absorption negates enhanced transmission at 4 kHz, at distances over 500 m. On days with low winds and low ambient noise levels, a seal pup calling at 90 dB re 20 \textmu Pa at 0.5 kHz should be detectable by the mother up to 1 km away, and may be audibly recognizable up to 140 m away.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {1350,mother-pup relations,PBS Record: 520,Phoca vitulina,Phoca vitulina/harbor seal/sound transmission/comm,vocalization},
