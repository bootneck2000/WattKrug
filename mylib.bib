@article{Punt1995c,
  title = {On the Use of Allele Frequency Data to Provide Estimates of the Extent of Mixing between the Various {{North Pacific}} Minke Whale Stocks},
  author = {Punt, A E and Butterworth, D S and Wada, S and Kishino, H},
  year = {1995},
  volume = {0},
  pages = {293--300},
  abstract = {A method based on Hardy Weinberg equilibrium predictions for genotype frequencies is developed to estimate the relative proportions of the minke whales in a subarea of the western North Pacific which belong to two different stocks. Bootstrap methods are applied to estimate the precision of the results. The estimates obtained from existing genetic data for subareas 7 and 11 indicate J stock: O stock ratios at various times of the year which are consistent with those inferred from conception data, and more precisely determined. It is suggested that this information could be included with that being used at present to condition the Revised Management Procedure trials for North Pacific minke whales. Calculations are made of the power of the method to determine the O stock: W stock ratio in a subarea, as a function of sample size. This power is an increasing function of the difference between the allele proportions for the O stock and the (hypothesised) W stock, but generally decreases for higher values of the actual O stock: W stock ratio.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals. cetaceans. chordates. mammals. nonhuman v,Balaenopteridae (Balaenopteridae).,Balaenopteridae [85810],Balaenopteridae: Cetacea,Ch,Chordata,Conservation. Genetics. Population Genetics (Popul,Ecology,Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,General Biology/Conservation,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/Population Genetics (197,Hardy-Weinberg Equilibrium. North Pacific Ocean. S,Mammalia,Resource Management,Vertebrata},
  number = {45}
}

@article{Punt1996,
  title = {Further Remarks on the {{Bayesian}} Approach for Assessing the {{Bering}}-{{Chukchi}}-{{Beaufort Seas}} Stock of Bowhead Whales},
  author = {Punt, A E and Butterworth, D S},
  year = {1996},
  volume = {0},
  pages = {481--491},
  abstract = {A number of variants of the Bayesian synthesis approach for the assessment of the Bering-Chukchi-Beaufort Seas stock of bowhead whales are investigated and contrasted. These include the 'backwards' and 'forwards' variants, whether or not to incorporate CPUE data and an approach which replaces the prior on the adult natural mortality rate parameter by the imposition of a lower bound only for this quantity. Nine areas are identified where decisions are required on methodological options to adopt, or whether or not certain data are to be taken into account. Preliminary suggestions for an appropriate choice are made in all these instances.},
  journal = {Report of the International Whaling Commission},
  keywords = {Adult Natural Mortality Rate. Model.,animals. cetaceans. chordates. mammals. nonhuman v,Balaenopteridae (Balaenopteridae).,Balaenopteridae [85810],Balaenopteridae: Cetacea,Biophysics/Biocybernetics (1972- ) [10515],Ch,Ecology,Ecology (Environmental Sciences). Mathematical Bio,Environmental Biology/Animal [07508],General and Miscellaneous/Necrosis (197,Mammalia,Mathematical Biology and Statistical Methods [0450,Pathology,Vertebrata},
  number = {46}
}

@article{Punt1997,
  title = {Comparison of {{SLAs}} for the {{Bering}}-{{Chukchi}}-{{Beaufort Seas}} Stock of Bowhead Whales},
  author = {Punt, A E and Polacheck, T and Butterworth, D S},
  year = {1997},
  volume = {0},
  pages = {865--870},
  abstract = {The protocol developed by Punt and Polacheck (1996) for the Bering-Chukchi-Beaufort Seas stock of bowhead whales is used to contrast the performances of the following Strike Limit Algorithms (SLAs): that proposed by Givens et al. (1996), that underlying the RMP for commercial whaling and that developed by Punt and Butterworth. It is shown that the performance of the Givens et al. (1996) SLA is inferior to that of the Punt-Butterworth SLA for the trials conducted, in terms of the performance statistics considered. The Punt-Butterworth procedure outperforms the other algorithms evaluated in terms of 'guaranteed' total and continuing catch. The Scientific Committee needs to specify hypotheses about the error-structure of future abundance surveys, the stock-structure, the likely levels of error in historic catch data and the bias in the estimates of abundance for further evaluation of candidate SLAs for this stock.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals. Cetaceans. Chordates. Mammals. Nonhuman M,Balaenidae [85805],Balaenidae: Cetacea,Bering-Chukchi-Beaufort Seas (Arctic Ocean).,bowhead whale (Balaenidae).,Chordat,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Mammalia,Resource Management,stock structure. Strike Limit Algorithms.,Vertebrata,Wildlife Management (Conservation).},
  number = {47}
}

@article{Punt1997a,
  title = {Assessments of the {{Bering}}-{{Chukchi}}-{{Beaufort}} Seas Stock of Bowhead Whales ({{Balaena}} Mysticetus) Using Maximum Likelihood and {{Bayesian}} Methods},
  author = {Punt, A E and Butterworth, D S},
  year = {1997},
  volume = {0},
  pages = {603--618},
  abstract = {A number of variants of the maximum likelihood and Bayesian Synthesis approaches for the assessment of the Bering-Chukchi-Beaufort Seas stock of bowhead whales are investigated and contrasted. The maximum likelihood analyses are extended to take into account the proportion of calves/matures and pregnancy rate data as well as the uncertainty about the biological parameters. The variants of the Bayesian Synthesis approach explore excluding either or both of the K(1+) and MSYR(mat) priors, changing the year 'hit' in the 'backwards' analyses and replacing the prior on the adult natural mortality rate parameter by the imposition of a lower bound only for this quantity. A simulation approach is used to compare two maximum likelihood approaches and the 'forwards' variant of the Bayesian Synthesis approach. Several areas are identified where decisions are required on which methodological options to adopt. Preliminary suggestions for appropriate choices are made in all these instances.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals. Cetaceans. Chordates. Mammals. Nonhuman M,Balaena-mysticetus [bowhead whale] (Balaenidae).,Balaenidae [85805],Balaenidae: Cetacea,Beaufort Sea (Arctic Ocean). Bering Sea (North Pac,Chordat,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Mammalia,Resource Management,stock assessment. Bayesian Synthesis.,Vertebrata,Wildlife Management (Conservation).},
  number = {47}
}

