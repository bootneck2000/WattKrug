@article{VerganiDaniel2001,
  title = {Growth Pattern Analysis of Female Southern Elephant Seals at Their Distribution Boundaries in the {{Atlantic Ocean}}},
  author = {Vergani Daniel, F and Stanganelli Zulma, B},
  year = {2001},
  pages = {[print] 26},
  abstract = {To analyse growth patterns of female elephant seal populations in the Atlantic Ocean, studies were carried out in Patagonia (Peninsula Valdes, 42degree05'S, 63degree45'W) and Antarctica (King George Island 62degree14'S, 58degree30'W), the northern and the southern limits of their distribution in the Atlantic Ocean. Information for length frequency analysis was obtained by a non-intrusive method employing a theodolite, developed for population monitoring purposes. Three parameters were taken into account: birth mass, pup growth rate (mass gain during suckling period) and adult female length. Differences in birth mass and adult female length frequency were found between Peninsula Valdes and King George Island. The largest females were found both at birth and in the adult stage at King George Island. Data on birth mass and pup growth from Signy Island (Laws 1953), taken between 1948 and 1949, were included to make the comparison not only in space but also in time. The possible association between these findings and the small decline in southern elephant seals population observed in 1996-1997 at Peninsula Valdes is discussed.},
  journal = {New Zealand Natural Sciences},
  number = {67-74}
}

