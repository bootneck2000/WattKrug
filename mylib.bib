@article{Møller1989a,
  title = {Copulation Behaviour in Mammals: {{Evidence}} That Sperm Competition Is Widespread},
  author = {M{\o}ller, Anders Pape and Birkhead, T R},
  year = {1989},
  volume = {38},
  pages = {119--131},
  abstract = {We review information on copulation behaviour and sperm competition in mammals using data primarily from the literature. Female mammals of many species regularly copulate with more than one male during each oestrous period. Such multi-male copulations are reported more often in social, compared with solitary species. In addition, the mates of males of polygynous species experience multi-male copulations as often as the mates of males of monogamous species. Male mammals attempt to increase their certainty of paternity through a number of reproductive tactics. Copulation frequency is higher in species with multi-male copulations compared with other species. Consortships, which can be regarded as a form of mate guarding, are often absent from species in which more than one male copulates with each female during her oestrous period. Most solitary burrow-living small mammal species copulate in the open, whereas social species often copulate inside their burrows. Insurance copulations may occur in many species since high copulation rates occur in four circumstances: (i) when mates are re-untied, (ii) when a new male takes over a female, (ii) when a strange male steals a copulation, and (iv) when an audience of males is present.},
  journal = {Biological Journal of the Linnean Society},
  number = {2}
}

