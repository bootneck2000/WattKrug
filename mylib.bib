@article{Dudley1993,
  title = {Some Effects of Shark Nets in the {{Natal}} Nearshore Environment},
  author = {Dudley, Sheldon F J and Cliff, Geremy},
  year = {1993},
  volume = {36},
  pages = {243--255},
  abstract = {Protective gillnets (shark nets) have been successful in reducing the frequency of shark attacks on the coast of Natal, South Africa. This is achieved primarily through a reduction in number of large sharks. The nets also take a by catch of dolphins, sea turtles, batoids and teleosts. Concern has been expressed over the direct effect of mortalities on the various stocks and also the broader, indirect effects on the inshore system. Catch rates of most shark species declined initially but have shown no trend since the mid-1970s. A first estimate of the reduction in total shark numbers is provided, and factors such as stock identity and net avoidance are discussed. Turtle and teleost stocks do not appear to be threatened by net mortalities but marine mammalogists are investigating the sustainability of catches of two dolphin species. Certain batoids may have declined despite a high release rate, but more data are needed. A published contention that shark netting has resulted in a proliferation of small sharks through reduced predation is re-examined and considered to be exaggerated. Reduced predation on dolphins, as a result of shark netting, is estimated.},
  journal = {Environmental Biology of Fishes},
  keywords = {Anim,Animal,Animalia,animals,Behavior,Behavioral Biology/Animal Behavior [07003],Cetacea - Unspecified: Cetacea,Cetacea (Cetacea - Unspecified),cetaceans,Chelonia: Reptilia,Chondrichthyes (Chondrichthyes),Chondrichthyes [85202],Chondrichthyes: Pisces,Chorda,Chordata,chordates,Conservation,Delphinidae: Cetacea,dolphin (Delphinidae),Ecology,Environmental Biology/Wildlife Management-Aquatic,Ethiopian region),fish,General,General and Miscellaneous/Necrosis (197,General and Systematic Zoology/Mammalia,General and Systematic Zoology/Pisces [6,General and Systematic Zoology/Reptilia,General Biology/Conservation,General/Field Me,Herbicides [54600],Mammalia,mammals,Materials and Apparatus,Mathematical Biology and Statistical Methods [0450,Methods,Methods and Techniques,nonhuman mammals,nonhuman vertebrates,Osteichthyes: Pisces,Pathology,Pest Assessment Control and Management,Pest Control,Pesticides,reptiles,Resource Management,sea turtle (Chelonia),South Africa (Africa,Systematics and Taxonomy,teleost (Osteichthyes),Vertebra,Vertebrata,vertebrates,Wildlife Management (Conservation)},
  number = {3}
}

@article{Dudley1998,
  title = {Shark Control: {{Experimental}} Fishing with Baited Drumlines},
  author = {Dudley, S F J and Haestier, R C and Cox, K R and Murray, M},
  year = {1998},
  volume = {49},
  pages = {653--661},
  abstract = {Protective gill-nets (shark nets) have been successful in reducing the frequency of shark attacks on the coast of Kwazulu-Natal (KZN), South Africa, since 1952. This is achieved primarily through a local reduction in numbers of large sharks. Yet the nets are non-selective in terms of shark species caught and take a by-catch of dolphins, sea turtles, batoids and teleosts. Baited lines, or drumlines, as used in the Queensland shark control programme, were tested as possible alternatives to gill-nets. They demonstrated greater species selectivity for sharks and also a reduced by-catch of non-shark animals. The shark catch included the three species responsible for most shark attacks on the KZN coast, Carcharhinus leucas, Galeocerdo cuvier and Carcharodon carcharias. The probability of the bait being scavenged, or a shark being caught, was modelled in relation to a number of physical environmental factors. Although there was insufficient variability in the effort data for a quantitative comparison of catch rates between nets and drumlines, the results suggested that an optimal solution may be to deploy a combination of nets and drumlines.},
  journal = {Marine and Freshwater Research},
  keywords = {Africa,Anim,Animal,Animalia,Animals,batoid (Chondrichthyes),Carcharhinus leucas [bull shark] (Chondrichthyes),Carcharodon carcharias [great white shark] (Chondr,Cetaceans,Chelonia: Reptilia,Chondrichthyes [85202],Chondrichthyes: Pisces,Chorda,Chordata,Chordates,Delphinidae: Cetacea,dolphin (Delphinidae),Ecology,Environmental Biology/Wildlife Management-Aquatic,Ethiopian reg,Fish,Galeocerdo cuvier [tiger shark] (Chondrichthyes),General and Systematic Zoology/Mammalia,General and Systematic Zoology/Pisces [6,General and Systematic Zoology/Reptilia,General Biology/Conservation,KwaZulu-Natal (South Africa,Mammalia,Mammals,Methods and Techniques,Nonhuman Mammals,Nonhuman Vertebrates,Osteichthyes: Pisces,Reptiles,Resource Management,sea turtle (Chelonia),teleost (Osteichthyes),Vertebrata,Vertebrates,Wildlife Management (Conservation)},
  number = {7}
}

