@article{Lockyer1978a,
  title = {The History and Behavior of a Solitary Wild but Sociable Bottle-Nosed Dolphin Tursiops-Truncatus on the West Coast of England and Wales Uk},
  author = {Lockyer, C},
  year = {1978},
  volume = {12},
  pages = {513--528},
  abstract = {A description of the appearance, behavior and movements of a mature adult .male. wild bottlenose dolphin are given. The animal measured approximately 360 cm in length during May, 1976. The movements of the dolphin were traced to April 1972. Between then and March 1975 it was resident on the coastal areas around the Isle of Man. From April 1975-Jan. 1976 the dolphin had moved to and remained resident in the region around Milford Haven in Pembrokeshire. From Jan. 1976-Dec. 1976, the dolphin moved south again, and patrolled an area stretching from St. Ives on the north coast of Cornwall to Falmouth on the south coast of Cornwall, although during most of this time favored localities were St. Ives and Mousehole. All areas where it stayed for any length of time showed similarities, in that boating traffic, fishing activity, mooring buoys and usually diving and swimming activities were present. The bays were usually about 10 m deep or less, often with rocky shore and sandy bottom. Behavior included playing with boats, divers, swimmers and floating objects, interfering with boat propellors and outboard engines; indiscriminate sexual activity with boats; and a general sociable attitude to people. The dolphin was a solitary animal. The animal was believed to be healthy and normal, except for the unusual sociability with man.},
  journal = {Journal of Natural History},
  number = {5}
}

