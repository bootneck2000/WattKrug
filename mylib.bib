@article{Houston1990,
  title = {Status of Blainville's Beaked Whale Mesoplodon-Densirostris in Canada},
  author = {Houston, J},
  year = {1990},
  volume = {104},
  pages = {117--120},
  abstract = {Blainville's Beaked Whale, Mesoplodon densirostris, is widely, if thinly, distributed in tropical and subtropical waters and occurs irregularly off the east coast of Canada. It has yet to be reported from the west coast, although one stranding has been reported from northern California. The species appears to be more pelagic than other ziphiids and of no commercial interest. They are rare in Canadian waters.},
  journal = {Canadian Field-Naturalist},
  number = {1}
}

@article{Houston1990a,
  title = {Status of Hubbs' Beaked Whale Mesoplodon-Carlhubbsi in Canada},
  author = {Houston, J},
  year = {1990},
  volume = {104},
  pages = {121--124},
  abstract = {Hubbs' Beaked Whale, Mesoplodon carlhubbsi, is a rare member of the North Pacific fauna. The species is known from 31 stranded specimens and one possible live sighting. Most strandings have been along the North American coast from Prince Rupert, British Columbia to La Jolla, California. Four strandings are recorded from Ayukawa, Japan. The species is not known to have been, or to be, of interest to commercial fisheries and is probably protected by its rarity and occurrence in less frequented (by man) waters of the North Pacific.},
  journal = {Canadian Field-Naturalist},
  number = {1}
}

@article{Houston1990b,
  title = {Status of Stejneger's Beaked Whale Mesoplodon-Stejnegeri in Canada},
  author = {Houston, J},
  year = {1990},
  volume = {104},
  pages = {131--134},
  abstract = {Stejneger's Beaked Whale, Mesoplodon stejnegeri, is a medium-sized ziphiid of the North Pacific. The range extends from Japan to the North American coast between 50 to 60.degree. N. The species is known only from a few stranded specimens, although unsubstantiated sightings have been recorded from Japan and Washington State. The species is of no commercial interest and is rare in Canadian waters.},
  journal = {Canadian Field-Naturalist},
  number = {1}
