@article{Clark1997,
  title = {Young Whale Sharks, {{Rhincodon}} Typus, Feeding on a Copepod Bloom near {{La Paz}}, {{Mexico}}},
  author = {Clark, Eugenie and Nelson, Diane R},
  year = {1997},
  volume = {50},
  pages = {63--73},
  abstract = {Seven small (3.2 to 5.2 m total length) whale sharks were observed suction feeding on patches of surface plankton in the Bay of La Paz within 1 km of shore and 2 km N of the phosphate dock at San Juan de la Costa, on 1-2 November 1993. The sharks were photographed and videotaped from the boat and by snorkelers in the water. When actively feeding the shark turned its head from side to side, part of the head was lifted out of the water, and the mouth opened and closed 7 to 28 times per minute ( hivin x = 17, N = 13). These suction gulps were synchronized with the opening and closing of the gill slits. This feeding behavior occurred only in the patchy areas of densely cloudy water, a layer 10 to 30 cm thick at the surface containing an immense concentration of copepods, 95\% of which were identified as Acartia clausi. Remoras accompanying the whale sharks also fed on the plankton bloom.},
  journal = {Environmental Biology of Fishes},
  keywords = {Anim,animals. arthropods. chordates. crustaceans. fish.,Bay of La Paz. Behavior. La Paz. Plankton Bloom. P,Behavior. Ecology (Environmental Sciences). Estuar,Behavioral Biology/Animal Behavior [07003],Chondrichthyes [85202],Chondrichthyes: Pisces,Chordata,Copepoda [75110],Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography and Limnology [,Mexico (North America. Nearctic region).,Nutrition/General Studies,Nutritional Status and,Vertebrata,whale shark (Chondrichthyes). Acartia clausi (Cope},
  number = {1}
}

@article{Clark1997a,
  title = {Whales '95: {{A}} Combined Visual and Acoustic Survey of Blue and Fin Whales off Southern {{California}}},
  author = {Clark, Christopher W and Fristrup, Kurt M},
  year = {1997},
  volume = {0},
  pages = {583--600},
  abstract = {From 30 September to 19 October 1995, a combined visual and acoustic survey for whales was conducted off southern California. Visual survey methods, following accepted NMFS-Southwest Fisheries Science Center (NMFS-SWFSC) protocols and acoustic monitoring, using a 16 hydrophone, 1 km, towed horizontal line array (HLA), were successfully merged during two, approximately one-week cruises. Preliminary results are encouraging and indicate that the mechanics of integrating the HLA into a visual survey are practical. Despite the fact that the project was conducted relatively late in the season, 11 days of observation effort (118 hours, 696 n.miles) yielded sightings of 73 blue (Balaenoptera musculus), 87 fin (Balaenoptera physalus), 3 minke (Balaenoptera acutorostrata) and 2 humpback (Megaptera novaeangliae) whales and additional sightings of 84 unidentified large whales that were probably blue or fin whales. Over 274 hours of 16-channel HLA data were collected during 13 days when the HLA was operational, along with approximately 500 hours of additional passive acoustic data from three bottom-deployed hydrophone arrays (L-CHEAPOs and SOSUS). Based on 466 15-minute samples during periods of simultaneous visual and acoustic effort, blue whales were detected acoustically at least six times more often than visually and fin whales were detected acoustically at least three times more often than visually. Results from a normal mode, low-frequency propagation model (KRAKEN) indicate conservatively, that the acoustic detection range for these two species is at least three to four times that of the visual detection range.},
  journal = {Report of the International Whaling Commission},
  keywords = {[00512] General biology - Conservation and resourc,[07516] Ecology: environmental biology - Wildlife,[85810] Balaenopteridae,Balaenoptera-acutorostrata: minke whale [Balaenopt,Balaenoptera-musculus: blue whale [Balaenopteridae,Balaenoptera-physalus: fin whale [Balaenopteridae],Balaenopteridae: Animals,Cetacea,Cetaceans,Chordates,Ma,Mammalia,Megaptera-novaengliae: humpback whale [Balaenopter,Verteb,Wildlife Management: Conservation},
  number = {47}
}

@article{Clark1999,
  title = {Nursing Parameters in Captive Killer Whales ({{Orcinus}} Orca)},
  author = {Clark, S T and Odell, D K},
  year = {1999},
  volume = {18},
  pages = {373--384},
  abstract = {We examined nursing behaviors for a population of captive-born killer whales (four females, three males) at SeaWorld parks from birth until 90 days of age. Nursing parameters examined included cumulatives of suckles per day, bouts per day, and suckle duration (seconds) per day. Daily cumulatives of all nursing parameters peaked within the first 2 days after birth then decreased through time. For the ages from birth until 42 days, data were converted using log(e)-log(e) transformations to allow linear regression modeling. Since these parameters were characterized by autocorrelation, bootstrapping was used to obtain parameter estimates for comparisons between sexes and cow parity. Both males and females, as well as calves born to primiparous and multiparous cows, exhibited similar nursing patterns. However, there were statistically significant differences (alpha \textexclamdown{} 0.05) between the regression equations among most of the nursing parameters examined. Cumulative frequencies and amounts from birth through 42 days of age for all nursing parameters were examined. Means were statistically similar (alpha \textquestiondown{} 0.05) between genders (means[sd] for males and females, respectively; suckles 3,772.7[412.4] and 3,276.3[1,226.5]; bouts 1,238.3[189.0] and 1,103.3[96.4]; suckle duration [seconds] 28,990.7[5,861.9] and 29,233.0[5,255.0]) and cow parity (means[sd] for primiparous and multiparous, respectively; suckles 4,459.0[606.7] and 3,101.0[753.8]; bouts 1,240.0[243.3] and 1,129.6[116.2]; suckle duration [sec ends] 32,415.0[5,212.8] and 27,814.8[4854.5]). Equal amounts of nursing occurred from both left and right mammary glands for the 42-day time period (means[sd] [seconds] for left and right, respectively; 13,800.4[2,787.0] and 15,328.7[2,471.0]; P = 0.30). Zoo Biol 18:373-384, 1999. (C) 1999 Wiley-Liss, Inc. [References: 43]},
  journal = {Zoo Biology},
  keywords = {Animal Sciences in Current Contents(R)/Agricultura,Behavior,Born,Calves,Captive-born cetaceans,Dolphin tursiops-truncatus,Fallow deer,Growth,Lactation,Maternal investment,Metabolites,Milk-composition,Reproduction.,Sex.},
