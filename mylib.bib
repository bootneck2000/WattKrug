@article{Miyashita1993,
  title = {Abundance of Dolphin Stocks in the Western {{North Pacific}} Taken by the {{Japanese}} Drive Fishery},
  author = {Miyashita, Tomio},
  year = {1993},
  volume = {0},
  pages = {417--437},
  abstract = {This study examines the distribution and abundance of six dolphin stocks taken by the Japanese drive fishery in the western North Pacific using data obtained during 34 sighting cruises from 1983 to 1991. Population size by 5 degree square was estimated using August and September data and the line transect method. The total abundance was the sum of these estimates. The size of large schools, assumed to be aggregates of small schools, was replaced by the mean school size to reduce the upward bias in the mean school size estimate. Striped dolphins were sighted in the waters from 25 degree N-41 degree N and 135 degree E-180 degree in August and September and in three geographical concentrations. The total population in these areas was estimated at 570,000 (CV = 0.18). Spotted dolphins were seen in the waters from 25 degree N-38 degree N and west of 180 degree in August and September. and most sightings were concentrated north of 30 degree N. The total abundance was estimated at 438,000 (CV = 0.17). Bottlenose dolphins were seen in the waters from 30 degree N-42 degree N and west of 160 degree E in August and September. Total abundance was estimated as 168,000 (CV = 0.26). Risso's dolphins were seen in the waters south of 40 degree N and west of 180 degree but their southern boundary could not be determined from the present data. Three concentrated areas of Risso's dolphins were found. Total abundance in these areas was estimated at 838.000 (CV = 0.17). Southern form short-finned pilot whales were sighted from coastal to offshore waters west of 165 degree E in the latitudes 25 degree N-36 degree N in August and September. The total abundance was estimated at 53,000 (CV = 0.22). False killer whales were sighted in almost the same area as southern form short-finned pilot whales but their northern limit was situated at 39 degree N or about 3 degree to the north of the boundary of short-finned pilot whales. Total abundance was estimated as 16,000 (CV = 0.26).},
  journal = {Report of the International Whaling Commission},
  keywords = {Animal,animals,cetaceans,Chorda,Chordata,chordates,Delphinidae: Cetacea,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Environmental Sciences),false killer whale (Delphinidae),fish,General and Systematic Zoology/Pisces [6,Mammalia,mammals,Marine Ecology (Ecology,nonhuman mammals,nonhuman vertebrates,North Pacific (Pacific Ocean),Osteichthyes (Osteichthyes),Osteichthyes [85206],Osteichthyes: Pisces,pilot whale (Delphinidae),Risso's dolphin (Delphinidae),Systematics and Taxonomy,Vertebrata,vertebrates,Wildlife Management (Conservation)},
  number = {43}
}

@article{Miyashita1996,
  title = {Winter Distribution of Cetaceans in the Western {{North Pacific}} Inferred from Sighting Cruises 1993-1995},
  author = {Miyashita, Tomio and Kishiro, Toshiya and Higashi, Naoto and Sato, Fumihiko and Mori, Kyoichi and Kato, Hidehiro},
  year = {1996},
  volume = {46},
  pages = {437--441},
  abstract = {Six sightings cruises covering a total research distance of 10,896 n.miles took place in the western North Pacific and the eastern South China Sea in the winters of 1993-1995. A total of 18 species (including three mysticetes and 15 odontocetes) were seen. The cruises revealed that: (1) the northern boundary of Bryde's whale winter distribution in offshore waters coincided with the 20 degree C isotherm which is situated at about 28 degree N; (2) humpback whales occur only in the coastal shallow waters around the Ogasawara Islands and the Kerama Islands in Ryukyus; (3) sperm whales were the most commonly seen species and were found throughout the surveyed areas.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animal Distribution (1971- ) [62800],animals. cetaceans. chordates. mammals. nonhuman m,Balaenopteridae [85810],Balaenopteridae: Cetacea,Biogeography (Population Studies). Climatology (En,Ch,Chordata,Ecology,Environmental Biology/Bioclimatology and Biometeor,General and Systematic Zoology/Mammalia,humpback whale (Balaenopteridae). sperm whale (Phy,Mammalia,Mysticetes. North Pacific Ocean. Odontocetes. Sout,Physeteridae [85830],Vertebrata}
}

@article{Miyazaki1978,
  title = {Observation of Cetacea during Whale Marking Cruise in the Western Tropical Pacific 1976},
  author = {Miyazaki, N and Wada, S},
  year = {1978},
  pages = {179--196},
  abstract = {From Jan. 20 to March 19, 1976, whale marking and sighting were carried out in the western tropical Pacific. Schools (103) of 13 spp. from 11 genera were sighted, and 15 specimens of 3 spp. from 4 genera were collected. Observations of these 103 schools were made and the biology of these 15 specimens studied. [Species discussed included; Balaenoptera edeni, Physeter catodon, Stenella coeruleoalba, S. attenuata, S. longirostris, Stenella sp., Tursiops sp., Lagenodelphis hosei, Peponocephala electra, Pseudorca crassidens, Orcinus orea, Grampus griseus, Globicephala macrorhynchus, Feresa attenuata and Ziphius caviostris.].},
