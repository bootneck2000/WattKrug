@article{Gilmartin1993a,
  title = {Survival Rates for the {{Hawaiian}} Monk Seal ({{Monachus}} Schauinslandi)},
  author = {Gilmartin, William G and Johanos, Thea C and Eberhardt, L Lee},
  year = {1993},
  volume = {9},
  pages = {407--420},
  abstract = {Endangered Hawaiian monk seal (Monachus schauinslandi) pups at all the major breeding islands in the Northwestern Hawaiian Islands have been tagged since the early 1980s. Pups were double flipper tagged as soon as possible post-weaning. With few exceptions, an extensive tag resighting effort was conducted annually at the same islands. These resighting data were used to estimate seal survival rates from the time of tagging to age one at all locations using the ratio of seals alive in the second year to number of pups tagged. These survival rates among the islands, from weaning to age one, averaged over the years of the study, ranged from 0.80 to 0.90. For young seals over age one, capture-recapture methods were used to calculate survival pooled through several years, and these rates ranged from 0.85 to 0.98. At French Frigate Shoals and Laysan Island, the higher numbers of tagged pups allowed separate estimates of male and female survival to be calculated. These rates suggested that survival of immature females was better than males. Beginning in 1989, survival of immature seals at French Frigate Shoals declined sharply.},
  isbn = {0824-0469},
  keywords = {Hawaiian monk seal/Monachus schauinslandi/survival,PBS Record: 552},
