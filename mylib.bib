@article{Hays2007,
  title = {Recording the Free-Living Behaviour of Small-Bodied, Shallow-Diving Animals with Data Loggers},
  author = {Hays, G C and Forman, D W and Harrington, L A and Harrington, A L and MacDonald, D W and Righton, D},
  year = {2007},
  volume = {76},
  pages = {183--190},
  doi = {10.1111/j.1365-2656.2006.01181.x},
  abstract = {Time-depth data recorders (TDRs) have been widely used to explore the behaviour of relatively large, deep divers. However, little is known about the dive behaviour of small, shallow divers such as semi-aquatic mammals. We used high-resolution TDRs to record the diving behaviour of American mink Mustela vison (weight of individuals 580-1275 g) in rivers in Oxfordshire (UK) between December 2005 and March 2006. Dives to \textquestiondown{} 0.2 m were measured in all individuals (n = 6). Modal dive depth and duration were 0.3 m and 10 s, respectively, although dives up to 3 m and 60 s in duration were recorded. Dive duration increased with dive depth. Temperature data recorded by TDRs covaried with diving behaviour: they were relatively cold (modal temperature 4-6 degrees C across individuals) when mink were diving and relatively warm (modal temperature 24-36 degrees C across individuals) when mink were not diving. Individuals differed hugely in their use of rivers, reflecting foraging plasticity across both terrestrial and aquatic environments. For some individuals there was \textexclamdown{} 1 dive per day while for others there was \textquestiondown{} 100 dives per day. We have shown it is now possible to record the diving behaviour of small free-living animals that only dive a few tens of centimetres, opening up the way for a new range of TDR studies on shallow diving species.},
  isbn = {0021-8790},
  journal = {Journal of Animal Ecology},
  keywords = {AMERICAN MINK,BASKING SHARK,COMPETITION,DIEL VERTICAL MIGRATION,DIVE,HABITAT,HEART-RATE,invasive species,LUTRA-LUTRA,MINK MUSTELA-VISON,otter,PROFILES,SATELLITE,seal,semi-aquatic,small mammal},
  language = {English},
  number = {1}
}

