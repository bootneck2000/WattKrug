@article{Arnould1997,
  title = {The Cost and Benefits of Territorial Tenure, and Factors Affecting Mating Success in Male {{Antarctic}} Fur Seals},
  author = {Arnould, John PY and Duck, Callan Duck},
  year = {1997},
  volume = {241},
  pages = {649--664},
  issn = {09528369},
  doi = {10.1111/j.1469-7998.1997.tb05739.x},
  abstract = {The timing, location and duration of territorial tenure, and the mating success and return rates of male Antarctic fur seals (Arctocephalus gazella) were measured over four consecutive breeding seasons (1984\textendash 87) on Bird Island (54\textdegree 00'S, 38\textdegree 02'W), South Georgia. Tenure duration (days) followed a heavily skewed, Poisson-like distribution (median 13.08 days, maximum 75 days) and was positively related to the number of years of tenure (rs= 0.52, P \textexclamdown{} 0.0001). Mating success was also biased to a few individuals and was positively correlated to both duration of tenure (days) and the previous number of years in which tenure was achieved (P \textexclamdown{} 0.0001 in both cases). The timing and location of territorial tenure had no measurable effect on mating success (P \textquestiondown{} 0.05 in both cases). The probability of a male returning to hold a territory in the next year was not related to the number of years tenure that had been achieved (P \textquestiondown{} 0.7) or to the level of mating success in the current year (P \textquestiondown{} 0.15). It was, however, positively related to the duration of tenure in the current year (P \textexclamdown{} 0.0001). The overall annual return rate was 43\% which is not significantly different from the survival rate for the general male population and suggests that territorial tenure does not contribute to increased mortality in male Antarctic fur seals.},
  journal = {Journal of Zoology},
  keywords = {5562,Arctocephalus gazella,behaviour,reproduction},
  mendeley-tags = {5562},
  number = {4}
}

@article{Arnould1997a,
  title = {Lactation and the Cost of Pup-Rearing in Antarctic Fur Seals},
  author = {Arnould, John Py},
  year = {1997},
  volume = {13},
  pages = {516--526},
  issn = {0824-0469},
  doi = {10.1111/j.1748-7692.1997.tb00662.x},
  abstract = {An attempt was made to develop simple, inexpensive, rapid means of determining body composition in Antarctic fur seals (Arctocephalus gazella). Measurements of total body water (TBW) and total body lipid (TBL), obtained by hydrogen isotope dilution, were compared to the results of bioelectrical impedance analysis (BIA) and morphometric indices of body condition in 52 adult females. TBW was weakly correlated with BIA measurements of resistance (r = -0.30, P \textexclamdown{} 0.03). Conductor volume (length(2)/resistance) was more highly correlated with TBW(r = 0.75, P \textexclamdown{} 0.0001) and the inclusion of mass into the predictive equation improved the correlation further (r = 0.95, P \textexclamdown{} 0.0001). A body condition index (mass/length) previously used in pinniped studies was positively correlated to TBL (r = 0.77, P \textexclamdown{} 0.0001) validating its use as a relative index of condition. However, body mass alone was highly correlated to TBW (r = 0.94, P \textexclamdown{} 0.0001) and appears to provide a simple, rapid means of estimating body composition in adult females. This technique may also be applicable to juvenile male Antarctic fur seals.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {5242,Arctocephalus gazella,Carnivora,Costs,Energetic cost,Lactation,Mammalia,Parental care,Parental investment,PBS Record: 843,Pinnipedia,Reproduction,South Georgia,Vertebrata},
  mendeley-tags = {5242,PBS Record: 843},
  number = {3},
  pmid = {6496}
}

@article{Arnould1999,
  title = {The Composition of Australian Fur Seal (Arctocephalus Pusillus Doriferus) Milk throughout Lactation},
  author = {Arnould, John P Y and Hindell, Mark A},
  year = {1999},
  edition = {1999/10/16},
  volume = {72},
  pages = {605--612},
  issn = {1522-2152},
  doi = {10.1086/316702},
  abstract = {The proximate chemical composition of milk was determined throughout lactation in the Australian fur seal (Arctocephalus pusillus doriferus Wood Jones), a temperate species with an 11-mo lactation period typical of most temperate otariids. Average lipid and protein contents were 42\% and 10\%, respectively, which is similar to that recorded for the polar otariid species but higher than reported in other temperate, long-lactation species. Milk composition, however, varied substantially throughout lactation, with lipid content rising from 30\% soon after parturition to 50\% at 230 d postpartum before decreasing to 45\% toward weaning. The trend in water content was op-posite to that of lipid, while protein content increased only slightly during lactation from 10\% to 12\%. The peak in lipid content occurred at approximately 70\% of the way through lactation, similar to that found in the Australian sea lion and several phocid seal species. Significant positive relationships were found between milk lipid content and both the duration of the preceding foraging trip and body mass. A highly signif-icant and close correlation was found between milk water and lipid contents such that gross energy content may be accurately predicted from water content alone. Similar predictive equa-tions have been found for several other otariid and phocid species, but these appear to differ between phylogenetic groups.},
  isbn = {1522-2152},
  journal = {Physiological and Biochemical Zoology},
  keywords = {2000 week 02,6590,Animal Sciences in Current Contents(R)/Agricultura,Animals,Arctocephalus pusillus,Australia,Body Composition,Energetics.,Environmental Sciences,Fatty-acid signatures. Halichoerus-grypus. Energy-,Female,Fur Seals/*physiology,lactation,Lactation/*physiology,Lipids/analysis,Marine Mammal Res Grp,milk,Milk Proteins/analysis,Milk/*chemistry,Mirounga-leonina. Elephant seal. Growth. Gazella.,NSW 2109,Physiology in Current Contents(R)/Life Sciences.,Reprint available from: Arnould JPY. Macquarie Uni,Sydney,Temperature,Water/analysis},
  language = {English},
  mendeley-tags = {6590},
  number = {5},
  pmid = {10521328}
}

