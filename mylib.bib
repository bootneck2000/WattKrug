@article{Sauter2013,
  title = {Continuous Exhumation of Mantle-Derived Rocks at the {{Southwest Indian Ridge}} for 11 Million Years},
  author = {Sauter, Daniel and Cannat, Mathilde and Roum{\'e}jon, St{\'e}phane and Andreani, Muriel and Birot, Dominique and Bronner, Adrien and Brunelli, Daniele and Carlut, Julie and Delacour, Ad{\'e}lie and Guyader, Vivien and MacLeod, Christopher J. and Manatschal, Gianreto and Mendel, V{\'e}ronique and M{\'e}nez, B{\'e}n{\'e}dicte and Pasini, Valerio and Ruellan, Etienne and Searle, Roger},
  year = {2013},
  volume = {6},
  pages = {314--320},
  issn = {17520894},
  doi = {10.1038/ngeo1771},
  abstract = {The global mid-ocean ridge system, where tectonic plates diverge, is traditionally thought of as the largest single volcanic feature on the Earth. Yet, wide expanses of smooth sea floor in the easternmost part of the Southwest Indian Ridge in the Indian Ocean lacks the hummocky morphology that is typical for submarine volcanism. At other slow-spreading ridges, the sea floor can extend by faulting the existing lithosphere, along only one side of the ridge axis. However, the smooth sea floor in the easternmost Southwest Indian Ridge also lacks the corrugated texture created by such faulting. Instead, the sea floor is smooth on both sides of the ridge axis and is thought to be composed of altered mantle-derived rocks. Here we use side-scan sonar to image the sea floor and dredge samples to analyse the composition of two sections of the Southwest Indian Ridge, between 6205{${'}$} E and 6440{${'}$} E, where the sea floor formed over the past 11 million years. We show that the smooth floor is almost entirely composed of seawater-altered mantle-derived rocks that were brought to the surface by large detachment faults on both sides of the ridge axis. Faulting accommodates almost 100\% of plate divergence and the detachment faults have repeatedly flipped polarity. We suggest that this tectonic process could also explain the exhumation of mantle-derived rocks at the magma-poor margins of rifted continents. \textcopyright{} 2013 Macmillan Publishers Limited. All rights reserved.},
  journal = {Nature Geoscience},
  number = {4}
}

