@article{Anderson1985,
  title = {Grey Seal Males: Energetic and Behavioural Links between Size and Sexual Success},
  author = {Anderson, Sheila S. and Fedak, Michael A.},
  year = {1985},
  volume = {33},
  pages = {829--838},
  publisher = {{Natural Environmental Research Council Sea Mammal Research Unit. c/o British Antarctic Survey}},
  address = {{Cambridge}},
  issn = {00033472},
  doi = {10.1016/S0003-3472(85)80017-8},
  abstract = {The costs of breeding in male grey seals (Halichoerus grypus) have been estimated by repeated weighings of animals on the breeding grounds. Individual variations in male size and rate of weight loss were positively correlated with measures of sexual behaviour. Grey seal males did not form a linear dominance hierarchy, nor were they of equal status, but large males lost few encounters. Finite resources set a limit on the time that can be spent ashore being sexually active. These limits can be predicted using the collected data on size and energy use, and the results emphasize the significance of large size in relation to breeding success in grey seal males. The largest males may on average sire 10 times as many offspring as the smallest breeding males. ?? 1985.},
  isbn = {0003-3472},
  journal = {Animal Behaviour},
  keywords = {3516,640,behaviour,breeding,breeding behaviour,drugging,energetics,Grey,growth curves,Halichoerus grypus,mass loss,reproductive success,Seals,socioecology},
