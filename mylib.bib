@article{Cuyler1992,
  title = {Thermal Infrared Radiation from Free Living Whales},
  author = {Cuyler, L C and Wiulsr{\o}d, R and A., {\O}ritsland N and {\O}ritsland, N A},
  year = {1992},
  volume = {8},
  pages = {120--134},
  abstract = {As part of a search for new detection techniques, and for obtaining information on whale surface temperatures, an Agema Thermovision 880 thermal imaging system was used to detect thermal infrared radiation from whales. The study took place along the northern coast of Norway and the northwest coast of Svalbard (68\textdegree{} to 80\textdegree{} N latitude). The emphasis of the study was on minke whales, but humpback, fin, blue and sperm whales were also observed. The apparent radiation temperature was strongly dependent on sea conditions, signal angle, and atmospheric interference; detection depended thus upon weather. During the study, sea surface temperatures varied as much as 7\textdegree C, but the sea and minke whale body trunk surfaces were usually within 0.0\textdegree{} to 0.1\textdegree C of each other. The other species observed had temperature differences of 0.0\textdegree{} to 1.0\textdegree C relative to the sea surface. Temperature differences between sea water and whale appendages ranged from 0.0\textdegree{} to 6.0\textdegree C. The indicated maximum difference between sea water and blow (i.e., expired air) was 4.0\textdegree C, while the maximum difference for the blowhole was 4. 1\textdegree C. The results from all whales observed support the belief that the main body trunk is normally not a heat window, this function being reserved for the appendages. However, the results also indicate a regulated dermal blood flow determining heat loss from the body trunk. Detection of whales by thermal infrared radiation from the body trunk appears unreliable; in contrast, the blow and blowhole provided a consistent positive signal with apparent temperature differences to the surroundings ranging from 0. 2\textdegree{} to 4.1\textdegree C.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {900,Balaenoptera acutorostrata,Balaenoptera musculus,Balaenoptera physalus,cetacean/whale/infrared/detection/blow temperature,Megaptera novaeangliae,PBS Record: 446,Physeter macrocephalus,surface temperature},
  mendeley-tags = {900,PBS Record: 446},
  number = {2}
}

