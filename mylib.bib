@article{Kooyman2007,
  title = {Animal-Borne Instrumentation Systems and the Animals That Bear Them: {{Then}} (1939) and Now (2007)},
  author = {Kooyman, G L},
  year = {2007},
  volume = {41},
  pages = {6--8},
  abstract = {The history of animal-borne instrumentation is reviewed from the first basic depth gauge invented in the late 1800s, to the complex animal-borne imagery and archival systems of the present day. A major breakthrough occurred in 1964 when the first time-depth recorder was deployed on a Weddell Seal in McMurdo Sound, Antarctica. The next phase in the study of animals at sea was the use of microprocessors as archival recorders in the mid-1980s. These also were first attached to Weddell seals to McMurdo Sound. Microprocessor technology made possible the next major step of attaching a video camera housed in a submersible case (CRITTERCAM) to a loggerhead turtle. Since the 1990s the field of "Biologging" has flourished, with new additions of satellite and GPS tracking, and resulted in three major international symposiums in the past four years (2003-2007).},
  isbn = {0025-3324},
  journal = {Marine Technology Society Journal},
  keywords = {10337,DIVING BEHAVIOR,FORAGING BEHAVIOR,ICE,instrumentation},
  language = {English},
  mendeley-tags = {10337},
