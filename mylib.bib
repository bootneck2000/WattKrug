@article{Bjørke2001,
  title = {Predators of the Squid {{Gonatus}} Fabricii ({{Lichtenstein}}) in the {{Norwegian Sea}}.},
  author = {Bj{\o}rke, H and Bjorke, Herman},
  year = {2001},
  volume = {52},
  pages = {113--120},
  abstract = {Gonatus fabricii is the most abundant squid of the Arctic and sub-Arctic waters of the North Atlantic and, during the summer months, young specimens can be found in the upper 60 m over large areas of the Norwegian Sea. In the summer of 1994, the biomass of young G. fabricii in this area was calculated to be at least 1.5 million tons. When the young squids reach a mantle length (ML) of 50-60 mm, they disappear from the surface and can be found at depths greater than 400 m. The life span of both sexes probably does not exceed 2 years, and the largest specimen ever recorded was a female of 385 mm ML. The biomass production of this species represents a considerable food resource and their consumption by known predators such as sperm whales (Physeter macrocephalus), northern bottlenose whales (Hyperoodon ampullatus), long-finned pilot whales (Globicephala melaena) and hooded seals (Cystophora cristata) is discussed. It is concluded that the distribution of G. fabricii in the Norwegian Sea and its importance as food for sperm whales and northern bottlenose whales could, to a great extent, explain the presence of these species in the Norwegian Sea.},
  journal = {Fisheries Research},
  keywords = {7142,Animalia,Animals,Cephalopoda [61100],Cephalopoda: Mollusca,Cetaceans,Chord,Chorda,Chordata,Chordates,Comparative and Experimental Morphol,Cystophora cristata,Cystophora cristata [hooded seal] (Phocidae): pred,Delphinidae: Cetacea,diet,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Sciences),Globicephala melaena [long-finned pilot whale] (De,Gonatus fabricii (Cephalopoda): female,Hyperoodon ampullatus [northern bottlenose whale],Invertebrata,Invertebrates,male,Mammalia,Mammals,mantle: length,Marine Ecology (Ecology,Mollusks,Nonhuman Mammals,Nonhuman Vertebrates,Norwegian Sea (Arctic Ocean),Phocidae: Pinnipedia,Physeter macrocephalus [sperm whale] (Physeteridae,Physeteridae: Cetacea,Pinnipeds,prey,stomach content analyses,Vertebrata,Vertebrates,Ziphiidae: Cetacea},
