@article{Veuger2005,
  title = {Analysis of {{N}}-15 Incorporation into {{D}}-Alanine: {{A}} New Method for Tracing Nitrogen Uptake by Bacteria},
  author = {Veuger, B and Middelburg, J J and Boschker, H T S and Houtekamer, M},
  year = {2005},
  volume = {3},
  pages = {230--240},
  abstract = {The quantitative contribution of bacteria to total microbial uptake of nitrogenous substrates is an aspect of the aquatic nitrogen cycle that is still largely unclear, mainly because existing methods are generally inadequate. We investigated the feasibility of measuring N-15 incorporation into bacterial D-amino acids by gas chromatography-combustion-isotope ratio mass spectrometry (GC-c-IRMS) and the potential of this method as a new tool for quantification of N-15 uptake by bacteria. The presented method allowed analysis of N-15 incorporation into various hydrolysable amino acids (HAAs), including the bacterial biomarker D-alanine (D-Ala), at trace levels. The potential of the method was tested in a N-15 labeling experiment in which sediment slurries were incubated with (NH4+)-N-15 and a N-15-labeled amino acid mixture. N-15 incorporation into D-Ala was used to calculate total bacterial N-15 uptake while comparison of N-15 incorporation into D-Ala versus L-Ala provided a direct measure for the relative contributions of bacteria versus algae to the total microbial N-15 uptake. Subsequently, it was also possible to calculate N-15 uptake by algae. Results for the test experiment showed that bacteria accounted for 38\% of total (NH4+)-N-15 uptake and dominated uptake of the N-15-amino acid mixture (90\%). Analysis of N-15 incorporation into other (non-biomarker) HAAs yielded useful additional information on the transformation of these HAAs during organic matter degradation. In conclusion, GC-c-IRMS analysis of D-Ala combined with N-15 labeling is a unique approach in aquatic sciences that provides a powerful new method for quantification of nitrogen flows through bacteria in natural microbial communities.},
  journal = {Limnology and Oceanography-Methods},
  keywords = {AMINO-ACID ENANTIOMERS,CELL-WALL,DISSOLVED ORGANIC,GAS-CHROMATOGRAPHY,HETEROTROPHIC BACTERIA,IONIZATION MASS-SPECTROMETRY,ISOTOPIC COMPOSITION,MARINE-ENVIRONMENT,MICROBIAL ECOLOGY,NITROGEN,STABLE-ISOTOPES},
  language = {English}
}

@article{Vialatte2006,
  title = {Tracing Individual Movements of Aphids Reveals Preferential Routes of Population Transfers in Agroecosystems},
  author = {Vialatte, A and Simon, J C and Dedryver, C A and Fabre, F and Plantegenest, M},
  year = {2006},
  volume = {16},
  pages = {839--844},
  abstract = {Agricultural pests are not restricted to crops, but often simultaneously or successively use different cultivated and uncultivated hosts. Nevertheless, the source-sink role of cultivated and uncultivated habitats in the life cycle of crop pests remains poorly understood. This is largely due to the difficulty of tracking displacements of small organisms in agricultural landscapes. We used stable-isotope ratios in order to infer the natal host plant of individuals of the English grain aphid Sitobion avenae colonizing wheat fields in autumn. We showed that among the numerous plant sources of S. avenae, maize, which has been intensively grown in western France since the 1960s, provided most aphids that attack wheat fields early in autumn. This study illustrates how insect pests respond to land-use changes within a relatively short period of time, rapidly acquiring a new host that in turn affected their population biology considerably by playing a pivotal role on their annual life cycle.},
  isbn = {1051-0761},
  journal = {Ecological Applications},
  keywords = {aphid movement,CEREAL APHIDS,DIFFERENTIATION,ECOLOGICAL SPECIALIZATION,ecology,EUROPEAN CORN-BORER,GENETIC,host specialization,insect migration,land-use changes,landscape,MONARCH BUTTERFLIES,MULTILOCUS (GATA)(4) PROBE,NATAL ORIGINS,pest management,Sitobion avenae,SITOBION-AVENAE,SOUTHERN ENGLAND,STABLE-ISOTOPE,stable-isotope ratios},
  language = {English},
  number = {3}
}

