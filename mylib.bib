@article{Zeh1991,
  title = {Rate of Increase, 1978-1988, of Bowhead Whales, {{Balaena}} Mysticetus, Estimated from Ice-Based Census Data},
  author = {Zeh, Judith E and George, John C and Raftery, Adrian E and Carroll, Geoffry M},
