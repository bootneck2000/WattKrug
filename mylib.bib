@article{Perrin2003b,
  title = {Sexual Ecology of the Spinner Dolphin, {{Stenella}} Longirostris: {{Geographic}} Variation in Mating System},
  author = {Perrin, William F and Mesnick, Sarah L},
  year = {2003},
  volume = {19},
  pages = {462--483},
  abstract = {We offer the first report for a cetacean of geographical variation in mating system based in morphology. Analysis of samples from 1,678 male spinner dolphins from the eastern Pacific revealed that testis + epididymis weight was greater (to 1,354 g) in the whitebelly form of the species than in the eastern form (to 843 g). Sexual dimorphism in dorsal-fin shape is greater in the eastern form. The difference in testis size was strongly linked with shape of the dorsal fin on an individual basis. Only a few eastern males (0.6\%) reached testis + epididymis weight at which all epididymides contain sperm, while a much larger proportion of whitebelly spinners (15.2\%) reached this level, suggesting that a smaller proportion of eastern spinner males may participate in reproductive activity. This, and the fact that increased dimorphism and decreased testis size are indicative of increased polygyny in a wide variety of other mammal species, leads to the conclusion that the mating system varies geographically in the species, with a gradient from a more polygynous mating system in the eastern form to a more open or polygynandrous mating system in the whitebelly form. Differences in ovulation rate in the two forms are consistent with this conclusion.},
  journal = {Marine Mammal Science},
  keywords = {[16504] Reproductive system - Physiology and bioch,geographic variation,geographical variation,mating system,polygynandry,polygyny,Reproductive System: Reproduction,sexual dimorphism,sperm: reproductive system,testes: reproductive system},
  number = {3}
}

