@article{Eyre1995,
  title = {Observations of Cetaceans in the Indian Ocean Whale Sanctuary, May-July 1993},
  author = {Eyre, Elizabeth J},
  year = {1995},
  volume = {0},
  pages = {419--426},
  abstract = {A cetacean sighting survey in the Indian Ocean Sanctuary was conducted by Greenpeace during the 1993 austral autumn and winter aboard the sailing vessel the SV Rainbow Warrior. Over 45 days 9.165 nautical miles were covered within the Sanctuary from 130 degree E to Port Suez and 109 sightings were recorded. One hundred and thirty-five sightings were made during the transit from Sydney to Malta. Species seen during the voyage include Bryde's, sperm, blue, minke and killer whales and bottlenose, common. Indo-Pacific humpback, Risso's, rough-toothed, spinner, spotted and striped dolphins. Areas providing the greatest number of sightings include south of Java, northwest of the Seychelles, the Gulf of Aden and the Red Sea. Distribution, behaviour and interspecies associations were examined and general conditions within the Sanctuary were assessed from daily debris surveys and observations of high seas fisheries.},
