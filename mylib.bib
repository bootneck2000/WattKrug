@article{Botha2004,
  title = {Development and Application of Molecular {{DNA}} Markers in {{Africa}}: A {{South African}} View},
  author = {Botha, A M and Venter, E and {van der Vyver}, C and Kunert, K J},
  year = {2004},
  volume = {70},
  pages = {152--166},
  abstract = {The development of molecular DNA markers for genetic analysis has greatly increased our understanding of the structure and behaviour of plant genomes. Different DNA marker technologies exist, however, information suggests that restriction fragment polymorphisms, amplified fragment length polymorphisms and also microsatellites are currently the most effective techniques for the detection of polymorphisms in plant genomes. Several other technologies, such as cDNA-amplified fragment length polymorphism, representational difference analysis or suppression subtractive hybridisation analysis, and cDNA microarrays, belong to a range of novel techniques very useful for the analysis of transcriptome variation, under specific stressful environmental conditions. However, the application of these technologies especially in Africa is not trivial, as execution of these techniques is largely dependent upon the availability of a technological advanced infrastructure, technical skills in plant molecular biology and substantial funding of the research groups involved in this type of research. Different molecular DNA-based marker techniques and their application to genome analysis and molecular breeding, and suitability for use in Africa, are discussed in this review.},
  isbn = {0254-6299},
  journal = {South African Journal of Botany},
  keywords = {DATA,GRAY LEAF-SPOT,HUMAN GENOME,LARGE-SCALE,MICROARRAY,QUANTITATIVE TRAIT LOCI,RAPD MARKERS,REPRESENTATIONAL DIFFERENCE ANALYSIS,RESISTANCE GENES,RNA EXPRESSION,SINGLE-NUCLEOTIDE POLYMORPHISMS},
  language = {English},
  number = {1}
}

@article{Botha2005,
  title = {Stable Isotope Composition of Faeces as an Indicator of Seasonal Diet Selection in Wild Herbivores in Southern {{Africa}}},
  author = {Botha, M S and Stock, W D},
  year = {2005},
  volume = {101},
  pages = {371--374},
  abstract = {We used stable carbon isotopes and nitrogen contents of faeces to investigate diet selection differences among wild grazers, browsers and mixed-feeders at seasonal intervals across a year in the Hluhluwe-Umfolozi Park, South Africa. Faecal delta(13)C values showed that wildebeest and warthog selected predominantly C-4 plant material throughout the year. Impala ingested significantly more C-3 plant material during the winter months than in all other months. Nyala also ingested more browse during winter. The nitrogen content of wildebeest faeces was significantly lower in winter than in summer, suggesting a possible decline in diet quality during the dry winter months. No significant seasonal trend in faecal nitrogen content was evident for nyala or warthog. Nitrogen contents of impala faeces were significantly higher in spring than in other seasons. Faecal isotopic and nutrient content analyses appear to be useful indicators of short-term diet selection and nutritional status of free-ranging herbivores. Analyses show resource partitioning among the different herbivores at finer time resolutions than can be obtained from bone collagen or isotopic analysis of tooth enamel.},
  isbn = {0038-2353},
  journal = {South African Journal of Science},
  keywords = {BROWSING RUMINANTS,ECOLOGY,FOOD SELECTION,HAIR,IMPALA AEPYCEROS-MELAMPUS,PLANTS,PROTEIN,QUALITY,SAVANNA,TANNINS},
  language = {English},
  number = {7-8}
}

