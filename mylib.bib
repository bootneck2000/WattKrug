@article{Wursig1997,
  title = {Dusky Dolphins ({{Lagenorhynchus}} Obscurus) off {{New Zealand}}: {{Status}} of Present Knowledge},
  author = {Wursig, B and Cipriano, F and Slooten, E and Constantine, R and Barr, K and Yin, S},
  year = {1997},
  volume = {0},
  pages = {715--722},
  abstract = {Dusky dolphins (Lagenorhynchus obscurus) occur in New Zealand waters off much of the South Island, the lower part of the North Island, the sub-Antarctic islands of Campbell and Auckland and over the extensive Chatham Rise to the east of the South island. As in southwestern Africa, South America and several South Atlantic and Indian Ocean islands, they do not appear to occur over oceanic waters deeper than 2,000 metres. Most research in New Zealand has taken place since 1984, on the east coast of the South Island near the Kaikoura Peninsula. Group sizes generally vary between 40 and 200; but groups with well over 1,000 individuals occur in April-May. Feeding is mainly on deep-water prey such as lantern fish and squid, largely at night. Nearshore daytime activity is related to resting, socialising and predator avoidance. Mothers and new-born young are found in especially shallow and nearshore waters. Births tend to occur in early summer, from mid-November to mid-January. Age at first reproduction is 7-8 years, when dolphins are 160-165cm long. Maximum sizes of males and females average 175cm, smaller than the dusky dolphins found off southwest Africa and Peru. Dusky dolphins form multi-species groups with short-beaked common dolphins (Delphinus delphis) in summer, but do not appear to interact with the Hector's dolphins (Cephalorhynchus hectori) that occur in nearshore waters. They are preyed upon by killer whales (Orcinus orca) and flee by rapid swimming or by hiding in the surf zone or tidal shallows. Commercial dolphin watching and swim-with-dolphin operations started in the late 1980s and are a major industry in Kaikoura. During summer, boats approach the same dolphin groups throughout the day. While there are behavioural reactions by the dolphins, no large-scale or long-term adverse reactions to human tourism have been documented to date. It is presently unknown whether more subtle chronic effects could be detrimental to the population(s). Genetic analyses indicate that the genus Lagenorhynchus is more diverse than had been believed from morphological studies and the genus is likely a paraphyletic assemblage of species in need of taxonomic revision. Population definitions and numbers are unknown for New Zealand and intensive photo-identification, genetic and survey studies are recommended. Bycatch in gillnets occurs at an unknown level and needs to be investigated. Long-term data are needed on human tourism effects. No recent data exist on bio-accumulated pollutant levels in dusky dolphins and this avenue of research is also seen as important.},
  journal = {Report of the International Whaling Commission},
  number = {47}
}

