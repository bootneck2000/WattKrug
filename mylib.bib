@misc{Aarseth1999,
  title = {The Effect of Body Fat on Basal Metabolic Rate in Adult Harp Seals ({{Phoca}} Groenlandica)},
  author = {Aarseth, J J and Nord{\o}y, E S and Blix, A S},
  year = {1999},
  volume = {124},
  pages = {69--72},
  issn = {1095-6433},
  doi = {10.1016/S1095-6433(99)00091-4},
  abstract = {Three adult harp seals (Phoca groenlandica) were fed different daily amounts of capelin (Mallotus 6illosus), and their body composition determined by use of the tritiated water method at different levels of fattening. Basal metabolic rate (BMR) was measured after 5 days of fasting by indirect calorimetry, and was on average 1.1 W\textperiodcentered kg - 1 when 45\% of body mass (BM) was fat and 2.3 W\textperiodcentered kg - 1 when body fat was reduced to 13\% of BM. This suggests that body fat contributes little to BMR in these animals. It follows, that predictions of BMR on the basis of BM is questionable in seals, in which body fat may change seasonally between 20 and 60\% of BM.},
  isbn = {4777644855},
  journal = {Comparative biochemistry and physiology part a},
  keywords = {6460,Adipose tissue,Body composition,Fasting,Lean body mass,Metabolism,O 2 consumption,Pinnipeds,Tritiated water},
  mendeley-tags = {6460},
  pmid = {10605069}
}

