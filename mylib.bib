@article{Walker2008,
  title = {Evidence for Habitat Fragmentation Altering Within-Population Processes in Wombats},
  author = {Walker, F M and Sunnucks, P and Taylor, A C},
  year = {2008},
  volume = {17},
  pages = {1674--1684},
  doi = {10.1111/j.1365-294X.2008.03701.x},
  abstract = {Habitat fragmentation and associated reduced dispersal of wildlife can lead to an accumulation of related individuals in fragments. The altered kin interactions and amplified chance of inbred matings has profound implications for mating and social systems, and ultimately population persistence. Nonetheless, within-fragment population processes are rarely studied. With this aim, we examined relatedness structure in two candidate isolated populations (Kulpara and Scrubby Peak) of southern hairy-nosed wombats (Lasiorhinus latifrons). Wombats were sampled by remote hair-trapping for genotyping at 14 microsatellite loci, enabling individual identification and estimation of space-use and associative behaviour with respect to relatedness. Genetic data indicated that Scrubby Peak was not strongly isolated, against predictions from landscape structure and history. In isolated Kulpara, inhibited female dispersal (normally the dispersing sex) was associated with high population density and altered kin relationships. First, female relatives preferentially coexisted, a radical departure from the previously reported active avoidance of female relatives in continuous habitat. This is consistent with females in altered habitat interacting with more- rather than less-related females to minimize the cost:benefit ratio of proximity to other wombats. Second, inbreeding avoidance appeared to be stronger at Kulpara than in conspecific populations with natural population structures. Although these adaptive behaviours may have contributed to persistence of the Kulpara population in the short term, they are unlikely to ensure its long-term viability in the face of ongoing isolation because they can act only to slow the rate of inbreeding and mitigate some of its negative impacts.},
  isbn = {0962-1083},
  journal = {Molecular Ecology},
  keywords = {CLETHRIONOMYS-GLAREOLUS,CONSERVATION GENETICS,dispersal,fragmentation,GRAY-TAILED VOLES,HAIRY-NOSED WOMBATS,INBREEDING-AVOIDANCE,marsupial,microsatellite DNA,MULTILOCUS GENOTYPES,NATURAL-POPULATIONS,ORYCTOLAGUS-CUNICULUS,SKINKS EGERNIA-CUNNINGHAMI,SOCIAL-ORGANIZATION,sociobiology},
  language = {English},
  number = {7}
}

