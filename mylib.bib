@incollection{Anderson1993a,
  title = {Trends in the Analysis of Recovery and Recapture Data},
  booktitle = {Marked Individuals in the Study of Bird Population},
  author = {Anderson, David R and Wotowa, Mark A and Rexstad, Eric A},
  editor = {Lebreton, J.-D. and North, P M},
  year = {1993},
  pages = {373--386},
  publisher = {{Birkhauser Verlag}},
  address = {{Basel}},
  abstract = {Summary: This paper reviews trends in the analysis of ring recovery and capture-recapture data and makes several predictions about trends into the remainder of the decade. The number and size of data sets have increased very substantially and now many taxonomic groups are represented by marked subpopulations. Interest is shifting from parameter estimation to hypothesis testing and structural models. There has been a explosion of new statistical theory. The key issue in the comprehensive analysis of recovery or recapture data is proper model selection. The Principle of Parsimony is the conceptual guide to model selection and Akaike's Information Criterion (AIC) provides a simple and effective method for practical use. Given a model, a large amount of theory exists for making optimal estimates and tests. Several methods offer improved means to estimate precision of estimates (e.g., emprical variance inflation using quasi-likelihood, and improved confidence intervals using logit-based or profile likelihood intervals). The small sample properties of AIC and other model selection criteria are topics which need additional research. Goodness-of-fit tests are reviewed and their interpretaions given. Small expectations associated with large data sets remain problematic. Heterogeneity in survival often cause little bias in \'i, but can result in poor model fit. Recent efforts to estimate the magnitude of heterogeneity are riviewed. Additional research on heterogeneity is recommended. An increasing number of research papers are showing that radio telemetry equipment has had impacts on avian species. These effects frequently impact both survival and reproduction. We suggest caution in attempting to make valid estimates of survival from radio-marked birds. Relatively few biologists conduct treatment-control survival experiments using samples of marked individuals. A general theory for design and analysis of such experiments exists, but few experiments are being conducted. We strongly recommend that more experimentation be done. Increasing interest in multistrata models, movement parameters, state transition models, and post-stratification has taken place since the 1989 EURING meetings. These results are reviewed briefly and more research results are recommended. Three brief examples are given (northern spotted owls ringed throughout their range, mallards ringed during the winter in eastern Colorado, and gadwalls ringed in North Park, Colorado). These data sets are used to illustrate a variety of subtle points and forecast future analysis trends. Finally, trends in computer hardware and software are given with a discussion of future requirements and present limitations.},
  keywords = {MARK-RECAPTURE,MIGRATION,POPULATION ESTIMATION,STATISTICS,SURVIVAL}
}

