@article{Fenwick2004,
  title = {A Comparison of {{Salmonella}} Serotypes Isolated from {{New Zealand}} Sea Lions and Feral Pigs on the {{Auckland Islands}} by Pulsed-Field Gel Electrophoresis.},
  author = {Fenwick, S G and Duignan, P J and Nicol, C M and Leyland, M J and Hunter, J E B},
  year = {2004},
  volume = {40},
  pages = {566--570},
  abstract = {The Salmonella serotypes S. Cerro and S, Newport were isolated from New Zealand sea lions (Phocarctos hookeri) and feral pigs on the Auckland Islands in the New Zealand subantarctic region. The isolates were typed by pulsed-field gel clectrophoresis using Xba1 as the restriction enzyme. The isolates were indistinguishable, which suggests that Salmonella infection cycles between sea lions and Pigs in this environment. Apart from a previous isolation from a single New Zealand fur seal (Arctocephalus forteri), S. Newport has not been recorded in any animals from New Zealand, but it is associated with gastroenteritis In humans. Contamination of the marine environment by human waste is a possible source of infection for marine mammals and warrants further investigation.},
  journal = {Journal of Wildlife Diseases},
  keywords = {[06702] Enterobacteriaceae,[31000] Physiology and biochemistry of bacteria,[36002] Medical and clinical microbiology - Bacter,[38002] Veterinary science - General and methods,[85740] Suidae,[86180] Otariidae,8953,Arctocephalus forsteri,Arctocephalus forteri: species,Artiodactyla,Artiodactyls,Chordates,common,common [,diseases,Enterobacteriaceae: Bacteria,Eubacteria,Facultatively Anaerobi,feral [Suidae],fur seal,hos,host,Infection,Mammalia,Mammals,Microorg,Nonhuman V,Otariidae: Animals,pathogen [Enterob,pathogen [Enterobacte,pathogen [Enterobacteri,Phocarctos hookeri: species,pig: common,Pinnipedia,Salmonella cerro: species,Salmonella newport: species,Salmonella typhimurium: species,sea lion,Suidae: Animals,Vertebrat,Vertebrata,Veterinary Medicine: Medical Sciences},
  mendeley-tags = {8953},
