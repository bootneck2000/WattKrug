@article{Myers2007,
  title = {A Novel Technique for Measuring Heart Rate in a Free Swimming Marine Vertebrate},
  author = {Myers, A E and Hays, G C},
  year = {2007},
  volume = {349},
  pages = {45--51},
  doi = {10.1016/j.jembe.2007.04.017},
  abstract = {A mouth opening sensor incorporating a magnet and Hall sensor attached to a data logging unit was used to monitor the breathing and foraging behavior of a free-swimming leatherback sea turtle (Dermochelys coriacea). Analysis of these data revealed a rhythmic low amplitude oscillation. Further investigation of the frequency of this signal lead us to believe that the movements (\textexclamdown 0.1 mm) are caused by the movement of blood through the nearby blood vessels. Putative heart rate decreased during dive descent and increased considerably during dive ascent reflecting the bradycardia and anticipatory tachycardia recorded by other means in other air-breathing divers. Oscillation frequencies were also comparable to the heart rate recorded in leatherbacks by means of implanted electrodes. We therefore propose that this device which was already known to reliably record behaviour such as breathing, feeding and buccal oscillations in sea turtles also has potential for recording other signals which cause movement on the external surface of an animal. (C) 2007 Elsevier B.V. All rights reserved.},
  isbn = {0022-0981},
  journal = {Journal of Experimental Marine Biology and Ecology},
  keywords = {DIVING BEHAVIOR,FREE-LIVING ANIMALS,FREQUENCY,heart rate,INSIGHTS,leatherback,MOVEMENT,penguin,PENGUINS,SEA-TURTLES,seal,TDR,TEMPERATURE,turtle,whale},
  language = {English},
