@article{Wagemann1984,
  title = {Concentrations of Heavy Metals and Organochlorines in Marine Mammals of Northern Waters Overview and Evaluation},
  author = {Wagemann, R and Muir, D C G},
  year = {1984},
  pages = {I--V; 1--97},
  abstract = {Published data on heavy metal and organochlorine concentrations in tissues of cetaceans and pinnipeds, mainly from northern waters, were compiled. The data were subjected to multiple comparison by Scheffe's method and assessed for significant differences. Most cetaceans had Hg concentrations (wet wt basis) of 0.02-1.6 .mu.g/g in muscle tissue, 1-2 .mu.g/g in renal tissue and 3-20 .mu.g/g in the liver. Of all cetaceans some dolphins, pilot whales and short-finned pilot whales had the highest recorded Hg levels in their tissues. Systematic differences in Hg levels among different species of animals were not apparent. Most mean Hg concentrations (89\% of the compiled data) in the liver of seals were \textexclamdown{} 65 .mu.g/g, and \textexclamdown{} 3.4 .mu.g/g and 0.94 .mu.g/g in renal and muscle tissue, respectively. Among seals there was no differentiation of Hg concentration according to species of animals, but age seemed to be 1 factor determining the level of Hg in tissues. A limited number of other metal data (Zn, Cu, Pb, Se) were also given. Mean Cd concentrations in renal tissue of whales, 28-64 .mu.g/g, were higher than in the same tissue of most seals and porpoises. Cd concentrations in kidneys of striped dolphins (25 .mu.g/g on average) were comparable to the concentrations in whales. In cetaceans and seals Cd was consistently higher in renal tissue than in hepatic tissue by a factor of 2-5. Statistical comparison of total DDT (.SIGMA.DDT) concentrations in cetaceans revealed 4 distinct groups. Dolphins from the California [USA] coast had higher .SIGMA.DDT levels than dolphins from the Mediterranean coast of France or porpoises from the Bay of Fundy. The latter group had significantly higher .SIGMA.DDT than all other groups. PCB [polychlorinated biphenyl] levels followed a similar trend, but only 2 groups (coast of France and all other data) were discerned. Levels of .SIGMA.DDT and PCB in narwhale blubber (Pond Inlet, N.W.T., Canada) averaged 3.51 and 10.09 .mu.g/g, respectively, with males having significantly higher levels. Results were not correlated with length of the animals. The residue levels in narwhales could not be distinguished statistically from other organochlorine data for cetaceans from Greenland or the North Atlantic. Comparison of concentrations of PCB in pinnipeds (blubber) revealed 4 distinct groups. Seals from the Baltic and the North Sea coast of The Netherlands had significantly higher PCB levels than all other animals. Levels of PCB in seals from Candian waters were significantly lower than those from the Baltic except for harbor seals in the Bay of Fundy. Five distinct groups of pinnipeds could be delineated for .SIGMA.DDT residues with sea lions from the California coast having the highest levels and seals from the Canadian Arctic the lowest.},
  journal = {Canadian Technical Report of Fisheries and Aquatic Sciences},
  keywords = {Animals,Biochemical Studies/Minerals [10069],Bones,Cetaceans,Chord,Chorda,Chordates,Connective and Adipose Tis,Delphinidae [85815],Delphinidae: Cetacea,Developmental Biology/Embryology-Morphogenesis,Digestive System/Physiology and Biochemistry [1400,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Fasciae,Ge,General and Miscellaneous/Comparative (,General and Miscellaneous/General [1250,Genetics and Cytogenetics/Sex Differences [03510],Joints,Mammalia,Mammals,Metabolism/Minerals [13010],Monodontidae: Cetacea,Muscle/Pathology [17506],Nonhuman Mammals,Nonhuman Vertebrates,Otariidae: Pinnipedia,Pathology,Phocidae: Pinnipedia,Pinnipeds,Public Health: Environmental Health/Air,Toxicology/Environmental and Industrial Toxicology,Urinary System and External Secretions/Physiology,Vertebrata,Vertebrates,Water and},
  number = {1279}
}

