@article{Ciaputa2006,
  title = {Seasonal and Annual Changes in {{Antarctic}} Fur Seal ({{Arctocephalus}} Gazella) Diet in the Area of {{Admiralty Bay}}, {{King George Island}}, {{South Shetland Islands}}},
  author = {Ciaputa, Piotr and Sicinski, Jacek},
  year = {2006},
  volume = {27},
  pages = {171--184},
  abstract = {This study describes the seasonal and annual changes in the diet of non-breeding male Antarctic fur seals (Arctocephalus gazella) through the analysis of faeces collected on shore during four summer seasons (1993/94-1996/97) in the area of Admiralty Bay (King George Island, South Shetlands). Krill was the most frequent prey, found in 88.3\% of the 473 samples. Fish was present in 84.7\% of the samples, cephalopods and penguins in 12.5\% each. Of the 3832 isolated otoliths, 3737 were identified as belonging to 17 fish species. The most numerous species were: Gymnoscopelus nicholsi, Electrona antarctica, Chionodraco rastrospinosus, Pleuragramma antarcticum, and Notolepis coatsi. In January, almost exclusively, were taken pelagic Myctophidae constituting up to 90\% of the total consumed fish biomass. However, in February and March, the number of bentho-pelagic Channichthyidae and Nototheniidae as well as pelagic Paralepididae increased significantly, up to 45\% of the biomass. In April the biomass of Myctophidae increased again. The frequency of squid and penguin occurrence was similar and low, but considering the greater individual body mass of penguins, their role as a food item may be much greater. In March and April, penguins could be as important prey item as fish. The amount of krill in the diet of Antarctic fur seals declined with a concomitant decrease in the mature krill availability. This appears to have been compensated by an increased frequency of the fur seal to cat fish and penguins.},
  journal = {Polish Polar Research},
  keywords = {[07002] Behavioral biology - General and comparati,[07003] Behavioral biology - Animal behavior,[07502] Ecology: environmental biology - General a,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[13202] Nutrition - General studies,[13502] Food technology - General and methods,[14004] Digestive system - Physiology and biochemi,[61100] Cephalopoda,[62800] Animal distribution,[64026] Invertebrata: comparative,[64054] Invertebrata:comparative,[75112] Malacostraca,[85206] Osteichthyes,[85562] Sphenisciformes,[86180] Otariidae,Anima,Antarctic fur seal,Arctocephalus gazella: species,Arthropoda,Arthropods,Aves,Behavior,Biogeography: Population Studies,Birds,cephalopod: common,Cephalopoda: Animals,Channichthys rhinoceratus: species,Channichthys wilsoni: species,Chionodraco rastrospinosus: species,Chordat,Chordata,Chordates,common,Crustacea,Crustaceans,diet variation,Electrona antarctica: species,Electrona carlsbergi: species,Environmental Sciences,Euphausia superba: species,experimental mo,experimental mor,feces: digestive system,Fish,Foods,Gymnoscopelus braueri: species,Gymnoscopelus nicholsi: species,In,Inver,Invertebrata,Invertebrates,Krefftichthys anderssoni: species,krill,Lampanyctus achirus: species [Osteichthyes],Lindbergichthys nudifrons: species,Malacostraca: Animals,Mammalia,Mammals,Marine Ecology: Ecology,Mollusca,Mollusks,Nonhum,Nonhuman V,Notolepis coatsi: species,Nutrition,nutritional s,Osteichthyes: Animals,Otariidae: Animals,penguin: common,Pinnipedia,Pisces,Pleuragramma antarcticum: species,prey [Cephalopoda],prey [M,prey [Osteich,prey [Osteicht,prey [Osteichth,prey [Osteichthye,prey [Osteichthyes,prey [Osteichthyes],prey [Sphenisciformes],Protomyctophum bolini: species,Protomyctophum normani: species,pry [Osteichthyes],seasonality,Sphenisciformes: Animals,Trematomus hansoni: species,Vertebrat,Vertebrata},
  number = {2}
}

