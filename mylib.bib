@article{Voris1995,
  title = {Predation on Marine Snakes - a Case for Decapods Supported by New Observations from Thailand},
  author = {Voris, H K and Jeffries, W B},
  year = {1995},
  volume = {11},
  pages = {569--576},
  abstract = {Scientific and commercial collecting have documented high levels of abundance among several species of marine snakes. Estimates of first-year mortality in populations of marine snakes range from 40 to 90\%. The primary cause of this mortality is unknown. Storms, currents, sun exposure, dehydration and fire are abiotic factors that may control populations of marine and amphibious snakes. Disease, malnutrition and predation are biotic factors known to affect populations. In the literature there are isolated reports of predation by marine mammals, birds of prey, fish and invertebrates. Sharks in Australian waters are known to be predators on sea snakes. Our studies show that in the estuaries, intertidal mangrove creeks and mud flats of southeast Asia decapod crustaceans are important snake predators. Microhabitat overlap, exoskeleton armour and a respiratory advantage in an underwater standoff argue for their potential as potent predators. Field observations, a survey of crab stomach contents and encounters between snakes and crabs under laboratory conditions support this hypothesis.},
  journal = {Journal of Tropical Ecology},
  number = {Part 4}
}

