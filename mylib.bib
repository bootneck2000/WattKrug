@article{Au1991,
  title = {Polyspecific Nature of Tuna Schools: Shark, Dolphin, and Seabird Associates},
  author = {Au, D. W.},
  year = {1991},
  volume = {89},
  pages = {343--354},
  issn = {00900656},
  abstract = {Yellowfin tuna Thun\- nus albacares are commonly found associated with other species, espe\- cially sharks, birds, and dolphins, in the eastern tropical Pacific. Data from the purse seine fishery there, collected during 1974 and 1975, indi\- cate that sharks occurred with tuna in 40\% or more of the purse seine sets made around floating logs. Most other species, including rays, billfish, and small tunas, usually occurred in less than 10\% of the sets. The asso\- ciation rate of these bycatch species declined progressively from log- to school- to porpoise-associated sets. This, together with their behavior as understood, suggests that at least some of these species stay with the tuna as much as they can. Such be\- havior would be like that of poly\- specific associations in which two or more species travel together for foraging and protective advantages.},
  isbn = {0090-0656},
  journal = {Fishery Bulletin},
  keywords = {Anim,Animal,Animalia,Animals,Aves: Vertebrata,Behavioral Biology/Animal Behavior [07003],Birds,Cetaceans,Chondrichthyes [85202],Chondrichthyes: Pisces,Chorda,Chordata,Chordates,Delphinidae: Cetacea,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Fish,General and Systematic Zoology/Pisces [6,General Biology/Conservation,General/Field Me,Mammalia,Mammals,Materials and Apparatus,Methods,Nonhuman Mammals,Nonhuman Vertebrates,Nutrition/General Studies,Nutritional Status and,Osteichthyes: Pisces,Resource Management,Vertebrata,Vertebrates},
