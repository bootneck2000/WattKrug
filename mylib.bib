@article{Kasuya1976,
  title = {Reconsideration of Life History Parameters of the Spotted and Striped Dolphins Based on Cemental Layers},
  author = {Kasuya, T},
  year = {1976},
  pages = {73--106},
  abstract = {Growth layers were visible in both cement and dentine of the decalcified and stained teeth of Stenella attenuata and S. coeruleoalba. Their accumulation was annual in young dolphins, but in older animals only the accumulation of cement layers were detected. Growth lasted longer than expected from previous studies. The maximum age was \textquestiondown{} 45 yr and sexual maturity was attained at 9 yr in females of both species. An annual natural mortality rate of 7.5\% for S. attenuata and a total mortality rate of 11.8\% for S. coeruleoalba were estimated in adult females. Mean mortality was lower in immature animals and higher in adult males. Annual ovulation rate was .apprx. 0.41 in both species. Reproductive parameters were analyzed in relation to age and present population level.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Anatomy and Histology,Animals,Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Dental and Oral Biology/Anatomy [19002],Dental and Oral Biology/Physiology and Biochemistr,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Water Research and Fishery B,Ge,General and Comparative/Gro,General and Miscellaneous/Necrosis (197,General and Systematic Zoology/Mammalia,Genetics and Cytogenetics/Sex Differences [03510],Mammalia,Mammals,Metabolic Pathways [13002],Metabolism/General Metabolism,Nonhuman Mammals,Nonhuman Vertebrates,Pathology,Reproductive System/Physiology and Biochemistry [1,Vertebrata,Vertebrates},
