@article{Yesner1988,
  title = {Effects of Prehistoric Human Exploitation on {{Aleutian}} Sea Mammal Populations},
  author = {Yesner, David R},
  year = {1988},
  volume = {25},
  pages = {28--43},
  abstract = {Here, Yesner compares age-sex distribution of archaeological material with a life table for a "natural" phocid population. Utilization of harbor seals matches the life table almost perfectly, but sea lions and fur seals do not. In particular, 70\% of the fur seal biomass is attributed to infants (but no mention of breeding anywhere but the Pribs). This is explained by ease of catching the littluns as they migrate through the eastern Aleutians. The sea lions are biased in the other direction, with a preponderance of older, immature male individuals. Yesner explains this as a preference for the larger individuals. Having said all this, Yesner attempts to model the long-term effect this differential culling may have had on the fur seal and sea lion populations. He concludes that utilization of this sort on fur seals would lead to a decrease in numbers which starts out slowly but accelerates over time. For sea lions, a similar result is found. However, the rate of population depletion is much lower. Testing this model against the archaeological record, Yesner observes that at the Oglodax' site on Umnak Island, sea lion percentages (of total NISP) vary considerably, while fur seal percentages only vary a little. His conclusion is that sea lion populations were affected, whereas fur seal populations were not. Next, Yesner looks at effects harvesting may have had on sea urchin populations. However, he uses data from modern urchin population studies which do not appear to take into consideration the fact that sea otter populations may have been severely reduced in recent times. He does make reference to the fact that the interaction between the Aleuts, sea otters, and sea urchin populations is likely to have been very complex in the past. Final comments: Aleut hunting probably led to a decrease in sea lion populations in the late prehistoric (cf. Lobdell 1980 and Piana 1984).},
  journal = {Arctic Anthropology},
  number = {1}
}

