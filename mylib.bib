@article{Ostram1993,
  title = {Evaluation of the Diet of {{Sowerby}}'s Beaked Whale, {{Mesoplodon}} Bidens, Baased on Isotopic Comparisons among Northwestern {{Atlantic}} Cetaceans},
  author = {Ostram, P H and Lien, Jon and Macko, Stephen A and Ostrom, Peggy H and Lien, Jon and Macko, Stephen A},
  year = {1993},
  volume = {71},
  pages = {858--861},
  abstract = {Sowerby's beaked whale, Mesoplodon bidens, is a poorly known and infrequently encountered species. Consequently, its behavior and habitat requirements are largely unknown. Evidence of the trophic level and diet of M. bidens was obtained through a comparison of delta-13C and delta-15N values for this species with those for eight other cetaceans and the basking shark, Cetorhinus maximus. The delta-13C value for M. bidens (18.5 +- 1.1 permill ) was similar to that for all other cetaceans (18.7 to -17.2 permill ) except the sperm whale, Physeter macrocephalus, and the blue whale, Balaenoptera musculus (-22.8 and -20.1 permill , respectively). At least a portion of the range of delta-13C values for the cetaceans and the basking shark is thought to be related to variations in the lipid content of the samples. Nitrogen isotope values appear to reflect trophic position. Based on delta 15N, organisms can be ordered along a trophic continuum bracketed by the planktivorous basking shark (9.9 permill ) and the piscivorous white-beaked dolphin, Lagenorhynchus albirostris (16.2\% permill ). The trophic position of M. bidens (delta-15N = 11.7 permill ) is intermediate between those of the pygmy sperm whale, Kogia breviceps (delta-15N = 11.9 permill ), and the sperm whale, Physeter macrocephalus (delta-15N = 11.1 permill ), and thus supports previous suggestions that these species feed at similar trophic positions. The estimated delta-15N value of the diet of M. bidens, 8.7 permill , is consistent with a diet that has a large contribution from small offshore squid, delta-15N = 9.3 permill .},
  journal = {Canadian Journal of Zoology},
  keywords = {Anim,animals,Balaenoptera musculus (Balaenopteridae),Balaenopteridae: Cetacea,Behavior,Behavioral Biology/Animal Behavior [07003],cetaceans,Cetorhinus maximus (Chondrichthyes),Ch,Chondrichthyes [85202],Chondrichthyes: Pisces,Chord,Chorda,Chordata,chordates,Delphinidae: Cetacea,diet,Ecology,Ecology (Environmental Sciences),Environmental Biology/Animal [07508],fish,Kogia breviceps (Physeteridae),Lagenorhynchus albirostris (Delphinidae),Mammalia,mammals,Mesoplodon bidens (Ziphiidae),nonhuman mammals,nonhuman vertebrates,Nutrition,Nutrition/General Studies,Nutritional Status and,Physeter macrocephalus (Physeteridae),Physeteridae: Cetacea,sowerby's beaked,techniques,Vertebrata,vertebrates,whales,Ziphiidae: Cetacea},
  number = {4}
}

