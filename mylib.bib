@article{Mass1999,
  title = {Retinal Topography and Visual Acuity in the Riverine Tucuxi ({{Sotalia}} Fluviatilis).},
  author = {Mass, Alla M and Supin, Alexander Ya.},
  year = {1999},
  volume = {15},
