@article{Jago1996,
  title = {Risk Factors Associated with Bruising in Red Deer at a Commercial Slaughter Plant},
  author = {Jago, J G and Hargreaves, A L and Harcourt, R G and Matthews, L R},
  year = {1996},
  volume = {44},
  pages = {181--191},
  abstract = {Bruising of slaughter animals has both economic and welfare implications. In order to identify potential risk factors we surveyed bruising of red deer carcasses from a single Deer Slaughter Plant (DSP) over a three year period. Downgrading due to bruising did not vary between the three years surveyed (1991, n = 21 454, 6.5\% downgraded (dg); 1992, n = 22,289, 7.9\% dg; 1993, n = 22 262, 6.1\% dg). From an intensive examination of one year's kill (1991) we related the incidence of bruising to various preslaughter transport, seasonal and animal variables. Bruising varied significantly with time of year, hot carcass weight, distance transported, carrier company and carcass fatness. Bruising was related to duration of lairage for some periods of the year which varied with sex. The majority of bruising was on one or other hindquarter implying a consistent cause of the damage. Carcass quality and deer welfare can be best protected by careful driving, by only transporting animals in good condition and avoiding transporting males during the rut.},
  journal = {Meat Science},
  keywords = {[13502] Food technology - General and methods,[18501] Integumentary system - General and methods,[26502] Animal production - General and methods,[38002] Veterinary science - General and methods,[85700] Mammalia,[85725] Cervidae,animal husbandry,Animal Husbandry: Agriculture,animal welfare,Animalia,Artiodactyla,Artiodactyls,biobusiness,bruising,carcass quality,Cervidae: Animals,Chordata,Chordates,female,Foods,Integumentary System: Chemical Coordination and Ho,male,Mammal,mammal [Mammalia],Mammalia,Mammalia: Animals,Mammals,meat industry,meat products,Nonhuman Ve,preslaughter transport,red deer [Cervidae],venison,Vertebra,Vertebrata,Veterinary Medicine: Medical Sciences},
  number = {3}
}

@article{Jago1997,
  title = {The Effect of Road-Type and Distance Transported on Behaviour, Physiology and Carcass Quality of Farmed Red Deer ({{Cervus}} Elaphus)},
  author = {Jago, J G and Harcourt, R G and Matthews, L R},
  year = {1997},
  volume = {51},
  pages = {129--141},
  abstract = {Nine groups of six hinds were transported a range of distances (80, 230 or 380 km) that were representative of current commercial practice. Behaviour during transport was recorded continuously using a camera mounted centrally in the ceiling of the pen. Blood samples were collected pre-transport and post-slaughter, the carcasses were assessed for bruising and ultimate pH was measured. Adjustments to balance (rapid foot adjustments), and the number of impacts and movements by animals were greatest at the start of the journey and on the steep, winding roads. Overall bruising levels were low. Bruising on the hindleg and vertebrae increased with increasing distance transported. Biting accounted for 95\% of all agonistic behaviour observed during transport. Heavier animals tended to initiate most of the agonistic behaviour and this was typically directed at the smaller animals. On two-thirds of the journeys one or more animals lay down. Deer tended to lie down after 60 min of the journey. Pre-slaughter handling (including transport) resulted in an increase in creatine kinase (CK), aspartate aminotransferase (AST), glucose, calcium, cortisol, total lactate dehydrogenase (LDH), LDH3, LDH4, LDH5 and a decrease in magnesium. Distance caused a further proportionate increase in plasma CK, total LDH, LDH5 and LDH4. This study shows that increasing distance transported has no additional effect on behaviour, carcass quality (bruising) or ultimate pH of red deer.},
  journal = {Applied Animal Behaviour Science},
  keywords = {[07003] Behavioral biology - Animal behavior,[10064] Biochemistry studies - Proteins,[10068] Biochemistry studies - Carbohydrates,[10069] Biochemistry studies - Minerals,[10806] Enzymes - Chemical and physical,[13516] Food technology - Meats and meat by-produc,[13530] Food technology - Evaluations of physical,[15002] Blood - Blood and lymph studies,[26502] Animal production - General and methods,[85725] Cervidae,58367-01-4q,agonistic behavior,animal husbandry,Animal Husbandry: Agriculture,Artiodactyla,Artiodactyls,aspartate aminotransferase,aspartate aminotransferase: 9000-97-9,Behavior,Biochemistry and Molecular Biophysics,biting,Blood and Lymphatics: Transport and Circulation,bruising,calcium,calcium: 7440-70-2,carcass quality,Cervidae: Animals,Cervus elaphus [Cervidae],Chordates,cortisol,cortisol: 50-23-7,creatine kinase,creatine kinase: 9001-15-4,Enzymology: Biochemistry and Molecular Biophysics,Foods,glucose,glucose: 50-99-7q,lactate dehydrogenase,lactate dehydrogenase: 9001-60-9,magnesium,magnesium: 7439-95-4,Mammal,Mammalia,peptides,ph,physiology,red deer [Cervidae],road-type,transport distance,Vertebra},
  number = {1-2}
}

