@misc{Addison1987,
  title = {Transfer of Organochlorine Residues from Blubber through the Circulatory System to Milk in the Lactating Grey Seal \textexclamdown i\textquestiondown{{Halichoerus}} Grypus\textexclamdown/I\textquestiondown},
  author = {Addison, R F and Brodie, P F},
  year = {1987},
  volume = {44},
  pages = {782--786},
  issn = {0706-652X},
  doi = {10.1139/f87-095},
  abstract = {Residues of the DDT group of insecticides and the polychlorinated biphenyls (PCBs) were measured in maternal blubber, milk, and blood or serum and in pup blubber and blood or serum of grey seals (Halichoerus grypus) from Sable Island, N.S. sampled in 1984 and 1985. DDT-group and PCB concentrations in blubber samples were lower in 1984 than in a sample of this population taken in the mid-1970's, but not lower than those in a sample taken in 1982. Concentrations in 1985 samples were slightly higher than those in the 1984 samples, for unknown reasons. On a lipid weight basis, residue concentrations in blood or serum were consistently about 50\% of those in blubber lipid. The more highly chlorinated and therefore more lipid-soluble PCB components were transferred less efficiently from blubber to the circulatory system. Net transfer of residues from maternal blubber to maternal milk was about 70\% efficient; this implies considerable degradation of circulatory lipid and resynthesis, probably to milk carbohydrates and other compounds. There was some selection against movement of especially the lower chlorinated PCB congeners from circulatory lipids into milk lipids, compared with transfer of the DDT group. Thus, a nonselective barrier exists to quantitative transfer of residues from blubber lipid to circulatory lipid, and a partially selective barrier exists against PCBs in the transfer of residues from circulatory to milk lipids; at least the latter barrier seems to involve lipid solubility. FR: Les auteurs ont quantifi\'e les r\'esidus d'insecticides du groupe DDT et des biph\'enyles polychlor\'es (BPC) dans la graisse, le lait, le sang et le s\'erum de phoques gris (Halichoerus grypus) femelles et dans la graisse, le sang et le s\'erum de leurs nouveau-n\'es \'echantillonn\'es en 1984 et 1985 \`a l'\^ile de Sable (N.-\'E.). Les concentrations de BPC et d'insecticides d\'eriv\'es du DDT dans la graisse \'etaient plus faibles en 1984 que dans un \'echantillon de cette population recueilli vers le milieu des ann\'ees 1970, mais elles n'\'etaient pas inf\'erieures \`a celles observ\'ees dans un \'echantillon recueilli en 1982. Dans les \'echantillons pr\'elev\'es en 1985, les concentrations \'etaient l\'eg\`erement plus \'elev\'ees que celles observ\'ees dans les \'echantillons de 1984, pour des raisons qui demeurent inconnues. En fonction du poids des lipides, les concentrations de r\'esidus dans le sang ou le s\'erum s'\'elevaient constamment \`a environ 50\% de celles pr\'esentes dans les lipides de la graisse. Le transfert des composantes des BPC beaucoup plus chlor\'ees et donc plus solubles dans les lipides s'est effectu\'e moins efficacement de la graisse au syst\`eme circulatoire. Le transfert net de r\'esidus de la graisse au lait maternel \'etait efficace \`a environ 70\%; ceci signifie une importante d\'egradation des lipides circulatoires et leur resynth\`ese, probablement en hydrates de carbone du lait et d'autres composantes. Il y a eu une certaine s\'election contre le d\'eplacement, surtout des cong\'en\`eres des BPC moins chlor\'es, \`a partir des lipides circulatoires vers les lipides du lait, par rapport au d\'eplacement des r\'esidus du DDT. Il existe donc un obstacle non s\'electif au d\'eplacement quantitatif de r\'esidus \`a partir des lipides de la graisse vers les lipides du syst\`eme circulatoire, ainsi qu'une barri\`ere partiellement s\'elective des BPC pour ce qui du d\'eplacement des r\'esidus entre les lipides circulatoires et les lipides du lait. La solubilit\'e des lipides semble \^etre une composante de cette derni\`ere barri\`ere.},
  isbn = {0706-652X},
  journal = {Canadian journal of fisheries and aquatic sciences},
  keywords = {2553,circulation,Halichoerus grypus,lactation,milk,pollution},
  mendeley-tags = {2553},
  number = {4}
}

