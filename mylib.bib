  author = {Kinas, Paul G and Bethlem, Claudia B P},
  year = {1998},
  volume = {0},
  pages = {447--450},
  abstract = {An empirical Bayes estimation procedure for the size of a closed population is proposed for when mark-recapture data are available and random variation in catchability among individuals is assumed. The procedure is an alternative to Yoshida et al. (1996) for cases where it is difficult to define a reasonable prior distribution for catchability. The new procedure is applied to photo-identification data of humpback whales, Megaptera novaeangliae, obtained from the breeding area at Abrolhos, Brazil in 1995. The posterior probability distribution for population size gives a mean of 1,634, mode 1,619 (90\% CI, 1,379-1,887).},
