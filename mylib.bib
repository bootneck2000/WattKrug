@article{Liggins1980a,
  title = {Fetal Cardio Vascular and Metabolic Responses to Simulated Diving in the Weddell Seal Leptonychotes-Weddelli},
  author = {Liggins, G C and Qvist, J and Hochachka, P W and Murphy, B J and Creasy, R K and Schneider, R C and Snider, M T and Zapol, W M},
  year = {1980},
  volume = {49},
  pages = {424--430},
  abstract = {Fetal responses to normobaric diving simulated by submersion of the maternal head for 20 min were studied in 4 conscious Weddell seals near term. Microspheres injected into the maternal aorta were distributed to the placenta and kidneys in the ratio of 0.4 in the control period and 19.3 during diving, suggesting minimal placental vasoconstriction. Fetal heart rate fell during diving from a mean control value of 90-34 beats/min after 4 min. The onset of fetal bradycardia was not consistently associated with changes in blood gas tensions. Diving was associated with a fall in fetal arterial O2 tension from 24-9 torr, arterial CO2 tension rose from 47-85 torr and arterial pH fell from 7.35-7.24. Fetal-maternal gradients for CO2 and H+ transport remained constant; gradient for O2 transport fell from 47 torr before diving to 14 torr at the end of diving. Blood lactate concentrations increased 3- to 4-fold during diving and reached peak values 10-15 min after diving ended. Similarity of the fetal and maternal heart rate responses to diving is consistent with the presence of physiological O2-conserving reflexes akin to the adult's.},
  journal = {Journal of Applied Physiology: Respiratory, Environmental and Exercise Physiology},
  keywords = {*Biochemistry/Gases (1970- ) [10012],*Cardiovascular System/Physiology and Biochemistry,*Developmental Biology/Embryology-Experimental [25,*Metabolism/General Metabolism,*Nervous System/Physiology and Biochemistry [20504,*Respiratory System/Physiology and Biochemistry [1,8100,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Biochemical Methods/General [10050],Biochemical Studies/General [10060],Blood,Blood Gas Ph Lactate Physiological Oxygen Conservi,Blood-Forming Organs and Body Fluids/Blood,Cardiovascular System/General,Chordate Body Regions/Head (1970- ) [11304],Ecology,Environmental Biology/Water Research and Fishery B,Metabolic Pathways [13002],Methods [14501],Phocidae [86185],Radiation/Radiation and Isotope Techniques [06504],Reproductive System/Physiology and Biochemistry [1,Urinary System and External Secretions/Physiology},
  number = {3}
}

@article{Liggins1993,
  title = {Concentrations, Metabolic Clearance Rates, Production Rates and Plasma Binding of Cortisol in {{Antarctic}} Phocid Seals.},
  author = {Liggins, G C and France, T J and Schneider, R C and Knox, B S and Zapol, W M and Liggins Graham, C and France John, T and Schneider Robert, C and Knox Bruce, S and Zapol Warren, M},
  year = {1993},
  volume = {129},
  pages = {129(4)},
  abstract = {We have reported previously that plasma of the Weddell seal, a member of the phocid family, contains a very high concentration of cortisol. The present study was undertaken to determine whether high cortisol levels were common to seals in the Antarctic environment, or to other phocidae, and to determine the mechanism of the hypercortisolaemia. High levels of cortisol (0.82-2.38 mu-mol/l) were found in 4 phocidae (Weddell, crabeater, leopard and Southern elephant seals), whereas levels in a member of the otariid family (Antarctic fur seal) were similar to human values. Metabolic clearance rates (MCR) and production rates (PR) of cortisol were determined in the field in Weddell (N=1), crabeater (N=3) and leopard (N=3) seals following bolus injections of (3H) cortisol. The MCR and PR did not differ between the three phocids, but whereas the MCR of 410-590 l/day was twice that of human values, the PR of 460-1180 mu-mol cntdot m-2 cntdot d-1 was up to 40-fold greater. The binding capacity of corticosteroid-binding globulin (CBG) was equal to or greater than the plasma concentrations of cortisol, resulting in relatively low concentrations of free cortisol. We conclude that hypercortisolaemia is maintained in phocid seals mainly by a high production rate-the highest (corrected for surface area) reported in any species. The relatively low cortisol levels in otariid seals studied in the same environment suggest that the high PR in phocidae is unrelated to the harsh climatic conditions, but may be part of their adaptation for diving to extreme depths. The phocid seals and New World primates have similarly high levels of cortisol and a high PR but CBG in the primates has low binding capacity and affinity and cortisol is mainly free.},
  journal = {Acta Endocrin.},
  keywords = {1026,Arctocephalus gazella,blood parameters,hormones,Hydrurga leptonyx,Lobodon carcinophagus,Mirounga leonina},
  mendeley-tags = {1026},
  number = {356-359}
}

