@article{Vizzini2004,
  title = {The Trophic Structure of the Pipefish Community ({{Pisces}} : {{Syngnathidae}}) from a Western {{Mediterranean}} Seagrass Meadow Based on Stable Isotope Analysis},
  author = {Vizzini, S and Mazzola, A},
  year = {2004},
  volume = {27},
  pages = {325--333},
  abstract = {Syngnathus abaster and Syngnathus typhle (Pisces: Syngnathidae) from a dense Cymodocea nodosa meadow in the western Mediterranean Stagnone di Marsala (Italy) were studied using delta(13)C and delta(15)N analysis. Because of the presence of these two species in the same habitat and the specialized parental care by the male, the effect of species and sex on the isotopic composition was also studied to investigate the different feeding strategies between and within species. S. abaster and S. typhle exhibited enriched C-13 and N-15 values throughout the sampling period (mean +/-SE, delta(13)C = -10.5 +/- 1.8parts per thousand and -10.8 +/- 2.0parts per thousand, delta(15)N = 11.9 +/- 0.7parts per thousand and 10.6 +/- 1.0parts per thousand, respectively), suggesting that these species receive their energy mainly from mixed sources, particularly from sedimentary and particulate organic matter and the seagrass C nodosa as ultimate organic matter sources. ANOVA results demonstrated that the interaction between season, species, and sex significantly affected the isotopic composition of the pipefish (p\textexclamdown 0.001 for both delta(13)C and delta(15)N). Differences between species and sex, although significant, were smaller than the values generally reported for trophic level differences (similar to1parts per thousand and similar to3.5parts per thousand for delta(13)C and delta(15)N, respectively) and change in foraging habitat. Slight isotopic differences may mirror small differences in resource exploitation and resource partitioning. Evidence from stomach content analysis from the literature coupled with stable isotope measurements, while disagreeing somewhat, provide additional knowledge of pipefish feeding strategies.},
  isbn = {0160-8347},
  journal = {Estuaries},
  keywords = {BAY,CARBON,DELTA-C-13,DELTA-N-15,DISCRIMINATION,FEEDING ECOLOGY,FISH,FOOD-WEBS,FRACTIONATION,RATIOS},
  language = {English},
  number = {2}
}

