@article{Wada1991,
  title = {Interactions between {{Kurile}} Seals and Salmon Trap Net Fishery in the Coastal Waters of Southeastern {{Hokkaido}}},
  author = {Wada, Kazuo and Hayama, Shin-Ichi S.-I. and Nakaoka, Toshiyasu and Uno, Hiroyuki},
