@article{Buchanan1999,
  title = {Evolutionary Applications of {{MIRs}} and {{SINEs}}},
  author = {Buchanan, F and Crawford, A and Strobeck, C and Palsboll, P and Plante, Y},
  year = {1999},
  volume = {30},
  pages = {47--50},
  abstract = {It is believed that short interspersed elements (SINEs) are irreversibly inserted into genomes. We use this concept to try to deduce the evolution of whales using sequence and hybridization studies. The observation that microsatellites are associated with SINEs lead us to screen sequences surrounding cetacean microsatellites for artiodactyl-derived SINEs. Two sequences that were thought to be cetacean SINEs and the bovine SINE were aligned for comparison to sequences flanking microsatellites from ungulates. The bovine SINE was observed only in ruminants while CetSINE1 and 2 were found in mammals. Hybridization studies using these three SINEs revealed that CetSINE1 was found in all ungulates and cetaceans with the strongest hybridization signal observed in the hippopotamus and beluga; CetSINE2 hybridized to all ungulate suborders, while the bovine SINE was only observed in Ruminantia. It is proposed that these putative SINEs are not 'generic' SINEs but mammalian-wide interspersed repe ats (MIRs). Caution is urged: what initially appears to be a SINE may instead be a MIR and have reduced evolutionary resolving power.},
  journal = {Animal Genetics},
  keywords = {[00532] General biology - Miscellaneous,[01500] Evolution,[03506] Genetics - Animal,[85710] Antilocapridae,[85715] Bovidae,[85720] Camelidae,[85725] Cervidae,[85730] Giraffidae,[85735] Hippopotamidae,[85740] Suidae,[85745] Tayassuidae,[85750] Tragulidae,[85805] Balaenidae,[85810] Balaenopteridae,[85825] Monodontidae,[86145] Equidae,Antilocapra americana californica: pronghorn [Anti,Antilocapridae: Animals,Artiodactyla,Artiodactyls,Balaena mysticetus: bowhead whale [Balaenidae],Balaenidae: Animals,Balaenopteridae: Animals,Bos taurus: cattle [Bovidae],Bovidae: Animals,Camelidae: Animals,Cervidae: Animals,Cervus canadensis: elk [Cervidae],Cetacea,Cetaceans,Chordates,Delphinapterus leucas: beluga whale [Monodontidae],Equidae: Animals,Equus caballus: horse [Equidae],Evolution and Adaptation,Genetics,Giraffa camelopardalis: giraffe [Giraffidae],Giraffidae: Animals,Hippopotamidae: Animals,Hippopotamus amphibius: hippopotamus [Hippopotamid,Lama guanicoe: llama [Camelidae],Ma,Mam,Mamm,Mamma,Mammal,Mammalia,mammalian-wide interspersed repeats: evolutionary,Mammals,Megaptera novaengliae: humpback whale [Balaenopter,Monodontidae: Animals,Nonhuman Ver,Ovis aries [Bovidae],Perissodactyla,Rangifer tarandus: caribou [Cervidae],short interspersed nuclear element: evolutionary a,Suidae: Animals,Sus scrofa [Suidae],Tayassu tajacu: peccary [Tayassuidae],Tayassuidae: Animals,Tragulidae: Animals,Tragulus napu: chevrotain [Tragulidae],Ve,Verte,Verteb,Vertebr,Vertebra,Vertebrat,Vertebrata},
