  year = {2019},
  abstract = {This paper describe tests with the Sailbuoy during the 2019 RV Kronprins Haakon cruise in the Antarctic. The trials were successful giving data during continuous operations from end of January to mid February. We present data demonstrating capabilities to run survey transects, to observe variability at a location (future comparison with mooring data when available) and surveying predator prey-fields. Perspectives and plans for the development of a ``Sailbuoy for krill'' including advanced on board processing in accordance with our funded project, is presented and discussed.}
