@article{Casper2006,
  title = {Diet Estimation Based on an Integrated Mixed Prey Feeding Experiment Using {{Arctocephalus}} Seals.},
  author = {Casper, Ruth M and Gales J., N and Hindell, Mark A and Robinson, Sarah M and Gales, Nicholas J and Hindell, Mark A and Robinson, Sarah M},
  year = {2006},
  volume = {328},
  pages = {228--239},
  abstract = {Food web models depend on identifying which taxa, are eaten and in what proportion they are consumed. Arctocephalus seals are generalist foragers and are an ongoing focus of Southern Hemisphere marine ecosystem research. This is the first feeding experiment to use Arctocephalus spp. to assess the utility of hard part scat analysis for diet estimation, based on mixed prey diets integrated over several days. Recovery rates of otoliths were extremely low for all taxa (0-9\%). Although we could not collect scats produced during a 90 min period each day, during which the seals had access to a large pool, this result could not be attributed to otolith robustness, pinniped species or class, activity level, meal size or frequency, or fat content of the diet. We conclude that the unusually low recovery rates in this study may be due to unaccounted scats produced during 90 min of each day, if they contained otolith numbers an order of magnitude greater than all otoliths retrieved from scats produced during the other 22.5 h of each day, and/or may be related to the digestive processing of a mixed prey diet. Our study demonstrates the inadequacy of using otoliths in field collected scats for diet estimation due to the high level of unexplained variability of otolith occurrence in scats. We also identify two new potential sources of this variability. These are variability in numbers of otoliths per scat depending on activity level when a scat is excreted, and variability in recovery rates of otoliths as a function of the complexity of the diet. (c) 2005 Elsevier B.V. All rights reserved.},
  journal = {Journal of Experimental Marine Biology and Ecology},
  keywords = {[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[10066] Biochemistry studies - Lipids,[13202] Nutrition - General studies,[18004] Bones,[19004] Dental - Physiology and biochemistry,[20004] Sense organs - Physiology and biochemistry,[61100] Cephalopoda,[64026] Invertebrata: comparative,[85206] Osteichthyes,[86180] Otariidae,9488,activity level,Amblygaster clupeoids: species,Anima,Arctocephalus forsteri,Arctocephalus forsteri: species,Arctocephalus tropicalis,Arctocephalus tropicalis: species,Arripis georgianus: species,beak: dental and oral system,Cephalopoda: Animals,Chordata,Chordates,connective and adi,Decapterus russelli: species,diet,diet estimation,digestion,digestive processing,Environmental Sciences,exoskeleleton: skeletal system,experimental mo,fasciae,fat: nutrient,Fish,Invertebrata,Invertebrates,joints,Mammalia,Mammals,Marine Ecology: Ecology,Mollusca,Mollusks,New Zealand fur s,Nonhuman V,Nototodarus: genus,Nutrition,nutritional s,Osteichthyes: Animals,Otariidae: Animals,otolith: sensory system,otolithes,passage time,Pinnipedia,Pisces,prey [Cephalopoda],prey [Osteichth,prey [Osteichthyes,prey [Osteichthyes],recovery rate,Sardinella lemuru: species,scat analysis: laboratory techniques,Scomber australasicus: species,Sillago flindersi: species,Sillago robusta: species,Subantarctic fu,Trachurus novaezelandiae: species,Vertebrat,Vertebrata},
