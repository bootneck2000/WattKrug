@article{Arnason1982a,
  title = {Cetacean Molecular Hybridization Using Balenopterid Satellite {{DNA cRNAs}} as Probes.},
  author = {Arnason, U and Purdom, I F and Jones, K W},
  year = {1982},
  volume = {97},
  pages = {33--6},
  issn = {0018-0661},
  abstract = {RNA complementary [c] to 2 unrelated DNA satellites of the mysticete genus Balaenoptera were hybridized to total DNA of several cetacean species [sei, minke, bowhead, beluga, goose-beaked and sperm whales; bridled, whitebeak and indus dolphins; and harbor porpoise]. Sequences related to the light (.rho. [bouyant density] = 1.702/1.703) balenopterid satellite were not present in the odontocete materials investigated. Limited hybridization to bowhead DNA was registered. When cRNA from the heavy (.rho. = 1.710/1.711) balenopterid satellite was used as a probe, hybridization was registered in all, both odontocete and mysticete, DNA. Tm [melting temperature] for intrageneric balenopterid DNA/cRNA hybrids was 63.degree. C in 0.1 .times. SSC [0.15 M NaCl/0.015 M trisodium citrate]. The corresponding figure for the balenopterid-bowhead hybridization was 54.degree. C. With the exception of the sperm whale, Tm for the balenopterid-odontocete cRNA/DNA hybrids were 48.degree.-50.degree. C Tm for the balenopterid-sperm whale cRNA/DNA hybrids was lower. In the balenopterid karyotypes the heavy satellite occurs in terminal C-bands; the same general pattern occurred in the bowhead. The results of the molecular hybridization are consistent with a monophyletic origin of odontocetes and mysticetes.},
  journal = {Hereditas},
