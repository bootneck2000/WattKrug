@article{Wang2006,
  title = {The Stable Isotopic ({{C}} and {{N}}) Composition of Modern Plants and Lichens from Northern {{Iceland}}: With Ecological and Paleoenvironmental Implications},
  author = {Wang, Y M and Wooller, M J},
  year = {2006},
  volume = {56},
  pages = {27--38},
  abstract = {The stable carbon and nitrogen isotopic composition (delta C-13 and delta N-15) of plants and lichens can indicate a considerable amount of information about the physiology and ecology of an environment. To our knowledge no stable isotope (C and N) data have been generated for plants and lichens from Iceland. These data could subsequently provide a unique perspective of nitrogen and carbon cycling in Iceland and aid in interpretation of data generated from stable isotope analyses of organic matter preserved in lake sediments. We analyzed plants and lichens around four lakes (Litla-Vioarvatn, Torfadalsvatn, Stifluvatn, Arnarvatn stora) in northern and interior Iceland. The delta C-13 values for plants from the sites rangedftont -30.9 parts per thousand to -23.3 parts per thousand that are typical of plants using C-3 photosynthesis. Aquatic plant samples (e.g. Potamogeton sp.) analyzed from the sites had delta C-13 values (mean=-13.0 parts per thousand) that were considerably less negative than the terrestrial plants and are typical for submerged freshwater aquatic macrophytes. The 615 N values from the analyses of plants and lichens showed a surprisingly large range (similar to -12.4 parts per thousand to +5.5 parts per thousand), and many of the specimens had delta N-15 values lower than -6.0 parts per thousand. A number of competing and testable causal mechanisms for the low delta N-15 values are proposed and discussed, including plant uptake of atmospheric ammonia and phosphorus limitation.},
  isbn = {0449-0576},
  journal = {Jokull},
  keywords = {AUSTRALIA,CARBON,DELTA-C-13,DELTA-N-15,LAKE-ONTARIO,NITROGEN,ORGANIC-MATTER,RECORD,SEDIMENTS,VEGETATION},
  language = {English}
}

