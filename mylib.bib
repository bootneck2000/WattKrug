@article{Clarke2003,
  title = {Production and Control of Sound by the Small Sperm Whales, {{Kogia}} Breviceps and {{K}}. Sima and Their Implications for Other {{Cetacea}}},
  author = {Clarke, M R},
  year = {2003},
  volume = {83},
  pages = {241--263},
  abstract = {The detailed anatomy of the noses of Kogia breviceps and K. sima (Kogiidae: Cetacea) is described in greater detail than previously. Probable functions of component parts of the nose are deduced from their geometry and physical properties of the tissues. It is concluded that control of the air making the sound is similar to that found in scottish bagpipes with a single reed, that sounds are produced by air being forced from the vocal valve and is resonated in an unusual chamber having cords and membranes, similar to human vocal cords. It is then reflected by air filled 'mirrors' and conducted and intensified through a megaphone-like 'horn' which is surrounded by air and contains tissues rich in spermaceti oil. Sound then passes through the melon where, by changes in temperature of the spermaceti oil, it is actively focused and possibly scanned. Thermal properties of Kogia spermaceti oil are described and related to previously made sound velocity and density measurements. The way sound production and reflection can continue while large variations of pressure are experienced during deep dives, is suggested. A structure for controlling the temperature of the melon is described. It is considered unlikely that the spermaceti oil is used for buoyancy control in Kogia. Some comparisons are drawn with Physeter catodon, Xiphius and Tursiops and some implications for research on other cetaceans are outlined.},
  journal = {Journal of the Marine Biological Association of the United Kingdom},
  number = {2}
}

@article{Clarke2003a,
  title = {Antarctic Marine Benthic Diversity},
  author = {Clarke, A and Johnston, N. M.},
  year = {2003},
  volume = {41},
  pages = {47--114},
  issn = {0078-3218},
  abstract = {Species lists have been compiled for all the major groups of Southernbenthic marine invertebrates, eliminating synonymies whereand providing a subjective estimate of completeness andfor each group. Antarctic marine diversity (pelagic and) is relatively high at the phylum and class level, with the gapscomprising minor, meiofaunal or parasitic groups. Most benthicdata come from the continental shelves, with relatively fewfrom deeper water. Even for the continental shelves, however,is highly patchy with some areas hardly investigated at all.4100 benthic species have been reported from the Southern Ocean,the most speciose groups being polychaetes, gastropods and. Comparison with tropical and temperate regions suggest that, bivalves and teleost fishes are poorly represented in theOcean benthic marine fauna, whereas pycnogonids, echinodermsmany suspension feeding groups are rich and diverse. Some groupsare currently low in diversity were previously well represented inAntarctic shallow water marine fauna, notably decapods and many. Other groups have undergone marked radiations in the Southern, including pycnogonids, amphipods, isopods and teleost fishes; incases, however, it is only some lineages that have diversified. Thisthat evolutionary questions concerning the origin,or extinction of the Southern Ocean marine fauna willno single answer; the evolutionary history of each group appears toa different response to the tectonic, climatic and oceanographicto which they have been subject through history. The dispositionsouthern hemisphere continents makes it difficult to assess whetheris a latitudinal cline in shallow-water marine diversity to mirrorknown from the northern hemisphere. Within Antarctica, many speciesto have circumpolar distributions, and the long establisheddivision into continental Antarctic, Antarctic Peninsulasub-Antarctic regions have not been challenged by recent sampling.most groups the frequency distribution of species per genus ratios{$\nis$}typical, though none is well described by the predictions fromevolutionary or null models. Where data are available, sizeindicate that many Southern Ocean taxa are small, a fewexamples of gigantism notwithstanding, and species abundanceare normal. Knowledge of the Southern Ocean benthic marine faunareached a stage where we can now ask powerful evolutionary, and the development of new molecular techniques provides thefor answering them.},
  isbn = {0-415-25463-9},
  journal = {Oceanography and Marine Biology: an Annual Review}
}

