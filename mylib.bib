  pages = {1069--1073},
  abstract = {We used mitochondrial DNA (mtDNA) restriction analysis to study genetic variation in 98 striped dolphins (Stenella coeruleoalba) stranded on coasts from different European countries and from animals caught by fisheries. A total of 63 different restriction sites was mapped after digestion of mtDNA with 15 restriction endonucleases that yielded a total of 27 haplotypes. No haplotype was shared between Mediterranean and Atlantic areas. All the analyses indicate the existence of two different populations with a very limited gene now across the Strait of Gibraltar. [References: 26]},
