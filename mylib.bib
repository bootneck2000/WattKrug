@article{CapellaAlzueta2002,
  title = {Mortality and Anthropogenic Harassment of Humpback Whales along the {{Pacific}} Coast of {{Colombia}}},
  author = {Capella Alzueta, Juan and {Florez-Gonzalez}, Lilian and Falk Fernandez, Patricia},
  year = {2002},
  volume = {47},
  pages = {547--553},
  abstract = {Reports of humpback whale, Megaptera novaeangliae, mortality and harassment in Pacific waters of Colombia from 1986-2000 were analysed to determine annual frequency, location, month of occurrence, age class and potential cause. Of the 24 records, 4 were published reports and 20 collected by the authors. Significantly more animals were found dead or entangled during the 1996-2000 period (n=18), than previous years 1986-1990 and 1991-95 (n=6). Of all deaths and harassments 54.2\% were calves, 41.7\% adults and 4.2\% juveniles, with the number of calves being significantly high, considering that the calf vs adult population ratio was consistent with 3:7 hypotheses. Deaths/harassments were more common in the Negritos Banks area (54\%), followed by the Gorgona-mainland (21\%), Bahia Solano-Utria sound (12.5\%) and other areas (12.5\%). Greatest incidence (87.5\%) was in the second half of the year: August (n=6), September (n=5) and October (n=6). Two calf strandings were recorded early in the year, one in February and one in April and probably originated from the Northern Hemisphere population. Annual frequency of occurrence over the 15-year period indicates an increasing trend of entanglement and vessel strike since 1996. For 24 reported events the cause of death was unknown in 9 and of the remaining 15, 1 was from natural causes with 14 showing signs of anthropogenic influence: 10 entangled, 3 from vessel strike and 1 exhibiting marks consistent with a hunting attempt.},
  journal = {Memoirs of the Queensland Museum},
  keywords = {[07512] Ecology: environmental biology - Oceanogra,[37056] Public health: epidemiology - Miscellaneou,[85810] Balaenopteridae,adult,annual frequency,anthropogenic harassment,Balaenopteridae: Animals,cal,Cetacea,Cetaceans,Chordates,entanglement,Environmental Sciences,Epidemiology: Population Studies,hunting attempt,Ma,Mammalia,Marine Ecology: Ecology,Megaptera novaeangliae: humpback whale,mortality,natural death,Verteb,vessel strike},
  number = {2}
}

