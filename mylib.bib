  keywords = {Animals,Artiodactyls,Biochemical Studies/Nucleic Acids,Biochemical Studies/Proteins,Blood,Blood-Forming Organs and Body Fluids/Blood,Bovidae [85715],Bovidae: Artiodactyla,bovine (Bovidae),Cetaceans,Chord,Chorda,Chordat,Chordata,Chordates,Cytology and Cytochemistry/Animal [02506],Cytology and Cytochemistry/Human [02508],Delphinidae: Cetacea,flavocytochrome b,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/General [03502],Genetics and Cytogenetics/Human [03508],gp91-phox,gp91-phox cDNA,Hominidae: Primates,human (Hominidae),Humans,immune system,Immune System (Chemical Coordination and Homeostas,Immunology and Immunochemistry/General,leukocyte: blood and lymphatics,Mammalia,Mammals,Methods [34502],mi,Molecular Genetics (Biochemistry and Molecular Bio,mouse (Muridae),Muridae: Rodentia,Nonhuman Mammals,Nonhuman Vertebrates,p22-phox,p22-phox cDNA,Peptides and Amino A,porcine (Suidae),Primates,Purines and Pyr,Rattus (Muridae),Rodents,Suidae: Artiodactyla,Tursiops truncatus [bottle-nosed dolphin] (Delphin,Vertebrata,Vertebrates},
  number = {1-2}
}

@article{Inoue2001,
  title = {Molecular Cloning and Functional Expression of Bottle-Nosed Dolphin ({{Tursiops}} Truncatus) Interleukin-1 Receptor Antagonist},
  author = {Inoue, Yuuki and Itou, Takuya and Jimbo, Tomoyo and Syouji, Youko and Ueda, Kenji and Sakai, Takeo},
  year = {2001},
  volume = {78},
  pages = {131--141},
  abstract = {The bottle-nosed dolphin (Tursiops truncatus) interleukin-1 receptor antagonist IL-1ra cDNA was cloned from mitogen-stimulated peripheral blood mononuclear cells (PBMC) RNA utilizing the reverse transcription-polymerase chain reaction (RT-PCR). The sequence of this cDNA showed that dolphin IL-1ra clones contained open reading frames encoding 177 amino acids. Comparison of the deduced amino acids showed that dolphin IL-1ra sequence shared 87.6, 77.9, 77.4, 77.4, 76.4, and 75.8\% similarity with the bovine, rabbit, equine, human, mouse, and rat IL-1ra sequences, respectively. Recombinant glutathione S-transferase (GST) dolphin IL-1ra produced in Escherichia coli (E. coli) was purified. This protein suppressed the cytostatic activity of dolphin IL-1beta on A375S2 cells, indicating that the dolphin IL-1ra cDNA obtained in the present study encodes biologically active dolphin IL-1ra.},
  journal = {Veterinary Immunology and Immunopathology},
  keywords = {Animals,Biochemical Studies/Nucleic Acids,Blood,Blood-Forming Organs and Body Fluids/Blood,bottle-nosed dolphin [Tursiops truncatus] (Delphin,bottle-nosed dolphin interleukin-1 receptor antago,bottle-nosed dolphin interleukin-1-beta: functiona,Cetaceans,Chorda,Chordates,Cytology and Cytochemistry/Animal [02506],Delphinidae [85815],Delphinidae: Cetacea,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/General [03502],Immune System (Chemical Coordination and Homeostas,Immunology and Immunochemistry/General,Immunology and Immunochemistry/Immunopathology,inflammatory disease: immune system disease,Mammalia,Mammals,Methods [34502],Methods [38002],Molecular Genetics (Biochemistry and Molecular Bio,Nonhuman Mammals,Nonhuman Vertebrates,peripheral blood mononuclear cell [PBMC]: blood an,Purines and Pyr,Ti,Vertebrata,Vertebrates,Veterinary Medicine (Medical Sciences),Veterinary Science/General,Veterinary Science/Pathology [38004]},
