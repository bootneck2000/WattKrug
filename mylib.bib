@misc{Agathos2011,
  title = {In Vivo Calcification of Glutaraldehyde-Fixed Cardiac Valve and Pericardium of {{Phoca}} Groenlandica.},
  author = {Agathos, E Andreas and Shen, Ming and Katsiboulas, Michalis and Koutsoukos, Petros and Gloustianou, Georgia},
  year = {2011},
  volume = {57},
