@article{Martensson1998,
  title = {Gut Length, Food Transit Time and Diving Habit in Phocid Seals},
  author = {Martensson, P-E. Per-Erik and Nordoy Erling, S and Messelt Edward, B and Blix Arnoldus, Schytte and Nordoy, Erling S and Messelt, Edward B and Blix, Arnoldus Schytte and Norday, E S and Messelt, Edward B and Blix, Arnoldus Schytte and Martenssen, P E and Nordoy, Erling S and Messelt, Edward B and Blix, Arnoldus Schytte and M{\aa}rtensson, P.-E. and Nord{\o}y, E S and Messelt, Edward B and Blix, Arnoldus Schytte},
  year = {1998},
  volume = {20},
  pages = {213--217},
  abstract = {The southern elephant seal (Mirounga leonina) has the ability to dive for 2 h and reach depths of 1200 in. This creature is also exceptional in having a small intestine that is 25 times body length. Krockenberger and Bryden advanced the hypothesis that the long small intestine has developed to compensate for the extended periods with reduced or even abolished intestinal blood perfusion during diving. To test this hypothesis we have measured small-intestinal lengths in crabeater (Lobodon carcinophagus), Weddell (Leptonychotes weddellii), Ross (Ommatophoca rossi), leopard (Hydrurga leptonyx), harp (Phoca groenlandica), ringed (Phoca hispida) and hooded (Cystophora cristata) seals and related them to available data on their maximal dive duration. We found no significant correlation (P \textquestiondown{} 0.05) between intestinal length relative to body length and diving ability, but we found that small-intestinal internal area was significantly (P \textexclamdown{} 0.05) related to body length. A crude scanning electron microscopical examination of the small intestines of Weddell, crabeater, hooded and harp seals failed to reveal any gross anatomical differences between small-intestinal surfaces. This suggests that gut dimension in this variety of phocid species with widely differing diving ability is not related to diving habit, but is instead related to body size. The transit time of digesta was determined in two 1-year-old harp seals by use of radiopaque polyethylene rings of 4-mm diameter followed by X-ray examination, as markers for the solid phase passage, and chromium ethylene-diaminetetra acetic acid (Cr-EDTA) as a marker for the liquid phase. The transit time for the Cr- EDTA marker was 6.9 h +- 0.5 SE (range 4.5-8 h, n = 7), while 80\% of the polyethylene markers appeared in the colon after 17,6 h +- 1.0 SE (range 14-21.5 h, n = 6) and were sometimes retained in the colon for several hours before defecation. These transit times did not change significantly (P \textquestiondown{} 0.05) in response to repetitive diving over a period of 8 h. This indicates that the often-used Cr-EDTA is not a good measure for digesta passage time when used alone in seals, and that the hypothesis of Krockenberger and Bryden is most likely wrong.},
  journal = {Polar Biology},
  keywords = {6468,anatomy,Animals. Chordates. Mammals. Nonhuman Mammals. Non,Behavioral Biology/Animal Behavior [07003],Chorda,Cystophora cristata,Cystophora-cristata [hooded seal] (Phocidae). Hydr,Dental and Oral System (Ingestion and Assimilation,Digestive System/General,dive depth. diving habitat. food transit time.,diving,Ecology,Environmental Biology/Wildlife Management-Aquatic,Hydrurga leptonyx,length.,Leptonychotes weddellii,Lobodon carcinophagus,Mammalia,Methods [14001],Ommatophoca rossi,passage rate,Phoca groenlandica,Phoca hispida,Phocidae [86185],Phocidae: Pinnipedia,small intestine: digestive system,Vertebrata},
  mendeley-tags = {6468},
  number = {3}
}

