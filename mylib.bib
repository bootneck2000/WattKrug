@article{Natarajan1996,
  title = {The Mathematical Modelling of Recombinant Behaviour of {{DNA}}},
  author = {Natarajan, P and Raj, C P},
  year = {1996},
  volume = {55},
  pages = {942--947},
  abstract = {The notion of splicing system in genetic engineering has been used to abstract the process of DNA digestion by restriction enzymes and subsequent relegation. In the present paper, biological aspects of DNA, restriction enzymes and recombinant behaviour of DNA under the influence of so-called enzymes are dealt for the creation of splicing systems. Fundamental concepts about semigroups and relations are presented briefly for the sole purpose of defying dominoes, a special algebraic structure, and the splicing product operation on the wit of dominoes. This process results in the creation of splicing semigroups. Finally, these two mathematical models for identifying recombinant behaviour of DNA, namely splicing systems and splicing semigroups are compared.},
