  year = {1984},
  volume = {13},
  pages = {95--100},
  abstract = {Weddell seal samples taken from the Antarctic were contaminated with chlordane compounds..SIGMA.Chlordane (cis-chlordane + cis-nonachlor + trans-nonachlor + oxychlordane) was present in blubber of seals at the range of 12-62 ng/g fresh wt. The order of chlordane compound concentrations was trans-nonachlor \textquestiondown{} oxychlordane \textquestiondown{} cis-nonachlor \textquestiondown{} cis-chlordane. Relative abundance of cis-chlordane in .SIGMA.chlordane was higher than that in humans. A probable explanation for their occurrence in the Antarctic was airborne transport.},
