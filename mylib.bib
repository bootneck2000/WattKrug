@incollection{Donovan1993,
  title = {Reports of the {{International Whaling Commission Special Issue}}, 14. {{Biology}} of Northern Hemisphere Pilot Whales},
  booktitle = {Report of the International Whaling Commission Special Issue; Biology of Northern Hemisphere Pilot Whales},
  author = {Donovan, G P and Lockyer, C H and Martin, A R},
  editor = {{P} and Lockyer, C H and Martin, A R},
  year = {1993},
  pages = {x+479},
  publisher = {{Cambridge University Press, The Pitt Building, Trumpington Street, Cambridge CB2 1RP, England, Cambridge University Press, 40 W. 20th Street, New York, New York 10011-4211, USA}},
  abstract = {The Faroe Islands (Danish territory in the North Atlantic between Scotland and Iceland) are the site of a year-around subsistence pilot whale fishery. This book presents the results of a series of studies of long-finned pilot whales undertaken by scientists and volunteers in cooperation with the fishermen's activities. Twenty papers examine diverse aspects of the biology of this species, Globicephala melas. Topics include distribution and abundance in the North Atlantic, external characteristics, age and growth, reproductive maturity, body fat seasonality, pollutants in blubber and muscle, parasites, and mass strandings (not caused by fishery activity). In addition, three papers discuss aspects of the biology of short-finned pilot whales in the North Pacific. The text is illustrated and heavily referenced but not indexed.},
