@article{Lindstrom,
  title = {Feeding Habits of Western {{North Pacific}} Minke Whales, {{Balaenoptera}} Acutorostrata, as Observed in {{July}}-{{September}} 1996},
  author = {Lindstrom, Ulf and Fujise, Yoshihiro and Haug, Tore and Tamura, Tsutomu},
  volume = {0},
  pages = {463--469},
  abstract = {As a part of the Japanese Whale Research Program in the North Pacific (JARPN), the possible ecological role of the western North Pacific minke whale, Balaenoptera acutorostrata, population is being investigated. Stomach content samples from 77 minke whales, caught during a research cruise in July-September 1996, were collected in four selected Sub-Areas north and east of Japan. Analyses of the samples showed that epipelagic fish and krill dominated the whales diets. In the more offshore Pacific Sub-Areas (7E and 8), the diets were dominated by Pacific saury, Cololabis saira, while the importance of krill, Euphausia pacifica, increased in the more coastal Sub-Areas (7W and 11). In the coastal Sub-Area north of Japan (Okhotsk Sea), minke whales fed exclusively on krill. The biomass of the stomach contents varied considerably during the day. There was a tendency towards increasing feeding activity in the morning and in the evening as compared to other times of the day.},
  journal = {Report of the International Whaling Commission},
  number = {48}
}

