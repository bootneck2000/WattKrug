@article{Reeb2005,
  title = {Evidence of Postnatal Ecdysis in Southern Right Whales, {{Eubalaena}} Australis},
  author = {Reeb, Desray and Duffield, Maureen and Best, Peter B},
  year = {2005},
  volume = {86},
  pages = {131--138},
  abstract = {This paper presents evidence of the presence and subsequent loss of postnatal skin in an ecdysis-like process in southern right whales, Eubalaena australis. Individuals whose skin was noticeably uneven, spongy, broken, and often light gray in color formed gtoreq20\% of right whale neonates seen on the South African coast on any day up to and including the 1st week of September. Thereafter gtoreq85\% of calves were of the normal, smooth-skinned appearance. The 50\% transition point between the 2 forms occurred on 31 August (95\% CI 1.1 days), or about a week after birth. Histological analysis of skin from stranded neonates showed a definite cleavage plane in the midepidermis, the mechanical integrity of which was further compromised by low concentrations of desmosomes and intracellular filaments. We propose that focal edema develops between the cells and forms the cleavage plane, which eventually leads to separation of the outer epidermal cell layer (cf. spongiosis in humans). The movement from the intrauterine to the oceanic milieu, and the osmoregulatory consequences thereof, may be a catalytic factor for this process to occur. This ecdysis may have important consequences for the cyamid fauna of neonatal fight whales.},
  journal = {Journal of Mammalogy},
  keywords = {[07508] Ecology: environmental biology - Animal,[18504] Integumentary system - Physiology and bioc,[25502] Development and Embryology - General and d,[37001] Public health - General and miscellaneous,[85805] Balaenidae,Balaenidae: Animals,Cetacea,Cetaceans,Chordates,Development,ecdysis,epidermis: integumentary system,Eubalaena australis: species,Integumentary System: Chemical Coordination and Ho,Mammalia,Mammals,Population Studies,skin: integumentary system,southern right whale,spongiosis,Vertebrata},
  number = {1}
}

