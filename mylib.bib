}

@article{Roman2003,
  title = {Whales before Whaling in the {{North Atlantic}}},
  author = {Roman, Joe and Palumbi, Stephen R},
  year = {2003},
  volume = {301},
  pages = {508--510},
  abstract = {It is well known that hunting dramatically reduced all baleen whale populations, yet reliable estimates of former whale abundances are elusive. Based on coalescent models for mitochondrial DNA sequence variation, the genetic diversity of North Atlantic whales suggests population sizes of approximately 240,000 humpback, 360,000 fin, and 265,000 minke whales. Estimates for fin and humpback whales are far greater than those previously calculated for prewhaling populations and 6 to 20 times higher than present-day population estimates. Such discrepancies suggest the need for a quantitative reevaluation of historical whale populations and a fundamental revision in our conception of the natural state of the oceans.},
  journal = {Science (Washington D C)},
  keywords = {[03506] Genetics - Animal,[03509] Genetics - Population genetics,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[10062] Biochemistry studies - Nucleic acids,[85800] Cetacea,[85805] Balaenidae,[85810] Balaenopteridae,Animalia,Balaenidae: Animals,Balaenoptera acutorostrata: species,Balaenoptera physalus: species,Balaenopteridae: Animals,Cetacea,Cetacea: Animals,Cetaceans,Chordata,Chordates,common [Balaenidae],common [Balaenopteridae],Environmental Sciences,Eubalaena glacialis: species,fin whale,humpback whale,Mammalia,Mammals,Marine Ecology: Ecology,Megaptera novaeangliae: species,minke whale,mitochondrial DNA: sequence variation,Nonhuman Mammals,Nonhuman Vertebrates,Northern right whale,Population Genetics: Population Studies,population size,purines and pyrimidines,Vertebrata,Vertebrates,whale: common [Cetacea],whaling},
