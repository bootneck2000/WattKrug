@article{Arthur2008,
  title = {Ontogenetic Changes in Diet and Habitat Use in Green Sea Turtle ({{Chelonia}} Mydas) Life History},
  author = {Arthur, Karen E. and Boyle, Michelle C. and Limpus, Colin J.},
  year = {2008},
  volume = {362},
  pages = {303--311},
  issn = {01718630},
  doi = {10.3354/meps07440},
  abstract = {Green turtles Chelonia mydas are endangered, long-lived marine reptilesdisplay an ontogenetic shift in diet and habitat use during. During their early life stage, juvenile green turtles insouthwestern Pacific inhabit the pelagic zone where they feedon neustonic material. At approximately 44 cm curvedlength they recruit to inshore foraging habitats where theyprimarily herbivorous. In this study we investigate the change inisotope (delta C-13 and delta N-15) composition of green turtletissue throughout their life history to examine thisshift in diet and habitat as it occurs in a southwesterngreen turtle population. Turtles that had recently recruited togrounds in Moreton Bay, Australia had significantly higherN-15 isotopic signatures when compared with all other life historyexamined and significantly lower delta C-13 when compared withage classes other than pelagic juveniles. Adult and large immaturehad similar isotopic signatures and were both significantlyin C-13 when compared with hatchlings and small immature. These results support previous observations that suggestjuveniles are foraging in a different habitat and at a higherlevel than turtles captured in the neritic environment. This isfirst study to capture the entire life history of green turtles inof foraging ecology and supports the ontogenetic shift previouslyin traditional diet and behavioral studies of green turtles.},
  isbn = {0171-8630},
  journal = {Marine Ecology Progress Series},
  keywords = {?? 13C,?? 13N,Chelonia mydas,Green turtle,Stable isotope analysis,Trophic shift},
  language = {English}
}

@article{Arthur2015,
  title = {Return Customers: {{Foraging}} Site Fidelity and the Effect of Environmental Variability in Wide-Ranging Antarctic Fur Seals},
  author = {Arthur, Benjamin and Hindell, Mark and Bester, Marthan and Trathan, Phil and Jonsen, Ian and Staniland, Iain and Oosthuizen, W. Chris and Wege, Mia and Lea, Mary Anne},
  year = {2015},
  volume = {10},
  issn = {19326203},
  doi = {10.1371/journal.pone.0120888},
  abstract = {Strategies employed by wide-ranging foraging animals involve consideration of habitat quality and predictability and should maximise net energy gain. Fidelity to foraging sites is common in areas of high resource availability or where predictable changes in resource availability occur. However, if resource availability is heterogeneous or unpredictable, as it often is in marine environments, then habitat familiarity may also present ecological benefits to individuals. We examined the winter foraging distribution of female Antarctic fur seals, Arctocephalus gazelle, over four years to assess the degree of foraging site fidelity at two scales; within and between years. On average, between-year fidelity was strong, with most individuals utilising more than half of their annual foraging home range over multiple years. However, fidelity was a bimodal strategy among individuals, with five out of eight animals recording between-year overlap values of greater than 50\%, while three animals recorded values of less than 5\%. High long-term variance in sea surface temperature, a potential proxy for elevated long-term productivity and prey availability, typified areas of overlap. Within-year foraging site fidelity was weak, indicating that successive trips over the winter target different geographic areas. We suggest that over a season, changes in prey availability are predictable enough for individuals to shift foraging area in response, with limited associated energetic costs. Conversely, over multiple years, the availability of prey resources is less spatially and temporally predictable, increasing the potential costs of shifting foraging area and favouring long-term site fidelity. In a dynamic and patchy environment, multi-year foraging site fidelity may confer a long-term energetic advantage to the individual. Such behaviours that operate at the individual level have evolutionary and ecological implications and are potential drivers of niche specialization and modifiers of intra-specific competition.},
  isbn = {1932-6203},
  journal = {PLoS ONE},
  number = {3},
  pmid = {25807082}
}

