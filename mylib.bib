@article{Vetter2001,
  title = {Determination and Mass Spectrometric Investigation of a New Mixed Halogenated Persistent Component in Fish and Seal.},
  author = {Vetter, Walter and Hiebl, Josef and Oldham, Neil J},
  year = {2001},
  volume = {35},
  pages = {4157--4162},
  abstract = {An unknown component that caused an intense signal in sample extracts of fish tissue was enriched and investigated using a variety of mass spectrometric techniques coupled to gas chromatographic separation. With the help of electron capture negative ion mass spectrometry (ECNI-MS) and electron impact mass spectrometry (EI-MS) it was established that the component carries 2Br and 3Cl atoms and forms a molecular ion at m/z 396. A concentrated solution of this mixed halogenated compound (MHC-1) was investigated by gas chromatography interfaced to electron impact high-resolution mass spectrometry (GC/EI-HRMS). Using full scan and SIM techniques, the molecular formula of MHC-1 was established to be C10H13Br2Cl3. This points toward MHC-1 having a monoterpene backbone. No chemical with this molecular formula has been synthesized, but two components with this composition have been earlier isolated from marine algae.},
  journal = {Environmental Science \& Technology},
  keywords = {7337,7444,Cystophora cristata,Leptonychotes weddellii,Monachus monachus,Phoca groenlandica,pollution},
  mendeley-tags = {7337,7444},
  number = {21}
}

