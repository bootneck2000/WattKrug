@article{Maxwell2013,
  title = {Cumulative Human Impacts on Marine Predators.},
  author = {Maxwell, Sara M and Hazen, Elliott L and Bograd, Steven J and Halpern, Benjamin S and a Breed, Greg and Nickel, Barry and Teutschel, Nicole M and Crowder, Larry B and Benson, Scott and Dutton, Peter H and Bailey, Helen and a Kappes, Michelle and Kuhn, Carey E and Weise, Michael J and Mate, Bruce and a Shaffer, Scott and Hassrick, Jason L and Henry, Robert W and Irvine, Ladd and McDonald, Birgitte I and Robinson, Patrick W and a Block, Barbara and Costa, Daniel P},
  year = {2013},
  volume = {4},
  pages = {2688},
  issn = {2041-1723},
  doi = {10.1038/ncomms3688},
  abstract = {Stressors associated with human activities interact in complex ways to affect marine ecosystems, yet we lack spatially explicit assessments of cumulative impacts on ecologically and economically key components such as marine predators. Here we develop a metric of cumulative utilization and impact (CUI) on marine predators by combining electronic tracking data of eight protected predator species (n=685 individuals) in the California Current Ecosystem with data on 24 anthropogenic stressors. We show significant variation in CUI with some of the highest impacts within US National Marine Sanctuaries. High variation in underlying species and cumulative impact distributions means that neither alone is sufficient for effective spatial management. Instead, comprehensive management approaches accounting for both cumulative human impacts and trade-offs among multiple stressors must be applied in planning the use of marine resources.},
  archiveprefix = {arXiv},
  arxivid = {arXiv:1011.1669v3},
  eprint = {1011.1669v3},
  eprinttype = {arxiv},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\V2MYP6LT\\Maxwell et al. - 2013 - Cumulative human impacts on marine predators.pdf},
  isbn = {2041-1723},
  journal = {Nature communications},
  pmid = {24162104}
}

@article{May-Collado2005,
  title = {Patterns of Cetacean Sighting Distribution in the {{Pacific Exclusive Economic Zone}} of {{Costa Rica}} Based on Data Collected from 1979-2001},
  author = {{May-Collado}, Laura and Gerrodette, Tim and Calambokidis, John and Rasmussen, Kristin and Sereg, Irena},
  year = {2005},
  volume = {53},
  pages = {249--263},
  abstract = {Nineteen species of cetaceans (families Balaenopteridae, Kogiidae, Physeteridae, Ziphiidae and Delphinidae) occur in the Costa Rican Pacific Exclusive Economic Zone (EEZ). Based on data recorded from the EEZ by the Southwest Fisheries Service Center, Cascadia Research Collective, and CIMAR between 1979200 1, we mapped the distribution of 18 cetacean species. Our results suggest that the majority of the cetacean species use primarily oceanic waters, particularly those species within the families Balacnopteridae, Kogiidae, Physeteridae and Ziphiidae. Members of the family Delphinidae showed a wide variety of distribution patterns: seven species are widespread throughout the EEZ, four appear to be exclusively pelagic, and two are primarily coastal. Overall, three cetacean species appear to have populations concentrated in coastal waters: Slenella attenuala graffmani, Tursiops truncatus, and Megaptera novaeanglitie. These three may be more susceptible to human activities due to the overlap of their ranges with fishery areas (tuna and artisanal Fisheries), and an uncontrolled increase of touristic whale watching activities in several parts of their range. The distribution maps represent the first comprehensive representation of cetacean species that inhabit Costa Rican Pacific waters. They provide essential base-line information that may be used to initiate conservation and management efforts of the habitats where these animals reproduce and forage.},
  journal = {Revista de Biologia Tropical},
  keywords = {[00504] General biology - Taxonomy,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[62520] Chordata: general and systematic - Mammali,[85810] Balaenopteridae,[85815] Delphinidae,[85830] Physeteridae,[85840] Ziphiidae,Balaenoptera borealis: species [Balaenopteridae],Balaenoptera edeni: species [Balaenopteridae],Balaenoptera physalus: species [Balaenopteridae],Balaenopteridae: Animals,Cetacea,Cetaceans,Chordates,Delphinidae: Animals,Delphinus delphis: species [Delphinidae],Environmental Sciences,Globicephala macrorhynchus: species [Delphinidae],Grampus griseus: species [Delphinidae],Kogia sima: species [Physeteridae],Lagenodelphis hosei: species [Delphinidae],Ma,Mamma,Mammal,Mammalia,Mammals,Marine Ecology: Ecology,Megaptera novaeangliae: species [Balaenopteridae],Mesoplodon densirostris: species [Ziphiidae],nomenclature a,Orcinus orca: species [Delphinidae],Peponocephala electra: species [Delphinidae],Physeter macrocephalus: species [Physeteridae],Physeteridae: Animals,Pseudorca crassidens: species [Delphinidae],Stenella attenuata graffinani: subspecies [Delphin,Stenella coeruleoalba: species [Delphinidae],Stenella longirostris: species [Delphinidae],Steno bredanensis: species [Delphinidae],Systematics and Taxonomy,Tursiops truncatus: species [Delphinidae],Verteb,Vertebrat,Vertebrata,Ziphiidae: Animals,Ziphius cavirostris: species [Ziphiidae]},
