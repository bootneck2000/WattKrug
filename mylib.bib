@article{Yu2005,
  title = {A Quantitative Assay for Linking Microbial Community Function and Structure of a Naphthalene-Degrading Microbial Consortium},
  author = {Yu, C P and Chu, K H},
  year = {2005},
  volume = {39},
  pages = {9611--9619},
  doi = {10.1021/es051024e},
  abstract = {A comprehensive culture-independent assay, called G-FAST, was developed for concurrent identification and quantification of active microorganisms involved a specific function in a given microbial community. The development of G-FAST was achieved by integrating the concept of stable isotope probing technique into a new quantitative fingerprinting assay called real-time-t-RFLP for microbial community structure analysis. The G-FAST was successfully validated by using a three-member artificial microbial community containing a known naphthalene-utilizing bacterium (Pseudomonas putida G7) and two nonnaphthalene-degrading bacteria (Escherichia coli and Bacillus thuringiensis). The application of G-FAST to identify and quantify a guild of naphthalene-utilizing microorganisms in soils revealed the involvement of eight members, with six members relating to several phylogenetic groups of eubacteria (three in beta-proteobacteria, two in gamma-proteobacteria, and one in genera Intrasporangium of Gram-positive bacteria) and two members showing no close phylogenetic affiliation to any known bacterial sequences deposited in GenBank. The quantity of three members belonging to beta-proteobacteria accounted for 34\% of total 16S rDNA copies measured from the "heavier" fraction of DNA that was contributed from the DNA of microorganisms capable of incorporating C-13-labeled naphthalene into their genetic biomarkers. The other five members composed 66\% of total 16S rDNA copies of active naphthalene-utilizing populations measured. Offering a powerful tool for studying microbial ecology, Q-FAST thus opens a new avenue for deeper exploration of microbial-mediated processes, mainly the quantitative relationship between microbial diversity and microbial activity in a given environment.},
  isbn = {0013-936X},
  journal = {Environmental Science \& Technology},
  keywords = {BACTERIA,BIODEGRADATION,DEGRADATION,DIVERSITY,FRAGMENT-LENGTH-POLYMORPHISM,MARINE-SEDIMENTS,PSEUDOMONAS-PUTIDA,RIBOSOMAL-RNA ANALYSIS,SOIL,WASTE-WATER},
