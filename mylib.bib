@article{Lake1997,
  title = {Influence of Time of Day and Month on {{Weddell}} Seal Haul-out Patterns at the {{Vestfold Hills}}, {{Antarctica}}},
  author = {Lake, S E and Burton, H R and Hindell, M A},
  year = {1997},
  volume = {18},
  pages = {319--324},
  abstract = {A diurnal pattern in haul-out behaviour has been described for Weddell seals at McMurdo Sound, Antarctica, but regional and seasonal variations were previously unknown. Knowledge of activity patterns is important for standardising census methods and census data. This study quantified the diurnal pattern in haul-out behaviour of Weddell seals at the Vestfold Hills from October 1994 to March 1995. Sequential counts of seals on the ice showed that, between 0900 and 1930 hours, seal abundance differed up to 95\%. Fewer seals were hauled out in the morning than in the afternoon. The maximum numbers of seals were hauled out at the warmest time of day. The diurnal cycle was less pronounced in the breeding season than in the moulting season. The findings indicated the importance of censusing Weddell seals after 1430 hours and before 1700 hours local time, especially in the moulting season. Correction factors are given for month and time of day.},
  journal = {Polar Biology},
  keywords = {5735,Activity Patterns. Behavior. Breeding Season. Diur,animals. chordates. mammals. nonhuman mammals. non,Antarctica (Antarctic Region).,Behavior. Ecology (Environmental Sciences).,Behavioral Biology/Animal Behavior [07003],Chorda,Ecology,Environmental Biology/General,haul-out behaviour,Leptonychotes weddelli (Phocidae). Weddell seal (P,Leptonychotes weddellii,Mammalia,Methods [07502],Phocidae [86185],Phocidae: Pinnipedia,Vertebrata},
  mendeley-tags = {5735},
