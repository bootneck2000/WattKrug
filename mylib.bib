@article{Baird2008,
  title = {Rapid {{SNP}} Discovery and Genetic Mapping Using Sequenced {{RAD}} Markers},
  author = {Baird, Nathan A. and Etter, Paul D. and Atwood, Tressa S. and Currey, Mark C. and Shiver, Anthony L. and Lewis, Zachary A. and Selker, Eric U. and Cresko, William A. and Johnson, Eric A.},
  year = {2008},
  month = oct,
  volume = {3},
  issn = {19326203},
  doi = {10.1371/journal.pone.0003376},
  abstract = {Single nucleotide polymorphism (SNP) discovery and genotyping are essential to genetic mapping. There remains a need for a simple, inexpensive platform that allows high-density SNP discovery and genotyping in large populations. Here we describe the sequencing of restriction-site associated DNA (RAD) tags, which identified more than 13,000 SNPs, and mapped three traits in two model organisms, using less than half the capacity of one Illumina sequencing run. We demonstrated that different marker densities can be attained by choice of restriction enzyme. Furthermore, we developed a barcoding system for sample multiplexing and fine mapped the genetic basis of lateral plate armor loss in threespine stickleback by identifying recombinant breakpoints in F2 individuals. Barcoding also facilitated mapping of a second trait, a reduction of pelvic structure, by in silico re-sorting of individuals. To further demonstrate the ease of the RAD sequencing approach we identified polymorphic markers and mapped an induced mutation in Neurospora crassa. Sequencing of RAD markers is an integrated platform for SNP discovery and genotyping. This approach should be widely applicable to genetic mapping in a variety of organisms.\textcopyright{} 2008 Baird et al.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\EMHCYDIA\\Baird et al. - 2008 - Rapid SNP discovery and genetic mapping using sequenced RAD markers.pdf},
  journal = {PLoS ONE},
  number = {10},
  pmid = {18852878}
}

