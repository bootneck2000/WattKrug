@article{Schrey2003,
  title = {Microsatellite Analysis of Population Structure in the Shortfin Mako ({{Isurus}} Oxyrinchus)},
  author = {Schrey, Aaron W and Heist, Edward J},
  year = {2003},
  volume = {60},
  pages = {670--675},
  abstract = {Microsatellite analysis of the shortfin mako shark (Isurus oxyrinchus) revealed very weak evidence of population structure. Samples collected from the North Atlantic, South Atlantic, North Pacific, South Pacific, and Atlantic, and Pacific coasts of South Africa were screened at four microsatellite loci. Multilocus measures of population subdivision were much lower than expected (FST = 0.0014, P = 0.1292; RST = 0.0029, P = 0.019). Power analysis revealed that the study had a high level of power (\textquestiondown 0.995) to detect the magnitude of FST expected based on a previous study of mtDNA and assumptions of equal male and female dispersal. Thus, integrating the results from microsatellite- and mitochondrial-based studies may provide evidence for gender-biased dispersal for the shortfin mako.},
  journal = {Canadian Journal of Fisheries and Aquatic Sciences},
  keywords = {[03502] Genetics - General,[03506] Genetics - Animal,[03509] Genetics - Population genetics,[07508] Ecology: environmental biology - Animal,[07512] Ecology: environmental biology - Oceanogra,[10062] Biochemistry studies - Nucleic acids,[85202] Chondrichthyes,c,Chondrichthyes: Animals,Chorda,Chordates,Environmental Sciences,Fish,gender-biased dispersal,Isurus oxyrinchus: species,Marine Ecology: Ecology,microsatellite loci,mitochondrial DNA: mtDNA,Molecular Genetics: Biochemistry and Molecular Bio,Nonhuman,Pisces,Population Genetics: Population Studies,population structure,population subdivision,puri,shortfin mako shark,Vertebrata},
