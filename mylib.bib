@article{Haque1977,
  title = {Observations on the Behavior and Other Biological Aspects of the Ganges Susu Platanista-Gangetica},
  author = {Haque, A K M A and Nishiwaki, M and Kasuya, T and Tobayama, T},
  year = {1977},
  pages = {87--94},
  abstract = {Observations on the behavior of the Ganges susu, P. gangetica (Roxburgh, 1801), indicated that these animals frequent the confluence of a smaller stream with the main river, even with over-flooded banks, for food fishes. Although they are side-swimming, the Ganges susu cruised with normal fish-like movements with the body in a normal, upright position. Breathing rate showed individual and diurnal variations, the rate being more for younger specimens, and slightly increased during the day. One susu was seen chasing a big fish at a tremendous speed, another attacked a goose and a 3rd attacked a fish caught by a hook and thereby got caught. Two others reportedly were seen in the act of mating about 1 h after sunset in Aug. 1959. Parturition in these animals appears to occur around May, with another peak possibly around Dec.},
  journal = {Scientific Reports of the Whales Research Institute Tokyo},
  keywords = {Animalia,Animals,Behavioral Biology/Animal Behavior [07003],Biochemical Studies/General [10060],Cetaceans,Chor,Chordata,Chordates,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Bioclimatology and Biometeor,Environmental Biology/Limnology [07514],Environmental Biology/Water Research and Fishery B,Fish,General and Systematic Zoology/Mammalia,Mammalia,Mammals,Methods [16501],Movement (1971- ) [12100],Nonhuman Mammals,Nonhuman Vertebrates,Nutrition/General Studies,Nutritional Status and,Pediatrics [25000],Pisces-Unspecified [85200],Pisces: Vertebrata,Platanistidae: Cetacea,Reproductive System/General,Respiratory System/Physiology and Biochemistry [16,Vertebrata,Vertebrates},
