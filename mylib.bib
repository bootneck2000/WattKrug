@article{Larsen1988,
  title = {{{LETTERS}}: {{Scientific}} Correspondence: {{Killer}} Whale-Minke Whale Interaction},
  author = {Larsen, Dotte},
  year = {1988},
  volume = {4},
  pages = {78},
  abstract = {In January, 1981 in the Erebus and Terror Gulf, off the Antarctic peninsula, the following cetacean encounter was witnessed: One portion, numbering approximately 10 animals, of a pod of minke whales was observed to be swimming in a straight line, diving and blowing in unison. As the animals gradually dispersed and appeared to be lunge-feeding they were joined by a pod, about equal in number, of killer whales. The two species intermingled, apparently ignoring one another, for a period of 1{$\frac{1}{2}$} h. The encounter culminated when an adult male orca and a minke of approximately the same size were observed to leap side by side and collide in mid-air, knocking each other away, each animal apparently indifferent to the other.},
