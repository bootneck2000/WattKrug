  keywords = {Animals. Cetaceans. Chordates. Mammals. Nonhuman M,Asia,Balaenopteridae [85810],Balaenopteridae: Cetacea,Bryde's whale (Balaenopteridae).,Ch,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Kochi (Japan,Mammalia,Palearctic region).,Resource Management,species abundance. species density.,Vertebrata,Wildlife Management (Conservation).},
  number = {47}
}

@misc{Kissel2011,
