@article{Moessner1997,
  title = {Marine Mammals as Global Pollution Indicators for Organochlorines.},
  author = {Moessner, Stephanie and Ballschmiter, Karlheinz and M{\"o}ssner, S and Ballschmiter, Karlheinz},
  year = {1997},
  volume = {34},
  pages = {1285--1296},
  abstract = {Blubber tissues of the following marine mammals differing in their geographic distribution (North Atlantic, North Pacific, Bering Sea/Arctic Ocean), trophic level, and feeding habits were analyzed for their organochlorine contents: two seal species (harbor seals - Phoca vitulina, northern fur seals Callorhinus ursinus), three toothed whale species (belukha whales - Delphinapterus leucas, one common dolphin - Delphinus delphis, one pilot whale - Globicephala melaena), and -one baleen whale species (a bowhead whale - Balaena mysticetus). As xenobiotics were quantified the seven indicator congeners of the polychlorinated biphenyls (PCB 28, 52, 101, 118, 138, 153, and 180), three isomers of the hexachlorocyclohexanes (alpha-, beta- and gamma-HCH) as well as six components of the DDT-group (4,4'-DDT, 4,4'-DDD, 4,4'-DDE, 2,4'-DDT, 2,4'-DDD, and 2,4'-DDE). When comparing the xenobiotic levels of these marine mammals, it showed that the animals from the western North Atlantic were contaminated about 15 times more with organochlorines than the animals from the eastern North Pacific and the Bering Sea/Arctic Ocean. The total organochlorine burden, the 4,4'-DDE-percentage as well as the metabolic PCB patterns correlate with the trophic levels of the marine mammals studied. The quantitative analyses were done by high-resolution capillary gas chromatography with electron capture detection (HRGC/ECD) whereas the analyses of the metabolic PCB patterns were done by highresolution capillary gas chromatography and mass selective detection (HRGC/MSD).},
  journal = {Chemosphere},
  keywords = {5198,animals,Atlantic Ocean (Atlantic Ocean),Balaena mysticetus (Balaenidae),Balaenidae [85805],Balaenidae: Cetacea,Biochemical Studies/General [10060],Biochemistry and Molecular Biophysics,Biphenyls,bowhead whale (Balaenidae),Callorhinus ursinus,Callorhinus ursinus (Otariidae),cetaceans,Chord,Chorda,Chordat,chordates,common dolphin (Delphinidae),Ddt,Delphinapterus leucas,Delphinapterus leucas (Monodontidae),Delphinidae: Cetacea,Delphinus delphis (Delphinidae),Ecology,Ecology (Environmental Sciences),Environmental Biology/Animal [07508],Globicephala melaena (Delphinidae),harbor seal (Phocidae),Hexachlorocyclohexanes,Mammalia,mammals,Metabolic Pathways [13002],Metabolism,Metabolism/General Metabolism,Monodontidae: Cetacea,nonhuman mammals,nonhuman vertebrates,North Atlantic (Atlantic Ocean),North Pacific (Pacific Ocean),northern fur seal (Otariidae),Otariidae: Pinnipedia,Pacific Ocean (Pacific Ocean),Phoca vitulina,Phoca vitulina (Phocidae),Phocidae: Pinnipedia,pilot whale (Delphinidae),pinnipeds,pollution,Pollution Assessment Control and Management,Public Health: Environmental Health/Air,Toxicology,Toxicology/Environmental and Industrial Toxicology,Vertebrata,vertebrates,Water and},
