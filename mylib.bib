@article{Paterson2014,
  title = {Behavioural Evolution in Penguins Does Not Reflect Phylogeny},
  author = {Paterson, Adrian M. and Wallis, Graham P. and Kennedy, Martyn and Gray, Russell D.},
  year = {2014},
  month = jun,
  volume = {30},
  pages = {243--259},
  issn = {10960031},
  doi = {10.1111/cla.12040},
  abstract = {Over the past two decades, behavioural biologists and ecologists have made effective use of the comparative method, but havestopped short of adopting an explicitly phylogenetic approach. We examined 68 behaviour and life history (BLH) traits of15 penguin species to: (i) infer penguin phylogeny, (ii) assess homology of behavioural characters, and (iii) evaluate hypothesescharacter evolution and ancestral states. Parsimony analysis of the BLH dataset found either two shortest trees (charactersas unordered) or a single shortest tree (characters coded as a combination of unordered and Dollo). The BLH data hadficant structure. Kishino\textendash Hasegawa tests indicated that BLH trees were significantly different from most previous estimatespenguin phylogeny. The BLH phylogeny generated from Dollo characters appeared to be less accurate than the tree derivedthe completely unordered dataset. Dividing BLH data into display and non-display traits resulted in no significant differ-in level of homoplasy and no difference in the accuracy of phylogeny. Tests for homology of BLH traits were performedmapping the characters onto a molecular tree. Assuming that independent gains are less likely than losses of character states,65 of the 68 characters were likely to be homologous across taxa, and at least several characters appeared to have been stablethe origin of modern penguins around 30 Myr. Finally, the likely BLH traits of the most recent common ancestor ofpenguins were reconstructed from character states along the internal branch leading to the penguins. This analysis sug-that the ``proto-penguin'' probably had a similar life history to current temperate penguins but few ritualized behaviours.southern, cool-temperate origin of penguins is suggested.},
  isbn = {1096-0031},
  journal = {Cladistics-the International Journal of The Willi Hennig Society},
  number = {3}
}

