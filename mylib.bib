@article{Roth1996,
  title = {Stable Carbon and Nitrogen Isotopic Fractionation between Diet and Tissue of Captive Seals: Implications for Dietary Reconstruction},
  author = {Roth, James D and a Hobson, Keith},
  year = {1996},
  volume = {78},
  pages = {848--852},
  issn = {0008-4301},
  doi = {10.1139/z00-008},
  abstract = {The amount of isotopic fractionation (change in isotope ratios) between diet and animal tissues is generally poorly known and may be affected by trophic position. Diet\textendash tissue fractionation of stable-carbon and -nitrogen isotopes was measured in several tissues of red foxes (Vulpes vulpes) raised on a commercial pellet feed. Stable carbon isotopic fractionation in red fox was positive for all tissues and was greatest in fur (2.6\textperthousand ), intermediate in muscle (1.1\textperthousand ), and least in liver and blood fractions (0.4\textendash 0.6\textperthousand ). These carbon isotope fractionation values were greater than those previ- ously measured for mammalian herbivores but were similar to values for marine mammals in most tissues. Little varia- tion in stable nitrogen isotopic fractionation occurred among tissues, except in the blood fractions. Nitrogen isotopic fractionation was much higher in blood serum (4.2\textperthousand ) than in liver, muscle, and fur (3.3\textendash 3.5\textperthousand ). Cellular fractions of blood had the lowest fractionation values (2.6\textperthousand ). There was a significant age effect in nitrogen- but not in carbon- isotopic fractionation. Subadult foxes (\textexclamdown 1 year) were significantly enriched in 15N compared with adult foxes for fur, muscle, and liver (no blood was collected from adults). The cause of this enrichment is unclear, but it may be related to the higher rate of protein synthesis and catabolism in growing animals. This study is the first to report isotopic frac- tionation values for a terrestrial mammalian carnivore. Such estimates are necessary to interpret stable-isotope patterns in wild carnivores.},
  isbn = {0008-4301},
  journal = {Canadian Journal of Zoology},
  keywords = {4336,diet,Phoca groenlandica,Phoca hispida,Phoca vitulina,stable isotopes},
  mendeley-tags = {4336,stable isotopes},
  number = {5},
  pmid = {4060}
}

