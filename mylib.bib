@article{Dolar1994,
  title = {Directed Fisheries for Cetaceans in the Philippines},
  author = {Dolar, Maria Louella L and Leatherwood, Stephen J and Wood, Colin J and Alava, Moonyeen Nida R and Hill, Cynthia L and Aragones, Lemneul V},
  year = {1994},
  volume = {0},
  pages = {439--449},
  abstract = {Directed fisheries for marine mammals in central and southern Visayas, northern Mindanao and Palawan, Philippines were investigated from archived reports and visits to sites where such fisheries are conducted. Hunters at four (Brooke's Point, Palawan; San Francisco, Negros; Selinog Island; and San Jose, Panay) take only dolphins, for bait or human consumption. The species taken are spinner dolphins, Stenella longirostris; Fraser's dolphins, Lagenodelphis hosei; pantropical spotted dolphins, Stenella attenuata; Risso's dolphins, Grampus griseus; melon-headed whales, Peponocephala electra; and short-finned pilot whales, Globicephala macrorhynchus. Hunters at one site (Pamilacan Island) take dolphins (primarily spinners), some small whales (at least melon-headed whales; pygmy sperm whale, Kogia simus; and beaked whale, Mesoplodon densirostris) and Bryde's whales, Balaenoptera edeni. Hunters at two sites (Lila, Bohol Island and Camiguin Island) take only balaenopterid whales for human consumption. Eight more areas were reported to have directed dolphin fisheries. Dolphins and whales are taken by hand harpoons or, increasingly, by togglehead harpoon shafts shot from modified, rubber-powered spear guns. Around 800 cetaceans are taken annually by hunters at the seven sites, mostly during the inter-monsoon period of February-May. Dolphin meat is consumed or sold in local markets and some dolphin skulls are cleaned and sold as curios. The methods of capturing the great whales are described. Carcasses from Pamilacan are usually towed to Lila, Bohol for butchering. Some meat is sold on Tagbilaran, Bohol. Those caught from Camiguin are butchered and sold on the island. On 16 December 1992 the Department of Agriculture issued Fisheries Administrative Order No. 185, 'banning the taking or catching, selling, purchasing, possessing, transporting and exporting of dolphins'. The order did not stop dolphin and whale hunting but seems to have decreased the sale of dolphin meat openly in the market. Investigations are encouraged to ensure that these artisanal whale fisheries operate within sustainable limits and do not export products illegally.},
  journal = {Report of the International Whaling Commission},
  number = {44}
}

@article{Dolar1997,
  title = {Preliminary Investigation of Marine Mammal Distribution, Abundance, and Interactions with Humans in the Southern {{Mulu}} Sea},
  author = {Dolar, M Louella L and Perrin, William F and Yaptinchay, Arnel Arnold S P and Jaaman, Saifullah Arifin B H and Santos, Mudjekeewis D and Alava, Moonyeen Nida and Suliansa, Muhammad Saini B},
  year = {1997},
  volume = {14},
  pages = {61--81},
  abstract = {A co-operative project between the Philippines and Malaysia to survey marine mammal distribution and abundance and investigate interactions with humans in the southern part of the Sulu Sea and northeastern Malaysian waters was carried out 7-21 May 1996. The survey covered an area of 30,730 km2 and an 'on-effort' trackline of 824.9 km. Density and abundance were estimated using the line transect method. Sixty-six cetacean sightings were made during the survey, with 10 species of cetaceans recorded. Eight of the ten species were sighted in Philippine waters: spinner dolphin, Stenella longirostris; pantropical spotted dolphin, S. attenuata; bottlenose dolphin, Tursiops truncatus; Fraser's dolphin, Lagenodelphis hosei; short-finned pilot whale, Globicephala macrorhynchus; Risso's dolphin, Grampus griseus; and Cuvier's beaked whale, Ziphius cavirostris. Two species were sighted in Malaysian waters: Irrawaddy dolphin, Orcaella brevirostris and hump-backed dolphin, Sousa chinensis. The Cuvier's beaked whales sighted during this survey were the first recorded for the Philippines. Density and abundance were estimated only for spinner, pantropical spotted and bottlenose dolphins; estimation for other species was not meaningful due to small sample size. Population size estimates were spinner dolphin = 3,979 (CV=0.59), pantropical spotted dolphin = 3,445 (CV=0.32), and bottlenose dolphin 415 (CV=0.96). Four of the seven fishing villages surveyed in the Philippines reported directed and/or incidental marine mammal takes (Risso's, spotted and bottlenose dolphins and dugongs), whereas only two of the six fishing villages visited in Malaysia reported takes (Irrawaddy dolphins and dugongs).},
  journal = {Asian Marine Biology},
  keywords = {Animal Distribution (1971- ) [62800],Animals,Cetaceans,Chorda,Chordata,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Environmental Biology/Wildlife Management-Aquatic,Environmental Sciences),General and Systematic Zoology/Mammalia,General Biology/Conservation,Globicephala macrorhynchus [short-finned pilot wha,Grampus griseus [Riss's dolphin] (Delphinidae),Lagenodelphis hosei [Fraser's dolphin] (Delphinida,Malaysia (Oriental region),Mammalia,Mammals,Marine Ecology (Ecology,Nonhuman Mammals,Nonhuman Vertebrates,Orcaella brevirostris [Irrawaddy dolphin] (Delphin,Pacific Ocean),Philippines (Oriental region),Population Studies,Resource Management,Sousa chinensis [hump-backed dolphin] (Delphinidae,Stenella attenuata [pantropical spotted dolphin] (,Stenella longirostris [spinner dolphin] (Delphinid,Sulu Sea (North Pacific,Tursiops truncatus [bottlenose dolphin] (Delphinid,Vertebrata,Vertebrates,Wildlife Management (Conservation),Ziphiidae: Cetacea,Ziphius cavirostris [Cuvier's beaked whale] (Ziphi},
  number = {0}
}

@article{Dolar1999,
  title = {Myoglobin in Pelagic Small Cetaceans},
  author = {Dolar, M L L and Suarez, P and Ponganis, P J and Kooyman, G L},
  year = {1999},
  volume = {202},
  pages = {227--236},
  abstract = {Although myoglobin (Mb) is considered to contribute significantly to the oxygen and diving capacity of marine mammals, few data are available for cetaceans, Cetacean by-catch in the tuna driftnet fisheries in the Sulu Sea, Philippines, afforded the opportunity to examine Mb content and distribution, and to determine muscle mass composition, in Fraser's (Lagenodelphis hosei) and spinner (Stenella longirostris) dolphins and a pygmy killer whale (Feresa attenuata). Age was estimated by body length determination. Stomach contents were analyzed for the presence or absence of milk and solid foods. It was hypothesized (a) that Mb concentration ([Mb]) would be higher in Fraser's and spinner dolphins than in other small cetaceans because of the known mesopelagic distribution of their prey, (b) that [Mb] would vary among different muscles according to function during diving, and (c) that [Mb] would increase with age during development. The results were as follows. ii) Myoglobin concentrations of the longissimus muscle in adult Fraser's (6.8-7.2 g 100 g(-1) muscle) and spinner (5-6 g 100 g(-1) muscle) dolphins and in an immature pygmy killer whale (5.7 g 100 g(-1) muscle) were higher than those reported previously for small cetaceans, (2) [Mb] varied significantly among the different muscle types in adult dolphins but not in calves; in adults, swimming muscles had significantly higher [Mb] than did non-swimming muscles, contained 82-86 \% of total Mb, and constituted 75-80 \% of total muscle mass. (3) Myoglobin concentrations in Fraser's and spinner dolphins increased with size and age and were 3-4 times greater in adults than in calves, The high Mb concentrations measured in the primary locomotory muscles of these pelagic dolphins are consistent with the known mesopelagic foraging behaviour of Fraser's and spinner dolphins and suggest that the pygmy killer whale is also a deep-diving species. The high Mb concentrations in epaxial, hypaxial and abdominal muscle groups also support the primary locomotory functions suggested for these muscles in other anatomical studies. As in other species. the increase in [Mb] during development probably parallels the development of diving capacity. [References: 58]},
  journal = {Journal of Experimental Biology},
  keywords = {6421,diving,myoglobin},
  mendeley-tags = {6421},
  number = {3}
}

