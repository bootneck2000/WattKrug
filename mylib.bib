@article{Anderson1987,
  title = {Grey Seal, \textexclamdown i\textquestiondown{{Halichoerus}} Grypus\textexclamdown/I\textquestiondown, Energetics: Females Invest More in Male Offspring},
  author = {Anderson, Sheila S. and Fedak, Michael A.},
  year = {1987},
  volume = {211},
  pages = {667--679},
  publisher = {{Natural Environmental Research Council Sea Mammal Research Unit. c/o British Antarctic Survey}},
  address = {{Cambridge}},
  issn = {09528369},
  doi = {10.1111/j.1469-7998.1987.tb04478.x},
  abstract = {Grey seal females transfer large amounts of energy to their pups during the brief lactation period. The costs of lactation have been measured using weight changes of mother and pup pairs. Large females come ashore to give birth earlier in the season and lose weight more rapidly than smaller females. The sex ratio of Grey seal pups born is skewed towards males in the early part of the breeding season. Male pups are larger at birth and gain weight more rapidly than female pups, and their mothers show a correspondingly faster rate of weight loss than mothers of female pups. The energy costs of gestation and lactation to a Grey seal mother are 31 GJ for male pups and2\textendash 8 GJ for female pups. Males are therefore 10\% more costly in energy terms to raise to weaning. Because, on average, large females arrive at breeding sites before smaller animals, biased results on weight changes would be obtained from methods which do not use repeated weighings. We suggest that the high efficiencies of lactation estimated for Harp seals compared with other phocid seals could be accounted for by such a bias.},
  journal = {Journal of Zoology},
  keywords = {3433,663,cost of reproduction,drugging,energetics,Halichoerus grypus,mass transfer,maternal investment,pinniped phocid maternal parental investment sex r},
  mendeley-tags = {3433,663},
