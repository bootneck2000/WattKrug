@article{Edds1987,
  title = {Occurrence and General Behavior of Balaenopterid Cetaceans Summering in the St. {{Lawrence}} Estuary Canada},
  author = {Edds, P L and Macfarlane, J A F},
  year = {1987},
  volume = {65},
  pages = {1363--1376},
  abstract = {Baleen whale movements were monitored from a hillside on the north shore of the St. Lawrence Estuary from 28 June to 27 September 1979. No diurnal or tidal relationships were apparent for the two most abundant species, the minke and finback. Single minke whales were seen almost daily. Adult pairs were only seen on four dates, and no adult-calf pairs were observed. Twenty-two small minkes were observed; three were possibly 1st-year calves. Finbacks occurred singly and in groups, particularly later in the field season. Resightings of distinctive finbacks indicate that adult pairings are temporary. One finback had been seen in the area in 1973-1975. Adult-calf pairs and seven single juveniles were also seen. Observations of finbacks pursued by whale watchers provide evidence that some regulation of the rapidly growing whale-watching industry may be warranted. Blue whales and humpback whales were seen far less frequently than minkes and finbacks. The relative abundances of minke, finback, and humpback were similar to 1973-1974 in the same area: however, blue whales were seen far more frequently in the past.},
  journal = {Canadian Journal of Zoology},
  keywords = {[00512] General biology - Conservation and resourc,[07003] Behavioral biology - Animal behavior,[07504] Ecology: environmental biology - Bioclimat,[07510] Ecology: environmental biology - Oceanogra,[07516] Ecology: environmental biology - Wildlife,[25508] Development and Embryology - Morphogenesis,[62510] Chordata: general and systematic - Pisces,[85810] Balaenopteridae,Balaenopteridae: Animals,baleen whale minke whale finback whale humpback wh,Behavior,Cetacea,Cetaceans,Chordates,Conservation,Development,Ma,Mammalia,Systematics and Taxonomy,Verteb,Wildlife Management: Conservation},
