  year = {1986},
  volume = {11},
  pages = {44--49},
  abstract = {The vigilance of a breeding group of Harbour seals (Phoca vitulina) was observed on Miquelon, a Department of France near Newfoundland, Canada. A large increase in scanning was recorded as the time for mating drew near. These changes were independent of the frequency of human disturbances. Adult males scanned more often if they were members of bigger herds, while other age/sex classes did not change their behavior as a function of group size. The results suggested that the seals were not scanning for predators or potential disturbances but for events important in their mating system.},
