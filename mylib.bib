@article{Ludwig1995,
  title = {{A population genetic study of Dall sheep (Ovis dalli dalli) in the southwestern Yukon Territory, Canada}},
  author = {Ludwig, J and Hoefs, M},
  year = {1995},
  volume = {41},
  pages = {256--266},
  abstract = {Upon comparing a protected with a hunted population of Dall sheep under the still natural conditions in the southwestern Yukon Territory, the pheno- and genotypic effects of hunting could be analyzed. The practice of hunting for trophies did not change the main structures of age and social behaviour within the population. The shooting of 3.8\% huntable rams cannot be the only reason for the shorter horns (4,9 cm) in the hunting area. There must be other (indirect) influences affecting the horn growth. For example, the shorter horns in the hunting area of the Ruby Range were demonstrably the result of continual anthropogenic disturbances. While horn length presumably as a reaction to environmental fluctuations, statistically shows great variability, the same cannot be said for environmental influences on horn circumference. The researched characteristics clearly show different levels of generic values. Horn length has a low (0.2-0.4) heritability coefficient, the horn circumference a high (0.5-0.7) heritability coefficient. Genetic changes due to the hunting of older rams could not be proven. The age structure and the generic disposition of the female Dall sheep is identical with that of the males. The female population thus provides a buffering effect for any genetic changes within the total population. In retrospect total protection of the sheep in the investigated area results in an increased population, while overdue hunting pressure contributes to a decline in the sheep population.},
  isbn = {0044-2887},
  journal = {Zeitschrift Fur Jagdwissenschaft},
  language = {German},
  number = {4}
}

