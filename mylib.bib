@article{Hubard2004,
  title = {Seasonal Abundance and Site Fidelity of Bottlenose Dolphins ({{Tursiops}} Truncatus) in {{Mississippi}} Sound},
  author = {Hubard, Carrie W and {Maze-Foley}, Kathy and Mullin, Keith D and Schroeder, William W},
  year = {2004},
  volume = {30},
  pages = {299--310},
  abstract = {Line-transect and photo-identification methods were used to examine bottlenose dolphin (Tursiops truncates) abundance and site fidelity in a 446 km2 portion of the Mississippi Sound in the north-central Gulf of Mexico from May 1995 through September 1996. For estimating density and abundance, north-south transect lines were surveyed using a 6.4-m boat. The density and abundance of dolphins in the area surveyed within Mississippi Sound varied seasonally, peaking in summer 1995 with 1.3 dolphins/km2 and 584 dolphins (CV = 0.17), and dropping to a low in fall 1995 with 0.6 dolphins/km2 and 268 dolphins (CV = 0.23). Density estimates were comparable to previous seasonal estimates for Mississippi Sound. Dolphins were widely distributed throughout the study area during all seasons. Group sizes ranged from I to 50 dolphins with an overall median of 4.0 ((x)over bar\textquestiondown{} = 6.5, SE = 0.45, n = 288). Group size varied by season, with the smallest groups in fall and winter (median = 3.0 for each), slightly larger groups in spring (median = 3.5), and largest groups during the summers (median = 5.0 and 5.5). Groups containing calves were significantly larger than groups without calves (median = 10.0 and 3.0, respectively) (p ltoreq 0.001). Five hundred fifteen individuals were photo-identified, but resighting rates were low, with a mean of 1.57 sightings/dolphin. The most frequently sighted dolphin was observed on six occasions. Evidence of site fidelity over various time scales was found, including possible long-term site fidelity. Two dolphins first photographed in 1991 and two dolphins freeze-branded in 1982-1983 were resighted during this study.},
  journal = {Aquatic Mammals},
  number = {2}
}

