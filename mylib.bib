  title = {Banded Karyotypes of 3 Whales Mesoplodon-Europaeus Mesoplodon-Carlhubbsi and Balaenoptera-Acutorostrata},
  author = {Arnason, U and Benirschke, K and Mead, J G and Nichols, W W},
