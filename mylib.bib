@misc{Aguilar1985,
  title = {Compartmentation an Dreliability of Sampling Procedures in Organochlorine Pollution Surveys of Cetaceans},
  author = {Aguilar, A},
  year = {1985},
  volume = {95},
  pages = {91--115},
  issn = {0080-181X},
  abstract = {The distribution pattern of organochlorine pollutants in the tissues of cetaceans and the reliability of blubber as an indicator fo the total pollution burden of the body are examined by menas of the compartmental model. The distribution of the various lipophilic xenobiotics seems to be conditioned by the limpid composition of the tissue and essentially linked to triglycerides. It is suggested that polar affinities between different kinds of lipids and organochlorines affect the constant rates of tdistribution. Thus differences in residue levels between brain and other organs are attributed to the particular lipidic composition of the nervous system rather to the blocking effect of the hematoencephalic barrier. As a consequence, possibilities of monitoring incidence of organochlorines on cetaceans on a whole-body basis are stressed. Various aspects of blubber fat deposition and mobilization are examined, and it is finally concluded that concentrations of pollutants may be substantially affected by nutritional or other physiological peculiarities of each specimen. Since blubber is not considered to be an homogeneous tissue and stratification and differential distribution of lipids are thought to affect spreading of organochlorines within blubber, sampling of this tissue becomes uncertain.},
  isbn = {0080-181X (Print){\r 0}080-181X (Linking)},
  journal = {Residue reviews},
