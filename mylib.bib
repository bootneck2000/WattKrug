@article{Hiby2001,
  title = {A Note on an Automated System for Matching the Callosity Patterns on Aerial Photographs of Southern Right Whales},
  author = {Hiby, Lex and Lovell, Phil},
  year = {2001},
  volume = {2},
  pages = {291--295},
  abstract = {Photographs showing the callosity patterns of southern right whales (Eubalaena australis) are currently compared by eye to identify individuals and monitor their occurrence within certain areas. This paper describes software designed to reduce the number of by eye comparisons required to maintain each of the existing local photo-identification catalogues. The software is used to extract, from each photograph, a viewpoint-independent description of the shape and location of each callosity which generates a parallel catalogue of extracts. This is then compared with the description extracted from each new photograph to generate a list of similarity scores and thus highlight likely matches. The software can also be used to compare the different catalogues of extracts with each other. Using a test set of 67 photographs of 23 whales taken from 1974 to 1986, the software reduced the number of by eye comparisons required to identify all individuals by 93\% when compared with a purely random search.},
  journal = {Journal of Cetacean Research \& Management Special Issue.},
  keywords = {[00512] General biology - Conservation and resourc,[00530] General biology - Information,[07502] Ecology: environmental biology - General a,[07516] Ecology: environmental biology - Wildlife,[85805] Balaenidae,aerial photography: identification method,Apparatus,automated callosity pattern matching software: com,Balaenidae: Animals,callosity patterns,Cetacea,Cetaceans,Chordates,Computer Applications: Computational Biology,Devices and Instrumentation,documentati,Equipment,Eubalaena australis: southern right whale,imaging,Mammalia,Mammals,protect,Vertebrata,Wildlife Management: Conservation}
