@article{Flint1999,
  title = {Minisatellite Mutational Processes Reduce {{F}}-St Estimates},
  author = {Flint, J and Bond, J and Rees, D C and Boyce, A J and {Roberts-Thomson}, J M and Excoffier, L and Clegg, J B and Beaumont, M A and Nichols, R A and Harding, R M},
  year = {1999},
  volume = {105},
  pages = {567--576},
  abstract = {We have used a new method for binning minisatellite alleles (semi-automated allele aggregation) and report the extent of population diversity detectable by eleven minisatellite loci in 2689 individuals from 19 human populations distributed widely throughout the world. Whereas population relationships are consistent with those found in other studies, our estimate of genetic differentiation (F-st) between populations is less than 8\%, which is lower than comparative estimates of between 10\%-15\% obtained by using other sources of polymorphism data. We infer that mutational processes are involved in reducing F-st estimates from minisatellite data because, first, the lowest F-st estimates are found at loci showing autocorrelated frequencies among alleles of similar size and, second, F-st declines with heterozygosity but by more than predicted assuming simple models of mutation. These conclusions are consistent with the view that minisatellites are subject to selective or mutational constraints in addition to those expected under simple stepwise mutation models.},
  isbn = {0340-6717},
  journal = {Human Genetics},
  keywords = {DEFICIENCY,DIVERSITY,ETHNICALLY DEFINED POPULATIONS,HETEROZYGOTE,HUMAN DNA,HUMAN-EVOLUTION,HYPERVARIABLE LOCI,MICROSATELLITE,MITOCHONDRIAL,MODERN HUMANS,VNTR LOCI},
  language = {English},
