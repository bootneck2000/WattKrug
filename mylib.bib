@article{Warwick-Evans2018,
  title = {Using Habitat Models for Chinstrap Penguins {{Pygoscelis}} Antarctica to Advise Krill Fisheries Management during the Penguin Breeding Season},
  author = {{Warwick-Evans}, Victoria and Ratcliffe, Norman and Lowther, Andrew D. and Manco, Fabrizio and Ireland, Louise and Clewlow, Harriet L. and Trathan, Philip N.},
  editor = {Hawkes, Lucy},
  year = {2018},
  month = jul,
  volume = {24},
  pages = {1756--1771},
  issn = {14724642},
  doi = {10.1111/ddi.12817},
  abstract = {Aim: To predict the at-sea distribution of chinstrap penguins across the South Orkney Islands and to quantify the overlap with the Southern Ocean krill fishery. Location: South Orkney Islands, Antarctica. Methods: Penguins from four colonies across the South Orkney Islands were tracked using global positioning systems (GPSs) and time depth recorders (TDRs). Relationships between a variety of environmental and geometric variables and the at-sea distribution of penguins were investigated using general additive models for the three main phases of the breeding season. Subsequently, the final models were extrapolated across the South Orkney archipelago to predict the at-sea distribution of penguins from colonies where no tracking data are available. Finally, the overlap between areas used by chinstrap penguins and the krill fishery was quantified. Results: The foraging distribution of chinstrap penguins can be predicted using two simple and static variables: the distance from the colony and the direction of travel towards the shelf-edge, while avoiding high densities of Pygoscelis penguins from other colonies. Additionally, we find that the chinstrap penguins breeding on the South Orkney Islands use areas which overlap with frequently used krill fishing areas and that this overlap is most prominent during the brood and cr\`eche phases of the breeding season. Main conclusions: This is the first step in understanding the potential impacts of the krill fishery, for all colonies including those where no empirical tracking data are available. However, with the available data, it is not currently possible to infer an impact of the krill fisheries on penguins. With this in mind, we recommend the implementation of monitoring schemes to investigate the effects of prey depletion on predator populations and to ensure that management continues to follow a precautionary approach and is addressed at spatial and temporal scales relevant to ecosystem operation.},
  file = {C\:\\Users\\Andy\\Zotero\\storage\\2M8RZIA9\\Warwick-Evans et al. - 2018 - Using habitat models for chinstrap penguins Pygoscelis antarctica to advise krill fisheries management dur.pdf},
  journal = {Diversity and Distributions},
  keywords = {Antarctica,chinstrap penguin,fisheries overlap,habitat modelling,krill fishery,management,marine predator,Pygoscelis antarctica},
  number = {12}
}

