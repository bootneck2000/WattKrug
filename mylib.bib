@article{Bryden1984a,
  title = {Growth of the Weddell Seal Leptonychotes-Weddelli Pinnipedia},
  author = {Bryden, M M and Smith, M S R and Tedman, R A and Featherston, D W},
  year = {1984},
  volume = {32},
  pages = {33--42},
  abstract = {Weight more than tripled during the 6 wk suckling period in Weddell seals and increments in girth measurements were greater than increments in standard length. There was a very highly significant relationship between body weight and length and girth, but no consistent difference between the sexes in birth weight or growth during the suckling period. The distribution of body length frequencies and regression of body length on age of juvenile and adult seals, indicated that at all ages greater than 1 yr, females are larger than males. The mean length difference favoring females is approximately 6 cm. A multiple regression equation was derived that permits estimation of body weight from length and girth measurement. Relative weights and growth coefficients of several tissues and organs are recorded and discussed in relation to similar data from other species of marine mammals.},
  journal = {Australian Journal of Zoology},
  keywords = {*Anatomy and Histology,*Developmental Biology/Embryology-Morphogenesis,*Physiology,8400,Animals. Chordates. Vertebrates. Nonhuman Vertebra,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Water Research and Fishery B,G,General and Comparative/Gr,General and Miscellaneous/Comparative,Mammalia-Unspecified [85700],Marine Mammal Standard Length Suckling Period Weig,Mathematical Biology and Statistical Methods [0450,Pediatrics [25000],Phocidae [86185]},
