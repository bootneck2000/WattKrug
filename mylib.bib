@article{Kinas2002,
  title = {The Impact of Incidental Kills by Gill Nets on the Franciscana Dolphin ({{Pontoporia}} Blainvillei) in Southern {{Brazil}}},
  author = {Kinas, Paul G},
  year = {2002},
  volume = {70},
  pages = {409--421},
  abstract = {The franciscana dolphin, Pontoporia blainvillei, is endemic to the western South Atlantic Ocean. Its distribution is restricted to waters up to 30 m depth, making it vulnerable to human influence. In southern Brazil the artisanal gillnet fisheries have increased since the early 1980s, and entanglement mortality of franciscanas has become a source for concern. Strandings have been documented for about 20 yrs, but the impact of incidental captures has remained unknown. In the 1990s numbers of franciscanas incidentally killed by the artisanal gillnet fleet, population size, and the intrinsic growth rate were estimated. I integrated all available information into a population model in order to quantify the impact of incidental kills. The statistical analysis was conducted within a Bayesian framework to maintain coherence while current biological knowledge was weighted with observational data. My analysis indicated a 99\% probability that the population is decreasing. For analysis of future impact of the incidental kill the population was defined as being at 'quasi collapse' when it reached 10\% of its current size, and the probability of quasi collapse within 30 yrs was calculated under alternative scenarios. Results indicate that current levels of entanglement mortality cannot be sustained and that protective measures are needed.},
  journal = {Bulletin of Marine Science},
  keywords = {Animals,Biophysics/Biocybernetics (1972- ) [10515],Brazil (South America,Cetaceans,Chor,Chordates,Ecology,Environmental Biology/Animal [07508],Environmental Biology/General,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Mammalia,Mammals,Mathematical Biology and Statistical Methods [0450,Methods [07502],Models and Simulations (Computational Biology),Neotropical region),Nonhuman Mammals,Nonhuman Vertebrates,Platanistidae [85835],Platanistidae: Cetacea,Pontoporia blainvillei [franciscana dolphin] (Plat,Population Studies,Public Health/General and Miscellaneous [37001],Resource Management,South Atlantic Ocean (Atlantic Ocean),Vertebrata,Vertebrates,Wildlife Management (Conservation)},
  number = {2}
}

