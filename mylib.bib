@article{Leonov1997,
  title = {Transformation of Organogenic Substances and Rates of Productional-Destructional Processes in the Okhotsk Sea Ecosystem},
  author = {Leonov, A V and Sapozhnikov, V V},
  year = {1997},
  volume = {37},
  pages = {67--80},
  abstract = {The annual dynamics of chemical and biological compouns is simulated by an ecological model for eight sea water areas. The observations in 1991-1993 were used in the model runs and they represent the changes of water temperature, light intensity at the water surface, parameters of water regime in the studied sea basins and biogenic load. The simulation results were used for the assessment of internal and external fluxes of organogenic substances and rates of productional-destructional processes in the marine ecosystem. It is shown that the pool of biogenic substances accumulated in the surface layer during the winter period determines the spring development of the primary production. In the summer-fall period the phytoplankton growth is supplied by the recycling of biogenic substances. In the most productive water areas (near Kamchatka peninsula and Sakhalin island) the water upwelling provides a continuous supply of organogenic substances to the upper layer and creates favorable conditions for the plankton growth and active substance biotransformations. During the vegetative period the integral primary production is from 37.6 to 44.6\% determined by the activity of diatoms, from 28.1 to 32.4\% determined by the activity of peridinium and from 27.2 to 30\% determined by the activity of the green algae. The production rate of the diatom algae and the bacterial destruction of organic substances are comparable in the productive water areas, however in the central regions of the sea the values of the diatom production are higher. The integral value of the primary production for the upper layer is by 59.8-66.3\% higher than the bacterial destruction of organic substances. [References: 11]},
  journal = {Okeanologiya},
  number = {1}
}

@article{Leonov1997a,
  title = {Estimation of the Flows of Organogenic Substances and Rates of Production-Destruction Processes in the Okhotsk Sea Ecosystem},
  author = {Leonov, A V and Sapozhnikov, V V and Nikolaev, V M},
  year = {1997},
  pages = {356--373},
  abstract = {An ecological model describing the dynamics of concentrations of dissolved organic carbon, mineral and organic components nitrogen, :phosphorus, and silicon, as well as detritus and biomass of heterotrophic bacteria, diatomous, peridinial, and green algae, and plant-eating and predatory zooplankton was used for studying the biological transformation of organogenic substances and primary production in;the Okhotsk Sea ecosystem. Observations from 1991 to 1993 of the changes in water temperature, illumination, and water regime were used for simulation of the annual dynamics of the chemical and biological components in eight regions of the sea. The internal-and external flows of organogenic substances and rates of production-destruction processes in these regions were estimated according to the results of calculation. In the spring, the Primary production is I formed from the reserve of biogenic substances accumulated in water at the expense of vertical circulation of water masses and in summer-autumn at the expense of recycling of biogenic substances. The regions off Kamchatka and Sakhalin were most productive, where water upwelling provides for a continuous supply of organogenic substances and creates favorable conditions for plankton development and active biological transformation of the matter. The contribution of diatomous, peridinial, and green algae to the total production of phytoplankton during the vegetation period amounted to 37.6-44.6\%, 28.1-32.4\%, and 27.2-30.0\%, respectively. The rates of the production of diatomous algae and the destruction of organic matter in the surface layer are comparable in the productive regions, while in the central part of the sea, the production of diatomous algae is somewhat higher. The total production of,phytoplankton in the surface layer was 59.8-66.3\% higher than the bacterial destruction of organic matter. [References: 10]},
  journal = {Izvestiya Akademii Nauk Seriya Biologicheskaya},
  number = {3}
}

