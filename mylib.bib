@article{Lux1997,
  title = {Mitochondrial {{DNA}} Population Structure of the {{Pacific}} White-Sided Dolphin},
  author = {Lux, C A and Costa, A S and Dizon, A E},
  year = {1997},
  volume = {0},
  pages = {645--652},
  abstract = {Examination of the hypervariable portion of the mitochondrial DNA control region was used to gain insights into the population structure of the abundant, mobile, continuously distributed Pacific white-sided dolphin (Lagenorhynchus obliquidens). One hundred and sixteen individuals from four strata loosely based on current USA management units (Baja California, Mexico; California, Oregon and Washington; British Columbia, Canada; and Southeast Alaska) were analysed along with samples from the high-seas North Pacific driftnet fishery. Eighty-one unique sequences (haplotypes) were found. We used an analysis of variance adapted for molecular genetic data to investigate whether our sample set was genetically subdivided. For this, we calculated a matrix of all pairwise genetic distances, stratified the sample on an a priori basis on geographic sampling areas and used the analysis of variance to examine correlations within and among the hypothesised strata. A significant portion of the variation in pairwise genetic distances could be accounted for by stratification of the individuals into geographic sampling areas, indicating genetic subdivision of the whole data set. Population-by-population comparisons of the a priori-chosen geographic strata indicated that all could be considered isolated, but likely incompletely, from one another.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals,Cetaceans,Chorda,Chordates,Delphinidae [85815],Delphinidae: Cetacea,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Lagenorhynchus-obliquidens [Pacific white-sided do,Mammalia,Mammals,mitochondrial DNA,Nonhuman Mammals,Nonhuman Vertebrates,Pacific Ocean (Pacific Ocean),Population Genetics (Population Studies),Resource Management,Vertebrata,Vertebrates,Wildlife Management (Conservation)},
  number = {47}
}

