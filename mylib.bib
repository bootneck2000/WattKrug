@article{Zanazzi2008,
  title = {Ecology and Physiology of {{White River}} Mammals Based on Stable Isotope Ratios of Teeth},
  author = {Zanazzi, A and Kohn, M J},
  year = {2008},
  volume = {257},
  pages = {22--37},
  doi = {10.1016/j.palaeo.2007.08.007},
  abstract = {To characterize the ecology and physiology of common late Eocene-early Oligocene White River mammals, we analyzed the carbon and oxygen isotope composition of tooth enamel carbonate for six of the most abundant taxa: the perissodactyls Brontops (brontothere), Mesohippus (equid) and Subhyracodon (rhino); and the artiodactyls Merycoidodon (oreodont), Leptomeryx (leptomerycid) and Poebrotherium (camelid). delta C-13 values of middle and rear molars (M2s and M3s) and premolars range from -13.1\%o to -7.7\%o (V-PDB), consistent with pure C3 diets. In the late Eocene, Mesohippus, Merycoidodon, and Leptomeryx show indistinguishable average delta C-13 values (similar to-10\%o). In contrast, Brontops and Subhyracodon exhibit lower (-11.2\%o) and higher (-8.7\%o) values, respectively. Early Oligocene values for Mesohippus and Merycoidodon remain indistinguishable from each other and lower than the value of Leptomeryx, Poebrotherium, and Subhyracodon (similar to-8.5\%o). These results likely indicate niche separation in terms of habitat preference between the investigated sympatric taxa. More specifically, assuming a delta C-13 value of atmospheric CO2 of -5.5\%o, our data suggest a preference of Brontops for mesic forested areas, of Mesohippus and Merycoidodon for woodlands, and of Subhyracodon and Poebrotherium for more open habitats (e.g., grasslands). The higher Oligocene versus Eocene average delta C-13 exhibited by Leptomeryx possibly reflects a preference of the new Oligocene species L. evansi for more open and/or xeric habitats relative to the Eocene species L. speciosus. Late Eocene and early Oligocene average delta O-18 of Mesohippus, Merycoidodon, Leptomeryx, and Subhyracodon are similar (similar to 25\%o, V-SMOW), possibly indicating comparable water dependency for these taxa. In contrast, the higher delta O-18 of Poebrotherium (26.6\%o) suggests lower water dependency whereas the lower delta O-18 of Brontops (23.0\%o) may result from a high water dependency or, more likely, from its preference for humid habitats. Because hind-gut fermentation in perissodactyls requires high water intake, whereas fore-gut fermentation does not, our results might indicate the presence of fore-gut fermentation in early Oligocene camelids but its absence or incomplete development in late Eocene-early Oligocene oreodonts and leptomerycids. (C) 2007 Elsevier B.V. All rights reserved.},
  isbn = {0031-0182},
  journal = {Palaeogeography Palaeoclimatology Palaeoecology},
  keywords = {BIOAPATITE,CARBON,DIET,ecology,Eocene-Oligocene,EVOLUTIONARY,FRACTIONATION,mammals,NORTH-AMERICA,PHOTOSYNTHESIS,RECONSTRUCTION,SIGNATURES,stable isotopes,tooth enamel,TOOTH ENAMEL},
  language = {English},
  number = {1-2}
}

