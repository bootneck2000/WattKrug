@article{Butt2008,
  title = {Spatial Trends of Perfluoroalkyl Compounds in Ringed Seals ({{Phoca}} Hispida) from the {{Canadian Arctic}}.},
  author = {Butt, C M and Mabury, S A and Kwan, M and Wang, X W and Muir, D C G},
  year = {2008},
  volume = {27},
  pages = {542--553},
  abstract = {The present study examined spatial trends of perfluoroalkyl compounds (PFCs) in liver samples from 11 populations of ringed seals (Phoca hispida) in the Canadian Arctic from 2002 to 2005. Trophic position and relative carbon sources were compared by analyzing stable nitrogen and carbon isotopes in muscle samples. Geometric mean concentrations of total C-9-C-15 perfluorinated carboxylates (PFCAs) ranged from 8.8 to 84 ng/g wet weight, and C-9-C-11 PFCAs predominated. Perfluorooctane sulfonate was the dominant PFC measured, with concentrations ranging from 6.5 to 89 ng/g wet weight, contributing between 29 and 56\% of the total PFC concentration. Overall, mean PFC concentrations were similar between populations, and differences were attributed largely to elevated levels in the Gjoa Haven (Rae Strait, central Canadian Arctic archipelago) and Inukjuak populations (eastern Hudson Bay) and to lower concentrations at Pangnirtung (Cumberland Sound, Baffin Island). Mean stable nitrogen isotope ratios (+/- 95\% confidence intervals) ranged from 14.7 parts per thousand (+/- 0.3 parts per thousand) at Nain (Labrador) to 17.9 parts per thousand (+/- 0.7 parts per thousand) at Gjoa Haven, suggesting that all populations were within the same trophic level. Stable carbon isotope ratios varied widely between the seal populations, ranging from -22.9 parts per thousand (+/- 0.2 parts per thousand) at Gjoa Haven to -17.7 parts per thousand (+/- 0.4 parts per thousand) at Nain. The delta C-13 ratios from Gjoa Haven were significantly more depleted than those for other populations and may suggest a terrestrially based carbon source. The depleted stable carbon isotope ratio may explain the elevated PFC concentrations in the Gjoa Haven population. Analysis of covariance indicated that delta C-13 was a significant covariable for seven of nine seal populations for which delta C-13 values were available. After adjusting for delta C-13 values. concentrations of most PFCs generally were statistically greater in the Grise Fiord, Qikiqtarjuaq, Arviat, and Nain populations.},
  isbn = {0730-7268},
  journal = {Environmental Toxicology and Chemistry},
  keywords = {10327,ACIDS,BEARS,BIODEGRADATION,CHAIN PERFLUORINATED,DOLPHINS TURSIOPS-TRUNCATUS,FLUOROTELOMER ALCOHOL,MARINE FOOD-WEB,perfluorinated carboxylates,perfluorinated sulfonates,PERFLUOROCARBOXYLIC ACIDS,PERSISTENT ORGANIC POLLUTANTS,Phoca hispida,POLAR BEARS,pollution,ringed seal,spatial trends,stable isotope analysis,STABLE-ISOTOPE ANALYSIS,TROUT ONCORHYNCHUS-MYKISS,URSUS-MARITIMUS},
  language = {English},
  mendeley-tags = {10327},
  number = {3}
}

