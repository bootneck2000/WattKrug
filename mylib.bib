@article{Badgley2008,
  title = {Ecological Changes in {{Miocene}} Mammalian Record Show Impact of Prolonged Climatic Forcing},
  author = {Badgley, C and Barry, J C and Morgan, M E and Nelson, S V and Behrensmeyer, A K and Cerling, T E and Pilbeam, D},
  year = {2008},
  volume = {105},
  pages = {12145--12149},
  doi = {10.1073/pnas.0805592105},
  abstract = {Geohistorical records reveal the long-term impacts of climate change on ecosystem structure. A 5-myr record of mammalian faunas from floodplain ecosystems of South Asia shows substantial change in species richness and ecological structure in relation to vegetation change as documented by stable isotopes of C and 0 from paleosols. Between 8.5 and 6.0 Mal, C-4 savannah replaced C-3 forest and woodland. Isotopic historical trends for 27 mammalian herbivore species, in combination with ecomorphological data from teeth, show three patterns of response. Most forest frugivores and browsers maintained their dietary habits and disappeared. Other herbivores altered their dietary habits to include increasing amounts of C4 plants and persisted for \textquestiondown 1 myr during the vegetation transition. The few lineages that persisted through the vegetation transition show isotopic enrichment of delta C-13 values over time. These results are evidence for long-term climatic forcing of vegetation structure and mammalian ecological diversity at the subcontinental scale.},
  isbn = {0027-8424},
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  keywords = {ENVIRONMENTS,EVOLUTION,EXPANSION,faunal turnover,flood,GRADIENTS,isotope ecology,mammals,NORTHERN PAKISTAN,paleocommunities,PALEOSOLS,plain paleoecology,PLATEAU,SIWALIK-GROUP,STABLE-ISOTOPES,TEETH},
  language = {English},
  number = {34}
}

