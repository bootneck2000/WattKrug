@article{Butterworth1993a,
  title = {The Development of a Management Procedure for the {{South African}} Anchovy Resource},
  author = {Butterworth, D S and Bergh, M O},
  year = {1993},
  volume = {120},
  pages = {83--99},
  abstract = {Exploitation of the South African anchovy resource commenced in 1963. Until 1983, the basis for management of this resource very roughly resembled a constant catch strategy, as the TAC for all pelagic species combined was kept virtually unchanged. Hydroacoustic surveys of the resource commenced in 1983, and showed it to be larger and less heavily exploited than had been thought previously on the basis of analysis of data from commercial catches alone. These surveys led to management on a constant escapement basis over the 1987-1990 period; the actual criteria applied involved pre-specified probabilities of escapement falling below 50\% of the average spawning biomass level in the absence of exploitation. This procedure initially found general favor, when TAC's were increased markedly for 1987 and 1988 following good recruitment. However, it was quickly overridden by decision makers when it indicated fishery closures following poor recruitment in 1989 and again in 1990. It has now been replaced by a management procedure based on the constant proportion strategy, which was selected on the basis of the results of simulation testing over a twenty year time horizon. A key requirement for sound interpretation of the results of this process is an appropriate definition of risk, which must also be readily meaningful to layman decision markers. This is closely related to the question: at what levels of spawning stock depletion is the probability of recruitment success likely to become substantially impaired? TAC's should ultimately be set by means of such simulation-tested management procedures, and not by the present widely used practice of linking annual "best" assessments of resource status to biological reference points. The future role of assessments is rather to condition the underlying models used for such simulation tests, as management procedures are revised at (typically) three to five year intervals.},
  journal = {Canadian Special Publication of Fisheries and Aquatic Sciences},
  keywords = {Administration and L,Animal,animals. chordates. fish. nonhuman vertebrates. ve,Biophysics/Biocybernetics (1972- ) [10515],Catch Strategy. Mathematical Model. Policy. Stock,Chordata,Ecology,Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Pisces [6,General Biology/Institutions,Government and Law. Mathematical Biology (Computat,Mathematical Biology and Statistical Methods [0450,Osteichthyes (Osteichthyes).,Osteichthyes [85206],Osteichthyes: Pisces,Vertebrata},
  number = {0}
}

@article{Butterworth1994,
  title = {An Investigation of the Merits or Otherwise of the Proposal for an Antarctic-Wide Whale Sanctuary by Means of Adaptations of the Simulation Trials Used to Test the Revised Management Procedure},
  author = {Butterworth, D S and Punt, A E},
  year = {1994},
  volume = {0},
  pages = {289--301},
  abstract = {Adaptations of the baseline single stock trials developed for testing the Revised Management Procedure (RMP), together with similar adaptations for the Southern Hemisphere minke whale implementation trials, are used to investigate the desirability of the imposition of a sanctuary of limited duration in the Southern Ocean. Two management options are considered: an initial 50-year sanctuary followed by 50 years of catches under the RMP, and the implementation of the RMP over the full 100 year period. It is argued that two pertinent considerations are: (i) which option is likely to achieve the better realised long-term catches, and (ii) which provides the better estimates of MSYR (for possible utilisation in the management of other baleen whale stocks). Continuing catch (C-c) and related statistics, and an MSYR estimator (the strictly Bayesian variant of the estimator component of the RMP's Catch Limit Algorithm), are developed to address these issues. Improved values of C-c statistics are obtained in the single stock trials under the initial sanctuary option. However, trials with management periods extending to 500 years show that the value of C-c after 100 years does not provide a reliable comparative measure of long term yields, because of differential transient effects. The Scientific Committee should consider alternative candidate statistics to C-c, to reflect continuing yield. The single stock trials indicate that there would be benefits from an initial sanctuary in the very long term (in excess of 300 years) if the populations involved were near pristine when monitoring commences ('D' scenarios), but not otherwise ('R' and 'S' scenarios). The Southern Hemisphere minke whale implementation trial adaptations indicate that after 50 years of a sanctuary, little useful information on MSYRs for these populations would be forthcoming. At the end of the 100-year management period, the option of an initial sanctuary leads to MSYR estimation performance which is clearly inferior to that if the RMP is implemented immediately. The sanctuary option results in particularly large positive biases (nearly +2.5\%) in MSYR estimation after 100 years for the case where the actual MSYR is 1\%. C-c and MSYR estimation results after 100 years without a sanctuary are very similar to those after 150 years with an initial 50-year sanctuary, indicating that the initial sanctuary achieves essentially nothing in these terms, at the expense of a 50-year delay in harvesting.},
  journal = {Report of the International Whaling Commission},
  keywords = {Administration and L,animals. cetaceans. chordates. mammals. nonhuman m,Balaenopteridae [85810],Balaenopteridae: Cetacea,Ch,Chordata,Conservation. Government and Law. Marine Ecology (,Conservation. Population Dynamics.,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,General Biology/Conservation,General Biology/Institutions,Mammalia,Minke whale (Balaenopteridae).,Resource Management,Vertebrata},
  number = {44}
}

@article{Butterworth1994a,
  title = {Estimating the Natural Growth Rate of Baleen Whale Populations: {{Is}} a Sanctuary a Help or a Hindrance, and What Would Be the Implications of a Deteriorating Habitat?},
  author = {Butterworth, D S and De, Oliveira J A A},
  year = {1994},
  volume = {0},
  pages = {413--428},
  abstract = {Whale populations are modelled by the discrete logistic equation, with abundance being estimated by surveys every five years over a 50 year period. Deteriorating habitat is reflected by a decreasing trend in the carrying capacity (K). The performance of different simple management options, comprising a range of constant (intended) fishing mortalities which include zero (i.e. a sanctuary), is considered in terms of the estimation of key parameters. The parameters considered are the logistic growth rate parameter (r-related to MSY rate) and a parameter delta measuring the rate at which carrying capacity declines, with the computations carried out for a range of actual values of r and of the initial depletion of a population. The results suggest that for a temporally invariant environment, the imposition of a whale sanctuary in the Southern Ocean would be of little consequence for the estimation of r for species still heavily depleted, but counter-beneficial for minke whales. Habitat degradation rates delta cannot be estimated with reasonable precision under current population monitoring levels, unless r is relatively high. The imposition of a sanctuary is of little consequence for estimation of 8 in circumstances where there is habitat degradation (so that these analyses provide no support for the belief expressed by some that harvesting confounds the estimation of such effects), but remains counter-beneficial for r estimation. These results are qualitatively robust to changes in the harvesting strategy (to include a protection level, for example), and to an alternative model for habitat deterioration in which both r and K decline over time. Parameter estimation might be improved somewhat by the imposition of a sanctuary over only a part of the Southern Ocean, but the benefits (if any) would probably depend on there being little difference between the MSY rates for the different stocks of minke whales in the Antarctic.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals. cetaceans. chordates. mammals. nonhuman m,Antarctic. Habitat. Maximum Sustainable Yield. Pop,Balaenopteridae [85810],Balaenopteridae: Cetacea,Ch,Chordata,Conservation. Ecology (Environmental Sciences). Ma,Ecology,Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,General Biology/Conservation,Mammalia,Minke whale (Balaenopteridae).,Resource Management,Vertebrata},
  number = {44}
}

@article{Butterworth1994b,
  title = {An Exploratory Investigation Based on Japanese Scouting Vessel Data of the Potential of Generalised Linear Models for Estimating the Relative Abundance of Southern Hemisphere Minke Whales},
  author = {Butterworth, D S and Miller, S},
  year = {1994},
  volume = {0},
  pages = {283--288},
  abstract = {Simple generalised linear models are fitted to the Japanese scouting vessel data for the period 1978/79 to 1987/88. The data are aggregated on a 2 degree latitude by 30 degree longitude basis for this purpose, and fits to data over the latitude ranges 60 degree -70 degree S and 58 degree -72 degree S are considered. The baseline model fitted represents the log of the minke whale sighting rate (n/l) by additive latitude and longitude effects, assuming an overdispersed Poisson distribution. While a statistically significant declining trend towards the north in density (assumed proportional to sighting rate) is readily apparent, the data are unable to support significant estimates of longitudinal effects at the 30 degree level. However, a two-term Fourier series model for the longitudinal variation pattern does give significant results, which seem to correlate with the northward extent of the ice-edge. There are some indications of model misspecification for the simple parametrizations attempted. While the immediate implication of these results is that natural fluctuations in the longitudinal density pattern are too large for reliable interpolation by means of the simple linear model forms investigated, the situation might be improved by reparametrization (if the data are available through the course of each year) in terms of distance north of the ice-edge instead of latitude.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals. cetaceans. chordates. mammals. nonhuman v,Assessment. Mathematical Model. Survey Ship.,Balaenopteridae (Balaenopteridae).,Balaenopteridae [85810],Balaenopteridae: Cetacea,Biophysics/Biocybernetics (1972- ) [10515],Ch,Chordata,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Environmental Sciences).,General and Systematic Zoology/Mammalia,General/Field Me,Mammalia,Marine Ecology (Ecology,Materials and Apparatus,Mathematical Biology and Statistical Methods [0450,Methods,Vertebrata},
  number = {44}
}

@article{Butterworth1994c,
  title = {The Origins of the Choice of 54 Percent of Carrying Capacity as the Protection Level for Baleen Whale Stocks, and the Implications Thereof for Management Procedures},
  author = {Butterworth, D S and Best, P B},
  year = {1994},
  volume = {0},
  pages = {491--497},
  abstract = {In 1975, the Commission adopted the value of 54\% (0.54K) as the protection level for baleen whales (in the form Z\% = 10\%), on the advice, at that time, of the majority of the Scientific Committee. The Scientific Committee's advice was in turn based upon analyses concerned with maximising continuing yield given the possibility of stock misclassification; that advice thus relates to the 'continuing catch' performance statistic in the context of the trials of the Revised Management Procedure. Continuing catches are shown to decrease as the (realised) protection level (RPL) for the R1 trial (MSYR = 1\%; P-0 = 0.3K) is increased by varying the control parameters of the Catch Limit Algorithm (CLA). RPLs lower than 0.54K provide improved performance on continuing yield and catch limit stability, without being in conflict with the Commission's other objective of avoiding a serious risk of stock extinction.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals. cetaceans. chordates. mammals. nonhuman v,Balaenopteridae (Balaenopteridae).,Balaenopteridae [85810],Balaenopteridae: Cetacea,Ch,Chordata,Ecology,Environmental Biology/Oceanography [07512],Environmental Biology/Wildlife Management-Aquatic,Environmental Sciences).,General and Systematic Zoology/Mammalia,Mammalia,Marine Ecology (Ecology,Maximum Sustainable Yield. Whaling.,Metabolism/Energy and Respiratory Metabolism [1300,Vertebrata},
  number = {44}
}

@article{Butterworth1995,
  title = {On the {{Bayesian}} Approach Suggested for the Assessment of the {{Bering}}-{{Chukchi}}-{{Beaufort}} Seas Stock of Bowhead Whales},
  author = {Butterworth, D S and Punt, A E},
  year = {1995},
  volume = {0},
  pages = {303--311},
  abstract = {A simplified version of the Bayesian approach suggested by Givens et al. (1993b) for the assessment of the bowhead population is found to be particularly sensitive to alternative choices for input prior distributions for MSYR and the pre-exploitation population size K. It is argued that the method suggested by Givens et al. (1993b) to develop a prior for K is questionable in the context of their overall procedure because, intet alia, it makes the implicit assumption that MSYR=0. A recasting (termed a 'Backwards' method) of their Bayesian approach is suggested, which avoids the need for the explicit specification of a prior for K by treating a recent absolute abundance estimate as a model input rather than a model output. This 'Backwards' method is applied to the data and prior choices agreed at the 1994 Scientific Committee meeting, and gives results which show some notable differences from those provided by the Givens et al. method. A particular advantage of the Bayesian approach is that it allows population age structure information to be taken into account, and ensures that the constraints imposed by a maximum possible pregnancy rate are respected; however, both these factors are shown to have little influence on the results of current Bayesian assessment, and the 'Backwards' method indicates that this is also the case for CPUE data from the first two decades of commercial exploitation. The 'Backwards' Bayesian results, though less discrepant than those of the Givens et al. method from estimates provided by the maximum likelihood methodology of the Hitter-Fitter package, still differ from the latter to an important extent. The relative influences on this difference of the upper bound on pregnancy rate imposed by the Bayesian approach, and the particular prior for MSYR chosen by the 1994 Scientific Committee meeting, merit examination.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals. cetaceans. chordates. mammals. nonhuman v,Balaenidae (Balaenidae).,Balaenidae [85805],Balaenidae: Cetacea,Biophysics/Biocybernetics (1972- ) [10515],Chordat,Chordata,Commercial Exploitation. Mathematical Model. Popul,Conservation. Mathematical Biology (Computational,Ecology,Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,General Biology/Conservation,Mammalia,Mathematical Biology and Statistical Methods [0450,Methods [16501],Reproductive System/General,Resource Management,Vertebrata},
  number = {45}
}

@article{Butterworth1996,
  title = {An {{ADAPT}} Approach to the Analysis of Catch-at-Age Information for Southern Hemisphere Minke Whales},
  author = {Butterworth, D S and Punt, A E and Geromont, H F and Kato, H and Miyashita, T},
  year = {1996},
  volume = {0},
  pages = {349--359},
  abstract = {A form of the ADAPT VPA assessment method is developed for application to Southern Hemisphere minke whale catch-at-age and sightings survey abundance estimate information. The method is applied to data for Area IV, with the catches-at-age being grouped on a 3-year-3-age basis to avoid problems associated with small numbers. The resultant estimates of the trend in recruitment over time depend critically upon the values assumed for natural mortality at age. At two extremes, a high rate of annual increase ( apprx 10\%) over the 1940-1970 period becomes roughly steady over the 1970s and 1980s if M is low ( apprx 0.02 yr-1), whereas if M is high ( apprx 0.14 yr-1) the historic trend was roughly steady but has been followed by a sharp decline in the 1970s. This conclusion is robust to considerations of the level of precision resulting from the finite size of the catch-at-age samples and the variance of the IWC/IDCR survey estimate of abundance used in the analysis. Simulation studies are conducted to investigate whether future data might be able to discriminate between these scenarios. An estimator is developed which estimates M (and its assumed linear dependence on age) by maximizing a likelihood involving the time series of a relative abundance index and assumed representative sampling of the population age structure. The initial results obtained suggest that the estimator performs better if it assumes that M is independent of age, even if M varies with age in reality. This variant of the estimator can achieve estimates of the historic annual rate of increase in recruitment with root mean square errors in the 2-3\% range, provided that the real M is not increasing too fast with age, or selectivity in the commercial catch did not decrease markedly for older animals. Suggestions for further investigations are made.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals. cetaceans. chordates. mammals. nonhuman v,Balaenopteridae (Balaenopteridae).,Balaenopteridae [85810],Balaenopteridae: Cetacea,Behavior. Development. Ecology (Environmental Scie,Behavioral Biology/Animal Behavior [07003],Ch,Developmental Biology/Embryology-Morphogenesis,Ecology,Environmental Biology/Animal [07508],Evolution [01500],Ge,General and Miscellaneous/Necrosis (197,Length-Age Distribution. Mortality. Recruitment. S,Mammalia,Mathematical Biology and Statistical Methods [0450,Pathology,Vertebrata},
  number = {46}
}

@article{Butterworth1996a,
  title = {On Plausible Hypothesis and Their Weighting, with Implications for Selection between Variants of the Revised Management Procedure},
  author = {Butterworth, D S and Punt, A E and Smith, A D M},
  year = {1996},
  volume = {0},
  pages = {637--640},
  abstract = {General arguments are presented that a 'worst case scenario' basis for risk assessment in the interpretation of the results of RMP implementation simulation trials, as appears to have been past practice in the Scientific Committee, is inappropriate. The arguments are illustrated by an example based on the Bering-Chukchi-Beaufort Seas stock of bowhead whales. The task of assigning relative weights to the different scenarios (hypotheses) considered in implementation simulation trials to provide integrative statistics upon which to base risk assessment cannot sensibly be avoided, despite the difficulties of such assignment. As a first step in this process, the Scientific Committee should develop a framework for ranking alternative hypotheses, and some suggested guidelines for this are put forward.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals. cetaceans. chordates. mammals. nonhuman v,Bering-Chukchi-Beaufort Seas Stock. Commercial Wha,Biophysics/Biocybernetics (1972- ) [10515],Cetacea - Unspecified: Cetacea,Cetacea (Cetacea - Unspecified).,Cetacea-Unspecified [85800],Chordata,Conservation. Mathematical Biology (Computational,Ecology,Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,General Biology/Conservation,Mammalia,Mathematical Biology and Statistical Methods [0450,Resource Management,Vertebra},
  number = {46}
}

@article{Butterworth1996b,
  title = {Further Analyses of Allele Frequency Data to Provide Estimates of the Extent of Mixing between the Various {{North Pacific}} Minke Whale Stocks, and Their Implications for the Status of the '{{O}}' Stock},
  author = {Butterworth, D S and Geromont, H F and Wada, S},
  year = {1996},
  volume = {0},
  pages = {443--451},
  abstract = {The analysis of Punt et al.(1995) based on Adh-1 locus data for North Pacific minke whales is repeated for the Gpi locus. The mixing proportions estimated for the J and O stocks from the two analyses are compatible, except that the Gpi data indicate a 12\% rather than an effectively 0\% proportion of animals in subarea 11 in June-July which belong to the J stock. A Bayesian variant of this analysis is applied to the genotype data from the scientific permit catch from subarea 9 in 1994, to attempt to detect the presence of the hypothesized W stock. These data are consistent with all animals in that subarea belonging to the O stock, but the small sample size means that there remains a 5\% chance that the proportion of those whales that are from the W stock could be as large as 88\% (based on Adh-1 locus data) or 91\% (from the Gpi data). Results are presented to show the extent to which the power of these analyses is expected to improve as sample size is increased. A HITTER population model analysis is conducted to ascertain the possible effect of an annual interim relief quota of 50 minke whales from Japanese coastal waters on the status of the O stock. If the O stock does not extend beyond subareas 7 and 11, it is assessed to be heavily depleted (below 30\% of its pre-exploitation level, in terms of the mature female component of the population) even if MSYR(mature) = 4\%. However, if allowance is made for the number of O stock whales in subareas 8, 9 and 12 that may be inferred from the analysis put forward of the Adh-1 locus data from the scientific permit catch, a 'worst case scenario' of a lower 5\%-ile of the 1990 abundance estimate and MSYR(mature) = 1\% shows depletion at 5 1 \%. Furthermore, depletion in terms of the total population is at 53\%, and there is a continuing small rate of increase (of 0.3\% p.a.) over five years of the proposed interim relief take. For the median abundance estimate, the O stock is assessed to be above MSYL even for MSYR(mature) = I\%. These results suggest that an annual interim relief take of 50 minkes can be regarded as sustainable.},
  journal = {Report of the International Whaling Commission},
  keywords = {Behavior. Conservation. Ecology (Environmental Sci,Behavioral Biology/Animal Behavior [07003],Ecology,Environmental Biology/Animal [07508],General Biology/Conservation,Genetics and Cytogenetics/Animal [03506],Genetics and Cytogenetics/Population Genetics (197,Genetics. Population Status. Stock Identity.,Japan (Asia,Palearctic region).,Resource Management},
  number = {46}
}

@article{Butterworth1996c,
  title = {On the Provision of Advice on the Effect on Stock(s) of Scientific Permit Catches, with Particular Reference to Proposed Research Catches of Minke Whales from {{Antarctic Area IV}}},
  author = {Butterworth, D S and Geromont, H F},
  year = {1996},
  volume = {0},
  pages = {653--655},
  abstract = {On the last occasion on which the Scientific Committee addressed this issue for Southern Hemisphere minke whales, the HITTER procedure was applied for a number of MSYR values. It is suggested that earlier practice of focussing on the resultant values for the current replacement yield (as the statistic to which to compare the proposed level of take) is not appropriate for a number of reasons. Instead, the suggestion is made to concentrate rather on the trend in resource size indicated over the full period of the programme of research proposed. Results are reported on this basis for the effect of the proposed level of research catches of minke whales from Antarctic Area IV.},
  journal = {Report of the International Whaling Commission},
  keywords = {animals. cetaceans. chordates. mammals. nonhuman v,Antarctica (Antarctic Region).,Balaenopteridae (Balaenopteridae).,Balaenopteridae [85810],Balaenopteridae: Cetacea,Ch,Chordata,Conservation. Systematics and Taxonomy. Wildlife M,Ecology,Environmental Biology/Wildlife Management-Aquatic,General and Systematic Zoology/Mammalia,General Biology/Conservation,Mammalia,Replacement Yield. Resource Size.,Resource Management,Vertebrata},
  number = {46}
}

@article{Butterworth1997,
  title = {An Initial Analysis of Updated Transition Phase Data for Minke Whales in {{Antarctic Area IV}}},
  author = {Butterworth, D S and Thomson, R B and Kato, H},
  year = {1997},
  volume = {0},
  pages = {445--450},
  abstract = {A model is developed to predict the transition-phase-based age at sexual maturity distributions to be expected from catch-at-age data, taking account of two effects which introduce bias into estimates of trend in age at sexual maturity with time. These are the under-representation of older animals in recent cohorts (the 'truncation' effect), and a 'fringe' effect arising from the difficulty of detecting a transition phase if only a few years have elapsed since the animal matured. The model is applied to the transition phase data for minke whales from Antarctic Area IV. The results show that the 'truncation' and 'fringe' effects alone cannot account for the nominal trend in the data, so strengthening the case that a real decline took place in the median age at sexual maturity, with a value of 11 for the 1950 cohort dropping to 7 for the 1980 cohort. However, final conclusions cannot be drawn until other effects, such as possible ageing errors which might introduce bias into this trend estimate, have been fully examined.},
  journal = {Report of the International Whaling Commission},
  keywords = {Animals. Cetaceans. Chordates. Mammals. Nonhuman M,Antarctica (Antarctic Region).,Balaenopteridae [85810],Balaenopteridae: Cetacea,Ch,Ecology,Environmental Biology/Wildlife Management-Aquatic,General Biology/Conservation,Mammalia,Mathematical Biology and Statistical Methods [0450,minke whale (Balaenopteridae).,model. sexual maturity.,Resource Management,Vertebrata,Wildlife Management (Conservation).},
  number = {47}
}

