@article{Milstein1978,
  title = {Sharks Taken by Longline in Inshore New-Jersey {{USA}} Waters during 1973 and 1974},
  author = {Milstein, C B},
  year = {1978},
  volume = {23},
  pages = {34--38},
  abstract = {Sharks were collected at 12 stations in the vicinity of Little Egg Inlet, New Jersey [USA] in 1973 and 1974. Longline sets (31) took 137 specimens of 6 shark spp. [White shark (Carcharodon carcharius), sandbar shark (Carcharhinus milberti), dusky shark (C. obscurus), tiger shark (Galeocerdo cuvieri), smooth dogfish (Mustelus canis), smooth hammerhead (Sphyrna zygaena)]. Most were juveniles. The highest monthly catches were made in Sept. (1.5 sharks/h) and in July (0.9 sharks/h). The dusky shark (75 specimens), sandbar shark (31 specimens) and smooth dogfish (19 specimens) together comprised 91\% of the sharks captured. During the warm months the first 2 spp. are apparently the most numerous larger pelagic sharks in New Jersey coastal waters.},
