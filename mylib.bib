@article{Lowry2008,
  title = {{{PACIFIC HARBOR SEAL CENSUS IN CALIFORNIA DURING MAY}}-{{JULY}} 2002 {{AND}} 2004},
  author = {Lowry, M S and Carretta, J V and Forney, K A},
  year = {2008},
  volume = {94},
  pages = {180--193},
  abstract = {An aerial photographic census Of Pacific harbor seals, Phoca vitulina richardsi, was conducted in California from May to July in 2002 and 2004 to document the number of seals hauled out during the molt period. To compensate for latitudinal differences in the timing of the molt, the state was divided into three strata. Surveys began in the southernmost stratum in May of each year and progressed north in June and July. Aerial photographic surveys at the Channel Islands and the mainland coast of southern California occurred during the afternoon high-low tide cycle. Surveys in central and northern California generally occurred after 0800 hours during the morning low-low tide cycle at tide levels of +0.5 m (re: MLLW) or less. Color transparency photographs of harbor seals were taken from an aircraft flying at an altitude of about 213 m with a 126-mm-format camera equipped with image motion compensation and A the geographical position of each photograph was recorded by linking I the camera to a computer and Global Positioning System (GPS). In 2002, A there were 3,878 harbor seals counted onshore at the Channel Islands, A 17,555 along the mainland coast and San Francisco Bay estuary, and 21,433 harbor seals statewide. In 2004, there were 4,344 harbor seals counted onshore at the Channel Islands, 21,989 along the mainland A coast and San Francisco Bay estuary, and 26,333 statewide. In southern A California, approximately 70\% of seals were found at Santa Cruz, Santa A Rosa, and San Miguel islands. After dividing the mainland counts by 0.5 degrees latitude segments to document distribution of seals, segment 37.50 degrees A to 37.99 degrees N latitude had the highest number of seals. No seals were found along the mainland along the section of coastline that included A Los Angeles and Orange counties, and north San Diego County. The population of harbor seals in California during 2004 was estimated to be 43,449 Individuals using a factor of 1.65 to correct for the fraction of seals not hauled out during overflights.},
  isbn = {0008-1078},
  journal = {California Fish and Game},
  keywords = {10893,aerial survey,COUNTS,ISLAND,Phoca vitulina,PHOCA-VITULINA-RICHARDSI,PHOTOGRAPHS,population size},
  language = {English},
  mendeley-tags = {10893},
  number = {4}
}

