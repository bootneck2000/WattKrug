  author = {Beaubrun, P C},
  year = {1995},
  volume = {C},
  pages = {1995},
  abstract = {This work is the result of studies on the distribution of Mediterranean cetaceans made by the Marine Mammal Research Group of the Commission Internationale pour l'Exploration Scientific de la mer Mediterranee begun in 1988. Nineteen categories are included in this atlas, 14 of which are species and 5 include unidentified whales, unidentified cetaceans of large, medium, or small size, and unidentified cetaceans. Each category entry includes a short explanation and 13 maps. One map covers all data for the category and 12 maps showing monthly distribution. Each map is divided into squares 30 minutes by 30 minutes. The species included are Balaenoptera physalus, B. acutorostrata, B. borealis, Megaptera novaeangliae, Physeter catodon, Ziphius cavirostris, Orcinus orca, Globicephala melas, Steno bredanensis, Delphinus delphis, Tursiops truncatus, Grampus griseus, Stenella coeruleoalba, Phocoena phocoena.},
