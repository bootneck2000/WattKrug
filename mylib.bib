@article{Barnes2004,
  title = {Bilateral Phacofragmentation in a New Zealand Fur Seal (Arctocephalus Fortseri).},
  author = {Barnes, Julie A and Smith, Jeffrey S},
  year = {2004},
  volume = {35},
  pages = {110--112},
  abstract = {Ophthalmic examination under anesthesia of a 5-yr-old, captive, male New Zealand fur seal (Arctocephalus forsteri) with reduced visual capacity revealed bilateral cataracts. Surgical extraction of the lenses was performed by phacofragmentation. Preoperative mydriasis was unsuccessful using common topical mydriatic agents. Intraoperative intracameral epinephrine 1:10,000 produced minimal pupillary dilation, but excellent dilation was achieved with intracameral epinephrine at 1:1,000. Postoperative uveitis was controlled with oral prednisolone. Postoperative complications included generalized corneal edema persisting for approximately 1 wk and corneal ulceration caused by the lateral canthotomy sutures. Vision was restored in both eyes.},
  journal = {Journal of Zoo and Wildlife Medicine},
  keywords = {[10060] Biochemistry studies - General,[10067] Biochemistry studies - Sterols and steroid,[11105] Anatomy and Histology - Surgery,[12512] Pathology - Therapy,[20004] Sense organs - Physiology and biochemistry,[20006] Sense organs - Pathology,[22012] Pharmacology - Connective tissue,[22024] Pharmacology - Neuropharmacology,[22031] Pharmacology - Sense organs,[38002] Veterinary science - General and methods,[38004] Veterinary science - Pathology,[86180] Otariidae,8828,adrenergic agonist-drug,alp,antiinflammatory-drug,Arctocephalus forsteri,Arctocephalus forsteri: species,associated st,bilateral phacofragmentation: clinical techniques,bone and,cataract: (Cataract (MeSH)),Chordates,diseases,drugging,epinephrine: 51-43-4,eye disease,Mammalia,Mammals,New Zealand fur s,Nonhuman V,Otariidae: Animals,Pinnipedia,postoperative complications,prednisolone: 50-24-8,Sense Organs: Sensory Reception,surgery,Surgery: Medical Sciences,Vertebrat,Veterinary Medicine: Medical Sciences,vision},
