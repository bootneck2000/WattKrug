@article{Tershy1991,
  title = {Increase in Cetacean and Seabird Numbers in the Canal de Ballenas during an El Nino-Southern Oscillation Event},
  author = {Tershy, B R and Breese, D and Alvarez, Borrego S and {Alvarez-Borrego}, S},
  year = {1991},
  volume = {69},
  pages = {299--302},
  abstract = {El Nino-Southern Oscillation (ENSO) events cause a decline in upwelling-based primary productivity throughout the California Current system and southern Gulf of California USA. However, in the Canal de Ballenas, central Gulf of California, primary productivity is based on tidal mixing and appears unaffected by ENSO events. Between the ENSO year of 1983 and the anti-ENSO year of 1985 we censused 4 piscivores (Bryde's whale Balaenoptera edeni; common dolphin Delphinus delphis; blue-footed booby Sula nebouxii and brown booby S. leucogaster) and 3 planktivores (fin whale B. physalus; black storm-petrel Oceanodroma melania; and least storm-petrel O. microsomea). For all species the number of individual sighted per declined by 77 to 94\% over the 3 yr period. This suggests that during ENSO events the Canal de Ballenas may serve as a refugium of high productivity and prey abundance for these highly mobile marine animals.},
  journal = {Marine Ecology-Progress Series},
  keywords = {*Behavioral Biology/Animal Behavior [07003],*Ecology,*Metabolism/General Metabolism,*Movement (1971- ) [12100],*Nutrition/General Studies,*Plant Physiology,9100,Balaenoptera-Edeni Balaenoptera-Physalus Delphinus,Balaenopteridae [85810],Biochemistry and Biophysics/Met,Biochemistry and Biophysics/Pho,Delphinidae [85815],Environmental Biology/Animal [07508],Environmental Biology/Oceanography [07512],Environmental Biology/Oceanography and Limnology [,Environmental Biology/Plant [07506],Metabolic Pathways [13002],Nutritional Status and,Pelecaniformes [85550],Plantae-Unspecified [11000],Plants. Animals. Chordates. Vertebrates. Nonhuman,Procellariiformes [85556]},
