  author = {Melnikov, V V},
  year = {2000},
  volume = {40},
  pages = {895--900},
  abstract = {Data are presented resulting from shore-based observations of seasonal distribution of humpback whales in waters adjacept to the Chukotka Peninsula in 1994-1996. Under favourable ice conditions humpback whales occur off coast of the Chukotka to the end of May. During the summer the humpback whales stay diffused in the coastal zone of the Chukotka in by singles and pairs. During the autumn humpback whales form appregation in the southerm part of the Chukchi Sea, stay in the Senyavin Strait and in the northern part of Gulf of Anadyr, Humpback whales go off from the area of observation before freeing. Both earlier and now the waters of the Chukotka are the foraging grounds of humpbacked whales. The sights of humpback whales indicate the signs of restoration of their population in the waters of Chukotka Peninsula.},
