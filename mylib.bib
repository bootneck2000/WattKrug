  author = {Dailey, M and Stroud, R},
  year = {1978},
  volume = {14},
  pages = {503--512},
  abstract = {Ten stranded cetaceans, representing 5 spp. [Phocoena phocoena, Stenella coeruleoalba, Grampus griseus, Delphinus delphis and Eschrichtius robustus], from the Oregon Coast [USA] were examined between 1973-1977. Fourteen genera of parasites [Hadwenius mironovi, H. hipponicus, Campula oblonga, Halocercus invaginatus, Pharurus convolutus, Stenurus minor, Anisakis simplex, Crassicauda sp., C. grampicola, Bolbosoma sp., Monorygma grimaldii, Tetrabothrius forsteri, Strobilocephalus triangularis, Sarcocystis, Phyllobothrium delphini, Penella sp., and Cyamus ceti] together with the pathogenesis and pathology associated with the presence of some of these parasites are reported.},
  journal = {Journal of Wildlife Diseases},
  number = {4}
}

