@article{Reed2000,
  title = {Gas Exchange and Heart Rate in the Harbour Porpoise, {{Phocoena}} Phocoena},
  author = {Reed, J Z and Chambers, C and Hunter, C J and Lockyer, C and Kastelein, R and Fedak, M A and Boutilier, R G},
  year = {2000},
  volume = {170},
  pages = {1--10},
  abstract = {The respiratory physiology, heart rates and metabolic rates of two captive juvenile male harbour porpoises (both 28 kg) were measured using a rapid-response respiratory gas analysis system in the laboratory. Breath-hold durations in the laboratory (12 +/- 0.3 s, mean +/- SEM) were shorter than field observations. although a few breath-holds of over 40 s were recorded. The mean percentage time spent submerged was 89 +/- 0.4\%. Relative to similarly-sized terrestrial mammals, the respiratory frequency was low (4.9 +/- 0.19 breaths min(-1)) but with high tidal volumes (1.1 +/- 0.01 l), enabling a comparatively high minute rate of gas exchange. Oxygen consumption under these experimental conditions (247 +/- 13.8 ml O-2. min(-1)) was 1.9-fold higher than predicted by standard scaling relations. These data together with an estimate of the total oxygen stores predicted an aerobic dive limit of 5.4 min. The peak end-tidal O-2 values were related to the length of the previous breath-hold, demonstrating the increased oxygen uptake from the lung for the longer dives. Blood oxygen capacity was 23.5 +/- 1.0 ml.100 ml(-1), and the oxygen affinity was high, enabling rapid oxygen loading during ventilation. [References: 56] 56},
  journal = {Journal of Comparative Physiology - B, Biochemical, Systemic, \& Environmental Physiology},
  keywords = {Animal Sciences in Current Contents(R)/Agricultura,Seals halichoerus-grypus. Metabolic rates. Respira},
  number = {1}
}

@article{Reep.1998,
  title = {Distribution and Innervation of Facial Bristles and Hairs in the {{Florida}} Manatee ({{Trichechus}} Manatus Latirostris)},
  author = {Reep., R L and Marshall, C D and Stoll, M L and Whitaker, D M and Reep, R L and Marshall, C D and Stoll, M L and Whitaker, D M},
  year = {1998},
  volume = {14},
  pages = {257--273},
  abstract = {The distribution and anatomy of sirenian perioral bristles (modified vibrissae) and facial hairs are of interest because of their use during feeding and tactile exploration. In the present study, we have identified six fields of perioral bristles on the face of the Florida manatee (T. manatus latirostris), four (U1U4) on each side of the upper lips and oral cavity, and two (L1L2) on each side of the lower lip pad, inside the oral cavity and rostral to the horny mandibular pad. Each field has a characteristic location, number of bristles, and range of bristle length and diameter. There is a mean of 110 ({$\pm$}19) bristles per side, with no leftright differences. Branches of the infraorbital nerve innervate the bases of the largest bristles (U2 group) on the upper bristle pad, and the inferior alveolar nerve supplies of the bristles of the lower bristle pad. The dorsal and ventral buccal branches of the facial nerve innervate the superficial facial musculature, which is likely to be involved in bristle eversion and other movements which constitute feeding behavior.},
  isbn = {0824-0469},
  journal = {Marine Mammal Science},
  keywords = {5680,PBS Record: 895,Trichechus manatus,vibrissae},
  mendeley-tags = {5680,PBS Record: 895},
  number = {2}
}

